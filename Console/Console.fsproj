<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>Exe</OutputType>
		<AssemblyName>EngineBattle.Console</AssemblyName>
		<TargetFramework>net10.0</TargetFramework>
		<PublishSingleFile>true</PublishSingleFile>
	</PropertyGroup>

	<ItemGroup>
		<Content Include="Json\EretConfig.json" />
		<Content Include="Json\PuzzleConfig.json" />
		<Content Include="Json\Tournament.json" />
		<Content Include="Properties\launchSettings.json" />
		<Content Include="benchmark-options.json" />
		<Compile Include="CliParser.fs" />
		<Compile Include="BenchmarkRunner.fs" />
		<Compile Include="TunerRunner.fs" />
		<Compile Include="BayesianOptimizer.fs" />
		<Compile Include="MatchMode.fs" />
		<Compile Include="Program.fs" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="MathNet.Numerics.FSharp" Version="5.0.0" />
	</ItemGroup>

	<ItemGroup>
		<ProjectReference Include="..\ChessLibrary\ChessLibrary.fsproj" />
	</ItemGroup>
	
	<Target Name="CopyContentAfterPublish" AfterTargets="Publish">
		<!-- Only when there is one: the repository has no Console/tournament.json (the console reads
		     the file named on its command line), and copying a missing file failed every publish. -->
		<Copy SourceFiles="tournament.json" DestinationFolder="$(PublishDir)" Condition="Exists('tournament.json')" />
	</Target>


</Project>


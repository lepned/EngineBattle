<Project Sdk="Microsoft.NET.Sdk.Web">
	<PropertyGroup>
		<TargetFramework>net10.0</TargetFramework>
		<AssemblyName>EngineBattle</AssemblyName>
		<ImplicitUsings>enable</ImplicitUsings>
		<ApplicationIcon>chessIcon.ico</ApplicationIcon>
	</PropertyGroup>
<ItemGroup>
		<!-- Bound directly by PuzzleRunReport.razor (SpecialFunctions.Erfc). It arrives
		     transitively via ChessLibrary today, but an invisible dependency breaks inside a
		     generated .razor.g.cs the moment that reference changes. -->
		<PackageReference Include="MathNet.Numerics" Version="5.0.0" />
		<PackageReference Include="Markdig" Version="0.41.1" />
		<PackageReference Include="MudBlazor" Version="8.5.1" />
		<PackageReference Include="Toolbelt.Blazor.HotKeys2" Version="6.0.1" />
		<PackageReference Include="Serilog.Extensions.Logging" Version="8.0.0" /> 
		<PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
	</ItemGroup>
	
	<ItemGroup>
		<ProjectReference Include="..\ChessLibrary\ChessLibrary.fsproj" />
	</ItemGroup>

	<ItemGroup>
		<Content Update="wwwroot\AnalyzeConfig.json" CopyToPublishDirectory="Never" />
	</ItemGroup>

	<!-- The documentation has ONE source, the markdown files in the repository root, which is
	     what GitHub renders. They are linked into wwwroot here so the app can serve and render
	     the same files (start page, /docs/{name}); nothing is copied into the tree, so nothing
	     can drift. Internal notes that are not user documentation are excluded by name. -->
	<ItemGroup>
		<Content Include="..\*.md"
		         Exclude="..\CLAUDE.md;..\agent.md;..\NuGetPackagePlan.md;..\RunningCeresTournaments.md;..\SPRT.md"
		         Link="wwwroot\%(Filename)%(Extension)" />
		<Content Include="..\License.txt" Link="wwwroot\License.txt" />
	</ItemGroup>

</Project>
   
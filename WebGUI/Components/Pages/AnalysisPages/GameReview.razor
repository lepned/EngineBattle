@page "/analysis/game-review"

@using WebGUI.Components.Layout
@using WebGUI.Components.Layout.ChessboardLayout
@using WebGUI.Plotting
@using WebGUI.Services
@using System.Text
@using System.Globalization
@using Microsoft.FSharp.Core
@using static ChessLibrary.GameAccuracyAnalysis
@using static ChessLibrary.PGNTypes
@using WebGUI.Components.Layout.ExperimentalLayout
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog

@implements IAsyncDisposable
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject NavigationManager navManager
@inject ILogger<GameReview> logger
@inject GameReviewService ReviewService
@inject JavaScriptInteropService JsInteropService
@inject GlobalSettingsService SettingsService
@inject AnalysisNavigationService AnalysisNav

<PageTitle>Game Review</PageTitle>


<div class="game-review">
    @* ── Toolbar ── *@
    <div class="gr-toolbar">
        <button class="gr-toolbar-btn" @onclick="BrowsePGNFile" title="Load PGN file">
            <MudIcon Icon="@Icons.Material.Filled.FileOpen" Size="Size.Small" /> Load PGN
        </button>

        @if (games != null && games.Count > 1)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                       OnClick="PrevGame" Disabled="@(isAnalyzing || reviewingAll || gameIndex <= 0)"
                       StartIcon="@Icons.Material.Filled.ChevronLeft" />
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                       OnClick="OpenPGNDialog" Disabled="@(isAnalyzing || reviewingAll)"
                       Style="min-width:auto; padding:4px 8px;">
                @($"{gameIndex + 1} / {games.Count}")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                       OnClick="NextGame" Disabled="@(isAnalyzing || reviewingAll || gameIndex >= games.Count - 1)"
                       StartIcon="@Icons.Material.Filled.ChevronRight" />
        }

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                   OnClick="StartAnalysis" Disabled="@(isAnalyzing || reviewingAll || currentGame == null || engineConfig == null)"
                   StartIcon="@Icons.Material.Filled.PlayArrow">
            Review
        </MudButton>

        @if (games != null && games.Count > 1)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small"
                       OnClick="ReviewAllGames" Disabled="@(isAnalyzing || reviewingAll || engineConfig == null)"
                       StartIcon="@Icons.Material.Filled.PlaylistPlay">
                Review All
            </MudButton>
        }

        <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                   OnClick="QuickAnalysis" Disabled="@(isAnalyzing || reviewingAll || currentGame == null)"
                   StartIcon="@Icons.Material.Filled.FlashOn">
            Quick Review
        </MudButton>

        @if (isAnalyzing || reviewingAll)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                       OnClick="CancelAnalysis" StartIcon="@Icons.Material.Filled.Stop">
                Cancel
            </MudButton>
        }

        @if (analysisResult != null)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                       OnClick="BrowseExportFolder" StartIcon="@Icons.Material.Filled.FolderOpen"
                       title="@(!string.IsNullOrEmpty(exportFolder) ? exportFolder : "Pick export folder")">
                @(!string.IsNullOrEmpty(exportFolder) ? Path.GetFileName(exportFolder.TrimEnd('/','\\')) : "Export Folder")
            </MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small"
                       OnClick="ExportAnnotatedPGN" StartIcon="@Icons.Material.Filled.Download">
                Export PGN
            </MudButton>
        }
    </div>

    @* ── Review All Progress ── *@
    @if (reviewingAll)
    {
        <div style="padding:4px 8px; font-size:0.85rem; color:var(--mud-palette-text-secondary);">
            Reviewing game @(reviewAllCurrentGame + 1) of @(games.Count)...
        </div>
    }

    @* ── Progress Bar ── *@
    @if (isAnalyzing)
    {
        <MudProgressLinear Value="@progressPercent" Max="100" Color="Color.Primary" Striped="true"
                           Style="height:6px" />
        <div class="gr-progress-text">Analyzing move @progressCurrent / @progressTotal</div>
    }

    @* ── Main Content ── *@
    <div class="gr-main">
        @* ── Left: EnginePanel ── *@
        <div class="gr-left">
            <EnginePanel @ref="enginePanel" FEN="@fen" ChessBoard="@board"
                         Id="grEngine" Engine="engineConfig"
                         Nodes="@nodes"
                         IsReviewing="@(isAnalyzing || analysisResult == null)"
                         CompactChartLegend="true" StatsPanelKey="game-review"
                         OnNewEngineLoaded="OnNewEngineLoaded" />
        </div>

        @* ── Center: Board + Annotated Move List ──
           The board size rides on the container so the below-board grid, which mirrors the
           board + move-list columns, stays aligned with it. *@
        <div class="gr-center" style="@($"--mcb-board-size:{boardSizePx}px")">
            <ModernChessboard @ref="chessBoardRazor" FENposition="@fen" ShowFenField="false"
                        ShowChessNavButtons="true" ShowMoveList="true"
                        MakeMoveListClickable="true"
                        MoveListPosition="MoveListPosition.Right"
                        ShowSizeSlider="true" SizeKey="game-review"
                        OnBoardSizeChanged="@(n => { boardSizePx = n; StateHasChanged(); })"
                        MoveEvals="@moveEvals"
                        MoveAnnotations="@moveAnnotations"
                        ChessBoard="@board"
                        OnMoveMadeOnBoard="OnBoardNavigated"
                        OnNewFENOnBoard="OnBoardNavigated"
                        OnBoardFlipped="f => boardFlipped = f"
                        EvalBarContent="@(SettingsService.Settings.ShowEvalBar ? EvalBarLeft : null)"
                        DetectedOpeningName="@openingName"
                        DetectedOpeningECO="@openingECO" />

            @if (analysisResult != null)
            {
                <div class="gr-below-board">
                    <div>
                        @if (GetCriticalMoves() is var criticalMoves && criticalMoves.Length > 0)
                        {
                            <div class="gr-stats-card gr-critical-card">
                                <h4>Critical Moves (@criticalMoves.Length)</h4>
                                <div class="gr-critical-list">
                                    @foreach (var move in criticalMoves)
                                    {
                                        <div class="gr-critical-row"
                                             @onclick="() => NavigateToPly(move.Ply)">
                                            <span class="gr-detail-chip @GetMoveClass(move.Classification)">@GetBadge(move.Classification)</span>
                                            <span class="gr-critical-move">@(move.Color == "w" ? $"{move.MoveNumber}." : $"{move.MoveNumber}...")@move.San</span>
                                            @if (!string.IsNullOrEmpty(move.BestMoveSan) && move.BestMove != move.UciMove)
                                            {
                                                <span class="gr-critical-best">@move.BestMoveSan</span>
                                            }
                                            <span class="gr-critical-acc">@($"{move.MoveAccuracy:F0}%")</span>
                                        </div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                    <div class="gr-stats-card gr-accuracy-card">
                        <div class="gr-accuracy-row">
                            <div class="gr-accuracy-item">
                                <div class="gr-accuracy-circle" style="--pct:@analysisResult.WhiteStats.Accuracy; --ring-color:#90caf9;">
                                    <span class="gr-accuracy-value">@($"{analysisResult.WhiteStats.Accuracy:F1}")</span>
                                </div>
                                <div class="gr-accuracy-label">@DisplayPlayerName(analysisResult.WhitePlayer, "White")</div>
                            </div>
                            <div class="gr-accuracy-item">
                                <div class="gr-accuracy-circle" style="--pct:@analysisResult.BlackStats.Accuracy; --ring-color:#616161;">
                                    <span class="gr-accuracy-value">@($"{analysisResult.BlackStats.Accuracy:F1}")</span>
                                </div>
                                <div class="gr-accuracy-label">@DisplayPlayerName(analysisResult.BlackPlayer, "Black")</div>
                            </div>
                        </div>
                    </div>
                </div>
            }
        </div>

        @* ── Right: Stats + Chart + Game List ── *@
        <div class="gr-right">
            @if (currentGame != null)
            {
                <div class="gr-game-info">
                    <span class="gr-game-info-players">@DisplayPlayerName(currentGame.GameMetaData.White) vs @DisplayPlayerName(currentGame.GameMetaData.Black)</span>
                    @if (!string.IsNullOrEmpty(openingName))
                    {
                        <span class="gr-game-info-opening">@openingName</span>
                    }
                    <span class="gr-game-info-result">@currentGame.GameMetaData.Result</span>
                </div>
            }

            <div @ref="chartElement" class="gr-chart" style="@(analysisResult == null ? "display:none" : "")"></div>

            @if (analysisResult != null)
            {
                <div class="gr-stats-card">
                    <h4>Classifications</h4>
                    <table class="gr-class-table">
                        <thead><tr><th></th><th>White</th><th>Black</th></tr></thead>
                        <tbody>
                            @foreach (var cls in classificationOrder)
                            {
                                var wCount = analysisResult.WhiteStats.Classifications.TryFind(cls);
                                var bCount = analysisResult.BlackStats.Classifications.TryFind(cls);
                                var w = OptionModule.IsSome(wCount) ? wCount.Value : 0;
                                var b = OptionModule.IsSome(bCount) ? bCount.Value : 0;
                                @if (w > 0 || b > 0)
                                {
                                    <tr>
                                        <td class="@GetMoveClass(cls)">@GetBadge(cls) @GetClassificationName(cls)</td>
                                        <td>@w</td>
                                        <td>@b</td>
                                    </tr>
                                }
                            }
                        </tbody>
                    </table>
                </div>

                <div class="gr-stats-card">
                    <h4>Phase Breakdown</h4>
                    <table class="gr-phase-table">
                        <thead><tr><th></th><th>White</th><th>Black</th></tr></thead>
                        <tbody>
                            <tr><td>Opening</td><td>@FormatPhaseAccuracy(analysisResult.WhiteStats.OpeningAccuracy, 1, 15)</td><td>@FormatPhaseAccuracy(analysisResult.BlackStats.OpeningAccuracy, 1, 15)</td></tr>
                            <tr><td>Middlegame</td><td>@FormatPhaseAccuracy(analysisResult.WhiteStats.MiddlegameAccuracy, 16, 40)</td><td>@FormatPhaseAccuracy(analysisResult.BlackStats.MiddlegameAccuracy, 16, 40)</td></tr>
                            <tr><td>Endgame</td><td>@FormatPhaseAccuracy(analysisResult.WhiteStats.EndgameAccuracy, 41, int.MaxValue)</td><td>@FormatPhaseAccuracy(analysisResult.BlackStats.EndgameAccuracy, 41, int.MaxValue)</td></tr>
                            <tr><td><strong>ACPL</strong></td><td>@($"{analysisResult.WhiteStats.ACPL:F1}")</td><td>@($"{analysisResult.BlackStats.ACPL:F1}")</td></tr>
                        </tbody>
                    </table>
                </div>
            }

            @* ── Game List ── *@
            @if (games != null && games.Count > 1)
            {
                <div class="gr-stats-card">
                    <h4>Games (@games.Count)</h4>
                    <div class="gr-gamelist">
                        @foreach (var game in games.Take(100))
                        {
                            <div class="gr-game-row @(game == currentGame ? "gr-game-selected" : "")"
                                 @onclick="() => SelectGame(game)">
                                <span>@game.GameNumber.</span>
                                <span>@DisplayGameLabel(game)</span>
                                <span>@game.GameMetaData.Result</span>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    // ── State ──
    private Chess.Board board = new();
    private ModernChessboard chessBoardRazor;
    // Mirrors the board's own size setting; only used to keep the below-board grid aligned.
    private int boardSizePx = 700;
    private string fen = Chess.startPos;
    private string openingName = "";
    private string openingECO = "";

    // Engine
    private EngineConfig engineConfig;
    private string engineName = "";
    private WebGUI.Components.Layout.EnginePanel enginePanel;

    // PGN / Games
    private List<PgnGame> games;
    private PgnGame currentGame;
    private int gameIndex;
    private HashSet<PgnGame> selectedItems = new();
    private string searchString = "";
    private Dictionary<int, GameAnalysisResult> allResults = new();
    private bool reviewingAll;
    private int reviewAllCurrentGame;

    // Analysis
    private GameAnalysisResult analysisResult;
    private Dictionary<int, string> moveEvals = new();
    private Dictionary<int, ModernChessboard.MoveAnnotation> moveAnnotations = new();

    // ── Eval bar: driven by the review's per-move evals, so it tracks browsing without
    // a running engine. moveEvals has two keying conventions: review data is EvalBefore
    // (keyed by the NEXT move's ply), comment-extracted evals are after-move (keyed by
    // the LAST move's ply) — probe the matching key first, the other as fallback.
    private bool boardFlipped;
    private RenderFragment EvalBarLeft => @<EvalBar Cp="@CurrentEval.Cp" Mate="@CurrentEval.Mate" Flipped="@boardFlipped" />;

    private (double? Cp, int? Mate) CurrentEval
    {
        get
        {
            var idx = gameFens != null ? Array.IndexOf(gameFens, fen) : -1; // last played ply, -1 = start position
            var keys = analysisResult != null ? new[] { idx + 1, idx } : new[] { idx, idx + 1 };
            foreach (var k in keys)
            {
                if (k >= 0 && moveEvals.TryGetValue(k, out var s))
                {
                    var v = ParseEvalString(s);
                    if (v.Cp != null || v.Mate != null) return v;
                }
            }
            return (null, null);
        }
    }

    /// <summary>"+0.3" / "-1.5" / "M5" / "M-3" (white perspective) → typed eval.</summary>
    private static (double? Cp, int? Mate) ParseEvalString(string s)
    {
        if (string.IsNullOrWhiteSpace(s)) return (null, null);
        s = s.Trim();
        if (s.StartsWith("M", StringComparison.OrdinalIgnoreCase))
            return int.TryParse(s[1..], System.Globalization.NumberStyles.Integer,
                                System.Globalization.CultureInfo.InvariantCulture, out var m)
                ? (null, m) : ((double?)null, (int?)null);
        return double.TryParse(s, System.Globalization.NumberStyles.Float,
                               System.Globalization.CultureInfo.InvariantCulture, out var cp)
            ? (cp, null) : ((double?)null, (int?)null);
    }
    private bool isAnalyzing;
    private int progressCurrent;
    private int progressTotal;
    private double progressPercent;
    private CancellationTokenSource analysisCts;
    // Loop-level token for "Review All": StartAnalysis owns (and nulls) analysisCts per game,
    // so the loop must not read that field between games.
    private CancellationTokenSource reviewAllCts;

    // Export
    private string exportFolder = "";

    // Search config
    private SearchMode searchMode = SearchMode.Time;
    private int timePerMove = 1000;
    private int nodes = 5000;
    private int depth = 18;

    private string[] gameFens; // Snapshot of FEN per ply, set once after game load

    // Chart
    private ElementReference chartElement;
    private IJSObjectReference chessModule;
    private AccuracyPlot accuracyPlot;

    // Classification display order
    private static readonly MoveClassification[] classificationOrder = new[]
    {
        MoveClassification.Brilliant, MoveClassification.Great, MoveClassification.Best,
        MoveClassification.Excellent, MoveClassification.Good,
        MoveClassification.Inaccuracy, MoveClassification.Mistake, MoveClassification.Blunder,
        MoveClassification.Book, MoveClassification.Forced
    };

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            chessModule = await JsInteropService.ImportModuleAsync(JS);

            // Load Game Review defaults from settings
            var s = SettingsService.Settings;
            boardSizePx = Math.Clamp(s.BoardSizeFor("game-review"), 360, 900);
            exportFolder = s.PgnOutputFolder;
            searchMode = s.ReviewSearchMode switch
            {
                "Nodes" => SearchMode.Nodes,
                "Depth" => SearchMode.Depth,
                _ => SearchMode.Time
            };
            timePerMove = s.ReviewTimePerMove;
            nodes = s.ReviewNodes;
            depth = s.ReviewDepth;

            if (engineConfig == null)
            {
                var path = SettingsService.Settings.DefaultEnginePath;
                if (!string.IsNullOrEmpty(path))
                {
                    try
                    {
                        engineConfig = Configuration.JSON.readSingleEngineConfig(path);
                        engineName = engineConfig?.Name ?? "";
                    }
                    catch (Exception ex) { logger.LogWarning(ex, "Failed to load default engine from {Path}", path); }
                }
            }

            // Restore state from round-trip navigation
            if (AnalysisNav.ReviewGames != null)
            {
                games = AnalysisNav.ReviewGames;
                var savedAnalysis = AnalysisNav.ReviewAnalysisResult;
                if (!string.IsNullOrEmpty(AnalysisNav.ReviewEngineName))
                    engineName = AnalysisNav.ReviewEngineName;
                var navPly = AnalysisNav.ReviewSelectedPly;
                var navGame = AnalysisNav.ReviewCurrentGame;
                AnalysisNav.ClearReviewState();

                if (navGame != null)
                {
                    await SelectGame(navGame); // this resets analysisResult to null
                    analysisResult = savedAnalysis; // restore after SelectGame

                    // Re-render the accuracy chart
                    if (analysisResult != null && analysisResult.Moves.Length > 0)
                    {
                        accuracyPlot = new AccuracyPlot(chessModule, chartElement);
                        await accuracyPlot.RenderAsync(analysisResult);
                        await chessModule.InvokeVoidAsync("triggerResizeEvent");
                    }

                    if (navPly >= 0 && gameFens != null && navPly < gameFens.Length)
                        await NavigateToPly(navPly);
                }
            }

            StateHasChanged();
        }
    }

    // ── File Loading ──

    private async Task BrowsePGNFile()
    {
        var path = await BrowseFileDialog(SettingsService.Settings.PgnOutputFolder, "*.pgn", "Select PGN File");
        if (path == null) return;
        try
        {
            games = FullPGNParser.parsePgnFile(path).Take(4000).ToList();
            allResults.Clear();
            gameIndex = 0;

            if (games.Count > 1)
            {
                await OpenPGNDialog();
            }
            else if (games.Count == 1)
            {
                await SelectGame(games[0]);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error loading PGN file");
        }
    }

    private async Task BrowseExportFolder()
    {
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, !string.IsNullOrEmpty(exportFolder) ? exportFolder : SettingsService.Settings.PgnOutputFolder },
            { x => x.Mode, FileBrowserMode.Folder }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select Export Folder", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
            exportFolder = (string)result.Data!;
    }

    private async Task<string> BrowseFileDialog(string initialDir, string filter, string title)
    {
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, initialDir },
            { x => x.FileFilter, filter },
            { x => x.Mode, FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return null;
        return (string)result.Data!;
    }

    private async void OnNewEngineLoaded(EngineConfigEventArgs args)
    {
        engineConfig = args.EngineConfig;
        engineName = engineConfig?.Name ?? "";
        await InvokeAsync(StateHasChanged);
    }

    // ── Game Selection ──

    private async Task SelectGame(PgnGame game)
    {
        currentGame = game;

        // Restore cached result if available, otherwise clear
        gameIndex = games != null ? games.IndexOf(game) : 0;
        if (gameIndex >= 0 && allResults.TryGetValue(gameIndex, out var cached))
        {
            analysisResult = cached;
            moveEvals = BuildMoveEvals(cached.Moves);
            moveAnnotations = BuildAnnotations(cached);
        }
        else
        {
            analysisResult = null;
            moveAnnotations = new();
            // Try to extract evals from PGN comments (computer match games)
            moveEvals = PGNHelper.evalsByPly(game);
        }

        var startFen = string.IsNullOrWhiteSpace(game.Fen) ? Chess.startPos : game.Fen;
        board.ResetBoardStateFromFen(startFen);
        board.LoadPGNGameWithVariations(game);

        // Snapshot FENs before any navigation mutates MovesAndFenPlayed
        gameFens = board.MovesAndFenPlayed.Select(m => m.FenAfterMove).ToArray();

        fen = board.FEN();
        openingName = game.GameMetaData.OtherTags?.FirstOrDefault(x => x.Key == "Opening")?.Value ?? "";
        openingECO = game.GameMetaData.OtherTags?.FirstOrDefault(x => x.Key == "ECO")?.Value ?? "";

        if (chessBoardRazor != null)
        {
            await chessBoardRazor.OnNotifyMoveAndFen(board.MovesAndFenPlayed.Count > 0
                ? board.MovesAndFenPlayed[board.MovesAndFenPlayed.Count - 1]
                : MoveAndFen.FirstEntry);
        }

        StateHasChanged();
    }

    private async Task OpenPGNDialog()
    {
        if (games == null || games.Count == 0) return;
        var parameters = new DialogParameters
        {
            ["Games"] = games,
            ["SelectedItems"] = selectedItems,
            ["SearchString"] = searchString
        };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.ExtraLarge,
            FullWidth = true,
            CloseOnEscapeKey = true,
            BackdropClick = false,
            Position = DialogPosition.CenterRight
        };
        var dialog = await DialogService.ShowAsync<PGNGameListDialog>("Select Game for Review", parameters, options);
        var result = await dialog.Result;
        if (result?.Data is null || result.Canceled) return;
        var (pgnGame, search) = ((PgnGame, string))result.Data;
        searchString = search;
        selectedItems.Clear();
        selectedItems.Add(pgnGame);
        await SelectGame(pgnGame);
    }

    private async Task PrevGame()
    {
        if (games == null || gameIndex <= 0) return;
        gameIndex--;
        selectedItems.Clear();
        selectedItems.Add(games[gameIndex]);
        await SelectGame(games[gameIndex]);
    }

    private async Task NextGame()
    {
        if (games == null || gameIndex >= games.Count - 1) return;
        gameIndex++;
        selectedItems.Clear();
        selectedItems.Add(games[gameIndex]);
        await SelectGame(games[gameIndex]);
    }

    private async Task ReviewAllGames()
    {
        if (games == null || games.Count == 0 || engineConfig == null) return;
        reviewingAll = true;
        reviewAllCts?.Dispose();
        reviewAllCts = new CancellationTokenSource();
        allResults.Clear();

        try
        {
            for (int i = 0; i < games.Count; i++)
            {
                if (reviewAllCts.Token.IsCancellationRequested) break;

                reviewAllCurrentGame = i;
                gameIndex = i;
                await SelectGame(games[i]);
                await InvokeAsync(StateHasChanged);

                await StartAnalysis();

                if (analysisResult != null)
                    allResults[i] = analysisResult;
            }
        }
        finally
        {
            reviewingAll = false;
            reviewAllCts?.Dispose();
            reviewAllCts = null;
            await InvokeAsync(StateHasChanged);
        }
    }

    // ── Analysis ──

    private PgnGame BuildGameWithVariations(PgnGame game, GameAnalysisResult analysis)
    {
        // Clone mainline and attach engine PV as variations where the engine disagrees
        var newMainline = new List<PlyMove>();
        foreach (var ply in game.Mainline)
        {
            var newPly = new PlyMove(ply.Ply, ply.MoveNumber, ply.Color, ply.San, ply.Comment,
                                     ply.Nags, new List<List<PlyMove>>(ply.Variations));
            newMainline.Add(newPly);
        }

        foreach (var move in analysis.Moves)
        {
            if (string.IsNullOrEmpty(move.PV)) continue;
            if (move.Ply < 0 || move.Ply >= newMainline.Count) continue;

            // Clear raw engine comments — evals are shown in the move list columns
            var mainPly = newMainline[move.Ply];
            mainPly.Comment = "";

            // Only add variation if engine's best move differs from played move
            if (move.BestMove == move.UciMove) continue;

            var pvMoves = move.PV.Split(' ', StringSplitOptions.RemoveEmptyEntries);
            if (pvMoves.Length == 0) continue;

            try
            {
                var variationLine = BuildVariationLine(move, pvMoves);
                if (variationLine != null && variationLine.Count > 0)
                {
                    mainPly.Variations.Add(variationLine);
                    logger.LogInformation("Added variation at ply {Ply}: {San} → {BestSan} ({Count} moves)",
                        move.Ply, move.San, move.BestMoveSan, variationLine.Count);
                }
            }
            catch (Exception ex)
            {
                logger.LogWarning("Failed to build variation at ply {Ply}: {Error}", move.Ply, ex.Message);
            }
        }

        return new PgnGame(game.GameNumber, game.GameMetaData, newMainline,
                           game.RootVariations, game.Comments, game.Fen, game.Raw);
    }

    private List<PlyMove> BuildVariationLine(MoveAnalysisResult move, string[] pvMoves)
    {
        var tempBoard = new Chess.Board();
        string fen;
        if (move.Ply == 0)
            fen = string.IsNullOrWhiteSpace(currentGame?.Fen) ? Chess.startPos : currentGame.Fen;
        else if (gameFens != null && move.Ply - 1 < gameFens.Length)
            fen = gameFens[move.Ply - 1];
        else
            fen = Chess.startPos;

        tempBoard.LoadFen(fen);

        var line = new List<PlyMove>();
        var currentPly = move.Ply;

        foreach (var uciMove in pvMoves)
        {
            try
            {
                var sanCountBefore = tempBoard.SanMovesPlayed.Count;
                tempBoard.PlayUciMove(uciMove);
                if (tempBoard.SanMovesPlayed.Count <= sanCountBefore) break;

                var san = tempBoard.SanMovesPlayed[tempBoard.SanMovesPlayed.Count - 1];
                var moveNumber = (currentPly / 2) + 1;
                var color = currentPly % 2 == 0 ? "w" : "b";
                var comment = "";

                line.Add(new PlyMove(currentPly, moveNumber, color, san, comment,
                                     Microsoft.FSharp.Collections.ListModule.Empty<int>(),
                                     new List<List<PlyMove>>()));
                currentPly++;
            }
            catch (Exception ex)
            {
                logger.LogWarning("PV conversion failed at ply {Ply} move '{Move}': {Error}", currentPly, uciMove, ex.Message);
                break;
            }
        }

        return line;
    }

    private static string FormatEval(EvalType eval)
    {
        // Three sections, not two: .NET applies the negative section to a value like -0.04
        // and then adds the sign of negative zero, printing "-+0.0". Near-zero evals are
        // everywhere in lichess games, which Quick Analysis now reads.
        if (eval.IsCP) return $"{((EvalType.CP)eval).Info:+0.0;-0.0;0.0}";
        if (eval.IsMate) return $"M{((EvalType.Mate)eval).Info}";
        return "";
    }

    private static Dictionary<int, string> BuildMoveEvals(MoveAnalysisResult[] moves) =>
        moves.Where(m => !m.EvalBefore.IsNA)
             .ToDictionary(m => m.Ply, m => FormatEval(m.EvalBefore));


    private static bool IsNotableClassification(MoveClassification cls) =>
        cls.IsBrilliant || cls.IsGreat || cls.IsInaccuracy || cls.IsMistake || cls.IsBlunder;

    private static string GetClassCss(MoveClassification cls)
    {
        if (cls.IsBrilliant) return "mcb-move-brilliant";
        if (cls.IsGreat) return "mcb-move-great";
        if (cls.IsInaccuracy) return "mcb-move-inaccuracy";
        if (cls.IsMistake) return "mcb-move-mistake";
        if (cls.IsBlunder) return "mcb-move-blunder";
        return "";
    }

    private static string GetClassLabel(MoveClassification cls)
    {
        if (cls.IsBrilliant) return "Brilliant.";
        if (cls.IsGreat) return "Great move.";
        if (cls.IsInaccuracy) return "Inaccuracy.";
        if (cls.IsMistake) return "Mistake.";
        if (cls.IsBlunder) return "Blunder.";
        return "";
    }

    private static ModernChessboard.MoveAnnotation BuildAnnotation(MoveAnalysisResult m)
    {
        var symbol = GetBadge(m.Classification);
        var label = GetClassLabel(m.Classification);
        var bestInfo = "";
        if (m.Classification.IsInaccuracy || m.Classification.IsMistake || m.Classification.IsBlunder)
            bestInfo = !string.IsNullOrEmpty(m.BestMoveSan) ? $"{m.BestMoveSan} was best." : "";
        return new ModernChessboard.MoveAnnotation(symbol, GetClassCss(m.Classification), label, bestInfo);
    }

    private static Dictionary<int, ModernChessboard.MoveAnnotation> BuildAnnotations(GameAnalysisResult result)
    {
        return result.Moves
            .Where(m => IsNotableClassification(m.Classification))
            .ToDictionary(m => m.Ply, BuildAnnotation);
    }

    private async Task StartAnalysis()
    {
        if (currentGame == null || engineConfig == null || isAnalyzing) return;

        isAnalyzing = true;
        progressCurrent = 0;
        progressTotal = currentGame.Mainline.Count;
        progressPercent = 0;
        analysisResult = null;
        accuracyPlot = null;
        moveEvals.Clear();
        moveAnnotations.Clear();
        analysisCts?.Dispose();
        analysisCts = new CancellationTokenSource();

        // Track last PV1 eval for live move list updates
        EvalType liveEval = EvalType.NA;

        // Clear previous chart
        if (chessModule != null)
        {
            try { await chessModule.InvokeVoidAsync("clearQPlot", chartElement, new { }); }
            catch (Exception ex) { logger.LogDebug(ex, "Failed to clear Q-value plot"); }
        }

        StateHasChanged();

        // Sync search settings from EnginePanel
        var mode = enginePanel != null && enginePanel.IsTimeMode
            ? GameAccuracyAnalysis.SearchMode.Time
            : GameAccuracyAnalysis.SearchMode.Nodes;
        var time = enginePanel != null ? (int)enginePanel.CurrentTimeMs : timePerMove;
        var nodeCount = enginePanel != null ? (int)enginePanel.CurrentNodes : nodes;

        var s = SettingsService.Settings;
        var thresholds = new GameAccuracyAnalysis.ClassificationThresholds(
            s.BrilliantPVGap, s.GreatPVGap, s.BestMinPVGap,
            s.ExcellentMaxWPLoss, s.GoodMaxWPLoss,
            s.InaccuracyMaxWPLoss, s.MistakeMaxWPLoss);
        var config = new GameReviewConfig(mode, time, nodeCount, depth, s.ReviewMultiPV, true, thresholds, s.AccuracyDecay, s.MicroLossBase, s.MicroLossScale);

        var progress = new Progress<(int current, int total)>(async p =>
        {
            await InvokeAsync(async () =>
            {
                progressCurrent = p.current;
                progressTotal = p.total;
                progressPercent = progressTotal > 0 ? (double)progressCurrent / progressTotal * 100.0 : 0;

                // Record eval for the just-completed move
                if (p.current >= 2 && liveEval != EvalType.NA)
                {
                    moveEvals[p.current - 2] = FormatEval(liveEval);
                    liveEval = EvalType.NA;
                }

                if (gameFens != null && p.current > 0 && chessBoardRazor != null)
                {
                    // p.current fires before analyzing move p.current, so show the position before that move
                    fen = p.current >= 2 ? gameFens[p.current - 2] : (string.IsNullOrWhiteSpace(currentGame?.Fen) ? Chess.startPos : currentGame.Fen);
                    await chessBoardRazor.SetPositionDirect(fen);
                    if (enginePanel != null) await enginePanel.ResetChartData();
                }

                StateHasChanged();
            });
        });

        try
        {
            analysisResult = await ReviewService.AnalyzeGameAsync(
                currentGame, engineConfig, config, progress, analysisCts.Token,
                update =>
                {
                    enginePanel?.HandleUpdate(update);
                    if (update.IsStatus)
                    {
                        var status = ((EngineUpdate.Status)update).Item;
                        if (status.MultiPV <= 1)
                            liveEval = status.Eval;
                    }
                });

            if (analysisResult != null && analysisResult.Moves.Length > 0)
            {
                // Finalize evals and annotations from full analysis result
                moveEvals = BuildMoveEvals(analysisResult.Moves);
                moveAnnotations = BuildAnnotations(analysisResult);

                accuracyPlot = new AccuracyPlot(chessModule, chartElement);
                await accuracyPlot.RenderAsync(analysisResult);
                await chessModule.InvokeVoidAsync("triggerResizeEvent");

                // Rebuild game with engine PV lines as variations and reload into board
                var annotatedGame = BuildGameWithVariations(currentGame, analysisResult);
                var startFen = string.IsNullOrWhiteSpace(annotatedGame.Fen) ? Chess.startPos : annotatedGame.Fen;
                board.ResetBoardStateFromFen(startFen);
                board.LoadPGNGameWithVariations(annotatedGame);
                gameFens = board.MovesAndFenPlayed.Select(m => m.FenAfterMove).ToArray();
                fen = startFen;

                if (chessBoardRazor != null)
                {
                    await chessBoardRazor.OnNotifyMoveAndFen(board.MovesAndFenPlayed.Count > 0
                        ? board.MovesAndFenPlayed[board.MovesAndFenPlayed.Count - 1]
                        : MoveAndFen.FirstEntry);
                }

                await NavigateToPly(0);

                // Cache result for game navigation
                if (games != null && gameIndex >= 0)
                    allResults[gameIndex] = analysisResult;
            }
        }
        catch (OperationCanceledException)
        {
            // Cancelled by user
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Error during game analysis");
        }
        finally
        {
            isAnalyzing = false;
            analysisCts?.Dispose();
            analysisCts = null;
            StateHasChanged();
            if (chessModule != null)
                await chessModule.InvokeVoidAsync("triggerResizeEvent");
        }
    }

    private async Task QuickAnalysis()
    {
        if (currentGame == null) return;

        var qs = SettingsService.Settings;
        var qThresholds = new GameAccuracyAnalysis.ClassificationThresholds(
            qs.BrilliantPVGap, qs.GreatPVGap, qs.BestMinPVGap,
            qs.ExcellentMaxWPLoss, qs.GoodMaxWPLoss,
            qs.InaccuracyMaxWPLoss, qs.MistakeMaxWPLoss);
        var result = ReviewService.AnalyzeGameFromAnnotations(currentGame, qThresholds, qs.AccuracyDecay);
        if (result == null)
        {
            await DialogService.ShowMessageBox("No annotations",
                "This game carries no per-move evaluations — neither engine annotations nor lichess [%eval] commands. Use full engine analysis instead.");
            return;
        }

        analysisResult = result;
        if (analysisResult.Moves.Length > 0)
        {
            moveEvals = BuildMoveEvals(analysisResult.Moves);
            moveAnnotations = BuildAnnotations(analysisResult);

            // Variations are already in the loaded PGN game (exported with PGN variation syntax).
            // Just render the accuracy chart — no need to rebuild variations.
            accuracyPlot = new AccuracyPlot(chessModule, chartElement);
            await accuracyPlot.RenderAsync(analysisResult);
            await chessModule.InvokeVoidAsync("triggerResizeEvent");
            await NavigateToPly(0);
        }
        StateHasChanged();
    }

    private void CancelAnalysis()
    {
        reviewingAll = false;
        ReviewService.Cancel();
        try { reviewAllCts?.Cancel(); } catch (ObjectDisposedException) { }
        analysisCts?.Cancel();
    }

    // ── Navigation ──

    private async void OnBoardNavigated(string _)
    {
        if (analysisResult == null) return;
        fen = board.FEN();

        var ply = gameFens != null
            ? Array.IndexOf(gameFens, fen)
            : -1;

        if (ply >= 0 && accuracyPlot != null)
            await accuracyPlot.UpdateMoveIndicatorAsync(ply);

        await InvokeAsync(StateHasChanged);
    }

    private async Task NavigateToPly(int ply)
    {
        if (gameFens == null || ply < 0 || ply >= gameFens.Length) return;
        fen = gameFens[ply];
        // SetPositionDirect only repaints the visual board — the shared Chess.Board must
        // follow too, since EnginePanel snapshots it for the search position. Without this,
        // starting a search after review navigation analyzes wherever the board last was
        // (typically the final position).
        board.LoadFen(fen);
        if (chessBoardRazor != null)
            await chessBoardRazor.SetPositionDirect(fen);
        if (accuracyPlot != null)
            await accuracyPlot.UpdateMoveIndicatorAsync(ply);
        StateHasChanged();
    }

    // ── Export ──

    private async Task ExportAnnotatedPGN()
    {
        if (analysisResult == null || currentGame == null) return;

        var sb = new StringBuilder();
        sb.AppendLine($"[Event \"{currentGame.GameMetaData.Event}\"]");
        sb.AppendLine($"[White \"{analysisResult.WhitePlayer}\"]");
        sb.AppendLine($"[Black \"{analysisResult.BlackPlayer}\"]");
        sb.AppendLine($"[Result \"{currentGame.GameMetaData.Result}\"]");
        sb.AppendLine($"[WhiteAccuracy \"{analysisResult.WhiteStats.Accuracy:F1}\"]");
        sb.AppendLine($"[BlackAccuracy \"{analysisResult.BlackStats.Accuracy:F1}\"]");
        sb.AppendLine($"[Annotator \"{analysisResult.AnalysisEngine}\"]");
        sb.AppendLine();

        foreach (var move in analysisResult.Moves)
        {
            if (move.Color == "w")
                sb.Append($"{move.MoveNumber}. ");

            sb.Append(move.San);

            // Classification is stored in the comment (cls= field), no NAGs needed

            // Add analysis comment with full data for reload
            var comment = $"wv={move.EvalBefore}, acc={move.MoveAccuracy:F0}%";
            var clsName = move.Classification switch
            {
                var c when c.IsBook => "Book", var c when c.IsForced => "Forced",
                var c when c.IsBrilliant => "Brilliant", var c when c.IsGreat => "Great",
                var c when c.IsBest => "Best", var c when c.IsExcellent => "Excellent",
                var c when c.IsGood => "Good", var c when c.IsInaccuracy => "Inaccuracy",
                var c when c.IsMistake => "Mistake", var c when c.IsBlunder => "Blunder",
                _ => "Best"
            };
            comment += $", cls={clsName}";
            comment += $", wpl={move.WinProbLoss:F4}, cpl={move.CentipawnLoss:F1}";
            if (!string.IsNullOrEmpty(move.BestMove))
                comment += $", bm={move.BestMove}";
            if (!string.IsNullOrEmpty(move.BestMoveSan))
                comment += $", bms={move.BestMoveSan}";
            if (move.Depth > 0)
                comment += $", d={move.Depth}";
            if (move.Nodes > 0)
                comment += $", n={move.Nodes}";
            sb.Append($" {{{comment}}} ");

            // Write PGN variation when engine's best move differs from played move
            if (!string.IsNullOrEmpty(move.PV) && move.BestMove != move.UciMove)
            {
                var pvMoves = move.PV.Split(' ', StringSplitOptions.RemoveEmptyEntries);
                if (pvMoves.Length > 0)
                {
                    try
                    {
                        var variationLine = BuildVariationLine(move, pvMoves);
                        if (variationLine != null && variationLine.Count > 0)
                        {
                            sb.Append("(");
                            foreach (var vm in variationLine)
                            {
                                if (vm.Color == "w")
                                    sb.Append($"{vm.MoveNumber}. ");
                                else if (vm == variationLine[0])
                                    sb.Append($"{vm.MoveNumber}... ");
                                sb.Append(vm.San);
                                if (!string.IsNullOrEmpty(vm.Comment))
                                    sb.Append($" {{{vm.Comment}}}");
                                sb.Append(' ');
                            }
                            sb.Append(") ");
                        }
                    }
                    catch { /* variation build failed — skip */ }
                }
            }
        }
        sb.AppendLine(currentGame.GameMetaData.Result);

        var invalidChars = Path.GetInvalidFileNameChars();
        var cleanWhite = new string(analysisResult.WhitePlayer.Where(c => !invalidChars.Contains(c)).ToArray());
        var cleanBlack = new string(analysisResult.BlackPlayer.Where(c => !invalidChars.Contains(c)).ToArray());
        var fileName = $"review_{cleanWhite}_vs_{cleanBlack}.pgn";
        try
        {
            if (!string.IsNullOrEmpty(exportFolder) && Directory.Exists(exportFolder))
            {
                var filePath = Path.Combine(exportFolder, fileName);
                await File.WriteAllTextAsync(filePath, sb.ToString());
                logger.LogInformation("Game review exported to {path}", filePath);
                await DialogService.ShowMessageBox("Exported", $"Saved to {filePath}");
            }
            else
            {
                var bytes = Encoding.UTF8.GetBytes(sb.ToString());
                var base64 = Convert.ToBase64String(bytes);
                await JS.InvokeVoidAsync("eval",
                    $"(function(){{ var a=document.createElement('a'); a.href='data:text/plain;base64,{base64}'; a.download='{fileName.Replace("'", "\\'")}'; document.body.appendChild(a); a.click(); document.body.removeChild(a); }})()");
            }
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Failed to export annotated PGN");
        }
    }

    // ── Helpers ──

    private MoveAnalysisResult[] GetCriticalMoves() =>
        analysisResult?.Moves.Where(m =>
            m.Classification.IsInaccuracy || m.Classification.IsMistake || m.Classification.IsBlunder).ToArray()
        ?? Array.Empty<MoveAnalysisResult>();

    private static string GetMoveClass(MoveClassification cls)
    {
        if (cls.IsBrilliant) return "gr-brilliant";
        if (cls.IsGreat) return "gr-great";
        if (cls.IsBest) return "gr-best";
        if (cls.IsExcellent) return "gr-excellent";
        if (cls.IsGood) return "gr-good";
        if (cls.IsInaccuracy) return "gr-inaccuracy";
        if (cls.IsMistake) return "gr-mistake";
        if (cls.IsBlunder) return "gr-blunder";
        return "gr-neutral";
    }

    private static string GetBadge(MoveClassification cls)
    {
        if (cls.IsBrilliant) return "!!";
        if (cls.IsGreat) return "!";
        if (cls.IsBest) return "";
        if (cls.IsExcellent) return "";
        if (cls.IsInaccuracy) return "?!";
        if (cls.IsMistake) return "?";
        if (cls.IsBlunder) return "??";
        return "";
    }

    private static string GetClassificationName(MoveClassification cls)
    {
        if (cls.IsBrilliant) return "Brilliant";
        if (cls.IsGreat) return "Great";
        if (cls.IsBest) return "Best";
        if (cls.IsExcellent) return "Excellent";
        if (cls.IsGood) return "Good";
        if (cls.IsInaccuracy) return "Inaccuracy";
        if (cls.IsMistake) return "Mistake";
        if (cls.IsBlunder) return "Blunder";
        if (cls.IsBook) return "Book";
        if (cls.IsForced) return "Forced";
        return "";
    }

    private string GetSearchModeLabel()
    {
        if (enginePanel != null)
        {
            return enginePanel.IsTimeMode
                ? $"Time {(int)enginePanel.CurrentTimeMs}ms"
                : $"Nodes {FormatNodes((long)enginePanel.CurrentNodes)}";
        }
        if (searchMode.IsTime) return $"Time {timePerMove}ms";
        if (searchMode.IsNodes) return $"Nodes {FormatNodes(nodes)}";
        if (searchMode.IsDepth) return $"Depth {depth}";
        return "";
    }

    private static string DisplayPlayerName(string name, string fallback = "")
    {
        if (string.IsNullOrWhiteSpace(name) || name == "*" || name == "?")
            return string.IsNullOrEmpty(fallback) ? "Unknown" : fallback;
        return name;
    }

    private static string DisplayGameLabel(PgnGame game)
    {
        var w = DisplayPlayerName(game.GameMetaData.White, "White");
        var b = DisplayPlayerName(game.GameMetaData.Black, "Black");
        return $"{w} vs {b}";
    }

    private string FormatPhaseAccuracy(double accuracy, int minMove, int maxMove)
    {
        if (analysisResult == null) return "—";
        // Check if any classifiable moves exist in this phase for either player
        var hasMoves = analysisResult.Moves.Any(m =>
            m.MoveNumber >= minMove && m.MoveNumber <= maxMove &&
            !m.Classification.IsBook && !m.Classification.IsForced);
        return hasMoves ? $"{accuracy:F1}%" : "—";
    }

    private static string FormatNodes(long n)
    {
        if (n >= 1_000_000_000) return $"{n / 1_000_000_000.0:F1}G";
        if (n >= 1_000_000) return $"{n / 1_000_000.0:F1}M";
        if (n >= 1_000) return $"{n / 1_000.0:F1}K";
        return n.ToString();
    }

    public async ValueTask DisposeAsync()
    {
        ReviewService.Cancel();
        try { reviewAllCts?.Cancel(); } catch (ObjectDisposedException) { }
        try { reviewAllCts?.Dispose(); } catch (ObjectDisposedException) { }
        reviewAllCts = null;
        try { analysisCts?.Cancel(); } catch (ObjectDisposedException) { }
        try { analysisCts?.Dispose(); } catch (ObjectDisposedException) { }
        analysisCts = null;
    }

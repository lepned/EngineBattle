    private void OnSearchCompleted(string eval)
    {
        var ply = board.PlyCount - 1;
        analyzedPositions.Add(board.CurrentNodeHash);
        if (ply >= 0 && !string.IsNullOrEmpty(eval))
        {
            moveEvals[ply] = eval;
            chessBoardRazor?.UpdateVariationsDisplay();
            StateHasChanged();
        }
    }


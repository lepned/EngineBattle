    // Candidate-moves panel below the board, fed by EnginePanel.OnLiveStats.
    // Stats are cached per position so navigating back to an already-analyzed position
    // (which auto-search deliberately skips) restores its stats instead of going blank.
    private List<NNValues> candidateStats = new();
    private string candidateFen = "";
    private string candidatePreferred = "";
    private string candidateSource = "";
    private string candidateInfoLine = "";
    // Everything the panel shows/copies for one position, snapshotted together so restored
    // positions stay coherent even after an engine switch (engine choice ≠ max-N for MCTS).
    private sealed record CandidateSnapshot(List<NNValues> Stats, string Preferred, string Source, string InfoLine);
    private readonly Dictionary<string, CandidateSnapshot> candidateStatsByFen = new();

    // The same panel slot shows the iteration log for alpha-beta engines, which have no root
    // visit counts to display. Cached per position on the same terms as the candidate stats.
    private IReadOnlyList<IterationRow> iterationRows = new List<IterationRow>();
    private string iterationFen = "";
    private string iterationEngine = "";
    private string iterationInfoLine = "";
    private sealed record IterationSnapshot(IReadOnlyList<IterationRow> Rows, string Engine, string InfoLine);
    private readonly Dictionary<string, IterationSnapshot> iterationsByFen = new();

    // Prefer what the running engine reports; before it is up, the def's option keys give
    // the same answer (LogLiveStats is what enables the MCTS views in the first place).
    private bool ShowIterationPanel =>
        analysisWithEngine is not null
            ? !analysisWithEngine.HasLiveStats
            : Engine?.Options is not null && !Engine.Options.ContainsKey("LogLiveStats");

    private void OnIterationsUpdated((IReadOnlyList<IterationRow> Rows, string Fen) payload)
    {
        iterationRows = payload.Rows;
        iterationFen = payload.Fen;
        iterationEngine = analysisWithEngine?.EngineIdLabel ?? "";
        iterationInfoLine = analysisWithEngine?.MainInfoLine ?? "";
        if (!string.IsNullOrEmpty(payload.Fen))
        {
            if (iterationsByFen.Count > 400)
                iterationsByFen.Clear();
            iterationsByFen[payload.Fen] = new(iterationRows, iterationEngine, iterationInfoLine);
        }
    }

    private void OnLiveStatsUpdated((IReadOnlyList<NNValues> Stats, string Fen) payload)
    {
        candidateStats = payload.Stats as List<NNValues> ?? payload.Stats.ToList();
        candidateFen = payload.Fen;
        candidatePreferred = analysisWithEngine?.PreferredLanMove ?? "";
        candidateSource = analysisWithEngine?.EngineDescription ?? "";
        candidateInfoLine = analysisWithEngine?.MainInfoLine ?? "";
        if (!string.IsNullOrEmpty(payload.Fen))
        {
            // Crude bound so a very long session can't grow without limit.
            if (candidateStatsByFen.Count > 400)
                candidateStatsByFen.Clear();
            candidateStatsByFen[payload.Fen] = new(candidateStats, candidatePreferred, candidateSource, candidateInfoLine);
        }
    }

    private void RestoreCandidateStatsForCurrentPosition()
    {
        candidateFen = board.FEN();
        var cached = candidateStatsByFen.GetValueOrDefault(candidateFen);
        candidateStats = cached?.Stats ?? new();
        candidatePreferred = cached?.Preferred ?? "";
        candidateSource = cached?.Source ?? "";
        candidateInfoLine = cached?.InfoLine ?? "";

        iterationFen = candidateFen;
        var cachedIterations = iterationsByFen.GetValueOrDefault(candidateFen);
        iterationRows = cachedIterations?.Rows ?? new List<IterationRow>();
        iterationEngine = cachedIterations?.Engine ?? "";
        iterationInfoLine = cachedIterations?.InfoLine ?? "";
    }

    // "Reset board state" = fresh analysis session: without this, positions analyzed
    // before the reset stay in the skip set and auto-search silently ignores them.
    private void OnBoardReset()
    {
        analyzedPositions.Clear();
        moveEvals.Clear();
        candidateStatsByFen.Clear();
        iterationsByFen.Clear();
    }


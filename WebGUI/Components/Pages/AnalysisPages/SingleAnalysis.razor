    private void UpdateDetectedOpening()
    {
        var info = openingExplorer.Lookup(board);
        detectedOpeningName = info?.Name ?? "";
        detectedOpeningECO = info?.ECO ?? "";
        SyncOpeningInputWithDetectedOpening();
    }

    private void SyncOpeningInputWithDetectedOpening()
    {
        var autoDetectedOpening = FormatOpeningForInput(detectedOpeningName);
        var canOverwrite = string.IsNullOrWhiteSpace(openingAndVariation)
            || string.Equals(openingAndVariation, lastAutoDetectedOpening, StringComparison.Ordinal);

        lastAutoDetectedOpening = autoDetectedOpening;

        if (canOverwrite)
        {
            openingAndVariation = autoDetectedOpening;
        }
    }

    private static string FormatOpeningForInput(string openingName)
    {
        if (string.IsNullOrWhiteSpace(openingName))
        {
            return string.Empty;
        }

        var separators = new[] { ": ", ":" };
        var parts = openingName.Split(separators, 2, StringSplitOptions.TrimEntries);

        return parts.Length == 2
            ? $"{parts[0]}; {parts[1]}"
            : openingName.Trim();
    }


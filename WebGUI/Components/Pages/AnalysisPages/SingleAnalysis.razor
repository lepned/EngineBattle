    public async void OnNewEngineLoaded(EngineConfigEventArgs engineConf)
    {
        if (engineConf.Id.Contains("Input1"))
        {
            Engine = engineConf.EngineConfig;
            showOverlayControls = Engine?.Options?.Keys.Contains("LogLiveStats") ?? false;
            if (showOverlayControls)
            {
                selectedOverlay = OverlaySettings.Policy;
                overlaySettings.SetOverlaySetting("nnInput1", selectedOverlay);
            }
            else
            {
                selectedOverlay = OverlaySettings.None;
                overlaySettings.SetOverlaySetting("nnInput1", OverlaySettings.None);
                await Notifier.UpdateDisplaySettings(OverlaySettings.None, "nnInput1");
            }
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task OnOverlayChanged()
    {
        overlaySettings.SetOverlaySetting("nnInput1", selectedOverlay);
        await Notifier.UpdateDisplaySettings(selectedOverlay, "nnInput1");
    }

    private async Task OnMinPolicyChanged(double value)
    {
        overlaySettings.MinPolicyThreshold = value;
        await Notifier.UpdateDisplaySettings(selectedOverlay, "nnInput1");
    }

    private void UpdateFrcId(string currentFen)
    {
        var result = ChessLibrary.ChessUtilities.Chess960.tryGetPositionIdFromFen(currentFen);
        frcPositionId = FSharpOption<int>.get_IsSome(result) ? result.Value : null;
        frcInput = frcPositionId;
    }

    private async Task LoadFrcPosition()
    {
        if (frcInput.HasValue && frcInput >= 0 && frcInput <= 959)
        {
            var fenOpt = ChessLibrary.ChessUtilities.Chess960.tryGetFenFromPositionId(frcInput.Value);
            if (FSharpOption<string>.get_IsSome(fenOpt))
            {
                board.ResetBoardState();
                board.LoadFen(fenOpt.Value);
                board.StartPosition = fenOpt.Value;
                fen = board.FEN();
                frcPositionId = frcInput;
                await Notifier.UpdateFenToBoard(fen);
                StateHasChanged();
            }
        }
    }

    private async Task OnFrcKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadFrcPosition();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            chessModule = await JsInteropService.ImportModuleAsync(JS);
            keyContext = HotKeys.CreateContext()
                .Add(ModKey.Ctrl, Key.ArrowRight, (() => NextPGNGame()), "Next game")
                .Add(ModKey.Ctrl, Key.ArrowLeft, (() => PreviousPGNGame()), "Previous game");

            if (!_pgnPasteRegistered)
            {
                _pgnPasteDotNetRef = DotNetObjectReference.Create(this);
                _pgnPasteRegistered = true;
            }
            await chessModule.InvokeVoidAsync("registerGlobalPgnPaste", _pgnPasteDotNetRef);

            board.LoadFen(fen);
            board.StartPosition = fen;
            UpdateFrcId(board.StartPosition);
            try
            {
                var env = Environment.CurrentDirectory;
                fullPath = Path.Combine(env, "wwwroot", "AnalyzeConfig.json");
                config = Configuration.JSONParser.loadAnalyzeConfig(fullPath);
                var folder = config.EngineFolder;

                var engineConfigs =
                  config.Engines
                  .SelectMany(e => Configuration.JSONParser.mapToEngConfig(folder, e))
                  .ToList();

                if (engineConfigs.Count > 0)
                {
                    Engine = engineConfigs[0];
                    if (Engine != null && Engine.Options.Keys.Contains("LogLiveStats"))
                    {
                        showOverlayControls = true;
                        selectedOverlay = OverlaySettings.Policy;
                        overlaySettings.SetOverlaySetting("nnInput1", OverlaySettings.Policy);
                    }
                    nodes = config.Engines[0] switch
                    {
                        PuzzleEngine.Engine eng => Math.Max(1, eng.Nodes),
                        PuzzleEngine.EngineWithNets engWithNets => Math.Max(1, engWithNets.Nodes),
                        _ => Math.Max(1, config.Nodes)
                    };
                }
                chartLines = config.ChartLines;
                logger.LogInformation("Analyze config loaded from {path}", fullPath);
            }
            catch (Exception)
            {
                logger.LogError("Failed to load analyzeConfig.json file, please load it manually");
            }
            finally
            {
                StateHasChanged();
            }
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        logger.LogInformation("Disposing {page}", "SingleAnalysis page");
        try
        {
            if (chessModule is not null)
            {
                await chessModule.InvokeVoidAsync("unregisterGlobalPgnPaste");
            }
        }
        catch { }

        if (_pgnPasteRegistered)
        {
            _pgnPasteDotNetRef.Dispose();
            _pgnPasteRegistered = false;
        }

        keyContext?.DisposeAsync();
        await ValueTask.CompletedTask;
    }
}

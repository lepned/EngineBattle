    private async Task LoadEpdFromPath(string path)
    {
        epdFileLoaded = true;
        pgnFileLoaded = false;
        tbFilesLoaded = false;
        pgnName = Path.GetFileName(path);
        var loadedEpds = EPDExtractor.readEPDs(path).Take(5001).ToList();
        if (loadedEpds.Count > 5000)
        {
            logger.LogWarning("EPD file contains more than 5000 entries; only the first 5000 were loaded");
            epdGames = loadedEpds.Take(5000).ToList();
        }
        else
        {
            epdGames = loadedEpds;
        }
        gameIndex = 0;
        await OpenEPDDialog();
        StateHasChanged();
    }

    private async Task LoadPgnFromPath(string path)
    {
        epdFileLoaded = false;
        tbFilesLoaded = false;
        pgnFileLoaded = true;
        pgnName = Path.GetFileName(path);
        var loadedGames = FullPGNParser.parsePgnFile(path).Take(4001).ToList();
        if (loadedGames.Count > 4000)
        {
            logger.LogWarning("PGN file contains more than 4000 games; only the first 4000 were loaded");
            games = loadedGames.Take(4000).ToList();
        }
        else
        {
            games = loadedGames;
        }
        gameIndex = 0;
        await OpenPGNDialog();
        StateHasChanged();
    }

    private async Task<string> BrowseFileDialog(string initialDir, string filter, string title)
    {
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, initialDir },
            { x => x.FileFilter, filter },
            { x => x.Mode, FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return null;
        return (string)result.Data!;
    }


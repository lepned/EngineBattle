    private void UpdateDetectedOpening()
    {
        var info = openingExplorer.Lookup(board);
        detectedOpeningName = info?.Name ?? "";
        detectedOpeningECO = info?.ECO ?? "";
        SyncOpeningInputWithDetectedOpening();

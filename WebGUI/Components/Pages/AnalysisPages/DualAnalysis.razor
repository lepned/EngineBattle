    public async void OnNewEngineLoaded(EngineConfigEventArgs engineConf)
    {
        if (engineConf.Id.Contains("Input1"))
        {
            Engine1 = engineConf.EngineConfig;
            engine1ConfigPath = engineConf.SourceFilePath ?? "";
        }
        else
        {
            Engine2 = engineConf.EngineConfig;
            engine2ConfigPath = engineConf.SourceFilePath ?? "";
        }

        // Track which engines support overlay
        engine1SupportsOverlay = Engine1?.Options?.Keys.Contains("LogLiveStats") ?? false;
        engine2SupportsOverlay = Engine2?.Options?.Keys.Contains("LogLiveStats") ?? false;
        showOverlayControls = engine1SupportsOverlay || engine2SupportsOverlay;

        if (showOverlayControls)
        {
            if (selectedOverlay == OverlaySettings.None)
                selectedOverlay = OverlaySettings.Policy;
            // Always re-evaluate both engines' overlay based on current support
            overlaySettings.SetOverlaySetting("nnInput1", engine1SupportsOverlay ? selectedOverlay : OverlaySettings.None);
            overlaySettings.SetOverlaySetting("nnInput2", engine2SupportsOverlay ? selectedOverlay : OverlaySettings.None);
            if (engine1SupportsOverlay)
                overlayEngineSource = 1;
            else
                overlayEngineSource = 2;
            var activeId = overlayEngineSource == 1 ? "nnInput1" : "nnInput2";
            await Notifier.UpdateDisplaySettings(selectedOverlay, activeId);
        }
        else if (!showOverlayControls)
        {
            selectedOverlay = OverlaySettings.None;
            overlaySettings.SetOverlaySetting("nnInput1", OverlaySettings.None);
            overlaySettings.SetOverlaySetting("nnInput2", OverlaySettings.None);
            await Notifier.UpdateDisplaySettings(OverlaySettings.None, "nnInput1");
            await Notifier.UpdateDisplaySettings(OverlaySettings.None, "nnInput2");
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetOverlaySource(int source)
    {
        overlayEngineSource = source;
        // Both engines keep the selected overlay type
        if (engine1SupportsOverlay)
            overlaySettings.SetOverlaySetting("nnInput1", selectedOverlay);
        if (engine2SupportsOverlay)
            overlaySettings.SetOverlaySetting("nnInput2", selectedOverlay);
        // Tell Chessboard which engine to display
        var activeId = source == 1 ? "nnInput1" : "nnInput2";
        await Notifier.UpdateDisplaySettings(selectedOverlay, activeId);
    }

    private void SetAsDefaultEngines()
    {
        if (string.IsNullOrEmpty(engine1ConfigPath) && string.IsNullOrEmpty(engine2ConfigPath)) return;
        var s = SettingsService.Settings;
        var updated = new GlobalSettings
        {
            EngineDefsFolder = s.EngineDefsFolder, OpeningsFolder = s.OpeningsFolder,
            PgnOutputFolder = s.PgnOutputFolder, TournamentConfigFolder = s.TournamentConfigFolder,
            TablebaseFolder = s.TablebaseFolder, NeuralNetFolder = s.NeuralNetFolder,
            AnalysisGamesPath = s.AnalysisGamesPath, OrdoExePath = s.OrdoExePath,
            LastBrowsedPath = s.LastBrowsedPath, StartupPage = s.StartupPage,
            DefaultEnginePath = !string.IsNullOrEmpty(engine1ConfigPath) ? engine1ConfigPath : s.DefaultEnginePath,
            SecondaryEnginePath = !string.IsNullOrEmpty(engine2ConfigPath) ? engine2ConfigPath : s.SecondaryEnginePath,
            DefaultSearchTimeMs = s.DefaultSearchTimeMs, DefaultSearchNodes = s.DefaultSearchNodes,
            ChartLines = s.ChartLines, PolicyDistributionMinMaxFilter = s.PolicyDistributionMinMaxFilter,
            CombineWhiteAndBlackMoves = s.CombineWhiteAndBlackMoves,
            DelayBetweenGamesSec = s.DelayBetweenGamesSec, MoveOverheadMs = s.MoveOverheadMs,
        };
        SettingsService.Save(updated);
    }

    private async Task OnOverlayChanged()
    {
        if (engine1SupportsOverlay)
            overlaySettings.SetOverlaySetting("nnInput1", selectedOverlay);
        if (engine2SupportsOverlay)
            overlaySettings.SetOverlaySetting("nnInput2", selectedOverlay);

        if (selectedOverlay != OverlaySettings.None)
        {
            var activeId = overlayEngineSource == 1 ? "nnInput1" : "nnInput2";
            await Notifier.UpdateDisplaySettings(selectedOverlay, activeId);
        }
        else
        {
            await Notifier.UpdateDisplaySettings(OverlaySettings.None, "nnInput1");
            await Notifier.UpdateDisplaySettings(OverlaySettings.None, "nnInput2");
        }
    }


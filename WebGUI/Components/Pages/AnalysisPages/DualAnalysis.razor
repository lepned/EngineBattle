    private void UpdateFrcId(string currentFen)
    {
        var result = ChessLibrary.ChessUtilities.Chess960.tryGetPositionIdFromFen(currentFen);
        frcPositionId = FSharpOption<int>.get_IsSome(result) ? result.Value : null;
        frcInput = frcPositionId;
    }

    private async Task LoadFrcPosition()
    {
        if (frcInput.HasValue && frcInput >= 0 && frcInput <= 959)
        {
            var fenOpt = ChessLibrary.ChessUtilities.Chess960.tryGetFenFromPositionId(frcInput.Value);
            if (FSharpOption<string>.get_IsSome(fenOpt))
            {
                board.ResetBoardState();
                board.LoadFen(fenOpt.Value);
                board.StartPosition = fenOpt.Value;
                fen = board.FEN();
                frcPositionId = frcInput;
                UpdateDetectedOpening();
                await Notifier.UpdateFenToBoard(fen);
                StateHasChanged();
            }
        }
    }

    private async Task OnFrcKeyDown(KeyboardEventArgs e)
    {
        if (e.Key == "Enter") await LoadFrcPosition();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            chessModule = await JsInteropService.ImportModuleAsync(JS);
            keyContext = HotKeys.CreateContext()
                .Add(ModKey.Ctrl, Key.ArrowRight, (() => NextPGNGame()), "Next game")
                .Add(ModKey.Ctrl, Key.ArrowLeft, (() => PreviousPGNGame()), "Previous game");

            if (!_pgnPasteRegistered)
            {
                _pgnPasteDotNetRef = DotNetObjectReference.Create(this);
                _pgnPasteRegistered = true;
            }
            await chessModule.InvokeVoidAsync("registerGlobalPgnPaste", _pgnPasteDotNetRef);

            board.LoadFen(fen);
            board.StartPosition = fen;
            UpdateFrcId(board.StartPosition);
            UpdateDetectedOpening();

            engine1SupportsOverlay = Engine1 != null && Engine1.Options.Keys.Contains("LogLiveStats");
            engine2SupportsOverlay = Engine2 != null && Engine2.Options.Keys.Contains("LogLiveStats");

            if (engine1SupportsOverlay || engine2SupportsOverlay)
            {
                showOverlayControls = true;
                selectedOverlay = OverlaySettings.Policy;
                if (engine1SupportsOverlay && engine2SupportsOverlay)
                {
                    overlayEngineSource = 1;
                    overlaySettings.SetOverlaySetting("nnInput1", OverlaySettings.Policy);
                    overlaySettings.SetOverlaySetting("nnInput2", OverlaySettings.Policy);
                }
                else if (engine1SupportsOverlay)
                {
                    overlayEngineSource = 1;
                    overlaySettings.SetOverlaySetting("nnInput1", OverlaySettings.Policy);
                    overlaySettings.SetOverlaySetting("nnInput2", OverlaySettings.None);
                }
                else
                {
                    overlayEngineSource = 2;
                    overlaySettings.SetOverlaySetting("nnInput1", OverlaySettings.None);
                    overlaySettings.SetOverlaySetting("nnInput2", OverlaySettings.Policy);
                }
                var activeId = overlayEngineSource == 1 ? "nnInput1" : "nnInput2";
                await Notifier.UpdateDisplaySettings(selectedOverlay, activeId);
            }
            StateHasChanged();
        }
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        logger.LogInformation("Disposing {page}", "DualAnalysis page");
        try
        {
            if (chessModule is not null)
            {
                await chessModule.InvokeVoidAsync("unregisterGlobalPgnPaste");
            }
        }
        catch { }

        if (_pgnPasteRegistered)
        {
            _pgnPasteDotNetRef.Dispose();
            _pgnPasteRegistered = false;
        }
        keyContext?.DisposeAsync();
        await ValueTask.CompletedTask;
    }

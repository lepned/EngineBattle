@page "/analysis/shortcuts"
@page "/analysis-shortcuts"
@page "/help"

<PageTitle>Analysis Shortcuts</PageTitle>

<div class="tool-page">
	<h1>Analysis Shortcuts</h1>
	<div class="tool-subtitle">Keyboard shortcuts for analysis mode</div>

	<div class="tool-table-container" style="max-width:550px">
		<table class="tool-table">
			<thead>
				<tr>
					<th>Shortcut</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				@foreach ((string key, string desc) in rows)
				{
					<tr>
						<td><kbd>@key</kbd></td>
						<td>@desc</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

@code {

	(string, string)[] rows = {
		("Esc", "Reset engine state"),
		("Home", "Start of game"),
		("End", "End of game"),
		("Left", "Step back"),
		("Right", "Step forward"),
		("Ctrl + Right", "Next game"),
		("Ctrl + Left", "Previous game"),
		("Ctrl + G", "Start infinite search"),
		("Ctrl + H", "Stop search"),
		("Ctrl + V", "Paste PGN from clipboard"),
		("F1", "Search 1 node"),
		("F2", "Search 1K nodes"),
		("F3", "Search 10K nodes"),
		("F4", "Search 100K nodes"),
		("F5", "Search 1M nodes"),
		("F6", "Search 10M nodes"),
		("F7", "Search 100M nodes"),
		("F8", "Search 1B nodes"),
		("Ctrl + P", "Check policy rank (current game)"),
		("Ctrl + Q", "Check Q-rank (current game)"),
		("Ctrl + Alt + P", "Check policy rank (all PGN games)"),
		("Ctrl + Alt + Q", "Check Q-rank (all PGN games)"),
	};

	protected override Task OnInitializedAsync()
	{
		return base.OnInitializedAsync();
	}

}

@page "/setup/analysis"
@page "/analysisMode"

<PageTitle>Analysis Setup</PageTitle>

<MudContainer>
    <MudAlert Severity="Severity.Info" Class="mt-6 mb-4" Variant="Variant.Outlined">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudText>Use the Analysis Creator to generate an analysis configuration file interactively.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/tools/analysis-creator"
                       StartIcon="@Icons.Material.Filled.Build" Size="Size.Small">
                Open Creator
            </MudButton>
        </MudStack>
    </MudAlert>
</MudContainer>

<WebGUI.Components.Layout.ExperimentalLayout.MarkDigComponent FileName="AnalyzeConfig.md" />

<PageTitle> Analyze position - Dual view </PageTitle>
<InputFile id="configFile" OnChange="@OpenConfigFile" hidden />
<InputFile id="fileInput" OnChange="@OpenPGNFile" hidden />
<InputFile id="epdInput" OnChange="@OpenEPDFile" hidden />
@* <InputFile id="tbInput" OnChange="@OpenTBTestFile" hidden /> *@
<MudItem Class="pl-3">
    <MudItem Class="d-flex">
        <MudItem lg="1">
            <MudFab Class="ml-3 mb-3 mt-3" HtmlTag="label" Color="Color.Default" Label="Config" Size="Size.Medium" StartIcon="@Icons.Material.Filled.DownloadForOffline" for="configFile" />

        </MudItem>
        <MudItem lg="1">
            <MudFab Class="ml-3 mb-3 mt-3" HtmlTag="label" Color="Color.Default" Label="PGN" Size="Size.Medium"
                    StartIcon="@Icons.Material.Filled.DownloadForOffline" for="fileInput" />
        </MudItem>
        <MudItem lg="1">
            <MudFab Class="ml-3 mb-3 mt-3" HtmlTag="label" Color="Color.Default" Label="EPD" Size="Size.Medium"
                    StartIcon="@Icons.Material.Filled.DownloadForOffline" for="epdInput" Style="white-space: nowrap;" />
        </MudItem>
        <MudItem lg="4" Class="ml-10 mt-5">
            <MudText>@pgnName</MudText>
        </MudItem>
    </MudItem>

    <MudItem Class="d-flex">
        <MudItem Class="mr-2" lg="4">
            <AnalyzeWithEngine @ref="analysisWithEngine1" FEN="@fen" OnUCIReceived="OnUCIReceived" ChessBoard="@board" OnEngineMoveMade="OnEngineMoveMade"
                               Id="nnInput1" Engine="Engine1" OnNewEngineLoaded="OnNewEngineLoaded" Config="@config" />
            <MudText Class="ml-2" Typo="Typo.body1">@currentGame</MudText>
            <!-- Chart selection UI -->
            <MudItem Class="d-flex align-items-end mt-2 mb-1" Style="width:150px;">
                <MudSelect T="CustomChartType" Dense="true" Class="mr-3" Value="@selectedChart" ValueChanged="@OnChartTypeChanged">
                    <MudSelectItem T="CustomChartType" Value="@CustomChartType.Evaluation">Evaluation</MudSelectItem>
                    <MudSelectItem T="CustomChartType" Value="@CustomChartType.Nodes">Nodes</MudSelectItem>
                    <MudSelectItem T="CustomChartType" Value="@CustomChartType.TimeUsage">Time Usage</MudSelectItem>
                    <MudSelectItem T="CustomChartType" Value="@CustomChartType.NPS">NPS</MudSelectItem>
					<MudSelectItem T="CustomChartType" Value="@CustomChartType.EPS">EPS</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xl="12">
                <div style="height:250px;" class="chart" @ref=pgnChart></div>
            </MudItem>
        </MudItem>

        <MudItem Class="pl-2" lg="3">
            @if (epdFileLoaded || tbFilesLoaded)
            {
                <p style="margin-top:5px;">@epdDesc</p>
            }

            <div @ref="chessBoard">
                <Chessboard @ref="chessBoardRazor" ShowFenField=true FENposition="@fen" ShowChessNavButtons=true ShowMoveList=true 
                            MakeMoveListClickable=true OnMoveMadeOnBoard="OnMoveMadeOnBoard" OnNewFENOnBoard="OnNewFENOnBoard" ChessBoard="@board" />
            </div>
            <MudItem>
                
                    <MudGrid>
					<MudItem lg="6">
						<MudItem Class="mt-3" >
							<MudTextField HelperText="Path to file - game will be appended to file" Placeholder="C:/dev/chess/mygames.pgn" T="string" @bind-Value="gamesPath" Text="@gamesPath" />

						</MudItem>
						<MudItem sm="11" lg="11">
							<MudButton Class="ml-2 mb-2 mt-2" Size="Size.Medium" OnClick="SaveGameToPGN" StartIcon="@Icons.Material.Filled.Save">Save game</MudButton>
							<MudButton Class="ml-2 mb-2 mt-1" Size="Size.Medium" OnClick="SaveAnalysis" StartIcon="@Icons.Material.Filled.Save">Save analysis</MudButton>
						</MudItem>
					</MudItem>
					<MudItem lg="6">

						<MudItem Class="mt-3">
							<MudTextField HelperText="Opening name; Variation name" Placeholder="Sicilian; Sveshnikov" T="string" @bind-Value="openingAndVariation" Text="@openingAndVariation" />
						</MudItem>
						<MudItem sm="11" lg="11">
							<MudButton Class="ml-2 mb-2 mt-2" Size="Size.Medium" OnClick="OpeningBook">Create Opening book from move graph</MudButton>
						</MudItem>
					</MudItem>
				</MudGrid>
            </MudItem>

            @if (pgnFileLoaded)
            {
                {
                    <MudButton Color="Color.Primary"
                               OnClick="OpenPGNDialog"
                               StartIcon="@Icons.Material.Filled.List"
                               Class="mt-2">
                        View PGN Games (@games.Count)
                    </MudButton>
                }
            }

            @if (epdFileLoaded)
            {
                <MudButton Color="Color.Primary"
                           OnClick="OpenEPDDialog"
                           StartIcon="@Icons.Material.Filled.List"
                           Class="mt-2">
                    View EPD List (@epdGames.Count)
                </MudButton>               
            }

            @if (tbFilesLoaded)
            {
                <div style="overflow-y: auto; height: calc(100vh - 200px);">
                    <MudTable FixedHeader=true style="border: none; padding: 0; background-color: transparent;" Items=@epdGames
                              OnRowClick="OpenEPDGame" T="EPDTypes.EPDEntry">
                        <HeaderContent>
                            <MudTh>FEN</MudTh>
                            <MudTh>Info</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd> @context.FEN</MudTd>
                            <MudTd> @context.Other?.Value.ToString()</MudTd>
                        </RowTemplate>
                    </MudTable>
                </div>
            }

        </MudItem>

        <MudItem Class="ml-3 mr-3" lg="4">
            <AnalyzeWithEngine @ref="analysisWithEngine2" FEN="@fen" OnUCIReceived="OnUCIReceived" ChessBoard="@board"
                               OnEngineMoveMade="OnEngineMoveMade" Id="nnInput2" Engine="Engine2" OnNewEngineLoaded="OnNewEngineLoaded" Config="@config" />
        </MudItem>


    </MudItem>

</MudItem>


@page "/setup/tournament"
@page "/tournamentSetup"
@inject NotifierService Notifier
@inject GlobalSettingsService SettingsService
@using System.Text.Json

<PageTitle>Tournament setup</PageTitle>

<MudContainer>
    <MudAlert Severity="Severity.Info" Class="mt-6 mb-4" Variant="Variant.Outlined">
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudText>Use the Tournament Creator to build a tournament configuration interactively.</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/tools/tournament-creator"
                       StartIcon="@Icons.Material.Filled.PostAdd" Size="Size.Small">
                Open Creator
            </MudButton>
        </MudStack>
    </MudAlert>
    <WebGUI.Components.Layout.ExperimentalLayout.MarkDigComponent FileName="TournamentConfig.md" />
</MudContainer>

@code {

  string engineDefFolderPath = "";

  protected override void OnInitialized()
  {
      var s = SettingsService.Settings;
      if (!string.IsNullOrEmpty(s.EngineDefsFolder))
          engineDefFolderPath = s.EngineDefsFolder;
  }

}

@page "/puzzles/eret"
@page "/eret-puzzles"
@page "/EretPuzzleTest"
@using System.Text
@using System.Threading
@using WebGUI.Components.Layout
@using System.Collections.Concurrent
@using WebGUI.Services
@using WebGUI.Components.Layout.VisualizationLayout
@using static ChessLibrary.EPDTypes
@using static ChessLibrary.PuzzleRunners
@using static ChessLibrary.PuzzleTypes

@inject ILogger<EretPuzzles> logger

<InputFile id="fileInput" OnChange="@OpenConfigFile" hidden />

<PageTitle>ERET Puzzle Tests</PageTitle>

<div class="tool-page">
  <h1>ERET Puzzle Tests</h1>
  <div class="tool-subtitle">Engine accuracy testing with EPD position suites</div>

  <div class="tool-controls">
    <div class="tool-input-group" style="margin-bottom:0">
      <label>Failed puzzles to show</label>
      <input type="number" class="tool-input" style="width:120px" @bind="failedNumber" min="0" step="1" />
    </div>
    <div class="tool-input-group" style="margin-bottom:0">
      <label>Solved puzzles to show</label>
      <input type="number" class="tool-input" style="width:120px" @bind="solvedNumber" min="0" step="1" />
    </div>
    <label for="fileInput" class="tool-upload-btn" style="@(isProcessing ? "pointer-events:none;opacity:0.5" : "")">Pick and run puzzle config file</label>
    @if (isProcessing)
    {
      <div class="tool-spinner"></div>
    }
  </div>

  <div class="file-name">
    @if (isProcessing && !string.IsNullOrEmpty(puzzleFileName))
    {
      @((MarkupString)$"Processing puzzles from <b>{puzzleFileName}</b>...")
    }
    else
    {
      @((MarkupString)$"<b>{puzzleFileName}</b>")
    }
  </div>

  @if (Scores.Count > 0)
  {
    <div class="tool-table-container">
      <table class="tool-table sortable">
        <thead>
          <tr>
            <th @onclick='() => SortBy("Engine")'>Engine @SortIndicator("Engine")</th>
            <th @onclick='() => SortBy("Accuracy")'>Accuracy @SortIndicator("Accuracy")</th>
            <th @onclick='() => SortBy("Total")'>Total @SortIndicator("Total")</th>
            <th @onclick='() => SortBy("Desc")'>Desc @SortIndicator("Desc")</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in GetPagedItems())
          {
            <tr>
              <td>@item.PlayerName</td>
              <td>@item.Accuracy.ToString("P1")</td>
              <td>@(item.FailedPuzzles.Count + item.CorrectPuzzles.Count)</td>
              <td>@item.Desc</td>
            </tr>
          }
        </tbody>
      </table>
      <div class="tool-pager">
        <span>@Scores.Count items</span>
        <select @bind="pageSize" @bind:after="ResetPage">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
        <span>per page</span>
        <button disabled="@(currentPage <= 0)" @onclick="PrevPage">Prev</button>
        <span>Page @(currentPage + 1) / @totalPages</span>
        <button disabled="@(currentPage >= totalPages - 1)" @onclick="NextPage">Next</button>
      </div>
    </div>
  }

  @foreach (var score in Scores)
  {
    var correctList = score.CorrectPuzzles.Take(solvedNumber).ToList();
    var failedList = score.FailedPuzzles.Take(failedNumber).ToList();

    @if (correctList.Count > 0)
    {
      <div class="tool-section">
        <h2>Solved by @score.PlayerName</h2>
        <div class="tool-puzzle-grid">
          @foreach (var epd in correctList)
          {
            <div class="tool-puzzle-card">
              <EPDVisualization EPD="@epd" />
            </div>
          }
        </div>
      </div>
    }

    @if (failedList.Count > 0)
    {
      <div class="tool-section">
        <h2>Failed by @score.PlayerName</h2>
        <div class="tool-puzzle-grid">
          @foreach (var epd in failedList)
          {
            <div class="tool-puzzle-card">
              <EPDVisualization EPD="@epd.Item1" />
            </div>
          }
        </div>
      </div>
    }
  }
</div>

@code {
    private Chess.Board chess = new();
    IBrowserFile browserFile;
    private string fileName;
    private string puzzleFileName = string.Empty;
    private List<ERETResults> Scores = new();
    int failedNumber = 3;
    int solvedNumber = 3;
    private string fullPath = string.Empty;
    private string finalMessage = "";
    private EPDTypes.EPDEntry epd = EPDTypes.EPDEntry.Empty;
    private string outputFileFolder = string.Empty;
    private EretConfig data = EretConfig.empty;
    private bool isProcessing = false;

    // Sorting state
    private string sortColumn = "Accuracy";
    private bool sortAscending = false;

    // Pagination state
    private int currentPage = 0;
    private int pageSize = 25;
    private int totalPages => Math.Max(1, (int)Math.Ceiling((double)Scores.Count / pageSize));

    private void SortBy(string column)
    {
        if (sortColumn == column)
            sortAscending = !sortAscending;
        else
        {
            sortColumn = column;
            sortAscending = true;
        }
        currentPage = 0;
    }

    private MarkupString SortIndicator(string column)
    {
        if (sortColumn != column)
            return new MarkupString("<span class=\"sort-arrow\">&#9650;</span>");
        var arrow = sortAscending ? "&#9650;" : "&#9660;";
        return new MarkupString($"<span class=\"sort-arrow active\">{arrow}</span>");
    }

    private IEnumerable<ERETResults> GetSortedItems()
    {
        var items = Scores.AsEnumerable();
        items = sortColumn switch
        {
            "Engine" => sortAscending ? items.OrderBy(x => x.PlayerName) : items.OrderByDescending(x => x.PlayerName),
            "Accuracy" => sortAscending ? items.OrderBy(x => x.Accuracy) : items.OrderByDescending(x => x.Accuracy),
            "Total" => sortAscending ? items.OrderBy(x => x.FailedPuzzles.Count + x.CorrectPuzzles.Count) : items.OrderByDescending(x => x.FailedPuzzles.Count + x.CorrectPuzzles.Count),
            "Desc" => sortAscending ? items.OrderBy(x => x.Desc) : items.OrderByDescending(x => x.Desc),
            _ => items
        };
        return items;
    }

    private IEnumerable<ERETResults> GetPagedItems()
    {
        return GetSortedItems().Skip(currentPage * pageSize).Take(pageSize);
    }

    private void PrevPage() { if (currentPage > 0) currentPage--; }
    private void NextPage() { if (currentPage < totalPages - 1) currentPage++; }
    private void ResetPage() { currentPage = 0; }

    private async void Update(ERET update)
    {
        switch (update)
        {
            case ERET.Start player:

                break;

            case ERET.Puzzle p:

                break;

            case ERET.PlayerResult pRes:
                Scores.Add(pRes.Item);
                var playerPerf = $"\nPlayer: {pRes.Item.PlayerName} - Accuracy: {pRes.Item.Accuracy:P1} - Total: {pRes.Item.FailedPuzzles.Count + pRes.Item.CorrectPuzzles.Count} - Desc: {pRes.Item.Desc}\n";
                logger.LogInformation(playerPerf);
                await InvokeAsync(StateHasChanged);
                break;

            case ERET.AllResults allRes:
                try
                {
                    var eretResults = allRes.Item.ToList();
                    Scores.Clear();
                    Scores.AddRange(eretResults);
                    var normalizedFolder = Configuration.JSONParser.normalizePath(data.FailedPuzzlesOutputFolder);
                    var datePart = DateTime.Now.ToString("yyyy-MM-dd_HH-mm", System.Globalization.CultureInfo.InvariantCulture);
                    var fileName = Path.Combine(normalizedFolder, $"failedEretPuzzles_{datePart}.epd");
                    if (Directory.Exists(normalizedFolder))
                    {
                        using (StreamWriter sw = new(fileName, append: false, Encoding.UTF8))
                        {
                            var boardBm = new Chess.Board();
                            var boardAm = new Chess.Board();
                            PuzzleRunners.writeToFile(data, eretResults, sw, boardBm, boardAm);
                            Console.WriteLine($"Failed puzzles written to {fileName}");
                        }
                    }
                }
                catch (Exception ex)
                {
                    logger.LogError("Failed to write results to file: {Message}", ex.Message);
                    finalMessage = "Failed to write results to file. Check console for details.";
                }
                finally
                {
                    isProcessing = false;
                    await InvokeAsync(StateHasChanged);
                }
                break;

            case ERET.ResultsInConsole resConsole:
                var table = resConsole.Item;
                Console.WriteLine(Environment.NewLine);
                Console.WriteLine(table);
                var escaped = Configuration.JSONParser.escapeString(outputFileFolder);

                if (Directory.Exists(escaped))
                {
                    var datePart = DateTime.Now.ToString("yyyy-MM-dd_HH-mm");
                    var outputPath = Path.Combine(escaped, $"EretSummary_{datePart}.txt");
                    try
                    {
                        File.WriteAllText(outputPath, table);
                        Console.WriteLine($"Console summary written to {outputPath}");
                    }
                    catch (Exception ex)
                    {
                        Console.WriteLine($"Failed to write results to file: {ex.Message}");
                        finalMessage = "Failed to write results to file. Check console for details.";
                    }
                }
                break;
        }
    }

    private async Task OpenConfigFile(InputFileChangeEventArgs e)
    {
        isProcessing = true;
        var pgnName = e.File.Name;
        fileName = pgnName;
        logger.LogInformation("Config file opened {File}", pgnName);
        var env = AppPaths.BaseDir;
        fullPath = Path.Combine(env, "wwwroot", pgnName);
        await using (FileStream fs = new(fullPath, FileMode.Create))
        {
            browserFile = e.File;
            await browserFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 1024 * 2L).CopyToAsync(fs);
        }

        data = Configuration.JSONParser.loadEretConfig(fullPath);
        puzzleFileName = Path.GetFileName(data.PuzzleFile);
        finalMessage = $"Running tests on {puzzleFileName}";
        await InvokeAsync(StateHasChanged);
        outputFileFolder = data.FailedPuzzlesOutputFolder;
        // Build engine configs
        var engineConfigs = data.Engines
          .SelectMany(e => Configuration.JSONParser.mapToEngPuzzleConfig(data.EngineFolder, e))
          .ToList();

        List<ERETResults> results = new();

        await Task.Factory.StartNew(() =>
          {
              try
              {
                  var timeConfig = TimeControlTypes.TimeControlCommands.getFixedTime(new TimeOnly(0, 0, data.TimeInSeconds));
                  var nodesConfig = TimeControlTypes.TimeControlCommands.getNodeTime(data.Nodes);
                  if (data.RunWithNodeLimit)
                  {
                      results = PuzzleRunners.runEretTests(nodesConfig, engineConfigs, data, Update, CancellationToken.None);
                  }
                  else
                  {
                      results = PuzzleRunners.runEretTests(timeConfig, engineConfigs, data, Update, CancellationToken.None);
                  }
              }
              catch (Exception ex)
              {
                  logger.LogError("Eret failed to start/run - ");
                  logger.LogError(ex.Message);
                  throw;
              }
          });

        finalMessage = $"Finished running tests on {puzzleFileName}";
        File.Delete(fullPath);
    }

}

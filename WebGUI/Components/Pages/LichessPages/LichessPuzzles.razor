@page "/puzzles/lichess"
@page "/LichessPuzzles"
@using System.Text
@using System.Threading
@using WebGUI.Components.Layout
@using System.Collections.Concurrent;
@using Microsoft.FSharp.Collections
@using WebGUI.Services;
@using WebGUI.Components.Layout.VisualizationLayout
@using static ChessLibrary.PuzzleTypes
@using static ChessLibrary.Configuration.JSONParser
@using static ChessLibrary.Configuration.PuzzleTheme

@implements IAsyncDisposable

@inject ILogger<LichessPuzzles> logger
@inject IDialogService DialogService
@inject GlobalSettingsService SettingsService
@inject IJSRuntime JS

<PageTitle>Lichess Puzzles</PageTitle>

<div class="tool-page">
  <h1>Lichess Puzzles</h1>
  <div class="tool-subtitle">Run policy, value, search and solve tests from your puzzle config — <a href="/tools/puzzle-creator">build one here</a></div>

  <div class="run-card">
    <div class="run-config">
      <label class="run-label" for="cfgPath">Puzzle config</label>
      <div class="run-path" id="cfgPath">
        @if (string.IsNullOrEmpty(fullPath))
        {
          <span class="run-path-empty">No config selected</span>
        }
        else
        {
          <span class="run-path-dir">@ConfigFolder(fullPath)</span><span class="run-path-sep">/</span><span class="run-path-file">@ConfigFileName(fullPath)</span>
        }
      </div>
    </div>
    <button class="tool-action-btn run-choose" @onclick="PickConfig" disabled="@disableRun">Choose…</button>
    <button class="run-go" @onclick="RunSelectedConfig" disabled="@(disableRun || string.IsNullOrEmpty(fullPath))">
      @(HasAnyScores ? "Run again" : "Run")
    </button>
    @if (disableRun)
    {
      <button class="tool-cancel-btn" @onclick="CancelRun">Stop</button>
      @if (progressTotal == 0)
      {
        <div class="tool-spinner"></div>
      }
    }
  </div>

  @if (configSummary is not null)
  {
    <div class="config-tiles">
      <div class="config-tile" title="@configSummary.NetNames">
        <div class="k">Nets</div>
        <div class="v">@configSummary.Nets</div>
      </div>
      <div class="config-tile">
        <div class="k">Puzzles</div>
        <div class="v">@configSummary.SampleSize.ToString("N0")</div>
      </div>
      <div class="config-tile">
        <div class="k">Tests</div>
        <div class="v small">@configSummary.Types</div>
      </div>
      <div class="config-tile">
        <div class="k">Nodes</div>
        <div class="v">@configSummary.Nodes</div>
      </div>
      <div class="config-tile">
        <div class="k">Rating groups</div>
        <div class="v small">@configSummary.RatingGroups</div>
      </div>
      <div class="config-tile wide">
        <div class="k">Themes</div>
        <div class="v small" title="@configSummary.Themes">@configSummary.Themes</div>
      </div>
      <div class="config-tile wide">
        <div class="k">Puzzle file</div>
        <div class="v small" title="@configSummary.PuzzleFile">@configSummary.PuzzleFile</div>
      </div>
    </div>
  }

  <div class="run-options">
    <div class="tool-input-group" style="margin-bottom:0; min-width:230px;">
      <label>Theme filter (csv)</label>
      <input type="text" class="tool-input" style="width:100%" @bind="Filter" placeholder="e.g. endgame, fork" />
    </div>
    <div class="tool-input-group" style="margin-bottom:0">
      <label>Failed shown</label>
      <input type="number" class="tool-input" style="width:104px" @bind="failedNumber" min="0" step="1" />
    </div>
    <div class="tool-input-group" style="margin-bottom:0">
      <label>Solved shown</label>
      <input type="number" class="tool-input" style="width:104px" @bind="solvedNumber" min="0" step="1" />
    </div>
    <div class="tool-input-group" style="margin-bottom:0">
      <label>Concurrency</label>
      <input type="number" class="tool-input" style="width:82px" @bind="concurrencyOverride" min="1" max="16" step="1" />
    </div>
    <button class="tool-action-btn tool-action-btn-sm" style="margin-left:auto" @onclick="Draw" disabled="@disableDraw">Draw themes</button>
  </div>

  <details class="puzzle-themes-details">
    <summary>Available puzzle themes</summary>
    <div class="puzzle-themes-list">
      @foreach (var theme in getLocalThemes())
      {
        <span class="puzzle-theme-chip" title="@theme.Description" @onclick="() => AddTheme(theme.Category)">@theme.Category</span>
      }
    </div>
  </details>

  @if (!HasAnyScores && !disableRun)
  {
    <div class="run-preview">
      <div class="run-preview-title">A run produces</div>
      <ol class="run-preview-list">
        <li><b>Accuracy per net</b> — policy, top-3 and value, split by rating group.</li>
        <li><b>A per-theme breakdown</b> — where two nets differ, so "8 points worse" becomes "worse at endgames, level at tactics". Needs at least two nets in the config.</li>
        <li><b>The positions themselves</b> — boards for the puzzles missed and the ones solved, with the move the net played. How many of each is set by <b>Failed shown</b> and <b>Solved shown</b> above.</li>
      </ol>
    </div>
  }

  @if (!string.IsNullOrEmpty(errorMessage))
  {
    <div class="tool-error" style="color:#ef5350; margin:8px 0; font-weight:500;">@errorMessage</div>
  }

  @if (disableRun && progressTotal > 0)
  {
    <div class="puzzle-progress">
      <div class="puzzle-progress-header">
        <span class="puzzle-progress-label">@progressEngine</span>
        <span class="puzzle-progress-count">@progressProcessed / @progressTotal</span>
      </div>
      <div class="puzzle-progress-track">
        <div class="puzzle-progress-fill" style="width:@($"{(double)progressProcessed / progressTotal * 100:F1}%")"></div>
      </div>
    </div>
  }

  <div class="file-name">
    @if (disableRun && !string.IsNullOrEmpty(puzzleFileName))
    {
      @((MarkupString)$"Processing puzzles from <b>{puzzleFileName}</b>...")
    }
    else
    {
      @((MarkupString)$"<b>{puzzleFileName}</b>")
    }
  </div>

  @if (HasAnyScores)
  {
    <div class="tool-tab-bar">
      @foreach (var tab in ActiveTabs)
      {
        <button class="tool-tab @(activeScoreTab == tab ? "active" : "")" @onclick="() => SetScoreTab(tab)">@tab</button>
      }
      @if (AvailableEngines.Count() > 1)
      {
        <select class="tool-input tool-tab-filter" @bind="selectedEngine" @bind:after="OnEngineFilterChanged" title="Filter the table by engine">
          <option value="All">All engines</option>
          @foreach (var engine in AvailableEngines)
          {
            <option value="@engine">@engine</option>
          }
        </select>
      }
      <button class="tool-action-btn tool-action-btn-sm" style="margin-left:auto" @onclick="CopyResultsToClipboard" title="Copy results table to clipboard">@copyLabel</button>
    </div>

    <div class="tool-table-container">
      <table class="tool-table sortable">
        <thead>
          <tr>
            @if (ShowEngineColumn)
            {
              <th @onclick='() => ScoreSortBy("Engine")'>Engine @ScoreSortIndicator("Engine")</th>
            }
            <th @onclick='() => ScoreSortBy("NeuralNet")'>Neural net @ScoreSortIndicator("NeuralNet")</th>
            <th @onclick='() => ScoreSortBy("Perf")'>Perf @ScoreSortIndicator("Perf")</th>
            <th @onclick='() => ScoreSortBy("Accuracy")'>Accuracy @ScoreSortIndicator("Accuracy")</th>
            <th @onclick='() => ScoreSortBy("Total")'>Total @ScoreSortIndicator("Total")</th>
            <th @onclick='() => ScoreSortBy("AvgRating")'>Avg rating @ScoreSortIndicator("AvgRating")</th>
            <th @onclick='() => ScoreSortBy("Type")'>Type @ScoreSortIndicator("Type")</th>
            <th @onclick='() => ScoreSortBy("Theme")'>Theme @ScoreSortIndicator("Theme")</th>
            <th @onclick='() => ScoreSortBy("Nodes")'>Nodes @ScoreSortIndicator("Nodes")</th>
            <th @onclick='() => ScoreSortBy("AvgKLD")'>AvgKLD @ScoreSortIndicator("AvgKLD")</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in GetPagedScoreItems())
          {
            var itemId = item.GetHashCode();
            <tr>
              @if (ShowEngineColumn)
              {
                <td>@item.Engine</td>
              }
              <td>@item.NeuralNet</td>
              <td>@item.PlayerRecord.Rating.ToString("F0")</td>
              <td>@(item.TotalNumber > 0 ? ((decimal)item.Correct / item.TotalNumber).ToString("P1") : "N/A")</td>
              <td>@item.TotalNumber</td>
              <td>@item.RatingAvg.ToString("F0")</td>
              <td>@item.Type</td>
              <td>@item.Filter</td>
              <td>@item.Nodes</td>
              <td>@(item.AvgKLD > 0 ? item.AvgKLD.ToString("F4") : "—")</td>
              <td>
                <button class="tool-action-btn tool-action-btn-sm" @onclick="() => ToggleScoreDetails(item)">
                  @(expandedScoreIds.Contains(itemId) ? "Hide boards" : "Show boards")
                </button>
              </td>
            </tr>
            @if (expandedScoreIds.Contains(itemId))
            {
              <tr>
                <td colspan="@(ShowEngineColumn ? 11 : 10)" style="padding:0; border-bottom:1px solid #2c2c3e;">
                  <div style="padding:8px" @key="itemId">
                    <DeferredContent>
                      <ChildContent>
                        <PuzzleBanner Score="@item"
                                      NumberOfFailedPuzzles="@failedNumber"
                                      NumberOfSolvedPuzzles="@solvedNumber" />
                      </ChildContent>
                    </DeferredContent>
                  </div>
                </td>
              </tr>
            }
          }
        </tbody>
      </table>
      <div class="tool-pager">
        <span>@TableScores.Count items</span>
        <select @bind="scorePageSize" @bind:after="ResetScorePage">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
        <span>per page</span>
        <button disabled="@(scoreCurrentPage <= 0)" @onclick="ScorePrevPage">Prev</button>
        <span>Page @(scoreCurrentPage + 1) / @scoreTotalPages</span>
        <button disabled="@(scoreCurrentPage >= scoreTotalPages - 1)" @onclick="ScoreNextPage">Next</button>
      </div>
    </div>
  }

  @if (HasAnyScores)
  {
    <div class="tool-section theme-panel">
      <div class="theme-head">
        <div>
          <h2 style="margin:0">Where the difference is</h2>
          <div class="theme-sub">@activeScoreTab accuracy by Lichess theme</div>
        </div>
        <div class="tool-controls" style="margin:0; @(ThemeNets.Count < 2 ? "display:none" : "")">
          <div class="tool-input-group" style="margin-bottom:0">
            <label>Rating group</label>
            <select class="tool-input" @bind="themeRatingGroup" @bind:after="CloseThemeBoards">
              @foreach (var rg in ThemeRatingGroups)
              {
                <option value="@rg">@rg</option>
              }
            </select>
          </div>
          <div class="tool-input-group" style="margin-bottom:0">
            <label>Baseline</label>
            <select class="tool-input" style="max-width:230px" @bind="ThemeBaseline" @bind:after="CloseThemeBoards">
              @foreach (var n in ThemeNets)
              {
                <option value="@n">@ShortNet(n)</option>
              }
            </select>
          </div>
          <div class="tool-input-group" style="margin-bottom:0">
            <label>Compare</label>
            <select class="tool-input" style="max-width:230px" @bind="ThemeCompare" @bind:after="CloseThemeBoards">
              @foreach (var n in ThemeNets.Where(n => n != ThemeBaseline))
              {
                <option value="@n">@ShortNet(n)</option>
              }
            </select>
          </div>
          <div class="tool-input-group" style="margin-bottom:0">
            <label>Min n</label>
            <input type="number" class="tool-input" style="width:82px" @bind="themeMinN" @bind:after="CloseThemeBoards" min="1" step="1" />
          </div>
        </div>
      </div>

      @{
        var singleNet = !disableRun && ThemeNets.Count == 1;
        var ts = singleNet ? ThemeSingleRows() : null;
        var td = singleNet ? null : ThemeRows();
      }
      @if (singleNet && ts!.Rows.Count > 0)
      {
        <div class="theme-legend">
          <span><i style="background:var(--theme-single)"></i> key move found</span>
          <span class="theme-legend-note">
            @ShortNet(ThemeNets[0]) · weakest first@(ts.Dropped > 0 ? $" · {ts.Dropped} themes under {themeMinN} omitted" : "")
          </span>
        </div>

        <div class="theme-chart">
          <div class="theme-row theme-row-single theme-row-head">
            <div class="tname">Theme</div>
            <div></div>
            <div class="tnum">n</div>
            <div class="tdelta" title="Share of puzzles whose FIRST solver move was right — the move the theme describes. Not the same as the whole-puzzle accuracy in the score table above.">key move %</div>
          </div>
          @foreach (var t in ts.Rows)
          {
            <div class="theme-row theme-row-single theme-row-click @(themeBoardsFor == t.Theme ? "open" : "")"
                 role="button" tabindex="0"
                 title="Show the positions tagged @t.Theme. The grid lists puzzles that failed ANYWHERE in the line, so it can include puzzles the bar counts as correct on their key move."
                 @onclick="() => ToggleThemeBoards(t.Theme)">
              <div class="tname">@t.Theme</div>
              <div class="ttrack ttrack-single">
                <div class="tbar single" style="width:@(SingleBarWidth(t))%"></div>
              </div>
              <div class="tnum">@t.Total</div>
              <div class="tdelta">@((ChessLibrary.PuzzleThemes.accuracyOf(t) * 100).ToString("F1")) %</div>
            </div>
          }
          @if (ts.Hidden > 0)
          {
            <div class="theme-elide"><span>… @ts.Hidden more themes</span><i></i></div>
          }
        </div>
      }
      else if (td is null || td.Rows.Count == 0)
      {
        <div class="theme-empty">
          <div class="theme-empty-ghost" aria-hidden="true">
            <span style="--w:38%; --side:l"></span>
            <span style="--w:26%; --side:l"></span>
            <span style="--w:11%; --side:l"></span>
            <span style="--w:19%; --side:r"></span>
            <span style="--w:31%; --side:r"></span>
          </div>
          <div class="theme-empty-text">
            @if (disableRun)
            {
              @* nets finish one at a time, so a partial run is not a one-net config *@
              <h4>Waiting for the rest of the run</h4>
              <p>
                Nets report as they finish. The comparison appears once a second one
                is in — or stays as a breakdown of the single net if the config has
                only one.
              </p>
            }
            else
            {
              <h4>No theme reached @themeMinN puzzles</h4>
              <p>
                A theme seen a handful of times swings twenty points on a single puzzle,
                so thin themes are held back. Lower <b>Min n</b> above, or raise the
                sample size — 2000 puzzles typically leaves 34 themes standing.
              </p>
            }
          </div>
        </div>
      }
      else
      {
        <div class="theme-legend">
          <span><i style="background:var(--theme-worse)"></i> worse than baseline</span>
          <span><i style="background:var(--theme-better)"></i> better than baseline</span>
          <span class="theme-legend-note">key move found · n = puzzles carrying the theme@(td!.Dropped > 0 ? $" · {td.Dropped} themes under {themeMinN} omitted" : "")</span>
        </div>

        <div class="theme-chart">
          <div class="theme-row theme-row-head">
            <div class="tname">Theme</div>
            <div></div>
            <div class="tnum">n</div>
            <div class="tnum">base</div>
            <div class="tnum">cmp</div>
            <div class="tdelta">Δ pp</div>
          </div>
          @foreach (var d in td!.Rows)
          {
            <div class="theme-row theme-row-click @(themeBoardsFor == d.Theme ? "open" : "")"
                 role="button" tabindex="0"
                 title="Show the positions tagged @d.Theme. The grid lists puzzles that failed ANYWHERE in the line, so it can include puzzles the bar counts as correct on their key move."
                 @onclick="() => ToggleThemeBoards(d.Theme)">
              <div class="tname">@d.Theme</div>
              <div class="ttrack">
                @if (d.DeltaPp < 0)
                {
                  <div class="tbar neg" style="width:@(BarWidth(d.DeltaPp, td.Scale))%"></div>
                }
                else
                {
                  <div class="tbar pos" style="width:@(BarWidth(d.DeltaPp, td.Scale))%"></div>
                }
              </div>
              <div class="tnum">@d.Total</div>
              <div class="tnum">@((d.AccuracyA * 100).ToString("F1"))</div>
              <div class="tnum">@((d.AccuracyB * 100).ToString("F1"))</div>
              <div class="tdelta @(d.DeltaPp < 0 ? "lag" : "lead")">@(d.DeltaPp >= 0 ? "+" : "")@d.DeltaPp.ToString("F1")</div>
            </div>
          }
          @if (td.Hidden > 0)
          {
            <div class="theme-elide"><span>… @td.Hidden more themes</span><i></i></div>
          }
        </div>
      }

      @if (!string.IsNullOrEmpty(themeBoardsFor))
      {
        var boardScore = ThemeBoardScore();
        @if (boardScore is not null)
        {
          <div class="theme-boards">
            <div class="theme-boards-head">
              <span>Positions tagged <b>@themeBoardsFor</b> · @ShortNet(boardScore.NeuralNet)</span>
              <button class="tool-action-btn tool-action-btn-sm" @onclick="@(() => themeBoardsFor = string.Empty)">Close</button>
            </div>
            <DeferredContent>
              <ChildContent>
                <PuzzleBanner Score="@boardScore"
                              ThemeFilter="@themeBoardsFor"
                              NumberOfFailedPuzzles="@failedNumber"
                              NumberOfSolvedPuzzles="@solvedNumber" />
              </ChildContent>
            </DeferredContent>
          </div>
        }
      }
    </div>
  }

</div>


@code {
    private string puzzleFileName = string.Empty;
    private CsvPuzzleData[] puzzles = Array.Empty<CsvPuzzleData>();
    // ---- theme breakdown ----------------------------------------------------
    // Reuses ChessLibrary.PuzzleThemes so the panel, the console and the written
    // files all report the same numbers.
    private int themeRatingGroup;
    private string themeBaselineNet = "";
    private string themeCompareNet = "";
    private int themeMinN = ChessLibrary.PuzzleThemes.MinThemePuzzles;
    /// Theme whose positions are open below the chart; empty = none.
    private string themeBoardsFor = "";

    private void CloseThemeBoards()
    {
        themeBoardsFor = "";
        StateHasChanged();
    }

    private void ToggleThemeBoards(string theme) =>
        themeBoardsFor = themeBoardsFor == theme ? "" : theme;

    /// The net whose positions a theme row opens: the compared net when there are
    /// two, otherwise the only one.
    private Score ThemeBoardScore()
    {
        var rg = EffectiveThemeRatingGroup;
        var nets = ThemeNets;
        if (nets.Count == 0) return null;
        var net = nets.Count == 1 ? nets[0] : ThemeCompare;
        return ThemeSource.FirstOrDefault(x => x.NeuralNet == net && RatingGroupOf(x.RatingAvg) == rg);
    }
    private const int ThemeTopN = 6;

    /// Scores behind the active metric tab, one per net per rating group.
    /// The theme panel compares nets, so it reads the UNFILTERED tab source - an
    /// engine filter on the table must not blind the comparison.
    private List<Score> ThemeSource => ActiveScoreSource;

    /// Tab source narrowed by the engine filter. Table only.
    private List<Score> TableScores =>
        selectedEngine == "All"
            ? ActiveScoreSource
            : ActiveScoreSource.Where(s => s.Engine == selectedEngine).ToList();

    // the shared rule, not a sixth copy of it — this one drives the theme panel's rating
    // groups, which must agree with what the run's own files were sliced by
    private static int RatingGroupOf(double avg) => ChessLibrary.PuzzlePaired.ratingGroupOf(avg);

    private List<int> ThemeRatingGroups =>
        ThemeSource.Select(s => RatingGroupOf(s.RatingAvg)).Distinct().OrderBy(r => r).ToList();

    /// Nets in config order - the runner emits them that way, and the first is the
    /// baseline by the same convention the console uses.
    private List<string> ThemeNets =>
        ThemeSource.Where(s => RatingGroupOf(s.RatingAvg) == EffectiveThemeRatingGroup)
                   .Select(s => s.NeuralNet)
                   .Where(n => !string.IsNullOrEmpty(n))
                   .Distinct()
                   .ToList();

    /// The nets the chart actually compares, and the values the two selects show.
    ///
    /// The backing fields are the raw user choice and can be "" (nothing picked yet) or a
    /// net that vanished when the rating group or metric tab changed. Resolving that in the
    /// chart alone left the selects displaying their own first option instead - so a fresh
    /// page showed the SAME net in Baseline and Compare while charting net 1 against net 2.
    /// One resolution, read by both, or the page shows one pair and computes another.
    private string ThemeBaseline
    {
        get
        {
            var nets = ThemeNets;
            return nets.Contains(themeBaselineNet) ? themeBaselineNet : (nets.FirstOrDefault() ?? "");
        }
        set
        {
            themeBaselineNet = value;
            // picking the net that was in Compare would leave Compare with a value its own
            // option list no longer offers; clearing lets the getter pick the next net
            if (themeCompareNet == value) themeCompareNet = "";
        }
    }

    private string ThemeCompare
    {
        get
        {
            var nets = ThemeNets;
            var baseNet = ThemeBaseline;
            return nets.Contains(themeCompareNet) && themeCompareNet != baseNet
                ? themeCompareNet
                : (nets.FirstOrDefault(n => n != baseNet) ?? "");
        }
        set => themeCompareNet = value;
    }

    private int EffectiveThemeRatingGroup
    {
        get
        {
            var groups = ThemeRatingGroups;
            if (groups.Count == 0) return 0;
            return groups.Contains(themeRatingGroup) ? themeRatingGroup : groups[0];
        }
    }

    private static string ShortNet(string n) =>
        string.IsNullOrEmpty(n) ? "" : (n.Length <= 34 ? n : "…" + n.Substring(n.Length - 33));

    private sealed record ThemeView(
        List<ChessLibrary.PuzzleThemes.ThemeDiff> Rows, int Dropped, int Hidden, double Scale);

    private static readonly ThemeView EmptyThemeView = new(new(), 0, 0, 1.0);

    /// The 6 worst and 6 best themes for the compared net, with the middle elided.
    private ThemeView ThemeRows()
    {
        var rg = EffectiveThemeRatingGroup;
        var nets = ThemeNets;
        if (nets.Count < 2) return EmptyThemeView;

        var baseNet = ThemeBaseline;
        var cmpNet = ThemeCompare;
        if (string.IsNullOrEmpty(baseNet) || string.IsNullOrEmpty(cmpNet)) return EmptyThemeView;

        Score Find(string net) => ThemeSource.FirstOrDefault(
            s => s.NeuralNet == net && RatingGroupOf(s.RatingAvg) == rg);

        var a = Find(baseNet);
        var b = Find(cmpNet);
        if (a is null || b is null) return EmptyThemeView;

        var result = ChessLibrary.PuzzleThemes.diff(
            Math.Max(1, themeMinN),
            ChessLibrary.PuzzleThemes.breakdown(a),
            ChessLibrary.PuzzleThemes.breakdown(b));

        var all = result.Item1.ToList();
        if (all.Count == 0) return new ThemeView(new(), result.Item2, 0, 1.0);

        // sorted ascending by delta, so the ends are the extremes
        var shown = all.Count <= ThemeTopN * 2
            ? all
            : all.Take(ThemeTopN).Concat(all.Skip(all.Count - ThemeTopN)).ToList();
        var hidden = all.Count - shown.Count;
        var scale = Math.Max(1.0, all.Max(d => Math.Abs(d.DeltaPp)));
        return new ThemeView(shown, result.Item2, hidden, scale);
    }

    private sealed record ThemeSingleView(
        List<ChessLibrary.PuzzleThemes.ThemeStat> Rows, int Dropped, int Hidden);

    private static readonly ThemeSingleView EmptyThemeSingleView = new(new(), 0, 0);

    /// One net has no reference to take a delta against, but "where is it weak" is
    /// still the question. Magnitude, not polarity - so plain bars, weakest first.
    /// Mirrors PuzzleThemes.renderSingle in the console output.
    private ThemeSingleView ThemeSingleRows()
    {
        var rg = EffectiveThemeRatingGroup;
        var net = ThemeNets.FirstOrDefault();
        if (net is null) return EmptyThemeSingleView;

        var score = ThemeSource.FirstOrDefault(
            s => s.NeuralNet == net && RatingGroupOf(s.RatingAvg) == rg);
        if (score is null) return EmptyThemeSingleView;

        var all = ChessLibrary.PuzzleThemes.breakdown(score).ToList();
        var min = Math.Max(1, themeMinN);
        var usable = all.Where(t => t.Total >= min)
                        .OrderBy(t => ChessLibrary.PuzzleThemes.accuracyOf(t))
                        .ThenBy(t => t.Theme)
                        .ToList();
        var dropped = all.Count - usable.Count;
        if (usable.Count == 0) return new ThemeSingleView(new(), dropped, 0);

        var shown = usable.Count <= ThemeTopN * 2
            ? usable
            : usable.Take(ThemeTopN).Concat(usable.Skip(usable.Count - ThemeTopN)).ToList();
        return new ThemeSingleView(shown, dropped, usable.Count - shown.Count);
    }

    private static string SingleBarWidth(ChessLibrary.PuzzleThemes.ThemeStat t) =>
        (ChessLibrary.PuzzleThemes.accuracyOf(t) * 100.0)
            .ToString("F1", System.Globalization.CultureInfo.InvariantCulture);


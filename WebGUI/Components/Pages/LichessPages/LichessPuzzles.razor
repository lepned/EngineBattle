@page "/puzzles/lichess"
@page "/LichessPuzzles"
@using System.Text
@using System.Threading
@using WebGUI.Components.Layout
@using System.Collections.Concurrent;
@using WebGUI.Services;
@using WebGUI.Components.Layout.VisualizationLayout
@using static ChessLibrary.PuzzleTypes
@using static ChessLibrary.Configuration.JSONParser

@implements IAsyncDisposable

@inject ILogger<LichessPuzzles> logger

<InputFile id="fileInput" OnChange="@OpenCSVFile" hidden />

<PageTitle>Lichess Puzzles</PageTitle>

<div class="tool-page">
  <h1>Lichess Puzzles</h1>
  <div class="tool-subtitle">Run policy, value, search and solve tests from your puzzle config</div>

  <div class="tool-controls">
    <button class="tool-action-btn" @onclick="Draw" disabled="@disableDraw">Draw themes</button>
    <div class="tool-input-group" style="margin-bottom:0; min-width:220px;">
      <label>Puzzle theme filter (csv)</label>
      <input type="text" class="tool-input" style="width:100%" @bind="Filter" />
    </div>
    <div class="tool-input-group" style="margin-bottom:0">
      <label>Failed puzzles to show</label>
      <input type="number" class="tool-input" style="width:120px" @bind="failedNumber" min="0" step="1" />
    </div>
    <div class="tool-input-group" style="margin-bottom:0">
      <label>Solved puzzles to show</label>
      <input type="number" class="tool-input" style="width:120px" @bind="solvedNumber" min="0" step="1" />
    </div>
    <label for="fileInput" class="tool-upload-btn" style="@(disableRun ? "pointer-events:none;opacity:0.5" : "")">Pick and run puzzle config file</label>
    @if (disableRun)
    {
      <div class="tool-spinner"></div>
    }
  </div>

  <div class="file-name">
    @if (disableRun && !string.IsNullOrEmpty(puzzleFileName))
    {
      @((MarkupString)$"Processing puzzles from <b>{puzzleFileName}</b>...")
    }
    else
    {
      @((MarkupString)$"<b>{puzzleFileName}</b>")
    }
  </div>

  @if (HasAnyScores)
  {
    <div class="tool-tab-bar">
      @foreach (var tab in ActiveTabs)
      {
        <button class="tool-tab @(activeScoreTab == tab ? "active" : "")" @onclick="() => SetScoreTab(tab)">@tab</button>
      }
    </div>

    <div class="tool-table-container">
      <table class="tool-table sortable">
        <thead>
          <tr>
            <th @onclick='() => ScoreSortBy("Engine")'>Engine @ScoreSortIndicator("Engine")</th>
            <th @onclick='() => ScoreSortBy("NeuralNet")'>Neural net @ScoreSortIndicator("NeuralNet")</th>
            <th @onclick='() => ScoreSortBy("Perf")'>Perf @ScoreSortIndicator("Perf")</th>
            <th @onclick='() => ScoreSortBy("Accuracy")'>Accuracy @ScoreSortIndicator("Accuracy")</th>
            <th @onclick='() => ScoreSortBy("Total")'>Total @ScoreSortIndicator("Total")</th>
            <th @onclick='() => ScoreSortBy("AvgRating")'>Avg rating @ScoreSortIndicator("AvgRating")</th>
            <th @onclick='() => ScoreSortBy("Type")'>Type @ScoreSortIndicator("Type")</th>
            <th @onclick='() => ScoreSortBy("Theme")'>Theme @ScoreSortIndicator("Theme")</th>
            <th @onclick='() => ScoreSortBy("Nodes")'>Nodes @ScoreSortIndicator("Nodes")</th>
            <th @onclick='() => ScoreSortBy("AvgKLD")'>AvgKLD @ScoreSortIndicator("AvgKLD")</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in GetPagedScoreItems())
          {
            <tr>
              <td>@item.Engine</td>
              <td>@item.NeuralNet</td>
              <td>@item.PlayerRecord.Rating.ToString("F0")</td>
              <td>@(item.TotalNumber > 0 ? ((decimal)item.Correct / item.TotalNumber).ToString("P1") : "N/A")</td>
              <td>@item.TotalNumber</td>
              <td>@item.RatingAvg.ToString("F0")</td>
              <td>@item.Type</td>
              <td>@item.Filter</td>
              <td>@item.Nodes</td>
              <td>@(item.AvgKLD > 0 ? item.AvgKLD.ToString("F4") : "—")</td>
            </tr>
          }
        </tbody>
      </table>
      <div class="tool-pager">
        <span>@ActiveScoreSource.Count items</span>
        <select @bind="scorePageSize" @bind:after="ResetScorePage">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
        <span>per page</span>
        <button disabled="@(scoreCurrentPage <= 0)" @onclick="ScorePrevPage">Prev</button>
        <span>Page @(scoreCurrentPage + 1) / @scoreTotalPages</span>
        <button disabled="@(scoreCurrentPage >= scoreTotalPages - 1)" @onclick="ScoreNextPage">Next</button>
      </div>
    </div>
  }

  @if (HasAnyScores)
  {
    <div class="tool-section">
      <h2>Puzzle Visualizations</h2>

      <div class="tool-controls">
        <div class="tool-input-group" style="margin-bottom:0">
          <label>Filter by Type</label>
          <select class="tool-input" @bind="selectedType" @bind:after="OnFilterChanged">
            <option value="All">All Types</option>
            <option value="Policy">Policy</option>
            <option value="Value">Value</option>
            <option value="Search">Search</option>
            <option value="Solve">Solve</option>
          </select>
        </div>
        <div class="tool-input-group" style="margin-bottom:0">
          <label>Filter by Engine</label>
          <select class="tool-input" @bind="selectedEngine" @bind:after="OnFilterChanged">
            <option value="All">All Engines</option>
            @foreach (var engine in AvailableEngines)
            {
              <option value="@engine">@engine</option>
            }
          </select>
        </div>
      </div>

      <div class="tool-table-container" style="margin-top:12px">
        <table class="tool-table">
          <thead>
            <tr>
              <th>Type</th>
              <th>Engine</th>
              <th>Neural Net</th>
              <th>Theme</th>
              <th>Nodes</th>
              <th>Rating</th>
              <th>Accuracy</th>
              <th></th>
            </tr>
          </thead>
          <tbody>
            @foreach (var item in FilteredScores)
            {
              var itemId = item.GetHashCode();
              <tr>
                <td>@item.Type</td>
                <td>@item.Engine</td>
                <td>@item.NeuralNet</td>
                <td>@(string.IsNullOrEmpty(item.Filter) ? "None" : item.Filter)</td>
                <td>@item.Nodes</td>
                <td>@item.PlayerRecord.Rating.ToString("F0")</td>
                <td>@(item.TotalNumber > 0 ? ((decimal)item.Correct / item.TotalNumber).ToString("P1") : "N/A")</td>
                <td>
                  <button class="tool-action-btn tool-action-btn-sm" @onclick="() => ToggleScoreDetails(item)">
                    @(expandedScoreIds.Contains(itemId) ? "Hide Boards" : "Show Boards")
                  </button>
                </td>
              </tr>
              @if (expandedScoreIds.Contains(itemId))
              {
                <tr>
                  <td colspan="8" style="padding:0; border-bottom: 1px solid #2c2c3e;">
                    <div style="padding: 8px;" @key="itemId">
                      <DeferredContent>
                        <ChildContent>
                          <PuzzleBanner Score="@item"
                                        NumberOfFailedPussles="@failedNumber"
                                        NumberOfSolvedPussles="@solvedNumber" />
                        </ChildContent>
                      </DeferredContent>
                    </div>
                  </td>
                </tr>
              }
            }
          </tbody>
        </table>
      </div>
    </div>
  }
</div>


@code {
    private Chess.Board chess = new();
    IBrowserFile browserFile;
    private string fileName;
    private string puzzleFileName = string.Empty;
    private CsvPuzzleData[] puzzles = Array.Empty<CsvPuzzleData>();
    private List<Score> PolicyScores = new();
    private List<Score> ValueScores = new();
    private List<Score> SearchScores = new();
    private List<Score> SolveScores = new();
    private string Filter { get; set; } = "";
    int failedNumber = 5;
    int solvedNumber = 5;
    private string FolderName { get; set; } = String.Empty;
    private string fullPath = string.Empty;
    private bool disableRun = false;
    private bool disableDraw = false;
    private string endOfRun = string.Empty;
    private string selectedType = "All";
    private string selectedEngine = "All";
    private HashSet<int> expandedScoreIds = new HashSet<int>();

    // Score table state
    private string activeScoreTab = "Policy";
    private string scoreSortColumn = "Accuracy";
    private bool scoreSortAscending = false;
    private int scoreCurrentPage = 0;
    private int scorePageSize = 25;

    private bool HasAnyScores => PolicyScores.Count > 0 || ValueScores.Count > 0 || SearchScores.Count > 0 || SolveScores.Count > 0;

    private IEnumerable<string> ActiveTabs
    {
        get
        {
            if (PolicyScores.Count > 0) yield return "Policy";
            if (ValueScores.Count > 0) yield return "Value";
            if (SearchScores.Count > 0) yield return "Search";
            if (SolveScores.Count > 0) yield return "Solve";
        }
    }

    private List<Score> ActiveScoreSource => activeScoreTab switch
    {
        "Policy" => PolicyScores,
        "Value" => ValueScores,
        "Search" => SearchScores,
        "Solve" => SolveScores,
        _ => PolicyScores
    };

    private int scoreTotalPages => Math.Max(1, (int)Math.Ceiling((double)ActiveScoreSource.Count / scorePageSize));

    private void SetScoreTab(string tab)
    {
        activeScoreTab = tab;
        scoreCurrentPage = 0;
    }

    private void ScoreSortBy(string column)
    {
        if (scoreSortColumn == column)
            scoreSortAscending = !scoreSortAscending;
        else
        {
            scoreSortColumn = column;
            scoreSortAscending = true;
        }
        scoreCurrentPage = 0;
    }

    private MarkupString ScoreSortIndicator(string column)
    {
        if (scoreSortColumn != column)
            return new MarkupString("<span class=\"sort-arrow\">&#9650;</span>");
        var arrow = scoreSortAscending ? "&#9650;" : "&#9660;";
        return new MarkupString($"<span class=\"sort-arrow active\">{arrow}</span>");
    }

    private IEnumerable<Score> GetSortedScoreItems()
    {
        var items = ActiveScoreSource.AsEnumerable();
        items = scoreSortColumn switch
        {
            "Engine" => scoreSortAscending ? items.OrderBy(x => x.Engine) : items.OrderByDescending(x => x.Engine),
            "NeuralNet" => scoreSortAscending ? items.OrderBy(x => x.NeuralNet) : items.OrderByDescending(x => x.NeuralNet),
            "Perf" => scoreSortAscending ? items.OrderBy(x => x.PlayerRecord.Rating) : items.OrderByDescending(x => x.PlayerRecord.Rating),
            "Accuracy" => scoreSortAscending ? items.OrderBy(x => x.TotalNumber > 0 ? (decimal)x.Correct / x.TotalNumber : -1) : items.OrderByDescending(x => x.TotalNumber > 0 ? (decimal)x.Correct / x.TotalNumber : -1),
            "Total" => scoreSortAscending ? items.OrderBy(x => x.TotalNumber) : items.OrderByDescending(x => x.TotalNumber),
            "AvgRating" => scoreSortAscending ? items.OrderBy(x => x.RatingAvg) : items.OrderByDescending(x => x.RatingAvg),
            "Type" => scoreSortAscending ? items.OrderBy(x => x.Type) : items.OrderByDescending(x => x.Type),
            "Theme" => scoreSortAscending ? items.OrderBy(x => x.Filter) : items.OrderByDescending(x => x.Filter),
            "Nodes" => scoreSortAscending ? items.OrderBy(x => x.Nodes) : items.OrderByDescending(x => x.Nodes),
            "AvgKLD" => scoreSortAscending ? items.OrderBy(x => x.AvgKLD) : items.OrderByDescending(x => x.AvgKLD),
            _ => items
        };
        return items;
    }

    private IEnumerable<Score> GetPagedScoreItems()
    {
        return GetSortedScoreItems().Skip(scoreCurrentPage * scorePageSize).Take(scorePageSize);
    }

    private void ScorePrevPage() { if (scoreCurrentPage > 0) scoreCurrentPage--; }
    private void ScoreNextPage() { if (scoreCurrentPage < scoreTotalPages - 1) scoreCurrentPage++; }
    private void ResetScorePage() { scoreCurrentPage = 0; }

    // Visualization filters
    private IEnumerable<string> AvailableEngines =>
      PolicyScores.Concat(ValueScores).Concat(SearchScores).Concat(SolveScores)
        .Select(s => s.Engine)
        .Distinct()
        .OrderBy(e => e);

    private IEnumerable<Score> FilteredScores =>
      PolicyScores.Concat(ValueScores).Concat(SearchScores).Concat(SolveScores)
        .Where(s => selectedType == "All" || s.Type.Contains(selectedType))
        .Where(s => selectedEngine == "All" || s.Engine == selectedEngine)
        .OrderBy(s => s.Type)
        .ThenBy(s => s.Filter)
        .ThenBy(s => s.Nodes)
        .ThenByDescending(s => s.PlayerRecord.Rating)
        .ThenBy(s => s.Engine);

    private void OnFilterChanged()
    {
        expandedScoreIds.Clear();
    }

    private async void ToggleScoreDetails(Score score)
    {
        var id = score.GetHashCode();
        if (expandedScoreIds.Contains(id))
        {
            expandedScoreIds.Remove(id);
        }
        else
        {
            expandedScoreIds.Add(id);
            await InvokeAsync(StateHasChanged);
            await Task.Delay(200);
            await InvokeAsync(StateHasChanged);
        }

        StateHasChanged();
    }

    private async void Update(Lichess update)
    {
        switch (update)
        {
            case Lichess.PuzzleResult pRes:
                var res = pRes.Item;
                if (res.Type.Contains("Policy") || res.Type.StartsWith("pTop"))
                    PolicyScores.Add(pRes.Item);
                else if (res.Type.Contains("Value") || res.Type.StartsWith("vTop"))
                    ValueScores.Add(pRes.Item);
                else if (res.Type == "Solve")
                    SolveScores.Add(pRes.Item);
                else
                    SearchScores.Add(pRes.Item);

                // Auto-select first tab with data
                if (!ActiveTabs.Contains(activeScoreTab))
                    activeScoreTab = ActiveTabs.FirstOrDefault() ?? "Policy";
                break;
            case Lichess.Done msg:
                endOfRun = ": " + msg.Item;
                break;
        }
        await InvokeAsync(StateHasChanged);
    }

    private void Draw()
    {
        Filter = drawPuzzleCategories(5);
        StateHasChanged();
    }

    private CsvPuzzleData[] ParseCsv(string filePath, bool random)
    {
        var records = new List<CsvPuzzleData>();
        var lines = File.ReadAllLines(filePath);

        foreach (var line in lines.Skip(1))
        {
            var fields = line.Split(',');
            var puzzleId = fields[0].GetHashCode();
            var fen = fields[1];
            var moves = fields[2];
            var rating = int.Parse(fields[3]);
            var ratingDeviation = int.Parse(fields[4]);
            var popularity = int.Parse(fields[5]);
            var nbPlays = int.Parse(fields[6]);
            var themes = fields[7];
            var gameUrl = fields[8];
            var openingTags = fields[9];
            var fens = new List<string>();
            var posList = new List<PuzzleTypes.Position>();
            var record = CsvPuzzleData.Create(puzzleId, fen, moves, rating, ratingDeviation, popularity, nbPlays, themes, gameUrl, openingTags, line, posList, fens, 0);
            records.Add(record);
        }

        var recordsArray = records.ToArray();
        if (random)
            System.Random.Shared.Shuffle(recordsArray);
        return recordsArray;
    }

    private void StartOfRun()
    {
        endOfRun = ": started";
        disableRun = true;
        StateHasChanged();
    }

    private async Task ClearPreviousRunResourcesAsync()
    {
        try
        {
            Array.Clear(puzzles);
            puzzles = null;

            PolicyScores?.Clear();
            ValueScores?.Clear();
            SearchScores?.Clear();
            SolveScores?.Clear();

            PolicyScores = new List<Score>();
            ValueScores = new List<Score>();
            SearchScores = new List<Score>();
            SolveScores = new List<Score>();

            expandedScoreIds.Clear();

            await InvokeAsync(StateHasChanged);
            await Task.Delay(50);

            GC.Collect();
            GC.WaitForPendingFinalizers();
            GC.Collect();

            await Task.Yield();
        }
        catch (Exception ex)
        {
            logger.LogWarning("ClearPreviousRunResourcesAsync failed: {Message}", ex.Message);
        }
    }

    private async Task OpenCSVFile(InputFileChangeEventArgs e)
    {
        StartOfRun();

        if (puzzles == null || fileName != e.File.Name)
        {
            var pgnName = e.File.Name;
            fileName = pgnName;
            if (!pgnName.EndsWith(".json"))
            {
                logger.LogError("Selected file does not end with .json, please select you puzzle config file (JSON)");
                disableRun = false;
                StateHasChanged();
                return;
            }
            logger.LogInformation("Selected file {File}", pgnName);
            var env = AppPaths.BaseDir;
            fullPath = Path.Combine(env, pgnName);
            await using (FileStream fs = new(fullPath, FileMode.Create))
            {
                browserFile = e.File;
                await browserFile.OpenReadStream(maxAllowedSize: 1024 * 1024 * 1024 * 2L).CopyToAsync(fs);
            }

        }
        await Run(null);

        browserFile = null;
        fileName = string.Empty;
        disableRun = false;
        StateHasChanged();
        await Task.Delay(500);
    }

    private string CreateCombinedScoresTable(string puzzleFile)
    {
        var sb = new StringBuilder();
        sb.AppendLine("\n```\n");
        sb.AppendLine($"Puzzle file name: {puzzleFile}\n");
        var allScores = PolicyScores.Concat(ValueScores).Concat(SearchScores).Concat(SolveScores).ToList();

        int maxEngineWidth = Math.Max("Engine".Length, allScores.Max(s => s.Engine.Length));
        int maxNeuralNetWidth = Math.Max("Neural net".Length, allScores.Max(s => s.NeuralNet.Length));
        int maxPerfWidth = Math.Max("Perf".Length, allScores.Max(s => s.PlayerRecord.Rating.ToString("F0").Length));
        int maxAccuracyWidth = Math.Max("Accuracy".Length, allScores.Max(s => ((decimal)s.Correct / s.TotalNumber).ToString("P1").Length));
        int maxTotalWidth = Math.Max("Total".Length, allScores.Max(s => s.TotalNumber.ToString().Length));
        int maxAvgRatingWidth = Math.Max("AvgR".Length, allScores.Max(s => s.RatingAvg.ToString("F0").Length));
        int maxTypeWidth = Math.Max("Type".Length, allScores.Max(s => s.Type.Length));
        int maxThemeWidth = Math.Max("Theme".Length, allScores.Max(s => s.Filter.Length + 2));
        int maxNodesWidth = Math.Max("Nodes".Length, allScores.Max(s => s.Nodes.ToString().Length));
        int maxKLDWidth = Math.Max("KLD".Length, PolicyScores.Count > 0 ? PolicyScores.Max(s => s.AvgKLD > 0 ? s.AvgKLD.ToString("F4").Length : 1) : 1);
        string FormatKLD(Score s) => s.AvgKLD > 0 ? s.AvgKLD.ToString("F4") : "—";
        var sep = "  ";
        string BaseRow(Score s) => $"{s.Engine.PadRight(maxEngineWidth)}{sep}{s.NeuralNet.PadRight(maxNeuralNetWidth)}{sep}{s.PlayerRecord.Rating.ToString("F0").PadRight(maxPerfWidth)}{sep}{(s.TotalNumber > 0 ? ((decimal)s.Correct / s.TotalNumber).ToString("P1") : "N/A").PadRight(maxAccuracyWidth)}{sep}{s.TotalNumber.ToString().PadRight(maxTotalWidth)}{sep}{s.RatingAvg.ToString("F0").PadRight(maxAvgRatingWidth)}{sep}{s.Filter.PadRight(maxThemeWidth)}";
        string BaseHeader() => $"{"Engine".PadRight(maxEngineWidth)}{sep}{"Neural net".PadRight(maxNeuralNetWidth)}{sep}{"Perf".PadRight(maxPerfWidth)}{sep}{"Accuracy".PadRight(maxAccuracyWidth)}{sep}{"Total".PadRight(maxTotalWidth)}{sep}{"AvgR".PadRight(maxAvgRatingWidth)}{sep}{"Theme".PadRight(maxThemeWidth)}";

        int sepWidth = 2;
        int columns = 8;
        int approximateWidth = maxEngineWidth + maxNeuralNetWidth + maxPerfWidth +
                              maxAccuracyWidth + maxTotalWidth + maxAvgRatingWidth +
                              maxThemeWidth + maxNodesWidth + (columns - 1) * sepWidth;

        string separatorLine = new string('-', approximateWidth);

        if (PolicyScores.Count > 0)
        {
            sb.AppendLine("Policy Head Tests\n");
            sb.AppendLine($"{BaseHeader()}{sep}{"Type".PadRight(maxTypeWidth)}{sep}{"KLD".PadRight(maxKLDWidth)}");

            double? currentGroup = null;
            foreach (var score in PolicyScores)
            {
                if (currentGroup.HasValue && score.RatingAvg != currentGroup.Value)
                {
                    sb.AppendLine(separatorLine);
                }
                currentGroup = score.RatingAvg;
                sb.AppendLine($"{BaseRow(score)}{sep}{score.Type.PadRight(maxTypeWidth)}{sep}{FormatKLD(score).PadRight(maxKLDWidth)}");
            }
            sb.AppendLine();
        }
        if (ValueScores.Count > 0)
        {
            sb.AppendLine("Value Head Tests\n");
            sb.AppendLine($"{BaseHeader()}{sep}{"Type".PadRight(maxTypeWidth)}");

            double? currentGroup = null;
            foreach (var score in ValueScores)
            {
                if (currentGroup.HasValue && score.RatingAvg != currentGroup.Value)
                {
                    sb.AppendLine(separatorLine);
                }
                currentGroup = score.RatingAvg;
                sb.AppendLine($"{BaseRow(score)}{sep}{score.Type.PadRight(maxTypeWidth)}");
            }
            sb.AppendLine();
        }

        if (SearchScores.Count > 0)
        {
            sb.AppendLine("Search Tests\n");
            sb.AppendLine($"{BaseHeader()}{sep}{"Nodes".PadRight(maxNodesWidth)}");

            double? currentGroup = null;
            foreach (var score in SearchScores)
            {
                if (currentGroup.HasValue && score.RatingAvg != currentGroup.Value)
                {
                    sb.AppendLine(separatorLine);
                }
                currentGroup = score.RatingAvg;
                sb.AppendLine($"{BaseRow(score)}{sep}{score.Nodes.ToString().PadRight(maxNodesWidth)}");
            }
            sb.AppendLine();
        }

        if (SolveScores.Count > 0)
        {
            sb.AppendLine("Solve Tests\n");
            sb.AppendLine($"{BaseHeader()}{sep}{"Nodes".PadRight(maxNodesWidth)}");

            double? currentGroup = null;
            foreach (var score in SolveScores)
            {
                if (currentGroup.HasValue && score.RatingAvg != currentGroup.Value)
                {
                    sb.AppendLine(separatorLine);
                }
                currentGroup = score.RatingAvg;
                sb.AppendLine($"{BaseRow(score)}{sep}{score.Nodes.ToString().PadRight(maxNodesWidth)}");
            }
            sb.AppendLine();
        }
        sb.Append("\n```\n");
        return sb.ToString();

    }

    public static string RemovePosAndFen(string input)
    {
        const string prefix = "position fen ";
        if (input.StartsWith(prefix, StringComparison.Ordinal))
            return input.Substring(prefix.Length);
        return input;
    }

    private async Task Run(MouseEventArgs args)
    {
        var fullPathName = string.IsNullOrWhiteSpace(fullPath) ? FolderName : fullPath;

        if (!File.Exists(fullPathName))
        {
            logger.LogError($"Puzzle config file not found: {fullPathName}");
            return;
        }

        await ClearPreviousRunResourcesAsync();

        disableRun = true;

        await Task.Run(async () =>
        {
            try
            {
                var data = loadPuzzleConfig(normalizePath(fullPathName));
                puzzleFileName = Path.GetFileName(data.PuzzleFile);
                if (!string.IsNullOrWhiteSpace(data.PuzzleFilter) && !string.IsNullOrWhiteSpace(Filter))
                {
                    data.PuzzleFilter = $"{data.PuzzleFilter},{Filter}";
                }
                else if (string.IsNullOrWhiteSpace(data.PuzzleFilter))
                {
                    data.PuzzleFilter = Filter;
                }
                await InvokeAsync(StateHasChanged);

                if (!string.IsNullOrWhiteSpace(data.PuzzleFilter))
                {
                    data.PuzzleFilter =
                  string.Join(",", data.PuzzleFilter.Split(',')
                  .Select(e => e.Trim())
                  .Select(e => e.ToLowerInvariant())
                  .Where(e => !string.IsNullOrWhiteSpace(e))
                  .Distinct());
                    logger.LogInformation($"Puzzle filter set to: {data.PuzzleFilter}");
                }

                var normalizedPath = normalizePath(data.PuzzleFile);
                logger.LogInformation($"Processing Lichess puzzle file: {fullPathName}");

                var engineConfigs = data.Engines
              .SelectMany(e => mapToEngPuzzleConfig(data.EngineFolder, e))
              .ToList();

                puzzles = parsePuzzle(normalizedPath, false);
                var formattedLength = puzzles.Length.ToString("N0");
                logger.LogInformation($"Loaded {formattedLength} puzzles from {normalizedPath}");

                var puzzleInput = TypesDef.PuzzleInput.PuzzleInput.Create(puzzles, data.MaxRating, data.MinRating, data.RatingGroups, data.PuzzleFilter,
                                  engineConfigs, 1, data.SampleSize, data.Nodes, data.Failed, data.Solved, data.Concurrency);

                var types = string.IsNullOrWhiteSpace(data.Type)
            ? new List<string>()
            : data.Type
              .ToLowerInvariant()
              .Split(',')
              .Select(e => e.Trim())
              .Where(e => e.Length > 0)
              .ToList();

                List<Score> scores;

                switch (types.Count)
                {
                    case 0:
                        logger.LogInformation("No puzzle types specified, defaulting to policy and value test");
                        scores = PuzzleRunners.runValueAndPolicyHeadTest(puzzleInput, Update, CancellationToken.None);
                        break;

                    default:
                        {
                            logger.LogInformation($"Puzzle types specified: {data.Type}");
                            var set = new HashSet<string>(types);
                            var nodeList = ChessLibrary.PuzzleDataUtils.parseNodes(puzzleInput.nodes);
                            var subTests = new List<ChessLibrary.PuzzleEngineAgent.SubTest>();
                            foreach (var t in types)
                            {
                                switch (t)
                                {
                                    case "policy":
                                        subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.Policy);
                                        break;
                                    case "value":
                                        subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.Value);
                                        break;
                                    case "search":
                                        foreach (var n in nodeList)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewSearch(n));
                                        break;
                                    case "solve":
                                        foreach (var n in nodeList)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewSolve(n));
                                        break;
                                    default:
                                        // policytop3 / policy3 → PolicyTopN
                                        if (t.StartsWith("policytop") && int.TryParse(t.Substring("policytop".Length), out int topN) && topN >= 1)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewPolicyTopN(topN));
                                        else if (t.StartsWith("policy") && t.Length > 6 && int.TryParse(t.Substring("policy".Length), out int pn) && pn >= 1)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewPolicyTopN(pn));
                                        // valuetop3 / value3 → ValueTopN
                                        else if (t.StartsWith("valuetop") && int.TryParse(t.Substring("valuetop".Length), out int valueTopN) && valueTopN >= 1)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewValueTopN(valueTopN));
                                        else if (t.StartsWith("value") && t.Length > 5 && int.TryParse(t.Substring("value".Length), out int vn) && vn >= 1)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewValueTopN(vn));
                                        else
                                            logger.LogWarning($"Unknown puzzle type '{t}', skipping");
                                        break;
                                }
                            }
                            if (subTests.Count == 0)
                            {
                                logger.LogInformation("No valid puzzle types found, defaulting to policy and value test");
                                scores = PuzzleRunners.runValueAndPolicyHeadTest(puzzleInput, Update, CancellationToken.None);
                            }
                            else
                            {
                                var subTestList = Microsoft.FSharp.Collections.ListModule.OfSeq(subTests);
                                scores = ChessLibrary.PuzzleEngineAgent.runTest(puzzleInput, Update, subTestList, CancellationToken.None);
                            }
                        }
                        break;
                }

                if (ValueScores.Any())
                {
                    ValueScores =
                  ValueScores.Where(e => e.TotalNumber > 0 && (e.Type.Contains("Value") || e.Type.StartsWith("vTop")))
                  .OrderBy(e => e.Filter)
                  .ThenByDescending(e => e.RatingAvg)
                  .ThenByDescending(e => ((decimal)e.Correct / e.TotalNumber))
                  .ToList();
                }

                if (PolicyScores.Any())
                {
                    PolicyScores =
                  PolicyScores.Where(e => e.TotalNumber > 0 && (e.Type.Contains("Policy") || e.Type.StartsWith("pTop")))
                  .OrderBy(e => e.Filter)
                  .ThenByDescending(e => e.RatingAvg)
                  .ThenByDescending(e => ((decimal)e.Correct / e.TotalNumber))
                  .ToList();
                }

                if (SearchScores.Any())
                {
                    SearchScores =
                  SearchScores.Where(e => e.TotalNumber > 0 && e.Type.Contains("Search"))
                  .OrderBy(e => e.Filter)
                  .ThenByDescending(e => e.RatingAvg)
                  .ThenByDescending(e => ((decimal)e.Correct / e.TotalNumber))
                  .ToList();
                }

                if (SolveScores.Any())
                {
                    SolveScores =
                  SolveScores.Where(e => e.TotalNumber > 0 && e.Type.Contains("Solve"))
                  .OrderBy(e => e.Filter)
                  .ThenByDescending(e => e.RatingAvg)
                  .ThenByDescending(e => ((decimal)e.Correct / e.TotalNumber))
                  .ToList();
                }

                // Auto-select first available tab
                activeScoreTab = ActiveTabs.FirstOrDefault() ?? "Policy";

                var normalized = Configuration.JSONParser.normalizePath(data.FailedPuzzlesOutputFolder);
                var table = CreateCombinedScoresTable(data.PuzzleFile);
                logger.LogInformation(table);
                if (Directory.Exists(normalized))
                {
                    var allScores = new List<Score>();
                    allScores.AddRange(PolicyScores);
                    allScores.AddRange(ValueScores);
                    allScores.AddRange(SearchScores);
                    allScores.AddRange(SolveScores);
                    var datePart = DateTime.Now.ToString("yyyy-MM-dd_HH-mm", System.Globalization.CultureInfo.InvariantCulture);
                    var fileName = Path.Combine(normalized, $"failedLichessPuzzles_{datePart}.epd");
                    using (StreamWriter sw = File.AppendText(fileName))
                    {
                        var boardBm = new Chess.Board();
                        var boardAm = new Chess.Board();
                        foreach (var item in allScores)
                        {
                            sw.WriteLine($"\n##Failed puzzles by {item.Engine} (nn:{item.NeuralNet}) - overall performance: {item.PlayerRecord.Rating.ToString("F0")} - Type: {item.Type} - Theme: {item.Filter} - Nodes: {item.Nodes}\n");
                            var sorted = item.FailedPuzzles
                      .Select(tuple =>
                      {
                    var parts = tuple.Item2.Split(",");
                    if (parts.Length > 1 && double.TryParse(parts[0].Trim(), out double value))
                        return (tuple.Item1, value, tuple.Item2);
                    return (tuple.Item1, tuple.Item1.Rating, tuple.Item2);
                })
                      .OrderBy(tuple => tuple.Item2);

                            foreach (var puzzle in sorted)
                            {
                                foreach (var cmd in puzzle.Item1.Commands)
                                {
                                    if (!String.IsNullOrWhiteSpace(cmd.MovePlayed) && cmd.MovePlayed.Length >= 4)
                                    {
                                        boardBm.PlayCommands(cmd.Command);
                                        var fen = boardBm.FEN();
                                        boardBm.PlayUciMove(cmd.CorrectMove);
                                        var bm = boardBm.SanMovesPlayed.LastOrDefault();
                                        boardAm.PlayCommands(cmd.Command);
                                        boardAm.PlayUciMove(cmd.MovePlayed);
                                        var aM = boardAm.SanMovesPlayed.LastOrDefault();
                                        var policies = puzzle.Item3.Split(",");
                                        var (bmP, amP) = policies.Length > 1 ? (policies[0].Trim(), policies[1].Trim()) : ("", "");
                                        var msg = $"{fen} bm {bm}; am {aM}; id \"Lichess id {puzzle.Item1.PuzzleId}, policy value for bestmove {bm}={bmP} and move played {aM}={amP}\"; other \"{cmd.CorrectMove},{cmd.MovePlayed}\"";
                                        sw.WriteLine(msg);
                                    }
                                }
                            }
                        }
                    }

                    var csvFileName = Path.Combine(normalized, $"failedLichessPuzzles_{datePart}.csv");
                    var allFailed = allScores
                        .SelectMany(s => s.FailedPuzzles.Select(t => t.Item1))
                        .GroupBy(p => p.PuzzleId)
                        .Select(g => g.First())
                        .ToArray();
                    if (allFailed.Length > 0)
                    {
                        using var csvWriter = new StreamWriter(csvFileName);
                        csvWriter.WriteLine("PuzzleId,FEN,Moves,Rating,RatingDeviation,Popularity,NbPlays,Themes,GameUrl,OpeningTags");
                        foreach (var p in allFailed)
                        {
                            csvWriter.WriteLine($"{p.PuzzleId},{p.Fen},{p.Moves},{(int)p.Rating},{(int)p.RatingDeviation},{p.Popularity},{p.NbPlays},{p.Themes},{p.GameUrl},{p.OpeningTags}");
                        }
                        logger.LogInformation($"  Failed puzzles CSV ({allFailed.Length} unique): {csvFileName}");
                    }

                    var allScoresForCross = PolicyScores.AsEnumerable()
                        .Concat(ValueScores)
                        .Concat(SearchScores)
                        .Concat(SolveScores);
                    ChessLibrary.PuzzleCrossEngine.writeCrossEngineFiles(normalized, datePart, allScoresForCross);

                    var tableFileName = Path.Combine(normalized, $"LichessSummary{datePart}.txt");
                    using (StreamWriter sw = new StreamWriter(tableFileName))
                    {
                        sw.WriteLine(table);
                    }
                }

                await Task.CompletedTask;
            }
            catch (Exception ex)
            {
                logger.LogError("Lichess puzzle failed to start/run - ");
                logger.LogError(ex.Message);
            }

            finally
            {
                if (!string.IsNullOrWhiteSpace(fullPath))
                {
                    File.Delete(fullPath);
                }
                await InvokeAsync(() => disableRun = false);
            }

        });

        StateHasChanged();
        await Task.Delay(1000);

    }

    public async ValueTask DisposeAsync()
    {
        await ClearPreviousRunResourcesAsync();
        logger.LogInformation("Disposing LichessPuzzles component");
        await ValueTask.CompletedTask;
    }
}

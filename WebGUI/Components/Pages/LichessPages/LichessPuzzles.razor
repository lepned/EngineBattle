    }

    private void AddTheme(string theme)
    {
        var lower = theme.ToLowerInvariant();
        if (string.IsNullOrWhiteSpace(Filter))
        {
            Filter = lower;
        }
        else
        {
            var existing = Filter.Split(',').Select(e => e.Trim().ToLowerInvariant()).Where(e => e.Length > 0).ToHashSet();
            if (!existing.Contains(lower))
                Filter = $"{Filter},{lower}";
        }
        StateHasChanged();
    }

    private DateTime runStartedUtc = DateTime.UtcNow;

    private void StartOfRun()
    {
        runStartedUtc = DateTime.UtcNow;
        disableRun = true;
        progressProcessed = 0;
        progressTotal = 0;
        progressEngine = "";
        errorMessage = "";
        cts?.Dispose();
        cts = new CancellationTokenSource();
        StateHasChanged();
    }

    private async Task ClearPreviousRunResourcesAsync()
    {
        try
        {
            if (puzzles != null)
            {
                Array.Clear(puzzles);
                puzzles = null;
            }

            PolicyScores = new List<Score>();
            ValueScores = new List<Score>();
            SearchScores = new List<Score>();
            SolveScores = new List<Score>();

            expandedScoreIds.Clear();

            await InvokeAsync(StateHasChanged);
        }
        catch (Exception ex)
        {
            logger.LogWarning("ClearPreviousRunResourcesAsync failed: {Message}", ex.Message);
        }
    }

    private void CancelRun()
    {
        cts?.Cancel();
        disableRun = false;
        progressProcessed = 0;
        progressTotal = 0;
        progressEngine = "";
        StateHasChanged();
    }

    /// What the picked config will run, read once when it is chosen. Lets you see
    /// the shape of a run - how many nets, how many puzzles - before spending the
    /// time on it.
    private sealed record ConfigSummary(
        int Nets, string NetNames, int SampleSize, string Types, string Nodes,
        string RatingGroups, string Themes, string PuzzleFile);

    /// A tooltip listing more than this is unreadable; ablation configs run dozens.
    private const int MaxListedNets = 30;

    private ConfigSummary configSummary;

    private void SummariseConfig(PuzzleConfig data)
    {
        // one Engines entry can expand to several nets, so count the expansion,
        // not the entries — and keep the names, because "6" does not tell you whether
        // the config is the one you meant to run
        var nets = 0;
        var netNames = "";
        try
        {
            var expanded = data.Engines
                .SelectMany(e => mapToEngPuzzleConfig(data.EngineFolder, e))
                .Select(t => t.Item1.Name)
                .ToList();
            nets = expanded.Count;
            var listed = expanded.Count <= MaxListedNets
                ? expanded
                : expanded.Take(MaxListedNets)
                    .Append($"… and {expanded.Count - MaxListedNets} more").ToList();
            netNames = string.Join(Environment.NewLine, listed);
        }
        catch
        {
            // the expansion reads every engine def; if that fails we still know how many
            // entries the config has, but not what they resolve to
            nets = data.Engines.Count;
        }

        configSummary = new ConfigSummary(
            nets,
            netNames,
            data.SampleSize,
            string.IsNullOrWhiteSpace(data.Type) ? "—" : data.Type,
            string.IsNullOrWhiteSpace(data.Nodes) ? "—" : data.Nodes,
            string.IsNullOrWhiteSpace(data.RatingGroups) ? "all" : data.RatingGroups,
            // the config's own theme filter - the box above may hold this merged with
            // whatever was typed before, so the two can differ
            string.IsNullOrWhiteSpace(data.PuzzleFilter) ? "all themes" : data.PuzzleFilter,
            System.IO.Path.GetFileName(data.PuzzleFile ?? ""));
    }

    private void PreloadConfigFilter()
    {
        try
        {
            // clear first: a summary that survives a failed load would describe the
            // previous config while the path shows the new one
            configSummary = null;
            if (string.IsNullOrEmpty(fullPath) || !File.Exists(fullPath)) return;

            var data = loadPuzzleConfig(normalizePath(fullPath));
            SummariseConfig(data);

            if (!string.IsNullOrWhiteSpace(data.PuzzleFilter))
            {
                if (string.IsNullOrWhiteSpace(Filter))
                {
                    Filter = data.PuzzleFilter;
                }
                else
                {
                    Filter = $"{data.PuzzleFilter},{Filter}";
                }

                Filter = string.Join(",", Filter.Split(',')
                    .Select(e => e.Trim())
                    .Select(e => e.ToLowerInvariant())
                    .Where(e => !string.IsNullOrWhiteSpace(e))
                    .Distinct());

                logger.LogInformation("Pre-loaded puzzle filter from config: {Filter}", Filter);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            logger.LogWarning("Failed to pre-load config filter: {Message}", ex.Message);
        }
    }

    /// Prepares the run's output folder, surfacing a bad path on the page rather than
    /// leaving a run that finishes and quietly writes nothing. Returns "" when the run
    /// should write no files.
    private string PrepareOutputFolder(string configured)
    {
        var (path, error) = PuzzleOutputFolder.Prepare(configured, "Puzzle", logger);
        if (error != "") errorMessage = error;
        return path;
    }

    private async Task PickConfig()
    {
        var initialDir = SettingsService.Settings.PuzzleConfigFolder;
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, initialDir },
            { x => x.FileFilter, "*.json" },
            { x => x.Mode, WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog.FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select Puzzle Config", parameters, options);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;

        fullPath = (string)result.Data!;
        logger.LogInformation("Selected file {File}", fullPath);

        PreloadConfigFilter();
        StateHasChanged();
    }

    /// Runs whatever config is currently selected. Split from picking so the same
    /// config can be re-run without walking the file dialog again.
    private async Task RunSelectedConfig()
    {
        if (string.IsNullOrEmpty(fullPath) || disableRun) return;

        StartOfRun();
        await Run(null);

        disableRun = false;
        StateHasChanged();
        await Task.Delay(500);
    }

    private static string ConfigFileName(string path) =>
        string.IsNullOrEmpty(path) ? "" : System.IO.Path.GetFileName(path);

    private static string ConfigFolder(string path)
    {
        if (string.IsNullOrEmpty(path)) return "";
        var dir = System.IO.Path.GetDirectoryName(path);
        return string.IsNullOrEmpty(dir) ? "" : dir.Replace('\\', '/');
    }

    private async Task CopyResultsToClipboard()
    {

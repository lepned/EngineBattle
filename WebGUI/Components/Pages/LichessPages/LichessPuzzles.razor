            copyLabel = "Copy";
            StateHasChanged();
        }
    }

    private string CreateCombinedScoresTable(string puzzleFile)
    {
        var sb = new StringBuilder();
        sb.AppendLine("\n```\n");
        sb.AppendLine($"Puzzle file name: {puzzleFile}\n");
        var allScores = PolicyScores.Concat(ValueScores).Concat(SearchScores).Concat(SolveScores).ToList();

        if (allScores.Count == 0)
        {
            sb.AppendLine("No results.\n```");
            return sb.ToString();
        }

        bool showEng = ShowEngineColumn;
        int maxEngineWidth = showEng ? Math.Max("Engine".Length, allScores.Max(s => s.Engine.Length)) : 0;
        int maxNeuralNetWidth = Math.Max("Neural net".Length, allScores.Max(s => s.NeuralNet.Length));
        int maxPerfWidth = Math.Max("Perf".Length, allScores.Max(s => s.PlayerRecord.Rating.ToString("F0").Length));
        int maxAccuracyWidth = Math.Max("Accuracy".Length, allScores.Max(s => (s.TotalNumber > 0 ? ((decimal)s.Correct / s.TotalNumber).ToString("P1") : "N/A").Length));
        int maxTotalWidth = Math.Max("Total".Length, allScores.Max(s => s.TotalNumber.ToString().Length));
        int maxAvgRatingWidth = Math.Max("AvgR".Length, allScores.Max(s => s.RatingAvg.ToString("F0").Length));
        int maxTypeWidth = Math.Max("Type".Length, allScores.Max(s => s.Type.Length));
        int maxThemeWidth = Math.Max("Theme".Length, allScores.Max(s => s.Filter.Length + 2));
        int maxNodesWidth = Math.Max("Nodes".Length, allScores.Max(s => s.Nodes.ToString().Length));
        int maxKLDWidth = Math.Max("KLD".Length, PolicyScores.Count > 0 ? PolicyScores.Max(s => s.AvgKLD > 0 ? s.AvgKLD.ToString("F4").Length : 1) : 1);
        string FormatKLD(Score s) => s.AvgKLD > 0 ? s.AvgKLD.ToString("F4") : "—";
        // Estimated-nodes columns (P95/P99/Max/≤100), mirroring the console table in CliParser.fs.
        // AvgEstNodesLog10 = 0 means the metric is absent (no policy data), which blanks the columns.
        static string FormatNodeCount(double n) =>
            n < 10.0 ? n.ToString("F2")
            : n < 1000.0 ? n.ToString("F0")
            : n < 1_000_000.0 ? (n / 1000.0).ToString("F1") + "k"
            : (n / 1_000_000.0).ToString("F2") + "M";
        string FormatEstPercentile(double value, Score s) => s.AvgEstNodesLog10 > 0.0 ? FormatNodeCount(value) : "—";
        string FormatEstCdf100(Score s) => s.AvgEstNodesLog10 > 0.0 ? (s.EstNodesCdf100 * 100.0).ToString("F1") + "%" : "—";
        string FormatEstMax(Score s) => s.AvgEstNodesLog10 > 0.0 && s.HardestByEstNodes.Count > 0 ? FormatNodeCount(s.HardestByEstNodes[0].Item2) : "—";
        int maxEstP95Width = Math.Max("P95".Length, PolicyScores.Count > 0 ? PolicyScores.Max(s => FormatEstPercentile(s.EstNodesP95, s).Length) : 0);
        int maxEstP99Width = Math.Max("P99".Length, PolicyScores.Count > 0 ? PolicyScores.Max(s => FormatEstPercentile(s.EstNodesP99, s).Length) : 0);
        int maxEstMaxWidth = Math.Max("Max".Length, PolicyScores.Count > 0 ? PolicyScores.Max(s => FormatEstMax(s).Length) : 0);
        int maxEstCdfWidth = Math.Max("≤100".Length, PolicyScores.Count > 0 ? PolicyScores.Max(s => FormatEstCdf100(s).Length) : 0);
        var sep = "  ";
        string engCol(string val) => showEng ? $"{val.PadRight(maxEngineWidth)}{sep}" : "";
        string BaseRow(Score s) => $"{engCol(s.Engine)}{s.NeuralNet.PadRight(maxNeuralNetWidth)}{sep}{s.PlayerRecord.Rating.ToString("F0").PadRight(maxPerfWidth)}{sep}{(s.TotalNumber > 0 ? ((decimal)s.Correct / s.TotalNumber).ToString("P1") : "N/A").PadRight(maxAccuracyWidth)}{sep}{s.TotalNumber.ToString().PadRight(maxTotalWidth)}{sep}{s.RatingAvg.ToString("F0").PadRight(maxAvgRatingWidth)}{sep}{s.Filter.PadRight(maxThemeWidth)}";
        string BaseHeader() => $"{engCol("Engine")}{"Neural net".PadRight(maxNeuralNetWidth)}{sep}{"Perf".PadRight(maxPerfWidth)}{sep}{"Accuracy".PadRight(maxAccuracyWidth)}{sep}{"Total".PadRight(maxTotalWidth)}{sep}{"AvgR".PadRight(maxAvgRatingWidth)}{sep}{"Theme".PadRight(maxThemeWidth)}";

        int sepWidth = 2;
        int columns = showEng ? 8 : 7;
        int approximateWidth = maxEngineWidth + maxNeuralNetWidth + maxPerfWidth +
                              maxAccuracyWidth + maxTotalWidth + maxAvgRatingWidth +
                              maxThemeWidth + maxNodesWidth + (columns - 1) * sepWidth;

        string separatorLine = new string('-', approximateWidth);

        if (PolicyScores.Count > 0)
        {
            sb.AppendLine("Policy Head Tests\n");
            sb.AppendLine($"{BaseHeader()}{sep}{"Type".PadRight(maxTypeWidth)}{sep}{"KLD".PadRight(maxKLDWidth)}{sep}{"P95".PadRight(maxEstP95Width)}{sep}{"P99".PadRight(maxEstP99Width)}{sep}{"Max".PadRight(maxEstMaxWidth)}{sep}{"≤100".PadRight(maxEstCdfWidth)}");

            double? currentGroup = null;
            foreach (var score in PolicyScores)
            {
                if (currentGroup.HasValue && score.RatingAvg != currentGroup.Value)
                {
                    sb.AppendLine(separatorLine);
                }
                currentGroup = score.RatingAvg;
                sb.AppendLine($"{BaseRow(score)}{sep}{score.Type.PadRight(maxTypeWidth)}{sep}{FormatKLD(score).PadRight(maxKLDWidth)}{sep}{FormatEstPercentile(score.EstNodesP95, score).PadRight(maxEstP95Width)}{sep}{FormatEstPercentile(score.EstNodesP99, score).PadRight(maxEstP99Width)}{sep}{FormatEstMax(score).PadRight(maxEstMaxWidth)}{sep}{FormatEstCdf100(score).PadRight(maxEstCdfWidth)}");
            }
            sb.AppendLine();
        }
        if (ValueScores.Count > 0)
        {
            sb.AppendLine("Value Head Tests\n");
            sb.AppendLine($"{BaseHeader()}{sep}{"Type".PadRight(maxTypeWidth)}");

            double? currentGroup = null;
            foreach (var score in ValueScores)
            {
                if (currentGroup.HasValue && score.RatingAvg != currentGroup.Value)
                {
                    sb.AppendLine(separatorLine);
                }
                currentGroup = score.RatingAvg;
                sb.AppendLine($"{BaseRow(score)}{sep}{score.Type.PadRight(maxTypeWidth)}");
            }
            sb.AppendLine();
        }

        if (SearchScores.Count > 0)
        {
            sb.AppendLine("Search Tests\n");
            sb.AppendLine($"{BaseHeader()}{sep}{"Nodes".PadRight(maxNodesWidth)}");

            double? currentGroup = null;
            foreach (var score in SearchScores)
            {
                if (currentGroup.HasValue && score.RatingAvg != currentGroup.Value)
                {
                    sb.AppendLine(separatorLine);
                }
                currentGroup = score.RatingAvg;
                sb.AppendLine($"{BaseRow(score)}{sep}{score.Nodes.ToString().PadRight(maxNodesWidth)}");
            }
            sb.AppendLine();
        }

        if (SolveScores.Count > 0)
        {
            sb.AppendLine("Solve Tests\n");
            sb.AppendLine($"{BaseHeader()}{sep}{"Nodes".PadRight(maxNodesWidth)}");

            double? currentGroup = null;
            foreach (var score in SolveScores)
            {
                if (currentGroup.HasValue && score.RatingAvg != currentGroup.Value)
                {
                    sb.AppendLine(separatorLine);
                }
                currentGroup = score.RatingAvg;
                sb.AppendLine($"{BaseRow(score)}{sep}{score.Nodes.ToString().PadRight(maxNodesWidth)}");
            }
            sb.AppendLine();
        }
        sb.Append("\n```\n");
        return sb.ToString();

    }

    public static string RemovePosAndFen(string input)
    {
        const string prefix = "position fen ";
        if (input.StartsWith(prefix, StringComparison.Ordinal))
            return input.Substring(prefix.Length);
        return input;
    }

    private async Task Run(MouseEventArgs args)
    {
        var fullPathName = fullPath;

        if (!File.Exists(fullPathName))
        {
            logger.LogError($"Puzzle config file not found: {fullPathName}");
            return;
        }

        await ClearPreviousRunResourcesAsync();

        disableRun = true;

        await Task.Run(async () =>
        {
            try
            {
                var data = loadPuzzleConfig(normalizePath(fullPathName));
                puzzleFileName = Path.GetFileName(data.PuzzleFile);

                // Resolved before any engine loads, so an unusable path costs seconds
                // instead of a whole run. Empty means this run writes no result files.
                var outputFolder = PrepareOutputFolder(data.FailedPuzzlesOutputFolder);

                // Filter already contains merged config + UI value from PreloadConfigFilter
                data.PuzzleFilter = Filter;
                await InvokeAsync(StateHasChanged);

                if (!string.IsNullOrWhiteSpace(data.PuzzleFilter))
                {
                    data.PuzzleFilter =
                  string.Join(",", data.PuzzleFilter.Split(',')
                  .Select(e => e.Trim())
                  .Select(e => e.ToLowerInvariant())
                  .Where(e => !string.IsNullOrWhiteSpace(e))
                  .Distinct());
                    logger.LogInformation($"Puzzle filter set to: {data.PuzzleFilter}");
                }

                var normalizedPath = normalizePath(data.PuzzleFile);
                logger.LogInformation($"Processing Lichess puzzle file: {fullPathName}");

                var engineConfigs = data.Engines
              .SelectMany(e => mapToEngPuzzleConfig(data.EngineFolder, e))
              .ToList();

                puzzles = parsePuzzle(normalizedPath, false);
                var formattedLength = puzzles.Length.ToString("N0");
                logger.LogInformation($"Loaded {formattedLength} puzzles from {normalizedPath}");

                var concurrency = concurrencyOverride > 0 ? concurrencyOverride : data.Concurrency;
                var puzzleInput = TypesDef.PuzzleInput.PuzzleInput.Create(puzzles, data.MaxRating, data.MinRating, data.RatingGroups, data.PuzzleFilter,
                                  engineConfigs, 1, data.SampleSize, data.Nodes, data.Failed, data.Solved, concurrency, data.IncludeFailedPuzzles, data.ScoreAllPositions);

                var types = string.IsNullOrWhiteSpace(data.Type)
            ? new List<string>()
            : data.Type
              .ToLowerInvariant()
              .Split(',')
              .Select(e => e.Trim())
              .Where(e => e.Length > 0)
              .ToList();

                List<Score> scores;

                switch (types.Count)
                {
                    case 0:
                        logger.LogInformation("No puzzle types specified, defaulting to policy and value test");
                        scores = PuzzleRunners.runValueAndPolicyHeadTest(puzzleInput, Update, cts.Token);
                        break;

                    default:
                        {
                            logger.LogInformation($"Puzzle types specified: {data.Type}");
                            var set = new HashSet<string>(types);
                            var nodeList = ChessLibrary.PuzzleDataUtils.parseNodes(puzzleInput.nodes);
                            var subTests = new List<ChessLibrary.PuzzleEngineAgent.SubTest>();
                            foreach (var t in types)
                            {
                                switch (t)
                                {
                                    case "policy":
                                        subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.Policy);
                                        break;
                                    case "value":
                                        subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.Value);
                                        break;
                                    case "policyvalue":
                                    case "dual":
                                        subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.PolicyValue);
                                        break;
                                    case "search":
                                        foreach (var n in nodeList)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewSearch(n));
                                        break;
                                    case "solve":
                                        foreach (var n in nodeList)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewSolve(n));
                                        break;
                                    default:
                                        // policytop3 / policy3 → PolicyTopN
                                        if (t.StartsWith("policytop") && int.TryParse(t.Substring("policytop".Length), out int topN) && topN >= 1)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewPolicyTopN(topN));
                                        else if (t.StartsWith("policy") && t.Length > 6 && int.TryParse(t.Substring("policy".Length), out int pn) && pn >= 1)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewPolicyTopN(pn));
                                        // valuetop3 / value3 → ValueTopN
                                        else if (t.StartsWith("valuetop") && int.TryParse(t.Substring("valuetop".Length), out int valueTopN) && valueTopN >= 1)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewValueTopN(valueTopN));
                                        else if (t.StartsWith("value") && t.Length > 5 && int.TryParse(t.Substring("value".Length), out int vn) && vn >= 1)
                                            subTests.Add(ChessLibrary.PuzzleEngineAgent.SubTest.NewValueTopN(vn));
                                        else
                                            logger.LogWarning($"Unknown puzzle type '{t}', skipping");
                                        break;
                                }
                            }
                            if (subTests.Count == 0)
                            {
                                logger.LogInformation("No valid puzzle types found, defaulting to policy and value test");
                                scores = PuzzleRunners.runValueAndPolicyHeadTest(puzzleInput, Update, cts.Token);
                            }
                            else
                            {
                                var subTestList = Microsoft.FSharp.Collections.ListModule.OfSeq(subTests);
                                scores = ChessLibrary.PuzzleEngineAgent.runTest(puzzleInput, Update, subTestList, cts.Token);
                            }
                        }
                        break;
                }

                // Re-sort on the dispatcher: Update callbacks add to these lists via
                // InvokeAsync, and enumerating them here on the Task.Run thread raced
                // still-queued adds ("Collection was modified" → empty results table).
                // Queued behind those adds, this also guarantees the file-export below
                // sees the complete lists.
                await InvokeAsync(() =>
                {
                    if (ValueScores.Any())
                    {
                        ValueScores =
                      ValueScores.Where(e => e.TotalNumber > 0 && (e.Type.Contains("Value") || e.Type.StartsWith("vTop")))
                      .OrderBy(e => e.Filter)
                      .ThenByDescending(e => e.RatingAvg)
                      .ThenByDescending(e => ((decimal)e.Correct / e.TotalNumber))
                      .ToList();
                    }

                    if (PolicyScores.Any())
                    {
                        PolicyScores =
                      PolicyScores.Where(e => e.TotalNumber > 0 && (e.Type.Contains("Policy") || e.Type.StartsWith("pTop")))
                      .OrderBy(e => e.Filter)
                      .ThenByDescending(e => e.RatingAvg)
                      .ThenByDescending(e => ((decimal)e.Correct / e.TotalNumber))
                      .ToList();
                    }

                    if (SearchScores.Any())
                    {
                        SearchScores =
                      SearchScores.Where(e => e.TotalNumber > 0 && e.Type.Contains("Search"))
                      .OrderBy(e => e.Filter)
                      .ThenByDescending(e => e.RatingAvg)
                      .ThenByDescending(e => ((decimal)e.Correct / e.TotalNumber))
                      .ToList();
                    }

                    if (SolveScores.Any())
                    {
                        SolveScores =
                      SolveScores.Where(e => e.TotalNumber > 0 && e.Type.Contains("Solve"))
                      .OrderBy(e => e.Filter)
                      .ThenByDescending(e => e.RatingAvg)
                      .ThenByDescending(e => ((decimal)e.Correct / e.TotalNumber))
                      .ToList();
                    }

                    // Auto-select first available tab
                    activeScoreTab = ActiveTabs.FirstOrDefault() ?? "Policy";
                });

                var normalized = outputFolder;
                // The folder is prepared at run start but can still vanish mid-run, and the
                // closing line must not claim success over a failure logged above it.
                var writeFailures = 0;
                void TryWrite(string what, Action action)
                {
                    try { action(); }
                    catch (Exception ex)
                    {
                        writeFailures++;
                        logger.LogError("Failed to write {What}: {Message}", what, ex.Message);
                    }
                }
                var table = CreateCombinedScoresTable(data.PuzzleFile);
                logger.LogInformation(table);
                if (normalized != "")
                {
                    var allScores = new List<Score>();
                    allScores.AddRange(PolicyScores);
                    allScores.AddRange(ValueScores);
                    allScores.AddRange(SearchScores);
                    allScores.AddRange(SolveScores);
                    var datePart = DateTime.Now.ToString("yyyy-MM-dd_HH-mm", System.Globalization.CultureInfo.InvariantCulture);
                    var fileName = Path.Combine(normalized, $"failedLichessPuzzles_{datePart}.epd");
                    TryWrite(fileName, () =>
                    {
                        using (StreamWriter sw = File.AppendText(fileName))
                        {
                            var boardBm = new Chess.Board();
                            var boardAm = new Chess.Board();
                            foreach (var item in allScores)
                            {
                                var nnSuffix = !string.IsNullOrEmpty(item.NeuralNet) ? $" (nn:{item.NeuralNet})" : "";
                                sw.WriteLine($"\n##Failed puzzles by {item.Engine}{nnSuffix} - overall performance: {item.PlayerRecord.Rating.ToString("F0")} - Type: {item.Type} - Theme: {item.Filter} - Nodes: {item.Nodes}\n");
                                var sorted = item.FailedPuzzles
                          .Select(tuple =>
                          {
                        var parts = tuple.Item2.Split(",");
                        if (parts.Length > 1 && double.TryParse(parts[0].Trim(), System.Globalization.NumberStyles.Float, System.Globalization.CultureInfo.InvariantCulture, out double value))
                            return (tuple.Item1, value, tuple.Item2);
                        return (tuple.Item1, tuple.Item1.Rating, tuple.Item2);
                    })
                          .OrderBy(tuple => tuple.Item2);

                                foreach (var puzzle in sorted)
                                {
                                    foreach (var cmd in puzzle.Item1.Commands)
                                    {
                                        if (!String.IsNullOrWhiteSpace(cmd.MovePlayed) && cmd.MovePlayed.Length >= 4)
                                        {
                                            boardBm.PlayCommands(cmd.Command);
                                            var fen = boardBm.FEN();
                                            var bm = ChessLibrary.PuzzleDataUtils.sanOfMovePlayed(
                                                boardBm, cmd.Command, cmd.CorrectMove);
                                            var aM = ChessLibrary.PuzzleDataUtils.sanOfMovePlayed(
                                                boardAm, cmd.Command, cmd.MovePlayed);
                                            var policies = puzzle.Item3.Split(",");
                                            var (bmP, amP) = policies.Length > 1 ? (policies[0].Trim(), policies[1].Trim()) : ("", "");
                                            var msg = $"{fen} bm {bm}; am {aM}; id \"Lichess id {puzzle.Item1.PuzzleId}, policy value for bestmove {bm}={bmP} and move played {aM}={amP}\"; other \"{cmd.CorrectMove},{cmd.MovePlayed}\"";
                                            sw.WriteLine(msg);
                                        }
                                    }
                                }
                            }
                        }
                    });

                    var csvFileName = Path.Combine(normalized, $"failedLichessPuzzles_{datePart}.csv");
                    TryWrite(csvFileName, () =>
                    {
                        var allFailed = allScores
                            .SelectMany(s => s.FailedPuzzles.Select(t => t.Item1))
                            .GroupBy(p => p.PuzzleId)
                            .Select(g => g.First())
                            .ToArray();
                        if (allFailed.Length > 0)
                        {
                            using var csvWriter = new StreamWriter(csvFileName);
                            csvWriter.WriteLine("PuzzleId,FEN,Moves,Rating,RatingDeviation,Popularity,NbPlays,Themes,GameUrl,OpeningTags");
                            foreach (var p in allFailed)
                            {
                                csvWriter.WriteLine($"{p.PuzzleId},{p.Fen},{p.Moves},{(int)p.Rating},{(int)p.RatingDeviation},{p.Popularity},{p.NbPlays},{p.Themes},{p.GameUrl},{p.OpeningTags}");
                            }
                            logger.LogInformation($"  Failed puzzles CSV ({allFailed.Length} unique): {csvFileName}");
                        }
                    });

                    var estCsvFileName = Path.Combine(normalized, $"estNodesHardest_{datePart}.csv");
                    TryWrite(estCsvFileName, () =>
                    {
                        var hardest = PolicyScores
                            .SelectMany(s => s.HardestByEstNodes)
                            .OrderByDescending(t => t.Item2)
                            .GroupBy(t => t.Item1.PuzzleId)
                            .Select(g => g.First())
                            .Take(50)
                            .ToArray();
                        if (hardest.Length > 0)
                        {
                            static string FormatEstNodes(double n) =>
                                n < 10.0 ? n.ToString("F2", System.Globalization.CultureInfo.InvariantCulture)
                                : n < 1000.0 ? n.ToString("F0", System.Globalization.CultureInfo.InvariantCulture)
                                : n < 1_000_000.0 ? (n / 1000.0).ToString("F1", System.Globalization.CultureInfo.InvariantCulture) + "k"
                                : (n / 1_000_000.0).ToString("F2", System.Globalization.CultureInfo.InvariantCulture) + "M";

                            using (var estWriter = new StreamWriter(estCsvFileName))
                            {
                                estWriter.WriteLine("PuzzleId,FEN,Moves,Rating,RatingDeviation,Popularity,NbPlays,Themes,GameUrl,OpeningTags");
                                foreach (var t in hardest)
                                {
                                    var p = t.Item1;
                                    estWriter.WriteLine($"{p.PuzzleId},{p.Fen},{p.Moves},{(int)p.Rating},{(int)p.RatingDeviation},{p.Popularity},{p.NbPlays},{p.Themes},{p.GameUrl},{p.OpeningTags}");
                                }
                            }
                            var hardestLog = new StringBuilder();
                            hardestLog.AppendLine($"  Hardest-by-EstNodes CSV (top {hardest.Length}, worst first): {estCsvFileName}");
                            hardestLog.AppendLine("  Top 10 worst-case candidates by estimated nodes to find the correct move:");
                            foreach (var t in hardest.Take(10))
                            {
                                var p = t.Item1;
                                hardestLog.AppendLine($"    {p.PuzzleId,-12}  rating {(int)p.Rating,4}  est {FormatEstNodes(t.Item2),-7}  {p.GameUrl}");
                            }
                            logger.LogInformation(hardestLog.ToString());
                        }
                    });

                    var allScoresForCross = PolicyScores.AsEnumerable()
                        .Concat(ValueScores)
                        .Concat(SearchScores)
                        .Concat(SolveScores);
                    TryWrite("cross-engine files", () =>
                        ChessLibrary.PuzzleCrossEngine.writeCrossEngineFiles(normalized, datePart, allScoresForCross));

                    // One order for the theme tables, the paired table and the JSON: A must
                    // mean the same net in all three or the same comparison reads with its
                    // sign flipped in one of them.
                    var engineNamesInConfigOrder = engineConfigs.Select(c => c.Item1.Name).ToList();

                    // Paired (McNemar) stats. Slice level keeps the solved/failed sets, so
                    // the discordant counts - and the tight test - are available here.
                    // Computed ONCE: the summary file renders it and the JSON embeds it.
                    // An empty result is normal - a single-net run has nothing to compare -
                    // so the outcome carries the failure flag separately.
                    var pairedOutcome = ChessLibrary.PuzzlePaired.outcomeOf(
                        FSharpList<ChessLibrary.PuzzlePaired.PairedComparison>.Empty);
                    var pairedSummary = "";
                    try
                    {
                        pairedOutcome = ChessLibrary.PuzzlePaired.outcomeOf(
                            ChessLibrary.PuzzlePaired.computeOrdered(
                                engineNamesInConfigOrder, allScoresForCross));
                    }
                    catch (Exception ex)
                    {
                        // counted like the theme block below: the summary file loses a
                        // section, so the run must not report itself as fully written
                        pairedOutcome = ChessLibrary.PuzzlePaired.failedOutcome;
                        writeFailures++;
                        logger.LogWarning($"Paired comparison failed: {ex.Message}");
                    }

                    // Rendering is a SEPARATE failure: losing the text table must not throw
                    // away comparisons that computed fine, nor mark them as a compute failure.
                    // The console splits these the same way.
                    try
                    {
                        pairedSummary = ChessLibrary.PuzzlePaired.render(pairedOutcome.Comparisons);
                    }
                    catch (Exception ex)
                    {
                        writeFailures++;
                        logger.LogWarning($"Paired table rendering failed: {ex.Message}");
                    }

                    // Same analysis and the same files as a console run - the two paths
                    // share one implementation so they cannot drift apart.
                    var themeSummary = "";
                    try
                    {
                        var themeOutput = ChessLibrary.PuzzleThemes.writeThemeFiles(
                            normalized, datePart,
                            engineNamesInConfigOrder,
                            allScoresForCross);
                        themeSummary = themeOutput.Summary;
                        // the tables live in the summary file; the log gets a pointer
                        if (themeSummary != "")
                        {
                            logger.LogInformation("Per-theme comparison. {Headline} Full tables: {Txt} All themes: {Csv}",
                                themeOutput.Headline,
                                Path.Combine(normalized, $"LichessSummary_{datePart}.txt"),
                                themeOutput.CsvPath);
                        }
                    }
                    catch (Exception ex)
                    {
                        writeFailures++;
                        logger.LogWarning($"Per-theme comparison failed: {ex.Message}");
                    }

                    // underscore matches the console naming; without it these files sort
                    // apart from console runs and no glob finds both
                    var tableFileName = Path.Combine(normalized, $"LichessSummary_{datePart}.txt");
                    TryWrite(tableFileName, () =>
                    {
                        using StreamWriter sw = new StreamWriter(tableFileName);
                        sw.WriteLine(table);
                        if (pairedSummary != "") sw.WriteLine(pairedSummary);
                        if (themeSummary != "") sw.WriteLine(themeSummary);
                    });

                    // The machine-readable twin, same basename. A console run writes this;
                    // without it here a GUI run is invisible to anything that reads results
                    // rather than looking at them. See Console/PuzzleJsonSchema.md.
                    var jsonFileName = Path.Combine(normalized, $"LichessSummary_{datePart}.json");
                    try
                    {
                        var result = PuzzleJsonOutput.buildResultWithPaired(
                            pairedOutcome,
                            data.PuzzleFile,
                            puzzles.Length,
                            data.SampleSize,
                            data.MinRating,
                            data.MaxRating,
                            data.PuzzleFilter,
                            data.RatingGroups,
                            runStartedUtc,
                            (DateTime.UtcNow - runStartedUtc).TotalSeconds,
                            allScoresForCross);
                        PuzzleJsonOutput.writeToFile(jsonFileName, result);
                    }
                    catch (Exception ex)
                    {
                        writeFailures++;
                        logger.LogWarning($"Failed to write JSON summary to {jsonFileName}: {ex.Message}");
                    }

                    if (writeFailures == 0)
                    {
                        logger.LogInformation("Result files written to {Folder}", normalized);
                    }
                    else
                    {
                        errorMessage = $"{writeFailures} output file(s) failed to write. Folder: {normalized}";
                        logger.LogError("{Count} output file(s) failed to write. Folder: {Folder}", writeFailures, normalized);
                    }
                }

                await Task.CompletedTask;
            }
            catch (OperationCanceledException)
            {
                logger.LogInformation("Puzzle tests cancelled by user");
            }
            catch (Exception ex)
            {
                logger.LogError("Lichess puzzle failed to start/run - ");
                logger.LogError(ex.Message);
            }

            finally
            {
                await InvokeAsync(() => disableRun = false);
            }

        });

        StateHasChanged();
        await Task.Delay(1000);

    }

    public async ValueTask DisposeAsync()
    {
        cts?.Cancel();
        cts?.Dispose();
        await ClearPreviousRunResourcesAsync();
        logger.LogInformation("Disposing LichessPuzzles component");
        await ValueTask.CompletedTask;
    }
}

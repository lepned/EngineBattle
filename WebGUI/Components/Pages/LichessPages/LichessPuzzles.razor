    private IEnumerable<Score> GetSortedScoreItems()
    {
        var items = TableScores.AsEnumerable();
        items = scoreSortColumn switch
        {
            "Engine" => scoreSortAscending ? items.OrderBy(x => x.Engine) : items.OrderByDescending(x => x.Engine),
            "NeuralNet" => scoreSortAscending ? items.OrderBy(x => x.NeuralNet) : items.OrderByDescending(x => x.NeuralNet),
            "Perf" => scoreSortAscending ? items.OrderBy(x => x.PlayerRecord.Rating) : items.OrderByDescending(x => x.PlayerRecord.Rating),
            "Accuracy" => scoreSortAscending ? items.OrderBy(x => x.TotalNumber > 0 ? (decimal)x.Correct / x.TotalNumber : -1) : items.OrderByDescending(x => x.TotalNumber > 0 ? (decimal)x.Correct / x.TotalNumber : -1),
            "Total" => scoreSortAscending ? items.OrderBy(x => x.TotalNumber) : items.OrderByDescending(x => x.TotalNumber),
            "AvgRating" => scoreSortAscending ? items.OrderBy(x => x.RatingAvg) : items.OrderByDescending(x => x.RatingAvg),
            "Type" => scoreSortAscending ? items.OrderBy(x => x.Type) : items.OrderByDescending(x => x.Type),
            "Theme" => scoreSortAscending ? items.OrderBy(x => x.Filter) : items.OrderByDescending(x => x.Filter),
            "Nodes" => scoreSortAscending ? items.OrderBy(x => x.Nodes) : items.OrderByDescending(x => x.Nodes),
            "AvgKLD" => scoreSortAscending ? items.OrderBy(x => x.AvgKLD) : items.OrderByDescending(x => x.AvgKLD),
            _ => items
        };
        return items;
    }


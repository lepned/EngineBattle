    private async void Update(Lichess update)
    {
        try
        {
            await InvokeAsync(() =>
            {
                switch (update)
                {
                    case Lichess.PuzzleResult pRes:
                        var res = pRes.Item;
                        if (res.Type.Contains("Policy") || res.Type.StartsWith("pTop"))
                            PolicyScores.Add(pRes.Item);
                        else if (res.Type.Contains("Value") || res.Type.StartsWith("vTop"))
                            ValueScores.Add(pRes.Item);
                        else if (res.Type == "Solve")
                            SolveScores.Add(pRes.Item);
                        else
                            SearchScores.Add(pRes.Item);

                        // Auto-select first tab with data
                        if (!ActiveTabs.Contains(activeScoreTab))
                            activeScoreTab = ActiveTabs.FirstOrDefault() ?? "Policy";
                        break;
                    case Lichess.Done msg:
                        progressProcessed = 0;
                        progressTotal = 0;
                        progressEngine = "";
                        break;
                    case Lichess.Progress prog:
                        progressProcessed = prog.Processed;
                        progressTotal = prog.Total;
                        progressEngine = prog.Label;
                        break;
                    case Lichess.LichessError err:
                        errorMessage = err.Item;
                        disableRun = false;
                        break;
                }
                StateHasChanged();
            });
        }
        catch (Exception ex)
        {
            logger.LogWarning("Update callback failed: {Message}", ex.Message);
        }
    }


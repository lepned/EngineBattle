@page "/boardtest"
@using WebGUI.Components.Layout.ChessboardLayout
@using ChessLibrary

<PageTitle>Native board test</PageTitle>

<h3 style="margin:16px 0 4px 0;">Native chessboard test page</h3>
<p style="margin:0 0 16px 0; opacity:0.8;">
    Exercises the native EbChessboard: position, theming, coordinates, overlay and click-to-move.
</p>

<div style="display:flex; flex-wrap:wrap; gap:24px; align-items:flex-start; margin-bottom:20px;">
    <fieldset style="border:1px solid #666; border-radius:6px; padding:10px 14px;">
        <legend>Position</legend>
        <div style="display:flex; gap:8px; margin-bottom:8px;">
            <button @onclick="SetStart">Start</button>
            <button @onclick="SetItalian">Italian (last move Bc5)</button>
            <button @onclick="SetEndgame">K+P endgame</button>
            <button @onclick="() => flipped = !flipped">Flip board</button>
        </div>
        <input style="width:420px;" @bind="fen" @bind:event="oninput" placeholder="FEN" />
        @{ var fenCheck = BoardUtils.validateFen(fen); }
        @if (!fenCheck.IsValid)
        {
            <div style="color:#e66; font-size:12px; margin-top:2px;">@string.Join("; ", fenCheck.Errors)</div>
        }
    </fieldset>

    <fieldset style="border:1px solid #666; border-radius:6px; padding:10px 14px;">
        <legend>Theme</legend>
        <label style="margin-right:12px;">Light <input type="color" @bind="lightColor" @bind:event="oninput" /></label>
        <label style="margin-right:12px;">Dark <input type="color" @bind="darkColor" @bind:event="oninput" /></label>
        <label style="margin-right:12px;">
            <input type="checkbox" @bind="showCoordinates" /> Coordinates
        </label>
        <label>
            Size <input type="range" min="120" max="640" step="20" @bind="sizePx" /> @sizePx px
        </label>
    </fieldset>

    <fieldset style="border:1px solid #666; border-radius:6px; padding:10px 14px;">
        <legend>Overlay (native board only)</legend>
        <label style="margin-right:12px;">
            <input type="checkbox" @bind="showArrowDemo" /> Engine arrows
        </label>
        <label>
            <input type="checkbox" @bind="showPolicyDemo" /> Policy circles + labels
        </label>
        <div style="opacity:0.7; margin-top:4px;">Best shown with the Italian position.</div>
    </fieldset>

    <fieldset style="border:1px solid #666; border-radius:6px; padding:10px 14px;">
        <legend>Insights (movegen)</legend>
        <label style="margin-right:12px;">
            <input type="checkbox" @bind="showInsights" /> Pins + checks
        </label>
        <label style="margin-right:12px;">
            <input type="checkbox" @bind="showDangerZone" /> King danger zone
        </label>
        <label style="margin-right:12px;">
            <input type="checkbox" @bind="showHanging" /> Hanging pieces
        </label>
        <label>
            <input type="checkbox" @bind="showTactics" /> Tactics
        </label>
        <div style="display:flex; gap:8px; margin-top:8px;">
            <button @onclick="SetRuyPin">Ruy pin</button>
            <button @onclick="SetCrossPin">Cross pin</button>
            <button @onclick="SetRookCheck">Rook check</button>
            <button @onclick="SetDoubleCheck">Double check</button>
        </div>
        <div style="opacity:0.7; margin-top:4px;">
            Orange: pin ray (attacker → pinned piece → king). Red: checker → king, faint dots = blocking squares.<br />
            Danger zone: red tint = king-adjacent squares the king may not step to, green dots = escape squares.<br />
            Amber: hanging piece (undefended or attacked by something cheaper), thin lines from its attackers.<br />
            Tactics — purple: fork (arrows to targets). Cyan: skewer / relative pin (attacker → front → back). Magenta: overloaded defender (lines to what it holds).<br />
            Teal: discovered attack (disc on the blocker, line slider → target). Burnt orange: removable defender (capture it, win what it defends).
        </div>
    </fieldset>
</div>

<div style="display:flex; flex-wrap:wrap; gap:32px; align-items:flex-start;">
    <div>
        <h4 style="margin:0 0 8px 0;">EbChessboard (native)</h4>
        <EbChessboard Fen="@fen" SizePx="@sizePx" Flipped="@flipped"
                      Animate="true" ShowCoordinates="@showCoordinates"
                      LightSquareColor="@lightColor" DarkSquareColor="@darkColor"
                      LastMoveFrom="@lastFrom" LastMoveTo="@lastTo"
                      SelectedSquare="@selectedSquare"
                      Arrows="@AllArrows" Circles="@AllCircles" Labels="@DemoLabels"
                      OnSquareClicked="OnSquareClicked" />
        <p style="margin-top:8px; min-height:1.2em;">
            @(selectedSquare is not null
                ? $"Selected {selectedSquare} — click a target square to move"
                : "Click a piece, then a target square, to move it (free move, no legality check yet)")
        </p>
        @if (showInsights || showDangerZone || showHanging || showTactics)
        {
            <p style="margin-top:4px; min-height:1.2em; opacity:0.85;">@InsightsSummary</p>
        }
    </div>
</div>

@code {
    private const string StartFen = EbChessboard.StartFen;
    private const string ItalianFen = "r1bqk1nr/pppp1ppp/2n5/2b1p3/2B1P3/5N2/PPPP1PPP/RNBQK2R w KQkq - 4 4";
    private const string EndgameFen = "8/8/4k3/8/2K5/8/4P3/8 w - - 0 1";

    private string fen = StartFen;
    private string lastFrom;
    private string lastTo;
    private bool flipped;
    private bool showCoordinates = true;
    private int sizePx = 400;
    private string lightColor = "#B1D8DB";
    private string darkColor = "#619EB3";
    private string selectedSquare;
    private bool showArrowDemo;
    private bool showPolicyDemo;

    // Mirrors the real EB use cases: green best-move arrow, grey ponder arrow
    // (StreamingChessboard), and policy-head circles with percentage chips
    // (ModernChessboard's addPolicyCircles).
    private IReadOnlyList<EbArrow> DemoArrows => showArrowDemo
        ? new[]
        {
            new EbArrow("f3", "g5", "#15781B"),
            new EbArrow("d8", "f6", "#9D8989", 0.6, 0.7),
        }
        : Array.Empty<EbArrow>();

    private IReadOnlyList<EbCircle> DemoCircles => showPolicyDemo
        ? new[]
        {
            new EbCircle("g5", "#3c3c3c", 0.5, 0.5),
            new EbCircle("d4", "#3c3c3c", 0.35, 0.5),
        }
        : Array.Empty<EbCircle>();

    private IReadOnlyList<EbSquareLabel> DemoLabels => showPolicyDemo
        ? new[]
        {
            new EbSquareLabel("g5", "42%"),
            new EbSquareLabel("d4", "27%"),
            new EbSquareLabel("c3", "12%"),
        }
        : Array.Empty<EbSquareLabel>();

    private void SetStart() { fen = StartFen; lastFrom = lastTo = selectedSquare = null; }
    private void SetItalian() { fen = ItalianFen; lastFrom = "f8"; lastTo = "c5"; selectedSquare = null; }
    private void SetEndgame() { fen = EndgameFen; lastFrom = lastTo = selectedSquare = null; }

    // ------------------------------------------------------------------
    // Movegen insights (pins + checks) via BoardUtils.getPositionInsights,
    // derived from the same LegalityContext the legal move generator uses.
    // ------------------------------------------------------------------
    private const string RuyPinFen = "r1bqkbnr/ppp2ppp/2np4/1B2p3/4P3/5N2/PPPP1PPP/RNBQK2R w KQkq - 0 4";
    private const string CrossPinFen = "4k3/4r3/8/8/4Q3/8/8/4K3 w - - 0 1";
    private const string RookCheckFen = "R3k3/8/8/8/8/8/8/4K3 b - - 0 1";
    private const string DoubleCheckFen = "4k3/8/8/1B6/8/8/8/4R1K1 b - - 0 1";

    private bool showInsights;
    private bool showDangerZone;
    private bool showHanging;
    private bool showTactics;
    private string insightsFen;
    private BoardUtils.PositionInsights cachedInsights;

    private void SetRuyPin() { fen = RuyPinFen; lastFrom = lastTo = selectedSquare = null; showInsights = true; }
    private void SetCrossPin() { fen = CrossPinFen; lastFrom = lastTo = selectedSquare = null; showInsights = true; }
    private void SetRookCheck() { fen = RookCheckFen; lastFrom = lastTo = selectedSquare = null; showInsights = true; }
    private void SetDoubleCheck() { fen = DoubleCheckFen; lastFrom = lastTo = selectedSquare = null; showInsights = true; }

    // Computation is microseconds, but the FEN input rerenders per keystroke — cache
    // by FEN and swallow parse errors while the user is mid-edit.
    private BoardUtils.PositionInsights Insights
    {
        get
        {
            if (!showInsights && !showDangerZone && !showHanging && !showTactics) return null;
            if (fen != insightsFen)
            {
                insightsFen = fen;
                try { cachedInsights = BoardUtils.getPositionInsights(fen); }
                catch { cachedInsights = null; }
            }
            return cachedInsights;
        }
    }

    private IReadOnlyList<EbArrow> AllArrows
    {
        get
        {
            var list = new List<EbArrow>(DemoArrows);
            list.AddRange(InsightShapes.Arrows(Insights, showInsights, showHanging, showTactics));
            return list;
        }
    }

    private IReadOnlyList<EbCircle> AllCircles
    {
        get
        {
            var list = new List<EbCircle>(DemoCircles);
            list.AddRange(InsightShapes.Circles(Insights, showInsights, showDangerZone, showHanging, showTactics));
            return list;
        }
    }

    private string InsightsSummary
    {
        get
        {
            var ins = Insights;
            if (ins == null) return "Insights: (invalid FEN)";
            var parts = new List<string>();
            foreach (var (side, name) in new[] { (ins.White, "White"), (ins.Black, "Black") })
            {
                if (showInsights)
                {
                    foreach (var pin in side.Pins)
                        parts.Add($"{name} {pin.Pinned} pinned by {pin.Attacker}");
                    if (side.InCheck)
                        parts.Add($"{name} in check from {string.Join(", ", side.Checkers)}"
                                  + (side.CheckBlockSquares.Length > 0 ? $" (block: {string.Join(", ", side.CheckBlockSquares)})" : ""));
                }
                if (showDangerZone)
                    parts.Add($"{name} K{side.King} escapes: "
                              + (side.KingEscapeSquares.Length > 0 ? string.Join(", ", side.KingEscapeSquares) : "none"));
                if (showHanging)
                    foreach (var h in side.HangingPieces)
                        parts.Add($"{name} {h.Square} hanging (attackers: {string.Join(", ", h.Attackers)})");
                if (showTactics)
                {
                    foreach (var f in side.Forks)
                        parts.Add($"{name} {f.Forker} forks {string.Join(", ", f.Targets)}");
                    foreach (var s in side.Skewers)
                        parts.Add($"{name} {s.Attacker} {(s.Kind == "skewer" ? "skewers" : "pins")} {s.Front} (behind: {s.Back})");
                    foreach (var o in side.OverloadedDefenders)
                        parts.Add($"{name} {o.Defender} overloaded: {string.Join(", ", o.Defends)}");
                    foreach (var d in side.DiscoveredAttacks)
                        parts.Add($"{name} {d.Slider} discovered vs {d.Target} (blocker {d.Blocker}{(d.IsCheck ? ", check" : "")})");
                    foreach (var r in side.RemovableDefenders)
                        parts.Add($"{name} can remove {r.Defender} (defends: {string.Join(", ", r.Defends)})");
                }
            }
            return parts.Count > 0 ? "Insights: " + string.Join(" · ", parts) : "Insights: no pins or checks";
        }
    }

    // Click-to-move: first click selects a piece, second click moves it.
    // Free movement for now — legality wiring against ChessLibrary comes with the
    // ModernChessboard migration.
    private void OnSquareClicked(string square)
    {
        var board = ParsePlacement(fen);
        if (selectedSquare is null)
        {
            if (board[SquareIndex(square)] != default) selectedSquare = square;
            return;
        }
        if (square == selectedSquare)
        {
            selectedSquare = null;
            return;
        }
        board[SquareIndex(square)] = board[SquareIndex(selectedSquare)];
        board[SquareIndex(selectedSquare)] = default;
        fen = BuildFen(board, fen);
        lastFrom = selectedSquare;
        lastTo = square;
        selectedSquare = null;
    }

    private static int SquareIndex(string sq) => (sq[1] - '1') * 8 + (sq[0] - 'a');

    private static char[] ParsePlacement(string fen)
    {
        var b = new char[64];
        var rows = fen.Split(' ')[0].Split('/');
        if (rows.Length != 8) return b;
        for (int i = 0; i < 8; i++)
        {
            int rank = 7 - i, file = 0;
            foreach (var c in rows[i])
            {
                if (char.IsDigit(c)) file += c - '0';
                else if (file < 8) b[rank * 8 + file++] = c;
            }
        }
        return b;
    }

    private static string BuildFen(char[] board, string originalFen)
    {
        var sb = new System.Text.StringBuilder();
        for (int rank = 7; rank >= 0; rank--)
        {
            int empty = 0;
            for (int file = 0; file < 8; file++)
            {
                var piece = board[rank * 8 + file];
                if (piece == default) { empty++; continue; }
                if (empty > 0) { sb.Append(empty); empty = 0; }
                sb.Append(piece);
            }
            if (empty > 0) sb.Append(empty);
            if (rank > 0) sb.Append('/');
        }
        var rest = originalFen.Split(' ', 2);
        return rest.Length > 1 ? $"{sb} {rest[1]}" : sb.ToString();
    }

}

@page "/tournament-shortcuts"
@page "/tournyShortcuts"

<PageTitle>Tournament Shortcuts</PageTitle>

<div class="tool-page">
	<h1>Tournament Shortcuts</h1>
	<div class="tool-subtitle">Keyboard shortcuts for tournament mode</div>

	<div class="tool-table-container" style="max-width:550px">
		<table class="tool-table">
			<thead>
				<tr>
					<th>Shortcut</th>
					<th>Description</th>
				</tr>
			</thead>
			<tbody>
				@foreach ((string key, string desc) in rows)
				{
					<tr>
						<td><kbd>@key</kbd></td>
						<td>@desc</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

@code {

	(string, string)[] rows = {
		("Ctrl + V", "Validate tournament config"),
		("Ctrl + R", "Run tournament"),
		("Ctrl + C", "Stop tournament"),
		("Ctrl + U", "Refresh tournament view"),
		("Ctrl + P", "Generate crosstable"),
		("Ctrl + Alt + W", "Adjudicate: White wins"),
		("Ctrl + Alt + B", "Adjudicate: Black wins"),
		("Ctrl + Alt + D", "Adjudicate: Draw"),
	};

	protected override Task OnInitializedAsync()
	{
		return base.OnInitializedAsync();
	}

}

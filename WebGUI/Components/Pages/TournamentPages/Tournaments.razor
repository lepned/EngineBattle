@page "/tournament"
@page "/tournament-feed"
@using System.Linq
@using WebGUI.Components.Pages.Experimental
@using WebGUI.Components.Pages
@using WebGUI.Components.Layout
@using System.Diagnostics
@using WebGUI.Plotting
@using WebGUI.Services
@using Toolbelt.Blazor.HotKeys2
@using WebGUI.Components.Layout.TournamentLayout
@using WebGUI.Components.Layout.CrosstableLayout
@using WebGUI.Components.Layout.ChessboardLayout
@using System.Text.Json

@implements IAsyncDisposable
@inject IJSRuntime JS
@inject JavaScriptInteropService JsInteropService
@inject IDialogService DialogService
@inject NotifierService Notifier
@inject ILogger<Tournaments> logger
@inject HotKeys HotKeys
@inject ShutdownTokenProvider shutdownTokenProvider
@inject IWebHostEnvironment Environment
@inject OpeningExplorerService openingExplorer
@inject TournamentService TournamentSvc
@inject JsonFeedService JsonFeedSvc
@inject LiveFeedReplayer Replayer
@inject NavigationManager Nav
@inject GlobalSettingsService SettingsService
@inject ISnackbar Snackbar


<PageTitle> Tournament page </PageTitle>

@if (!string.IsNullOrEmpty(tournamentLoadError))
{
	<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-5">
		<MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
			<MudText Typo="Typo.h6" Class="mb-2">Failed to load tournament.json</MudText>
			<MudText Style="white-space: pre-line;">@tournamentLoadError</MudText>
		</MudAlert>
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/tools/tournament-creator"
				   StartIcon="@Icons.Material.Filled.PostAdd">
			Open Tournament Creator
		</MudButton>
	</MudContainer>
	return;
}

@* A tournament.json that parsed but names no engines is not a failure - it is every fresh
   installation. This is the way in, in the order the documentation walks it. *@
@if (firstRun)
{
	<MudContainer MaxWidth="MaxWidth.Medium" Class="mt-5">
		<MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mb-4">
			<MudText Typo="Typo.h6" Class="mb-2">No engines yet</MudText>
			<MudText Class="mb-2">
				EngineBattle plays chess engines against each other, so the first thing it needs is
				at least two engine definitions: a small JSON file each, pointing at an engine you
				already have on this machine (Stockfish, Lc0, Ceres, ...).
			</MudText>
			<MudText>
				1. Create an engine definition for each engine.<br />
				2. Set up the tournament: which engines, time control, openings.<br />
				3. Come back here and press Start.
			</MudText>
		</MudAlert>
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/tools/engine-creator"
				   StartIcon="@Icons.Material.Filled.Memory" Class="mr-2 mb-2">1. Engine definitions</MudButton>
		<MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/tools/tournament-creator"
				   StartIcon="@Icons.Material.Filled.PostAdd" Class="mr-2 mb-2">2. Tournament setup</MudButton>
		<MudButton Variant="Variant.Outlined" Href="/docs"
				   StartIcon="@Icons.Material.Filled.MenuBook" Class="mb-2">Documentation</MudButton>
	</MudContainer>
	return;
}

<div class="main-screen" id="tournamentPage">

	@* Every size on this page, set where you are when you notice that a table is too small to
	   read or too crowded to fit, and remembered for this screen - nobody has to open a file.
	   Invisible until the pointer comes for the corner, the way the drawer toggle is: this is a
	   broadcast layout, and a control that sits on screen permanently is a control in the
	   picture. *@
	<div class="eb-fontscale" aria-label="Page size controls">
		<div class="eb-fontscale-row">
			<span class="eb-fontscale-label">Text</span>
			<button type="button" title="Smaller table text (Ctrl + Alt + -)"
					@onclick="@(() => NudgeFontScale(-5))">A&minus;</button>
			<span class="eb-fontscale-value">@fontScalePct%</span>
			<button type="button" title="Larger table text (Ctrl + Alt + +)"
					@onclick="@(() => NudgeFontScale(5))">A+</button>
		</div>

		@* The PV boards are the first thing with nowhere to go once several games share the
		   screen, so the choice belongs next to the text size rather than in a config file. *@
		<div class="eb-fontscale-row">
			<span class="eb-fontscale-label">PV</span>
			@foreach (var (mode, label, tip) in PvBoardChoices)
			{
				<button type="button" title="@tip" class="@(PvBoardMode == mode ? "is-on" : "")"
						@onclick="@(() => SetPvBoard(mode))">@label</button>
			}
		</div>

		@* Chart height, on the same terms as the text. Seven charts can share that column, so
		   how much room each gets is a screen decision rather than a tournament one. *@
		<div class="eb-fontscale-row">
			<span class="eb-fontscale-label">Chart</span>
			<button type="button" title="Shorter charts"
					@onclick="@(() => NudgeChartScale(-10))">&minus;</button>
			<span class="eb-fontscale-value">@chartScalePct%</span>
			<button type="button" title="Taller charts"
					@onclick="@(() => NudgeChartScale(10))">+</button>
		</div>

		@* Which charts. The same four that tournament.json can name, as toggles, per screen. *@
		<div class="eb-fontscale-row">
			<span class="eb-fontscale-label">Show</span>
			<button type="button" title="Evaluation chart" class="@(layoutOptions.Charts.ShowEval ? "is-on" : "")"
					@onclick="@(() => ToggleChart("eval"))">Eval</button>
			<button type="button" title="Nodes per second chart" class="@(layoutOptions.Charts.ShowNPS ? "is-on" : "")"
					@onclick="@(() => ToggleChart("nps"))">NPS</button>
			<button type="button" title="Time usage chart" class="@(layoutOptions.Charts.ShowTime ? "is-on" : "")"
					@onclick="@(() => ToggleChart("time"))">Time</button>
			<button type="button" title="Nodes per move chart" class="@(layoutOptions.Charts.ShowNodes ? "is-on" : "")"
					@onclick="@(() => ToggleChart("nodes"))">Nodes</button>
		</div>

		<div class="eb-fontscale-row">
		<button type="button" class="eb-fontscale-reset" title="Forget everything this screen chose - text, PV boards, charts, panels - and go back to the defaults (Ctrl + Alt + 0)"
				@onclick="ResetToConfiguredLayout">reset</button>
		@* Any time, feed view included: it writes only this screen's settings, and a viewer
		   sizing someone else's tournament for their own monitor is exactly what it is for. *@
		<button type="button" class="eb-fontscale-reset" title="Make the sizes on screen this screen's own - the nudge goes back to 100% and Appearance shows these numbers"
				@onclick="SaveAsBaseline">save</button>
		</div>
	</div>

	<div class="rhs lhs infoB">

		@* Two headers while the new one is being proven on real broadcasts — switchable on
		   /appearance, and the old one goes once it has been. Both read the same
		   InfoBannerInfo; the fields the new one adds are simply ignored by the old. *@
		@if (SettingsService.Settings.UseNewTournamentBanner)
		{
			@* The dot follows the running-game marker the banner already carries, rather
			   than a flag that would only ever say "yes". *@
			<TournamentBanner FontSize="@FontCeiling(FontKey.Banner)" R3="@r3" TB="TB"
							  Move50="move50" DrawP="DrawP" Info="infoBannerInfo"
							  IsLive="@(infoBannerInfo?.ResultTxt?.Trim() == "*")"
							  WinRule="@WinRuleToken" WinRuleText="@WinRuleText"
							  DrawRule="@DrawRuleToken" DrawRuleText="@DrawRuleText" />
		}
		else
		{
			<InfoBanner FontSize="@FontCeiling(FontKey.Banner)" R3="@r3" TB="TB"
						Move50="move50" DrawP="DrawP" Info="infoBannerInfo" WidthFit="@bannerFit.Value" />
		}
	</div>

	<MudGrid Class="pl-3 justify-content-between">

		<MudItem sm="12" md="4" lg="4" Class="@SideColumnClass">

			@* Same switch as the header above: a fallback should restore a page that has
			   actually been in service, not a half-new one. It sits out here rather than
			   inside the lg="1" spacers because those are the old layout — a percentage
			   gutter that moved with the window. The deck sets its own inset in CSS. *@
			@if (SettingsService.Settings.UseNewTournamentBanner)
			{
				<MudItem Class="lhs mb-3" lg="12">
					<TournamentSummary Name="@tournament?.Name" Mode="@ModeBadge" Pairing="@PairingBadge"
									   Description="@tournament?.Description" Setup="@SetupLine"
									   FontSize="@FontCeiling(FontKey.Description)" />
				</MudItem>
			}
			else
			{
				<MudItem Class="lhs mb-3 d-flex eb-desc-row" lg="12">
					<MudItem lg="1">
					</MudItem>
					<MudItem lg="10">
						<MudText Class="mt-4" Typo="Typo.h6">@tournament?.Name</MudText>
						<MudText Class="pl-3 eb-scale eb-text eb-g-description" Style=@descriptionStyle>@tournament?.Description</MudText>
						<MudPaper>
							<ul class="pt-4 pb-4" style="list-style-type: disc; list-style-position:inside;">
								<li class="eb-scale eb-text eb-g-description" style=@descriptionStyle title="@(Gauntlet)">@Gauntlet</li>
								<li class="eb-scale eb-text eb-g-description" style=@descriptionStyle title="@(GetOpening())">@(GetOpening())</li>
								<li class="eb-scale eb-text eb-g-description" style=@descriptionStyle title="@(GetWin())">@(GetWin())</li>
								<li class="eb-scale eb-text eb-g-description" style=@descriptionStyle title="@(GetDraw())">@(GetDraw())</li>
							</ul>
						</MudPaper>
					</MudItem>
					<MudItem lg="1">
					</MudItem>
				</MudItem>
			}
			<MudItem>
				<div class="lhs">

					<EngineStatsModern @ref="engineStats"
								 Engine1Logo="@whiteEngineLogo"
								 Engine1Name="@whitePlayer"
								 Engine2Logo="@blackEngineLogo"
								 Engine2Name="@blackPlayer"
								 Engine1Version="@WhiteEngineConfig.Version"
								 Engine2Version="@BlackEngineConfig.Version"
								 Engine1TimeLeft="@whiteTime"
								 Engine1TimePerMove="@whiteMoveTime"
								 Engine2TimeLeft="@blackTime"
								 Engine2TimePerMove="@blackMoveTime"
								 Engine1="Engine1"
								 Engine2="Engine2"
								 Engine1Config="@WhiteEngineConfig"
								 Engine2Config="@BlackEngineConfig"
								 Engine1ToMove="whiteToMove"
								 ShowPV="@showPVBoard"
								 ShowCompletePV="showCompletePV"
								 FontSize="@FontCeiling(FontKey.EnginePanel)"
								 IsFRC=@tournament.IsChess960
								 MainLogoFileName="@tournament.MainLogoFileName"
								 LogoSize="@layoutOptions.Sizes.LogoSize"
								 MainLogoSize="@layoutOptions.Sizes.MainLogoSize"
								 WhiteMoveAndFen="WhiteMoveAndFen"
								 BlackMoveAndFen="BlackMoveAndFen"
								 PvBoardSizePx="@PvBoardSizePx" />

				</div>

		@if (layoutOptions.CrosstableWithStandings.IsBelow)
		{
			<div class="standingTable">
				@if (IsCupMode)
				{
					<CupCyclingView FontSize="@FontCeiling(FontKey.Standings)" StandingsWidthFit="@standingsFit.Value" Height=@height
									CycleSeconds=@layoutOptions.AutoCycleTimeInSec ShouldCycle="@(layoutOptions.AutoCycleTimeInSec > 0)"
									WhitePlayer="@whitePlayer" BlackPlayer="@blackPlayer"
									ScoreTable=@scoreTable ShowNPM=@layoutOptions.UseNPM />
				}
				else if (IsLadderMode)
				{
					<LadderCyclingView FontSize="@FontCeiling(FontKey.Standings)" StandingsWidthFit="@standingsFit.Value" Height=@height
									   CycleSeconds=@layoutOptions.AutoCycleTimeInSec ShouldCycle="@(layoutOptions.AutoCycleTimeInSec > 0)"
									   WhitePlayer="@whitePlayer" BlackPlayer="@blackPlayer"
									   ScoreTable=@scoreTable ShowNPM=@layoutOptions.UseNPM />
				}
				else
				{
					<Standings FontSize="@FontCeiling(FontKey.Standings)" WidthFit="@standingsFit.Value" ScoreTable="scoreTable" ShowNPM=@layoutOptions.UseNPM
							   Height="height" CycleSeconds=@layoutOptions.AutoCycleTimeInSec ShouldCycle=shouldCycle />
				}
			</div>
			@if (!IsCupMode && !IsLadderMode)
			{
				@* It shares the column with the standings box above it, so it takes a cap of its
				   own. Without one it grew to its natural height and left standings the crumbs. *@
				<CrossTableSummary FontSize="@FontCeiling(FontKey.Crosstable)" CrossTable="table"
								   WidthFit="@crosstableFit.Value" Height="@crosstableHeight" />
			}
		}


		@if (!layoutOptions.CrosstableWithStandings.IsBelow)
		{
			@if (layoutOptions.CrosstableWithStandings.IsCycle)
			{
				@if (IsCupMode)
				{
					<div class="standingTable">
						<CupCyclingView FontSize="@FontCeiling(FontKey.Standings)" StandingsWidthFit="@standingsFit.Value" Height=@height
										CycleSeconds=@layoutOptions.AutoCycleTimeInSec ShouldCycle="@(layoutOptions.AutoCycleTimeInSec > 0)"
										WhitePlayer="@whitePlayer" BlackPlayer="@blackPlayer"
										ScoreTable=@scoreTable ShowNPM=@layoutOptions.UseNPM />
					</div>
				}
				else if (IsLadderMode)
				{
					<div class="standingTable">
						<LadderCyclingView FontSize="@FontCeiling(FontKey.Standings)" StandingsWidthFit="@standingsFit.Value" Height=@height
										   CycleSeconds=@layoutOptions.AutoCycleTimeInSec ShouldCycle="@(layoutOptions.AutoCycleTimeInSec > 0)"
										   WhitePlayer="@whitePlayer" BlackPlayer="@blackPlayer"
										   ScoreTable=@scoreTable ShowNPM=@layoutOptions.UseNPM />
					</div>
				}
				else
				{
					<div class="standingTable">
						<CyclingStandingTables CrossTable="table" Height="height" StandingsWidthFit="@standingsFit.Value" CrosstableWidthFit="@crosstableFit.Value" CycleSeconds=@layoutOptions.AutoCycleTimeInSec FontSizeStandings="@FontCeiling(FontKey.Standings)" ShowNPM=@layoutOptions.UseNPM ScoreTable="scoreTable" FontSizeCross="@FontCeiling(FontKey.Crosstable)" />
					</div>
				}

			}
			else
			{
				<div class="standingTable">
					@if (IsCupMode)
					{
						<CupCyclingView FontSize="@FontCeiling(FontKey.Standings)" StandingsWidthFit="@standingsFit.Value" Height=@height
										CycleSeconds=@layoutOptions.AutoCycleTimeInSec ShouldCycle="@(layoutOptions.AutoCycleTimeInSec > 0)"
										WhitePlayer="@whitePlayer" BlackPlayer="@blackPlayer"
										ScoreTable=@scoreTable ShowNPM=@layoutOptions.UseNPM />
					}
					else if (IsLadderMode)
					{
						<LadderCyclingView FontSize="@FontCeiling(FontKey.Standings)" StandingsWidthFit="@standingsFit.Value" Height=@height
										   CycleSeconds=@layoutOptions.AutoCycleTimeInSec ShouldCycle="@(layoutOptions.AutoCycleTimeInSec > 0)"
										   WhitePlayer="@whitePlayer" BlackPlayer="@blackPlayer"
										   ScoreTable=@scoreTable ShowNPM=@layoutOptions.UseNPM />
					}
					else
					{
						<Standings FontSize="@FontCeiling(FontKey.Standings)" WidthFit="@standingsFit.Value" ScoreTable="scoreTable" ShowNPM=@layoutOptions.UseNPM
								   Height="height" CycleSeconds=@layoutOptions.AutoCycleTimeInSec ShouldCycle=shouldCycle />
					}
				</div>
			}
		}


				<MudSpacer></MudSpacer>
			</MudItem>


			@if (swapTables == false)
			{
				<div>
					<CyclingTables Results="@results"
								   Pairings="@pairings"
								   FontSizePairing="@FontCeiling(FontKey.Pairings)"
								   FontSizeLatestGames="@FontCeiling(FontKey.Latest)"
								   TableHeight=@pairingTableHeight
								   CycleSeconds=@layoutOptions.AutoCycleTimeInSec
								   HeaderSuffix="@swissRoundLabel" />
				</div>
			}

		</MudItem>

		@* The board column follows the board's chosen width (see BoardColumnStyle); the two
		   side columns then share whatever is left. Both are inert until a size is set. *@
		<MudItem Class="@($"mt-5 {BoardColumnClass}")" Style="@BoardColumnStyle"
				 sm="12" md="4" lg="4" xl="4" xxl="4">
			<StreamingChessboard @ref="streamingBoard" ShowMoveList=true OpeningMoves="@openingMoves" MoveListHeight=@moveListHeight
								 MoveHistory="@moveHistory" OpeningName="@currentOpeningInPlay" MoveListFontSize="@FontCeiling(FontKey.MoveList)"
								 OpeningSansForDeviation="@openingSansForDeviation"
								 ReferenceSansForDeviation="@referenceSansForDeviation"
								 ShowCopyFen="@FeedMode"
								 ShowEvalBar="@SettingsService.Settings.ShowEvalBar"
								 ShowSizeSlider="true"
								 OnBoardSizeChanged="OnBoardSizeChanged"
								 EvalCp="@tournamentEvalCp" EvalMate="@tournamentEvalMate">
			</StreamingChessboard>
			<div>
				<div style=@pvStyleBlack class="pv-black-box pv eb-scale eb-g-pv">
					<span>@blackBefore </span>
					<span class="pv-deviation-black">@blackPVda </span>
					<span>@blackRest </span>
				</div>
				<div style=@pvStyleWhite class="pv-white-box pv eb-scale eb-g-pv">
					<span>@whiteBefore </span>
					<span class="pv-deviation-white">@whitePVda </span>
					<span>@whiteRest </span>
				</div>
			</div>

		</MudItem>

		<MudItem sm="12" md="4" lg="4" Class="@SideColumnClass">

			<MudItem hidden="@(!runWithLogLiveStats)" Class="my-5">
				<div style=@liveChartStyle class="chart rhs" @ref=livePlotReference></div>
			</MudItem>
			<MudItem hidden="@(!runWithLogLiveStats)" Class="my-5">
				<div style=@liveChartStyle class="chart rhs" @ref=liveQPlotReference></div>
			</MudItem>

			<MudItem hidden="@(!ShowEval())" Class="my-5">
				<div style=@moveChartStyle class="chart rhs" @ref=evalChart></div>
			</MudItem>
			<MudItem hidden="@(!ShowTime())" Class="my-5">
				<div style=@moveChartStyle class="chart rhs" @ref=timeUsageChart></div>
			</MudItem>
			<MudItem hidden="@(!ShowNpsSpeedChart())" Class="my-5">
				<div style=@moveChartStyle class="chart rhs" @ref=npsChart></div>
			</MudItem>
			<MudItem hidden="@(!ShowEpsSpeedChart())" Class="my-5">
				<div style=@moveChartStyle class="chart rhs" @ref=epsChart></div>
			</MudItem>
			<MudItem hidden="@(!ShowNodes())" Class="my-5">
				<div style=@moveChartStyle class="chart rhs" @ref=nodesChart></div>
			</MudItem>

			@if (swapTables)
			{
				<div id="cycleTable">
					<CyclingTables Results="@results"
								   Pairings="@pairings"
								   FontSizePairing="@FontCeiling(FontKey.Pairings)"
								   FontSizeLatestGames="@FontCeiling(FontKey.Latest)"
								   TableHeight=@pairingTableHeight
								   CycleSeconds=@layoutOptions.AutoCycleTimeInSec
								   HeaderSuffix="@swissRoundLabel" />
				</div>
			}

		</MudItem>
	</MudGrid>
</div>

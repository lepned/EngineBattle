		else if (action.Equals("resume", StringComparison.OrdinalIgnoreCase))
		{
			ChessLibrary.Tournament.Manager.setCupResumeRequested(true);
		}
		else
		{
			ChessLibrary.Tournament.Manager.setCupResumeRequested(false);
		}

		return true;
	}


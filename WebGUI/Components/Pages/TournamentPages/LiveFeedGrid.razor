@page "/tournament-grid"
@using WebGUI.Services
@using WebGUI.Components.Layout.TournamentLayout
@using WebGUI.Components.Layout.ChessboardLayout
@using ChessLibrary
@using static ChessLibrary.PGNTypes
@using static ChessLibrary.MiscTypes
@implements IDisposable
@inject JsonFeedService JsonFeedSvc
@inject LiveFeedReplayer Replayer
@inject WebGUI.Services.Ceres.CeresFeedBridge CeresBridge
@inject NavigationManager Nav
@inject Microsoft.JSInterop.IJSRuntime JS
@inject GlobalSettingsService SettingsService

<PageTitle>Live games grid</PageTitle>

<div class="grid-header">
    <h3>@tournamentName</h3>
    <span class="count">@games.Count game(s)</span>
    @if (tournamentComplete) { <span class="done-badge" title="The tournament has finished (EndOfTournament received)">✔ Completed</span> }
    @if (!string.IsNullOrEmpty(machine)) { <span class="hdr-meta" title="Host machine">@machine</span> }
    @if (!string.IsNullOrEmpty(timeControl)) { <span class="hdr-meta" title="Time control">@timeControl</span> }
    <button class="reset-btn" @onclick="ResetAll" title="Clear standings and boards for a fresh tournament">Reset</button>
    <span class="ceres-connect">
        <input type="text" placeholder="Ceres host:port (e.g. 192.168.0.50:7440)" @bind="ceresHostPort" />
        @if (!CeresBridge.IsConnected)
        {
            <button @onclick="ConnectCeres">Connect</button>
        }
        else
        {
            <button @onclick="DisconnectCeres">Disconnect</button>
        }
        <span class="ceres-status">@CeresBridge.Status</span>
    </span>
</div>

@if (!string.IsNullOrEmpty(lanUrl))
{
    <div class="lan-url">
        <span class="lan-label">Watch from another device (same Wi‑Fi):</span>
        <a href="@lanUrl" target="_blank">@lanUrl</a>
        <button class="copy-btn" @onclick="CopyLanUrl" title="Copy URL">Copy</button>
    </div>
}

@{
    List<GameVM> tiles;
    List<PlayerResult> table;
    string pento;
    int pentoCovered, resultCount;
    Dictionary<string, (string nodes, string nps, string eps, string time)> spd;
    Dictionary<(string, string), (int w, int d, int l)> cross;
    lock (sync)
    {
        tiles = games.Values.OrderBy(x => x.GameId, StringComparer.Ordinal).ToList();
        table = standings.OrderByDescending(x => x.Points).ThenByDescending(x => x.Elo).ToList();
        cross = BuildCrosstable(results);
        pento = pentoLine;
        pentoCovered = pentoGames.Count;   // games we paired live (by opening hash)
        resultCount = results.Count;       // all games in standings (incl. global catch-up)
        // Per-engine average speed (nodes/move, nps, eps) + total think time for the standings columns.
        spd = speed.ToDictionary(kv => kv.Key, kv =>
        {
            var v = kv.Value;
            if (v.N == 0) return ("", "", "", "");
            return (Kfmt((double)v.Nodes / v.N), Kfmt(v.Nps / v.N), v.Eps > 0 ? Kfmt(v.Eps / v.N) : "", FmtDuration(v.Time));
        });
    }
    // Pentanomial pairs by opening hash, which only the live per-game stream carries. On a mid-tournament
    // join the standings catch-up (global results) has no opening, so pento can't cover those games.
    // Show pento only when it covers (nearly) all standings games; otherwise it'd be misleading.
    bool pentoReliable = pentoCovered > 0 && (resultCount - pentoCovered) <= Math.Max(2, tiles.Count);
    // Board size: explicit ?size=N wins; otherwise scale to how many games run in parallel.
    var bs = manualSize ?? AutoSize(tiles.Count);
}

@if (table.Count > 0)
{
    <table class="standings">
        <thead>
            <tr><th>#</th><th>Engine</th><th>Pts</th><th>Pl</th><th>W-D-L</th><th>Elo</th>
                <th title="Average nodes per move">Nodes</th><th title="Average nodes/sec">NPS</th><th title="Average evals/sec">EPS</th>
                <th title="Total think time used by this engine">Time</th></tr>
        </thead>
        <tbody>
            @{ var rank = 1; }
            @foreach (var p in table)
            {
                var s = spd.TryGetValue(p.Player, out var sv) ? sv : default;
                <tr>
                    <td>@(rank++)</td>
                    <td class="eng">@p.Player</td>
                    <td>@p.Points.ToString("0.0")</td>
                    <td>@p.Played</td>
                    <td>@p.Win-@p.Draw-@p.Loss</td>
                    <td>@p.Elo.ToString("+0;-0;0") ±@p.Error.ToString("0")</td>
                    <td>@s.nodes</td>
                    <td>@s.nps</td>
                    <td>@s.eps</td>
                    <td>@s.time</td>
                </tr>
            }
        </tbody>
    </table>
    @if (table.Count >= 3)   // head-to-head crosstable (W-D-L), useful for round-robin
    {
        <table class="crosstable">
            <thead>
                <tr><th>vs →</th>@foreach (var c in table) { <th>@c.Player</th> }</tr>
            </thead>
            <tbody>
                @foreach (var rowEng in table)
                {
                    <tr>
                        <td class="eng">@rowEng.Player</td>
                        @foreach (var c in table)
                        {
                            @if (rowEng.Player == c.Player)
                            {
                                <td class="diag">—</td>
                            }
                            else
                            {
                                var v = cross.TryGetValue((rowEng.Player, c.Player), out var hv) ? hv : default;
                                <td>@($"{v.w}-{v.d}-{v.l}")</td>
                            }
                        }
                    </tr>
                }
            </tbody>
        </table>
    }
    @if (table.Count == 2)   // pentanomial is a 2-engine (paired-match) stat — not shown for round-robin
    {
        @if (pentoReliable && !string.IsNullOrEmpty(pento))
        {
            <div class="pento">@pento</div>
        }
        else if (resultCount > 0)
        {
            <div class="pento pento-na">Pentanomial: n/a — joined mid-tournament (pairs unavailable for games played before connecting)</div>
        }
    }
}

@if (tiles.Count == 0)
{
    <p class="hint">No games yet.
        <br />Live (EB Console with <code>EB_LIVEFEED_FILE</code> set): <code>/tournament-grid?tail=PATH</code>
        <br />Replay a recording: <code>/tournament-grid?replay=PATH&amp;games=4&amp;speed=600</code></p>
}

<div class="games-grid" style="grid-template-columns: repeat(auto-fill, minmax(@(bs + (showEvalBar ? 40 : 28))px, 1fr));">
    @foreach (var g in tiles)
    {
        <a class="game-tile @(g.Finished ? "done" : "")" @key="g.GameId"
           href="@($"/tournament-feed?game={Uri.EscapeDataString(g.GameId)}")" target="_blank"
           title="Open this game in a focused view (new tab)">
            <div class="tile-row">
                <span class="nm">@g.Black</span>
                <span class="clk">@g.BlackTime</span>
                <span class="ev">@g.BlackEval</span>
            </div>
            <div class="pv">@ShortPv(g.BlackPV)</div>
            <div class="stats">@g.BlackStats</div>
            <div class="tile-board-row">
                @if (showEvalBar)
                {
                    <EvalBar Cp="@g.EvalCp" Mate="@g.EvalMate" />
                }
                <PVtileBoard Fen="@g.Fen" Color="@g.MoveColor" FromSq="@g.FromSq" ToSq="@g.ToSq" Size="@bs" />
            </div>
            <div class="pv">@ShortPv(g.WhitePV)</div>
            <div class="stats">@g.WhiteStats</div>
            <div class="tile-row">
                <span class="nm">@g.White</span>
                <span class="clk">@g.WhiteTime</span>
                <span class="ev">@g.WhiteEval</span>
            </div>
            <div class="tile-meta">
                <span class="gid" title="Board / game id">@g.BoardId</span>
                @if (!string.IsNullOrEmpty(g.Source))
                {
                    <span class="src" title="Source server">live from @g.Source</span>
                }
                <span class="lm">@g.LastMove</span>
                <span class="st">@(g.Finished ? g.Result : (g.MoveNr > 0 ? $"move {g.MoveNr}" : "starting…"))</span>
            </div>
        </a>
    }
</div>

@code {
    private bool showEvalBar => SettingsService.Settings.ShowEvalBar;

    private readonly Dictionary<string, GameVM> games = new();
    private readonly List<Result> results = new();          // accumulated across all games/slots
    private readonly HashSet<string> seenStandings = new(); // dedup results for standings (Ceres sends gameEnd + gameResult)
    private readonly HashSet<string> seenPento = new();     // dedup results for pentanomial
    private readonly Dictionary<string, int> perThreadOrdinal = new(); // results seen per thread -> pentanomial pairing
    private List<PlayerResult> standings = new();
    private readonly List<PgnGame> pentoGames = new();       // synthesized games for pentanomial
    private string pentoLine = "";
    private readonly object sync = new();
    private string tournamentName = "Live games";
    private string machine = "";        // host machine (from tournament meta)
    private string timeControl = "";     // time control text (from tournament meta)
    private bool tournamentComplete;     // set on EndOfTournament; shows the "Completed" header badge
    private Action<string, TournamentTypes.Update> handler;
    private volatile bool renderQueued;
    private int? manualSize;   // explicit ?size=N override; otherwise auto-scaled by parallel game count

    private string ceresHostPort = "localhost:7440";   // sensible default; remote servers can edit it

    protected override void OnInitialized()
    {
        handler = OnFeed;
        JsonFeedSvc.SubscribeMulti(handler);
        CeresBridge.Changed += OnBridgeChanged;
        if (int.TryParse(GetQuery("size"), out var s) && s >= 80 && s <= 700)
            manualSize = s;
        lanUrl = BuildLanUrl();
    }

    private string lanUrl = "";   // shareable URL for watching from another device on the LAN

    // Server's LAN IPv4 via the default-route trick (picks the active adapter, not WSL/virtual).
    private string BuildLanUrl()
    {
        try
        {
            string ip;
            using (var sock = new System.Net.Sockets.Socket(System.Net.Sockets.AddressFamily.InterNetwork,
                                                             System.Net.Sockets.SocketType.Dgram,
                                                             System.Net.Sockets.ProtocolType.Udp))
            {
                sock.Connect("8.8.8.8", 65530);   // no packets sent; just resolves the outbound local IP
                ip = ((System.Net.IPEndPoint)sock.LocalEndPoint!).Address.ToString();
            }
            int port = new Uri(Nav.BaseUri).Port;
            return $"http://{ip}:{port}/tournament-grid?ceres=localhost:7440";
        }
        catch { return ""; }
    }

    private async Task CopyLanUrl()
    {
        try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", lanUrl); } catch { /* clipboard unavailable */ }
    }

    private void OnBridgeChanged() => _ = InvokeAsync(StateHasChanged);

    private async Task ConnectCeres()
    {
        var hp = (ceresHostPort ?? "").Trim();
        if (string.IsNullOrEmpty(hp)) return;
        var parts = hp.Split(':', 2);
        var host = parts[0].Trim();
        var port = (parts.Length == 2 && int.TryParse(parts[1], out var p)) ? p : 7440;
        if (string.IsNullOrEmpty(host)) return;
        try { await CeresBridge.ConnectAsync(host, port); }
        catch { /* status reflects failure via Changed */ }
    }

    private async Task DisconnectCeres() => await CeresBridge.DisconnectAsync();

    // Fresh start: clear accumulated standings/boards (and the feed cache) so a new tournament
    // doesn't continue the previous one's results.
    private void ResetAll()
    {
        lock (sync)
        {
            games.Clear();
            results.Clear();
            seenStandings.Clear();
            seenPento.Clear();
            perThreadOrdinal.Clear();
            speed.Clear();
            standings = new List<PlayerResult>();
            pentoGames.Clear();
            pentoLine = "";
            tournamentName = "Live games";
            machine = "";
            timeControl = "";
            tournamentComplete = false;
        }
        JsonFeedSvc.Reset();
        StateHasChanged();
    }

    // Board size scaled to how many games run in parallel (more games -> smaller boards).
    private static int AutoSize(int games) => games switch
    {
        <= 1 => 420,
        2 => 360,
        <= 4 => 300,
        <= 6 => 260,
        <= 9 => 220,
        _ => 190
    };

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            // Live tail of a feed file written by an external producer (e.g. EB Console with
            // EB_LIVEFEED_FILE set) — events arrive in real time, already gameId-stamped.
            var tail = GetQuery("tail");
            if (!string.IsNullOrEmpty(tail))
            {
                startedReplay = true;
                _ = Replayer.TailFileAsync(tail);
            }
            else
            {
                // Replay a recording, splitting it into per-game segments played concurrently.
                var replay = GetQuery("replay");
                if (!string.IsNullOrEmpty(replay))
                {
                    var n = int.TryParse(GetQuery("games"), out var gx) ? gx : 4;
                    var speed = int.TryParse(GetQuery("speed"), out var ms) ? ms : 600;
                    startedReplay = true;
                    _ = Replayer.ReplayGamesConcurrentlyAsync(replay, n, speed);
                }
            }

            // Auto-connect to a Ceres broadcast: /tournament-grid?ceres=host:port
            var ceres = GetQuery("ceres");
            if (!string.IsNullOrEmpty(ceres))
            {
                ceresHostPort = ceres;
                _ = ConnectCeres();
            }
        }
        return Task.CompletedTask;
    }

    private void OnFeed(string gameId, TournamentTypes.Update update)
    {
        lock (sync)
        {
            switch (update)
            {
                case TournamentTypes.Update.StartOfTournament sot:
                    // Just the header — do NOT clear results/standings: with multiple servers each sends
                    // a StartOfTournament, and results accumulate across them (combined standings).
                    tournamentComplete = false;   // a (re)start clears a stale "Completed" badge
                    if (sot.Info.Tournament != null)
                    {
                        var t = sot.Info.Tournament.Value;
                        tournamentName = t.Name;
                        machine = t.Description ?? "";        // host machine carried in Description
                        try { timeControl = t.TimeControlText() ?? ""; } catch { timeControl = ""; }
                    }
                    break;

                case TournamentTypes.Update.EndOfTournament:
                    tournamentComplete = true;
                    break;

                case TournamentTypes.Update.StartOfGame sog:
                    {
                        var vm = Get(gameId);
                        vm.White = sog.Game.WhitePlayer.Name;
                        vm.Black = sog.Game.BlackPlayer.Name;
                        vm.OpeningHash = sog.Game.OpeningHash;
                        vm.WhiteTime = FmtClock(sog.Game.WhiteTime);
                        vm.BlackTime = FmtClock(sog.Game.BlackTime);
                        vm.Fen = sog.Game.OpeningMovesAndFen.Count > 0
                            ? sog.Game.OpeningMovesAndFen[sog.Game.OpeningMovesAndFen.Count - 1].FenAfterMove
                            : sog.Game.StartPos;
                        vm.FromSq = vm.ToSq = vm.LastMove = "";
                        vm.WhiteEval = vm.BlackEval = "";
                        vm.EvalCp = null; vm.EvalMate = null;
                        vm.WhitePV = vm.BlackPV = "";
                        vm.WhiteStats = vm.BlackStats = "";
                        vm.Result = "";
                        vm.Finished = false;
                        vm.Ply = 0;
                        break;
                    }

                case TournamentTypes.Update.BestMove bm:
                    {
                        var vm = Get(gameId);
                        vm.Fen = bm.Info.FEN;
                        vm.FromSq = bm.Info.MoveAndFen.Move.FromSq;
                        vm.ToSq = bm.Info.MoveAndFen.Move.ToSq;
                        vm.MoveColor = bm.Info.MoveAndFen.Move.Color;
                        vm.LastMove = bm.Info.MoveAndFen.ShortSan;
                        vm.Ply++;
                        var ev = Eval(bm.Info.Eval);
                        var stats = FmtStats(bm.Status.Nodes, bm.Status.NPS, bm.Status.EPS);
                        if (bm.Info.Player == vm.White) { vm.WhiteEval = ev; vm.WhitePV = bm.Info.PV; vm.WhiteTime = FmtClock(bm.Info.TimeLeft); vm.WhiteStats = stats; }
                        else if (bm.Info.Player == vm.Black) { vm.BlackEval = ev; vm.BlackPV = bm.Info.PV; vm.BlackTime = FmtClock(bm.Info.TimeLeft); vm.BlackStats = stats; }
                        SetTileEval(vm, bm.Info.Eval);
                        // Per-engine speed + cumulative think time for the standings table (one sample per move).
                        if (!string.IsNullOrEmpty(bm.Info.Player) && bm.Status.Nodes > 0)
                        {
                            var sp = speed.TryGetValue(bm.Info.Player, out var sv) ? sv : (speed[bm.Info.Player] = new Speed());
                            sp.Nodes += bm.Status.Nodes; sp.Nps += bm.Status.NPS; sp.Eps += bm.Status.EPS; sp.N++;
                            sp.Time += bm.Info.MoveTime;   // total time this engine has spent thinking
                        }
                        break;
                    }

                case TournamentTypes.Update.Status st:
                    {
                        var vm = Get(gameId);
                        var ev = Eval(st.Engine.Eval);
                        var stats = FmtStats(st.Engine.Nodes, st.Engine.NPS, st.Engine.EPS);
                        if (st.Engine.PlayerName == vm.White) { vm.WhiteEval = ev; vm.WhitePV = st.Engine.PV; vm.WhiteStats = stats; }
                        else if (st.Engine.PlayerName == vm.Black) { vm.BlackEval = ev; vm.BlackPV = st.Engine.PV; vm.BlackStats = stats; }
                        SetTileEval(vm, st.Engine.Eval);
                        break;
                    }

                case TournamentTypes.Update.PeriodicResults pr:
                    // Catch-up: rebuild standings from the full results snapshot (sent on subscribe).
                    results.Clear();
                    seenStandings.Clear();
                    foreach (var r in pr.results)
                        if (seenStandings.Add(JsonFeedService.ResultKey(r)))
                            results.Add(r);
                    standings = FeedStats.playerResultsFromResults(results);
                    break;

                case TournamentTypes.Update.Time tm:
                    {
                        var vm = Get(gameId);
                        if (tm.Player == vm.White) vm.WhiteTime = FmtClock(tm.Time);
                        else if (tm.Player == vm.Black) vm.BlackTime = FmtClock(tm.Time);
                        break;
                    }

                case TournamentTypes.Update.EndOfGame eog:
                    {
                        // Standings: dedup — a Ceres game arrives both as a per-thread gameEnd and a
                        // global gameResult (the latter gives full catch-up on join). Count once.
                        var sig = JsonFeedService.ResultKey(eog.Result);
                        if (seenStandings.Add(sig))
                        {
                            results.Add(eog.Result);
                            standings = FeedStats.playerResultsFromResults(results);
                        }
                        var boardId = gameId.Substring(gameId.LastIndexOf('/') + 1);
                        if (boardId.StartsWith("r"))
                        {
                            // Ceres global result (results-only, no board tile). Two ways to pair pentanomial:
                            //  - "r{threadId}~o{openingIndex}": Ceres sent the opening id -> pair by opening
                            //    (robust to threads/parallelism/distribution).
                            //  - "r{threadId}": older Ceres -> fall back to thread-ordinal adjacency (each
                            //    thread plays an opening then its reverse back-to-back). Breaks under
                            //    distributed runs where a coordinator emits finished pairs from many workers.
                            var tilde = boardId.IndexOf('~');
                            // When the opening id is present, fold it into the dedup key so two different
                            // openings that share a ResultKey (common under node limits) aren't collapsed.
                            var pentoKey = tilde >= 0 ? sig + "@" + boardId.Substring(tilde + 1) : sig;
                            if (seenPento.Add(pentoKey))
                            {
                                string pairKey;
                                if (tilde >= 0)
                                {
                                    pairKey = boardId.Substring(tilde + 1);   // "o{openingIndex}" — same for both colors
                                }
                                else
                                {
                                    int ord = perThreadOrdinal.TryGetValue(boardId, out var c) ? c : 0;
                                    perThreadOrdinal[boardId] = ord + 1;
                                    pairKey = $"{boardId}#{ord / 2}";
                                }
                                pentoGames.Add(FeedStats.pentanomialGame(eog.Result.Player1, eog.Result.Player2, eog.Result.Result, pairKey));
                                if (standings.Count == 2)   // pentanomial only for a single 2-engine matchup (not RR)
                                    pentoLine = FeedStats.pentanomialCompact(pentoGames);
                            }
                        }
                        else if (!string.IsNullOrEmpty(boardId))
                        {
                            // Per-game tile (e.g. EB Console): tile done-state + pentanomial by opening hash.
                            var vm = Get(gameId);
                            vm.Result = eog.Result.Result;
                            vm.Finished = true;
                            if (seenPento.Add(sig))
                            {
                                pentoGames.Add(FeedStats.pentanomialGame(eog.Result.Player1, eog.Result.Player2, eog.Result.Result, vm.OpeningHash));
                                if (standings.Count == 2)   // pentanomial only for a single 2-engine matchup (not RR)
                                    pentoLine = FeedStats.pentanomialCompact(pentoGames);
                            }
                        }
                        break;
                    }
            }
        }
        ThrottledRender();
    }

    private GameVM Get(string id)
    {
        if (!games.TryGetValue(id, out var vm))
        {
            var slash = id.IndexOf('/');
            var src = slash < 0 ? "" : id.Substring(0, slash);
            var board = slash < 0 ? id : id.Substring(slash + 1);
            vm = new GameVM { GameId = id, Source = src, BoardId = board };
            games[id] = vm;
        }
        return vm;
    }

    private async void ThrottledRender()
    {
        if (renderQueued) return;
        renderQueued = true;
        try
        {
            await Task.Delay(120);
            renderQueued = false;
            await InvokeAsync(StateHasChanged);
        }
        catch { /* circuit disposed */ }
    }

    private static string Eval(EvalType e) => e == null || e.IsNA ? "" : e.ToString();

    /// <summary>Latest typed eval for the tile's bar (white perspective); NA keeps the last value.</summary>
    private static void SetTileEval(GameVM vm, EvalType e)
    {
        switch (e)
        {
            case EvalType.CP cp: (vm.EvalCp, vm.EvalMate) = (cp.Info, null); break;
            case EvalType.Mate m: (vm.EvalCp, vm.EvalMate) = (null, m.Info); break;
        }
    }

    // Compact magnitude formatter: 31200 -> "31.2k", 4_300_000 -> "4.3M".
    private static string Kfmt(double v) => v >= 1_000_000 ? $"{v / 1_000_000:0.0}M" : $"{v / 1_000:0.0}k";

    // Per-engine search stats line for a tile: "N = 1,276,331  nps = 31.2k  eps = 24.7k".
    // eps is omitted when the engine doesn't report it (e.g. classical engines).
    private static string FmtStats(long nodes, double nps, double eps)
    {
        if (nodes <= 0 && nps <= 0) return "";
        var s = $"N = {nodes:N0}  nps = {Kfmt(nps)}";
        if (eps > 0) s += $"  eps = {Kfmt(eps)}";
        return s;
    }

    // Running per-engine speed accumulator (summed over completed moves -> averaged for the table).
    // Time is cumulative (total think time spent), shown as-is rather than averaged.
    private sealed class Speed { public long Nodes; public double Nps; public double Eps; public int N; public TimeSpan Time; }

    // Total think time used by an engine, compact: "8.4s", "1:23", "1:02:03".
    private static string FmtDuration(TimeSpan t)
    {
        if (t <= TimeSpan.Zero) return "";
        if (t.TotalHours >= 1) return $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}";
        if (t.TotalMinutes >= 1) return $"{t.Minutes}:{t.Seconds:00}";
        return $"{t.TotalSeconds:0.0}s";
    }
    private readonly Dictionary<string, Speed> speed = new();

    // Head-to-head W-D-L matrix from the results: hh[(a,b)] = a's wins/draws/losses vs b.
    private static Dictionary<(string, string), (int w, int d, int l)> BuildCrosstable(IEnumerable<Result> results)
    {
        var hh = new Dictionary<(string, string), (int w, int d, int l)>();
        void Add(string a, string b, int w, int d, int l)
        {
            hh.TryGetValue((a, b), out var c);
            hh[(a, b)] = (c.w + w, c.d + d, c.l + l);
        }
        foreach (var r in results)
        {
            int ww = r.Result == "1-0" ? 1 : 0;
            int dd = r.Result == "1/2-1/2" ? 1 : 0;
            int ll = r.Result == "0-1" ? 1 : 0;
            Add(r.Player1, r.Player2, ww, dd, ll);   // white vs black
            Add(r.Player2, r.Player1, ll, dd, ww);   // black vs white
        }
        return hh;
    }

    // Bound the PV to a sensible number of plies so it fits ~2 lines without any CSS clamp trick.
    private const int PvMaxPlies = 20;
    private static string ShortPv(string pv)
    {
        if (string.IsNullOrWhiteSpace(pv)) return "PV:";   // placeholder keeps the line height stable
        var toks = pv.Split(' ', StringSplitOptions.RemoveEmptyEntries);
        return toks.Length <= PvMaxPlies ? pv : string.Join(' ', toks.Take(PvMaxPlies)) + " …";
    }

    private static string FmtClock(TimeSpan t)
    {
        var ts = t;
        return ts.TotalHours >= 1
            ? $"{(int)ts.TotalHours}:{ts.Minutes:00}:{ts.Seconds:00}"
            : $"{ts.Minutes}:{ts.Seconds:00}";
    }

    private string GetQuery(string key)
    {
        var q = new Uri(Nav.Uri).Query;
        if (string.IsNullOrEmpty(q)) return null;
        foreach (var part in q.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
        {
            var kv = part.Split('=', 2);
            if (kv.Length == 2 && Uri.UnescapeDataString(kv[0]).Equals(key, StringComparison.OrdinalIgnoreCase))
                return Uri.UnescapeDataString(kv[1]);
        }
        return null;
    }

    // Set when THIS page started a tail/replay; the replayer is a singleton, so a grid
    // tab closing must not stop a replay another tab (or the Tournaments page) started.
    private bool startedReplay;

    public void Dispose()
    {
        if (handler != null) JsonFeedSvc.UnsubscribeMulti(handler);
        CeresBridge.Changed -= OnBridgeChanged;
        if (startedReplay) Replayer.Stop();
    }

    private sealed class GameVM
    {
        public string GameId { get; set; } = "";   // composite key: "source/board" or "board"
        public string Source { get; set; } = "";    // server/producer (from ingest), "" if local
        public string BoardId { get; set; } = "";   // local board/slot id
        public string White { get; set; } = "";
        public string Black { get; set; } = "";
        public string Fen { get; set; } = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
        public string FromSq { get; set; } = "";
        public string ToSq { get; set; } = "";
        public string MoveColor { get; set; } = "w";
        public string OpeningHash { get; set; } = "";
        public string LastMove { get; set; } = "";
        public string WhiteEval { get; set; } = "";
        public string BlackEval { get; set; } = "";
        // Latest typed eval from either engine (white perspective) — drives the tile's eval bar.
        public double? EvalCp { get; set; }
        public int? EvalMate { get; set; }
        public string WhitePV { get; set; } = "";
        public string BlackPV { get; set; } = "";
        public string WhiteStats { get; set; } = "";   // "N = …  nps = …k  eps = …k"
        public string BlackStats { get; set; } = "";
        public string WhiteTime { get; set; } = "";
        public string BlackTime { get; set; } = "";
        public string Result { get; set; } = "";
        public bool Finished { get; set; }
        public int Ply { get; set; }
        public int MoveNr => (Ply + 1) / 2;
    }

@page "/broadcast"
@inject WebGUI.Services.Broadcast.BroadcastState Feed
@inject NotifierService Notifier
@inject GlobalSettingsService SettingsService
@inject ILogger<Broadcast> logger
@implements IAsyncDisposable
@using WebGUI.Services.Broadcast
@using WebGUI.Components.Layout
@using WebGUI.Components.Layout.ChessboardLayout

<PageTitle>Lichess Broadcast</PageTitle>

<div class="bc-container">
    <h2>Lichess Broadcast</h2>
    <div class="bc-description">
        Watch live tournament games relayed by lichess, with your own engine analyzing the
        position you are viewing. Make moves on the board to explore your own lines; Follow live
        returns to the broadcast.
    </div>

    <div class="bc-picker">
        <select @bind="selectedOfficial">
            <option value="">— official broadcasts —</option>
            @foreach (var r in officialRounds)
            {
                <option value="@r.RoundId">@r.Label</option>
            }
        </select>
        <input placeholder="…or broadcast round URL / id" @bind="roundInput" @bind:event="oninput" />
        @if (Feed.IsRunning)
        {
            <button class="bc-btn" @onclick="Stop">Stop</button>
        }
        else
        {
            <button class="bc-btn primary" @onclick="Start">Start</button>
        }
        <span class="bc-status">@Feed.Status</span>
    </div>

    @if (Focus is { } g)
    {
        <div class="bc-layout">
            <div class="bc-focus">
                <div class="bc-controls">
                    <button class="bc-btn @(follow ? "primary" : "")" @onclick="ToggleFollow">
                        @(follow ? "Following live" : "Follow live")
                    </button>
                    @if (SiblingRounds is { Count: > 1 } siblings)
                    {
                        <select class="bc-round-select" value="@Feed.RoundId" @onchange="SwitchRound" title="Switch round">
                            @foreach (var r in siblings)
                            {
                                <option value="@r.RoundId">@r.RoundName @(r.Ongoing ? " (live)" : "")</option>
                            }
                        </select>
                    }
                    @if (!follow && !g.Finished)
                    {
                        <span class="bc-hint">exploring — stepping to the latest move resumes following</span>
                    }
                    @if (!g.Finished)
                    {
                        <span class="bc-badge live header">LIVE</span>
                    }
                </div>

                <ModernChessboard @ref="chessBoardRazor" FENposition="@fen" ChessBoard="@focusBoard"
                                  ShowFenField=false ShowChessNavButtons=true ShowMoveList=true
                                  MakeMoveListClickable=true MoveListPosition="MoveListPosition.Right"
                                  ShowPlayerInfo=true MoveEvals="@moveEvals"
                                  OnMoveMadeOnBoard="OnUserMoveMade" OnNewFENOnBoard="OnBoardFenChanged"
                                  OnBoardFlipped="f => boardFlipped = f">
                    <BoardLeft>
                        <EvalBar Cp="@kibCp" Mate="@kibMate" Flipped="@boardFlipped" />
                    </BoardLeft>
                    <AboveMoveList>
                        <KibitzerPanel ChessBoard="@focusBoard" Id="nnInput1"
                                       InitialEngine="Engine" InitialEnginePath="@engineConfigPath"
                                       OnEvalUpdated="OnKibitzerEval" />
                    </AboveMoveList>
                    <BlackPlayerInfo>
                        <div class="bc-player">
                            <span class="bc-name">@g.Black <span class="bc-elo">@g.BlackElo</span></span>
                            @if (g.Finished)
                            {
                                <span class="bc-score">@ScoreFor(g, white: false)</span>
                            }
                            <span class="bc-clock @(BlackToMove(g) ? "active" : "")">@Clock(g.BlackClock)</span>
                        </div>
                    </BlackPlayerInfo>
                    <WhitePlayerInfo>
                        <div class="bc-player">
                            <span class="bc-name">@g.White <span class="bc-elo">@g.WhiteElo</span></span>
                            @if (g.Finished)
                            {
                                <span class="bc-score">@ScoreFor(g, white: true)</span>
                            }
                            <span class="bc-clock @(!BlackToMove(g) && !g.Finished ? "active" : "")">@Clock(g.WhiteClock)</span>
                        </div>
                    </WhitePlayerInfo>
                </ModernChessboard>

                @if (g.Plies.Count > 1)
                {
                    <div class="bc-evalchart">
                        <MoveEvalChart Baseline="@BaselineEvals(g)" Engine="@EngineEvals(g)"
                                       CurrentPly="@CurrentPlyIndex(g)" OnPlyClicked="JumpToPly"
                                       EngineName="@(Engine?.Name ?? "engine")" />
                    </div>
                }
            </div>

            <div class="bc-games">
                @foreach (var game in OrderedGames)
                {
                    var last = game.Plies.Count > 0 ? game.Plies[^1] : null;
                    <div class="bc-tile @(game.Key == focusKey ? "selected" : "") @(game.Finished ? "done" : "")"
                         @onclick="() => SelectGame(game.Key)">
                        @if (!game.Finished)
                        {
                            <span class="bc-badge live">LIVE</span>
                        }
                        <EbChessboard Fen="@game.CurrentFen" SizePx="170"
                                      LastMoveFrom="@last?.FromSq" LastMoveTo="@last?.ToSq"
                                      LastMoveColor="@last?.Color" />
                        <div class="bc-tile-caption">
                            <span>@Surname(game.White) – @Surname(game.Black)</span>
                            <span class="bc-tile-result">@(game.Finished ? game.Result : $"{game.SanMoves.Count / 2 + game.SanMoves.Count % 2}. {game.LastMoveSan}")</span>
                        </div>
                    </div>
                }
            </div>
        </div>
    }
    else if (Feed.IsRunning)
    {
        <p class="bc-waiting">Waiting for games…</p>
    }
</div>

@code {
    private string roundInput = "";
    private string selectedOfficial = "";
    private List<OfficialRound> officialRounds = new();

    private string focusKey = "";
    private bool follow = true;
    private string fen = Chess.startPos;

    // The shared board: ModernChessboard renders and takes user moves on it, the
    // kibitzer's analyzer reads search positions from it.
    private readonly Chess.Board focusBoard = new();
    private ModernChessboard chessBoardRazor;
    private EngineConfig Engine;
    private string engineConfigPath = "";
    private string lastNotifiedFen = "";
    private Dictionary<int, string> moveEvals = new();

    // Eval-bar state fed by the kibitzer (white perspective).
    private double? kibCp;
    private int? kibMate;
    private bool boardFlipped;

    // Engine eval per ply index (white perspective, clamped to ±5) for the eval chart.
    // Fills in as the kibitzer analyzes positions — live tip while following, gaps when browsing.
    private readonly Dictionary<int, double> engineEvalByPly = new();

    private BroadcastGame Focus =>
        Feed.Games.FirstOrDefault(x => x.Key == focusKey) ?? OrderedGames.FirstOrDefault();

    // Tiles: live games before finished ones, strongest pairings first within each group.
    private IEnumerable<BroadcastGame> OrderedGames =>
        Feed.Games
            .OrderBy(g => g.Finished ? 1 : 0)
            .ThenByDescending(RatingSum)
            .ThenBy(g => g.Key, StringComparer.Ordinal);

    private static int RatingSum(BroadcastGame g)
    {
        int.TryParse(g.WhiteElo, out var w);
        int.TryParse(g.BlackElo, out var b);
        return w + b;
    }

    private static bool BlackToMove(BroadcastGame g) =>
        !g.Finished && g.SanMoves.Count % 2 == 1;

    private static string Clock(string clk) => string.IsNullOrEmpty(clk) ? "–" : clk;

    /// <summary>Per-player score once a game is finished: "1", "0" or "½".</summary>
    private static string ScoreFor(BroadcastGame g, bool white) => g.Result switch
    {
        "1-0" => white ? "1" : "0",
        "0-1" => white ? "0" : "1",
        "1/2-1/2" or "½-½" => "½",
        _ => ""
    };

    private static string Surname(string name)
    {
        var comma = name.IndexOf(',');
        return comma > 0 ? name[..comma] : name;
    }

    protected override async Task OnInitializedAsync()
    {
        Feed.Changed += OnChanged;
        Feed.GameUpdated += OnGameUpdated;

        var s = SettingsService.Settings;
        if (Engine == null && !string.IsNullOrEmpty(s.DefaultEnginePath))
        {
            try
            {
                Engine = Configuration.JSON.readSingleEngineConfig(s.DefaultEnginePath);
                engineConfigPath = s.DefaultEnginePath;
            }
            catch (Exception ex)
            {
                logger.LogWarning("Could not load default engine: {Msg}", ex.Message);
            }
        }

        if (Focus is { } g) { focusKey = g.Key; await LoadFocusGameAsync(); }
        officialRounds = await BroadcastState.FetchOfficialRoundsAsync();
    }

    private void OnKibitzerEval((double? Cp, int? Mate, string Fen) eval)
    {
        (kibCp, kibMate) = (eval.Cp, eval.Mate);
        // Chart: attribute the eval to the position the search ran on (not whatever is
        // on the board now — engine output can arrive just after a navigation). Start
        // position and off-game exploration fens resolve to -1 and are not recorded.
        if (Focus is { } g && !string.IsNullOrEmpty(eval.Fen))
        {
            var idx = g.Plies.FindIndex(p => p.Fen == eval.Fen);
            var v = eval.Mate is int m ? (m > 0 ? 5.0 : -5.0) : eval.Cp;
            if (idx >= 0 && v is double val) engineEvalByPly[idx] = Math.Clamp(val, -5.0, 5.0);
        }
        StateHasChanged();
    }

    // ── Eval chart helpers ──
    private int CurrentPlyIndex(BroadcastGame g) => g.Plies.FindIndex(p => p.Fen == fen);

    /// <summary>Lichess server evals per ply ("0.18" / "#4" strings → white-perspective pawns, ±5).</summary>
    private static List<double?> BaselineEvals(BroadcastGame g) =>
        g.Plies.Select(p => ParseLichessEval(p.Eval)).ToList();

    private List<double?> EngineEvals(BroadcastGame g)
    {
        var result = new List<double?>(g.Plies.Count);
        for (int i = 0; i < g.Plies.Count; i++)
            result.Add(engineEvalByPly.TryGetValue(i, out var v) ? v : null);
        return result;
    }

    private static double? ParseLichessEval(string raw)
    {
        if (string.IsNullOrEmpty(raw)) return null;
        if (raw.StartsWith('#'))
            return raw.Contains('-') ? -5.0 : 5.0;
        return double.TryParse(raw, System.Globalization.NumberStyles.Float,
                               System.Globalization.CultureInfo.InvariantCulture, out var v)
            ? Math.Clamp(v, -5.0, 5.0)
            : null;
    }

    /// <summary>Chart click: jump the board (and engine) to the position after that ply.</summary>
    private async Task JumpToPly(int ply)
    {
        var g = Focus;
        if (g == null || ply < 0 || ply >= g.Plies.Count) return;
        var targetFen = g.Plies[ply].Fen;
        focusBoard.LoadFen(targetFen);
        if (chessBoardRazor != null) await chessBoardRazor.SetPositionDirect(targetFen);
        await AfterBoardNavigation();
    }

    // ── Round switcher ──
    private List<OfficialRound> SiblingRounds
    {
        get
        {
            var current = officialRounds.FirstOrDefault(r => r.RoundId == Feed.RoundId);
            if (current == null || string.IsNullOrEmpty(current.TourId)) return new();
            return officialRounds.Where(r => r.TourId == current.TourId).ToList();
        }
    }

    private void SwitchRound(ChangeEventArgs e)
    {
        var roundId = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(roundId) || roundId == Feed.RoundId) return;
        focusKey = "";
        follow = true;
        ResetEvalState();
        Feed.Start(roundId);
    }

    private void ResetEvalState()
    {
        (kibCp, kibMate) = (null, null);
        engineEvalByPly.Clear();
    }

    private void Start()
    {
        var target = !string.IsNullOrWhiteSpace(roundInput) ? roundInput : selectedOfficial;
        if (string.IsNullOrWhiteSpace(target)) return;
        focusKey = "";
        follow = true;
        ResetEvalState();
        Feed.Start(target);
    }

    private async Task Stop() => await Feed.StopAsync();

    private async Task SelectGame(string key)
    {
        focusKey = key;
        follow = true;
        // Neutral eval bar + empty chart until the kibitzer reports on the new game.
        ResetEvalState();
        await LoadFocusGameAsync();
    }

    private async Task ToggleFollow()
    {
        follow = !follow;
        // Returning to the live game discards any exploration and snaps to the latest move.
        if (follow) await LoadFocusGameAsync();
    }

    /// <summary>A move made or navigated on the board (ModernChessboard already updated
    /// the shared board): sync fen, adjust follow mode, notify the engine.</summary>
    private async Task OnUserMoveMade(string move) => await AfterBoardNavigation();

    /// <summary>Home/End navigation reports a bare fen instead of a move.</summary>
    private async Task OnBoardFenChanged(string newFen) => await AfterBoardNavigation();

    /// <summary>Shared post-navigation logic: browsing away from the live tip pauses
    /// following; stepping back onto the tip resumes it (lichess-style).</summary>
    private async Task AfterBoardNavigation()
    {
        var g = Focus;
        fen = focusBoard.FEN();
        follow = g != null && !g.Finished && fen == g.CurrentFen;
        if (fen != lastNotifiedFen)
        {
            lastNotifiedFen = fen;
            await Notifier.UpdateFen(fen);
        }
        StateHasChanged();
    }

    /// <summary>Rebuilds the shared board from the focus game's PGN (latest position),
    /// refreshes ModernChessboard and notifies the engine.</summary>
    private async Task LoadFocusGameAsync()
    {
        var g = Focus;
        if (g?.Parsed is null) return;
        try
        {
            focusBoard.ResetBoardStateFromFen(g.StartFen);
            focusBoard.LoadPGNGameWithVariations(g.Parsed);
        }
        catch (Exception ex)
        {
            logger.LogWarning("Broadcast board load failed: {Msg}", ex.Message);
            return;
        }
        fen = focusBoard.FEN();
        moveEvals = ExtractMoveEvals(g);

        var maf = focusBoard.MovesAndFenPlayed.LastOrDefault();
        if (chessBoardRazor != null)
        {
            if (maf != null && !string.IsNullOrEmpty(maf.ShortSan)) await chessBoardRazor.OnNotifyMoveAndFen(maf);
            else await chessBoardRazor.SetPositionDirect(fen);
        }

        if (fen != lastNotifiedFen)
        {
            lastNotifiedFen = fen;
            await Notifier.UpdateFen(fen);
        }
    }

    /// <summary>Lichess server evals per ply, formatted for the move list ("+0.2", "-1.5", "#4").</summary>
    private static Dictionary<int, string> ExtractMoveEvals(BroadcastGame g)
    {
        var evals = new Dictionary<int, string>();
        for (int i = 0; i < g.Plies.Count; i++)
        {
            var raw = g.Plies[i].Eval;
            if (string.IsNullOrEmpty(raw)) continue;
            if (raw.StartsWith('#'))
                evals[i] = raw;
            else if (double.TryParse(raw, System.Globalization.NumberStyles.Float,
                                     System.Globalization.CultureInfo.InvariantCulture, out var v))
                evals[i] = v.ToString("+0.0;-0.0", System.Globalization.CultureInfo.InvariantCulture);
        }
        return evals;
    }

    private void OnChanged() => _ = InvokeAsync(StateHasChanged);

    private void OnGameUpdated(BroadcastGame game, int newMoves) => _ = InvokeAsync(async () =>
    {
        // First game to arrive becomes the focus; while following, the board tracks the
        // newest move. While exploring, the board is left alone (tiles keep updating).
        if (string.IsNullOrEmpty(focusKey)) { focusKey = game.Key; await LoadFocusGameAsync(); }
        else if (follow && game.Key == focusKey && newMoves > 0) await LoadFocusGameAsync();
        StateHasChanged();
    });

    public async ValueTask DisposeAsync()
    {
        Feed.Changed -= OnChanged;
        Feed.GameUpdated -= OnGameUpdated;
        await Task.CompletedTask;
    }
}

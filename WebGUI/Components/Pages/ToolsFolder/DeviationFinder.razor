@page "/results/move-deviation"
@page "/deviationFinder"
@using System.Text
@using Microsoft.FSharp.Collections
@using Microsoft.JSInterop
@using WebGUI.Components.Layout
@using WebGUI.Components.Layout.ChessboardLayout
@using WebGUI.Services
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog

@inject ILogger<DeviationFinder> logger
@inject NotifierService Notifier
@inject IDialogService DialogService
@inject GlobalSettingsService SettingsService
@inject IJSRuntime JS
@inject NavigationManager Nav

<PageTitle>Move deviation page</PageTitle>

<div class="tool-page">
  <h1>Move Deviation Analysis</h1>
  <div class="tool-subtitle">Find and visualize move deviations across PGN games</div>

  <div class="tool-controls">
    <button class="tool-upload-btn" @onclick="BrowsePgnFile" disabled="@isProcessing">Load PGN file</button>
    <div class="tool-input-group" style="margin-bottom:0; min-width:220px;">
      <label>Reference player</label>
      <select class="tool-input" style="width:100%" @bind="refPlayer" disabled="@(availableEngines.Count == 0)">
        <option value="">(none)</option>
        @foreach (var e in availableEngines)
        {
          <option value="@e">@e</option>
        }
      </select>
    </div>
    <div class="tool-input-group" style="margin-bottom:0; min-width:320px;">
      <label>Compare players (none selected = all)</label>
      <select class="tool-input" style="width:100%" multiple size="5" @bind="compareSelection" @bind:after="ClearCompareIfAll"
              disabled="@(availableEngines.Count == 0)">
        <option value="">(all)</option>
        @foreach (var e in availableEngines)
        {
          <option value="@e">@e</option>
        }
      </select>
    </div>
    <button class="tool-action-btn" style="align-self:flex-end;" @onclick="RunAnalysis"
            disabled="@(isProcessing || loadedGames.Count == 0)">Apply</button>
  </div>
  <div style="font-size:0.85rem; color:#787890; margin:-6px 0 10px 0;">
    Engines are read from the loaded file. Ctrl-click to pick several to compare. Apply re-runs
    the analysis on the games already in memory - no need to load the file again.
  </div>

  <div class="file-name">@fileName</div>

  @if (isProcessing)
  {
    <div class="file-name" style="display:flex; align-items:center; gap:10px;">
      <MudProgressCircular Indeterminate="true" Size="Size.Small" />
      <span>@processingStatus</span>
    </div>
  }

  @if (!string.IsNullOrEmpty(resultDescription1))
  {
    <h2>Critical Move Differences Between Engines</h2>
    <pre style="font-size:0.88rem; color:#c0c0d0; margin:8px 0 16px 0; line-height:1.6;">@resultDescription1</pre>
  }

  @if (coverage is not null && coverage.HasUnverifiedOpenings)
  {
    <div class="tool-section" style="border-left:3px solid #d9a441; padding-left:12px;">
      <strong style="color:#d9a441;">@coverage.Unknown of @coverage.Total games have no opening information.</strong>
      <div style="color:#9aa1b1; font-size:0.9rem; margin-top:4px;">
        Neither per-move search data nor a book marker was found, so opening moves could not be
        separated from real choices in those games. Self-deviations below may be artefacts of
        both sides following the same book line.
      </div>
    </div>
  }

  @if (coverage is not null)
  {
    <div class="tool-section">
      <h2>Engine self-consistency</h2>
      <div class="tool-section-desc">
        How often an engine played a different move in a position it had <em>already reached in
        another game</em>. Opening moves are excluded, so only positions the engine actually
        chose in are counted.
        <div style="margin-top:6px; color:#787890;">
          This is a different count from the reference-replay results above: those compare each
          game against one reference game ply by ply, so they miss an engine contradicting itself
          across games that were never compared. Here every position is compared across all games.
        </div>
        @if (focusEngines.Count > 0)
        {
          <div style="margin-top:6px; color:#c7ccd8;">
            Showing only: @string.Join(", ", focusEngines) — from the Reference / Compare players fields.
          </div>
        }
      </div>

      @if (measurableEngines.Count == 0)
      {
        <div style="border-left:3px solid #5b8def; padding:10px 14px; color:#c7ccd8;">
          <strong>@(focusEngines.Count > 0 ? "Not measurable for the selected engine(s) in this PGN." : "Not measurable in this PGN.")</strong>
          <div style="margin-top:6px; color:#9aa1b1; font-size:0.9rem;">
            No engine reached the same position in more than one game, so there was never an
            opportunity to contradict itself — the result is an empty denominator, not a clean
            score. This is normal for reverse-colour pairings such as a superfinal or a paired
            match: when the two games of a pair swap colours, the engine that faces a given
            position in one game is the opponent in the other. Gauntlets, ladders and long
            events that repeat openings against several opponents do produce a denominator.
          </div>
        </div>
      }
      else
      {
        <div class="tool-puzzle-grid">
          @foreach (var e in measurableEngines)
          {
            var rate = 100.0 * e.SelfDeviations / e.RepeatedPositions;
            var share = e.DistinctPositions > 0 ? 100.0 * e.RepeatedPositions / e.DistinctPositions : 0.0;
            <div class="tool-puzzle-card">
              <div style="font-weight:600; color:#e8eaf0;">@e.Engine</div>
              <div style="display:flex; align-items:baseline; gap:10px; margin:4px 0 2px 0;">
                <span style="font-size:1.6rem; color:@(e.SelfDeviations > 0 ? "#e8a33d" : "#6fbf73");">
                  @e.SelfDeviations / @e.RepeatedPositions.ToString("N0")
                </span>
                <span style="font-size:0.95rem; color:#9aa1b1;">
                  @rate.ToString("0.0") %
                </span>
              </div>
              <div style="color:#9aa1b1; font-size:0.85rem;">
                positions it reached in more than one game, and played differently the second time
              </div>
              <div style="color:#787890; font-size:0.78rem; margin-top:4px;">
                those @e.RepeatedPositions.ToString("N0") are @share.ToString("0.0") % of the
                @e.DistinctPositions.ToString("N0") positions it chose in
              </div>
            </div>
          }
        </div>
        @if (unmeasurableCount > 0)
        {
          <div style="color:#787890; font-size:0.85rem; margin-top:8px;">
            @unmeasurableCount other engine(s) never met the same position twice, so they cannot
            be scored.
          </div>
        }
      }
    </div>
  }

  @if (positionDeviations.Count > 0)
  {
    <div class="tool-section">
      <h2>Position deviations</h2>
      <div class="tool-section-desc">
        One row per position where the games did not agree. Self means one engine contradicted
        an earlier choice of its own; cross means different engines disagreed.
      </div>

      <div class="tool-tab-bar">
        <button class="tool-tab @(typeFilter == "all" ? "active" : "")" @onclick='() => SetTypeFilter("all")'>
          All (@FocusedPositions.Count())
        </button>
        <button class="tool-tab @(typeFilter == "self" ? "active" : "")" @onclick='() => SetTypeFilter("self")'>
          Self (@FocusedSelfCount)
        </button>
        <button class="tool-tab @(typeFilter == "cross" ? "active" : "")" @onclick='() => SetTypeFilter("cross")'>
          Cross (@(FocusedPositions.Count() - FocusedSelfCount))
        </button>
        <span style="flex:1"></span>
        <button class="tool-action-btn-sm" @onclick="CopyPositionDeviations">Copy as text</button>
      </div>

      @if (focusEngines.Count > 0 && !FocusedPositions.Any())
      {
        <div style="color:#9aa1b1; font-size:0.9rem; margin:8px 0;">
          None of the @positionDeviations.Count position deviations involve @string.Join(", ", focusEngines).
        </div>
      }
      <div class="tool-table-container">
        <table class="tool-table dense">
          <thead>
            <tr>
              <th @onclick='() => SortPositionsBy("Move")'>Move @PosSortIndicator("Move")</th>
              <th @onclick='() => SortPositionsBy("Color")'>To play @PosSortIndicator("Color")</th>
              <th @onclick='() => SortPositionsBy("Type")'>Type @PosSortIndicator("Type")</th>
              <th @onclick='() => SortPositionsBy("Games")'>Games @PosSortIndicator("Games")</th>
              <th @onclick='() => SortPositionsBy("Choices")'>Choices @PosSortIndicator("Choices")</th>
            </tr>
          </thead>
          <tbody>
            @foreach (var d in FilteredPositionDeviations)
            {
              <tr style="cursor:pointer; @(ReferenceEquals(d, selectedPosition) ? "background:#2a2d38;" : "")"
                  @onclick="() => SelectPosition(d)">
                <td>@d.MoveNumber</td>
                <td>@(d.Color == "w" ? "White" : "Black")</td>
                <td>
                  @if (d.IsSelfDeviation)
                  {
                    <span style="color:#e8a33d;">self</span>
                    <span style="color:#787890; font-size:0.85rem;"> @string.Join(", ", d.SelfEngines)</span>
                  }
                  else
                  {
                    <span style="color:#5b8def;">cross</span>
                  }
                </td>
                <td>@d.GameCount</td>
                <td>@string.Join("  ·  ", d.Choices.Select(c => $"{c.San} ({c.GameNumbers.Count()})"))</td>
              </tr>
            }
          </tbody>
        </table>
      </div>
    </div>

    @if (selectedPosition is not null)
    {
      <div class="tool-section">
        <h2>Move @selectedPosition.MoveNumber — @(selectedPosition.Color == "w" ? "White" : "Black") to play</h2>
        <MudGrid>
          <MudItem md="5" lg="4">
            <EbChessboard Fen="@selectedPosition.Fen" SizePx="null" ShowCoordinates="true"
                          Arrows="@selectedArrows" />
          </MudItem>
          <MudItem md="7" lg="8">
            <div style="color:#787890; font-size:0.8rem; margin-bottom:6px;">
              Points are counted for the engine that chose the move — 1 for a win, ½ for a draw,
              0 for a loss — so they say whether the choice worked out, which the White-relative
              PGN result on its own cannot.
            </div>
            <table class="tool-table dense">
              <thead>
                <tr>
                  <th></th><th>Move</th><th>Played by</th><th>In</th>
                  <th title="Points over games, for the engine that chose this move: 1 = win, ½ = draw, 0 = loss — not the White-relative PGN result">Points</th>
                </tr>
              </thead>
              <tbody>
                @{ var ci = 0; }
                @foreach (var c in selectedPosition.Choices)
                {
                  var color = ChoiceColor(ci++);
                  <tr>
                    <td><span style="display:inline-block; width:14px; height:14px; border-radius:3px; background:@color;"></span></td>
                    <td style="font-weight:600;">@c.San</td>
                    @* One engine for every game: name it once. Several: name it per game, or
                       the reader cannot tell which engine played where. *@
                    @{ var oneEngine = c.Engines.Count() == 1; }
                    <td>@(oneEngine ? c.Engines.First() : "—")</td>
                    <td>
                      @string.Join("  ·  ", c.Instances.Select(i =>
                        oneEngine
                          ? $"#{i.GameNumber} {ResultGlyph(i.Result)}"
                          : $"#{i.GameNumber} {i.Engine} {ResultGlyph(i.Result)}"))
                    </td>
                    <td style="white-space:nowrap;">
                      @FormatPoints(c.Points)
                      <span style="color:#787890; font-size:0.8rem;"> of @c.Instances.Count()</span>
                    </td>
                  </tr>
                }
              </tbody>
            </table>
            <div style="margin-top:10px;">
              <button class="tool-action-btn-sm" @onclick="OpenSelectedInAnalysis">Open position in analysis</button>
            </div>
          </MudItem>
        </MudGrid>
      </div>
    }
  }

  @if (deviationListCritical.Count > 0)
  {
    <div class="tool-section">
      <h2>Critical Deviation Visualizations</h2>

      <div class="tool-controls">
        <div class="tool-input-group" style="margin-bottom:0">
          <label>Select Engine</label>
          <select class="tool-input" @bind="selectedEngine">
            <option value="All">All Engines</option>
            @foreach (var engine in deviationListCritical.Select(d => d.PlayerToDeviate).Distinct().OrderBy(e => e))
            {
              <option value="@engine">@engine</option>
            }
          </select>
        </div>
        <button class="tool-action-btn" @onclick="ToggleCriticalVisualizations">
          @(showCriticalVisualizations ? "Hide Boards" : "Render Boards")
        </button>
        @if (showCriticalVisualizations)
        {
          <div class="tool-input-group" style="margin-bottom:0">
            <label>Board size</label>
            <select class="tool-input" @bind="boardSizePx">
              <option value="170">Small</option>
              <option value="240">Medium</option>
              <option value="340">Large</option>
            </select>
          </div>
          <span style="font-size:0.85rem; color:#787890; align-self:center;">
            @FilteredCriticalDeviations.Count() pairs
          </span>
        }
      </div>

      @if (showCriticalVisualizations)
      {
        @* Flow the pairs across the width instead of one per row - at fluid board width only
           a single pair fitted, which meant scrolling past one deviation at a time. *@
        <div style="display:flex; flex-wrap:wrap; margin-top:12px;">
          @foreach (var item in FilteredCriticalDeviations)
          {
            <WebGUI.Components.Layout.VisualizationLayout.MoveDeviation
                MoveDeviationInput="item"
                BoardSizePx="@boardSizePx" />
          }
        </div>
      }
    </div>
  }

  @if (deviationListAll.Count > 0)
  {
    <h2>Move Deviations — All Games</h2>

    <div class="tool-table-container">
      <table class="tool-table sortable dense">
        <thead>
          <tr>
            <th @onclick='() => SortBy("Round")'>Round @SortIndicator("Round")</th>
            <th @onclick='() => SortBy("GameNr")'>Game @SortIndicator("GameNr")</th>
            <th @onclick='() => SortBy("MoveNr")'>Move @SortIndicator("MoveNr")</th>
            <th @onclick='() => SortBy("Color")'>Color @SortIndicator("Color")</th>
            <th @onclick='() => SortBy("Deviator")'>Deviator @SortIndicator("Deviator")</th>
            <th @onclick='() => SortBy("Opponent")'>Opponent @SortIndicator("Opponent")</th>
            <th @onclick='() => SortBy("Move1")'>Move1 @SortIndicator("Move1")</th>
            <th @onclick='() => SortBy("Move2")'>Move2 @SortIndicator("Move2")</th>
            <th @onclick='() => SortBy("Res1")'>Res1 @SortIndicator("Res1")</th>
            <th @onclick='() => SortBy("Res2")'>Res2 @SortIndicator("Res2")</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var d in GetPagedItems())
          {
            <tr>
              <td>@d.Round</td>
              <td>@d.GameNr</td>
              <td>@d.MoveNr</td>
              <td>@d.Color</td>
              <td>@d.PlayerToDeviate</td>
              <td>@d.Opponent</td>
              <td>@d.PrevSanMove.Item1</td>
              <td>@d.DevSanMove.Item1</td>
              <td>@d.Result</td>
              <td>@d.DevRes</td>
            </tr>
          }
        </tbody>
      </table>
      <div class="tool-pager">
        <span>@FilteredDeviationListAll.Count() items</span>
        <select @bind="pageSize" @bind:after="ResetPage">
          <option value="10">10</option>
          <option value="25">25</option>
          <option value="50">50</option>
          <option value="100">100</option>
        </select>
        <span>per page</span>
        <button disabled="@(currentPage <= 0)" @onclick="PrevPage">Prev</button>
        <span>Page @(currentPage + 1) / @totalPages</span>
        <button disabled="@(currentPage >= totalPages - 1)" @onclick="NextPage">Next</button>
      </div>
    </div>

    <pre style="font-size:0.88rem; color:#c0c0d0; margin:8px 0 16px 0; line-height:1.6;">@resultDescription2</pre>
  }
</div>


@code {
  // Filter fields
  private string filterRound = "", filterGameNr = "", filterMoveNr = "", filterColor = "", filterDeviator = "", filterOpponent = "", filterMove1 = "", filterMove2 = "", filterRes1 = "", filterRes2 = "";

  private IEnumerable<MoveDeviation> FilteredDeviationListAll =>
      deviationListAll.Where(d =>
          (string.IsNullOrWhiteSpace(filterRound) || d.Round.ToString().Contains(filterRound, StringComparison.OrdinalIgnoreCase)) &&
          (string.IsNullOrWhiteSpace(filterGameNr) || d.GameNr.ToString().Contains(filterGameNr, StringComparison.OrdinalIgnoreCase)) &&
          (string.IsNullOrWhiteSpace(filterMoveNr) || d.MoveNr.ToString().Contains(filterMoveNr, StringComparison.OrdinalIgnoreCase)) &&
          (string.IsNullOrWhiteSpace(filterColor) || (d.Color?.Contains(filterColor, StringComparison.OrdinalIgnoreCase) ?? false)) &&
          (string.IsNullOrWhiteSpace(filterDeviator) || (d.PlayerToDeviate?.Contains(filterDeviator, StringComparison.OrdinalIgnoreCase) ?? false)) &&
          (string.IsNullOrWhiteSpace(filterOpponent) || (d.Opponent?.Contains(filterOpponent, StringComparison.OrdinalIgnoreCase) ?? false)) &&
          (string.IsNullOrWhiteSpace(filterMove1) || (d.PrevSanMove.Item1?.Contains(filterMove1, StringComparison.OrdinalIgnoreCase) ?? false)) &&
          (string.IsNullOrWhiteSpace(filterMove2) || (d.DevSanMove.Item1?.Contains(filterMove2, StringComparison.OrdinalIgnoreCase) ?? false)) &&
          (string.IsNullOrWhiteSpace(filterRes1) || (d.Result?.Contains(filterRes1, StringComparison.OrdinalIgnoreCase) ?? false)) &&
          (string.IsNullOrWhiteSpace(filterRes2) || (d.DevRes?.Contains(filterRes2, StringComparison.OrdinalIgnoreCase) ?? false))
      );
  // --- Position-keyed analysis -------------------------------------------------
  // Unlike the reference-replay path below, this keys on the position rather than on a
  // designated reference game, so it can see an engine contradicting itself. Opening moves are
  // excluded by the library; coverage reports how reliably that could be determined.
  private List<ChessLibrary.DeviationAnalysis.PositionDeviation> positionDeviations = new();
  private List<ChessLibrary.DeviationAnalysis.EngineSelfSummary> engineConsistency = new();
  private ChessLibrary.DeviationAnalysis.OpeningCoverage coverage;
  private ChessLibrary.DeviationAnalysis.PositionDeviation selectedPosition;
  private string typeFilter = "all";

  // Engines named in the Reference / Compare players fields when the file was loaded. Empty
  // means no focus. Snapshotted at load, like the legacy analysis, so the two sections never
  // answer for different inputs.
  private HashSet<string> focusEngines = new(StringComparer.OrdinalIgnoreCase);

  private IEnumerable<ChessLibrary.DeviationAnalysis.PositionDeviation> FocusedPositions =>
      focusEngines.Count == 0
        ? positionDeviations
        : positionDeviations.Where(d => d.Choices.Any(c => c.Instances.Any(i => focusEngines.Contains(i.Engine))));

  private int FocusedSelfCount => FocusedPositions.Count(d => d.IsSelfDeviation);

  // An engine with no repeated positions has an empty denominator, which is a different
  // statement from "perfectly consistent" and must not be shown as a score. With any
  // denominator at all the rate is shown; the denominator beside it says what it is worth.

  private IEnumerable<ChessLibrary.DeviationAnalysis.EngineSelfSummary> focusedConsistency =>
      focusEngines.Count == 0 ? engineConsistency : engineConsistency.Where(e => focusEngines.Contains(e.Engine));

  private List<ChessLibrary.DeviationAnalysis.EngineSelfSummary> measurableEngines =>
      focusedConsistency
        .Where(e => e.RepeatedPositions > 0)
        .OrderByDescending(e => e.RepeatedPositions)
        .ToList();

  private int unmeasurableCount => focusedConsistency.Count(e => e.RepeatedPositions == 0);

  private string posSortColumn = "Move";
  private bool posSortAscending = true;

  private IEnumerable<ChessLibrary.DeviationAnalysis.PositionDeviation> FilteredPositionDeviations
  {
    get
    {
      var rows = typeFilter switch
      {
        "self" => FocusedPositions.Where(d => d.IsSelfDeviation),
        "cross" => FocusedPositions.Where(d => !d.IsSelfDeviation),
        _ => FocusedPositions
      };

      Func<ChessLibrary.DeviationAnalysis.PositionDeviation, IComparable> key = posSortColumn switch
      {
        "Color" => d => d.Color,
        // Self first when descending: the interesting rows, not alphabetical order.
        "Type" => d => d.IsSelfDeviation ? 1 : 0,
        "Games" => d => d.GameCount,
        "Choices" => d => d.Choices.Count(),
        _ => d => d.MoveNumber
      };

      return posSortAscending ? rows.OrderBy(key) : rows.OrderByDescending(key);
    }
  }

  private void SortPositionsBy(string column)
  {
    if (posSortColumn == column) posSortAscending = !posSortAscending;
    else { posSortColumn = column; posSortAscending = true; }
    selectedPosition = null;
  }

  private string PosSortIndicator(string column) =>
      posSortColumn != column ? "" : posSortAscending ? "▲" : "▼";

  private void SetTypeFilter(string value)
  {
    typeFilter = value;
    selectedPosition = null;
  }

  private void SelectPosition(ChessLibrary.DeviationAnalysis.PositionDeviation d) => selectedPosition = d;

  // Distinct colours for the first few choices; anything beyond that is rare and grey is fine.
  // Compact, colour-free result marker so a game and its outcome read as one token.
  private static string ResultGlyph(string result) => result switch
  {
    "1-0" => "1-0",
    "0-1" => "0-1",
    "1/2-1/2" => "½",
    _ => "?"
  };

  // Chess notation for a point total: 1, ½, 1½, 2 — never 0.5 or 1.5.
  private static string FormatPoints(double points)
  {
    var whole = (int)Math.Floor(points + 1e-9);
    var half = points - whole >= 0.5 - 1e-9;
    if (whole == 0 && half) return "½";
    return half ? $"{whole}½" : whole.ToString();
  }

  private static string ChoiceColor(int index) => index switch
  {
    0 => "#5b8def",
    1 => "#e8a33d",
    2 => "#6fbf73",
    3 => "#c96b6b",
    _ => "#8a8fa3"
  };

  private IReadOnlyList<EbArrow> selectedArrows =>
      selectedPosition is null
        ? Array.Empty<EbArrow>()
        : selectedPosition.Choices
            .Select((c, i) => new { c, i })
            .Where(x => x.c.Move != null && x.c.Move.Length >= 4)
            .Select(x => new EbArrow(x.c.Move.Substring(0, 2), x.c.Move.Substring(2, 2), ChoiceColor(x.i)))
            .ToList();

  private async Task OpenSelectedInAnalysis()
  {
    if (selectedPosition is null) return;
    try
    {
      await JS.InvokeVoidAsync("open", $"/analysis/single?fen={Uri.EscapeDataString(selectedPosition.Fen)}", "_blank");
    }
    catch (JSException ex)
    {
      logger.LogWarning(ex, "Could not open the analysis window");
    }
  }

  private async Task CopyPositionDeviations()
  {
    var sb = new StringBuilder();
    sb.AppendLine("Move	ToPlay	Type	Games	Choices");
    foreach (var d in FilteredPositionDeviations)
    {
      var type = d.IsSelfDeviation ? "self:" + string.Join("/", d.SelfEngines) : "cross";
      var choices = string.Join("  ", d.Choices.Select(c =>
        $"{c.San}[{string.Join("/", c.Engines)} {string.Join(",", c.Instances.Select(i => $"#{i.GameNumber}:{i.Result}"))} {FormatPoints(c.Points)}/{c.Instances.Count()}]"));
      sb.AppendLine($"{d.MoveNumber}	{(d.Color == "w" ? "White" : "Black")}	{type}	{d.GameCount}	{choices}");
    }
    try
    {
      // navigator.clipboard is undefined on a non-secure origin, which is how this page is
      // reached when the GUI is opened over plain HTTP from another machine. Every other
      // clipboard call in this app guards for the same reason.
      await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
    }
    catch (JSException ex)
    {
      logger.LogWarning(ex, "Clipboard unavailable - copy skipped");
    }
  }

  private List<MoveDeviation> deviationListCritical = new();
  private List<MoveDeviation> deviationListAll = new();
  private string resultDescription1;
  private string resultDescription2;
  private string fileName;
  // Parsed once per file. Apply re-runs the analysis on these with the current selection,
  // so changing the engines does not mean reading and parsing the file again.
  private List<ChessLibrary.PGNTypes.PgnGame> loadedGames = new();
  private List<string> availableEngines = new();
  private string refPlayer = String.Empty;
  private string[] compareSelection = Array.Empty<string>();

  // "(all)" is a real entry so the selection can be emptied with one click; picking it
  // clears everything else, and an empty selection means no filter.
  private void ClearCompareIfAll()
  {
    if (compareSelection.Contains("")) compareSelection = Array.Empty<string>();
  }
  private string selectedEngine = "All";
  private bool showCriticalVisualizations = false;
  private int boardSizePx = 240;

  // Sorting state
  private string sortColumn = "Round";
  private bool sortAscending = true;

  // Pagination state
  private int currentPage = 0;
  private int pageSize = 25;
  private int totalItems => FilteredDeviationListAll.Count();
  private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalItems / pageSize));

  private IEnumerable<MoveDeviation> FilteredCriticalDeviations =>
      selectedEngine == "All"
          ? deviationListCritical
          : deviationListCritical.Where(d => d.PlayerToDeviate == selectedEngine);

  private void ToggleCriticalVisualizations()
  {
    showCriticalVisualizations = !showCriticalVisualizations;
    StateHasChanged();
  }

  private void SortBy(string column)
  {
    if (sortColumn == column)
      sortAscending = !sortAscending;
    else
    {
      sortColumn = column;
      sortAscending = true;
    }
    currentPage = 0;
  }

  private MarkupString SortIndicator(string column)
  {
    if (sortColumn != column)
      return new MarkupString("<span class=\"sort-arrow\">&#9650;</span>");
    var arrow = sortAscending ? "&#9650;" : "&#9660;";
    return new MarkupString($"<span class=\"sort-arrow active\">{arrow}</span>");
  }

  private IEnumerable<MoveDeviation> GetSortedItems()
  {
    var items = FilteredDeviationListAll;
    items = sortColumn switch
    {
      "Round" => sortAscending ? items.OrderBy(x => x.Round) : items.OrderByDescending(x => x.Round),
      "GameNr" => sortAscending ? items.OrderBy(x => x.GameNr) : items.OrderByDescending(x => x.GameNr),
      "MoveNr" => sortAscending ? items.OrderBy(x => x.MoveNr) : items.OrderByDescending(x => x.MoveNr),
      "Color" => sortAscending ? items.OrderBy(x => x.Color) : items.OrderByDescending(x => x.Color),
      "Deviator" => sortAscending ? items.OrderBy(x => x.PlayerToDeviate) : items.OrderByDescending(x => x.PlayerToDeviate),
      "Opponent" => sortAscending ? items.OrderBy(x => x.Opponent) : items.OrderByDescending(x => x.Opponent),
      "Move1" => sortAscending ? items.OrderBy(x => x.PrevSanMove.Item1) : items.OrderByDescending(x => x.PrevSanMove.Item1),
      "Move2" => sortAscending ? items.OrderBy(x => x.DevSanMove.Item1) : items.OrderByDescending(x => x.DevSanMove.Item1),
      "Res1" => sortAscending ? items.OrderBy(x => x.Result) : items.OrderByDescending(x => x.Result),
      "Res2" => sortAscending ? items.OrderBy(x => x.DevRes) : items.OrderByDescending(x => x.DevRes),
      _ => items
    };
    return items;
  }

  private IEnumerable<MoveDeviation> GetPagedItems()
  {
    return GetSortedItems().Skip(currentPage * pageSize).Take(pageSize);
  }

  private void PrevPage() { if (currentPage > 0) currentPage--; }
  private void NextPage() { if (currentPage < totalPages - 1) currentPage++; }
  private void ResetPage() { currentPage = 0; }

  double GetScore(MoveDeviation game)
  {
    // The deviator is by definition the side to move at the deviation, which is what Color
    // holds. Deriving it from the reference game's White and the opponent's name only worked
    // when the two games were a straight colour reversal of the same pairing; in a gauntlet the
    // reference game is often against a different opponent, and the colour came out inverted.
    var deviatorColor = game.Color;

    var res = game.Result switch
    {
      "1-0" when game.DevRes == "1/2-1/2" => -0.5,
      "1-0" when game.DevRes == "0-1" => -1,
      "1-0" when game.DevRes == "1-0" => 0,
      "1/2-1/2" when game.DevRes == "1-0" => 0.5,
      "1/2-1/2" when game.DevRes == "0-1" => -0.5,
      "1/2-1/2" when game.DevRes == "1/2-1/2" => 0,
      "0-1" when game.DevRes == "1-0" => 1,
      "0-1" when game.DevRes == "1/2-1/2" => 0.5,
      "0-1" when game.DevRes == "0-1" => 0,
      _ => 0
    };

    return deviatorColor == "w" ? res : -res;
  }

  private bool isProcessing;
  private string processingStatus = "";
  private bool queryLoadAttempted;

  /// Reads one query-string value from the current URL, dependency-free.
  private string GetQuery(string key)
  {
    var q = new Uri(Nav.Uri).Query;
    if (string.IsNullOrEmpty(q)) return null;
    foreach (var part in q.TrimStart('?').Split('&', StringSplitOptions.RemoveEmptyEntries))
    {
      var kv = part.Split('=', 2);
      if (kv.Length == 2 && Uri.UnescapeDataString(kv[0]).Equals(key, StringComparison.OrdinalIgnoreCase))
        return Uri.UnescapeDataString(kv[1]);
    }
    return null;
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (!firstRender || queryLoadAttempted) return;
    queryLoadAttempted = true;

    var path = GetQuery("pgn");
    if (string.IsNullOrWhiteSpace(path)) return;
    if (!File.Exists(path))
    {
      logger.LogWarning("PGN from query string not found: {File}", path);
      return;
    }

    fileName = Path.GetFileName(path);
    await LoadPgnFile(path);
    StateHasChanged();
  }

  private async Task BrowsePgnFile()
  {
    if (isProcessing) return;
    var initialDir = SettingsService.Settings.PgnOutputFolder;
    var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
    {
      { x => x.InitialPath, initialDir },
      { x => x.FileFilter, "*.pgn" },
      { x => x.Mode, FileBrowserMode.File }
    };
    var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
    var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select PGN File", parameters, options);
    var result = await dialog.Result;
    if (result == null || result.Canceled) return;
    var filePath = (string)result.Data!;
    await LoadPgnFile(filePath);
  }

  /// <summary>
  /// Runs the analysis for one PGN. Split out from the file dialog so the page can also be
  /// opened straight at /deviationFinder?pgn=&lt;path&gt;, the way the analysis pages accept ?fen=.
  /// </summary>
  private async Task LoadPgnFile(string filePath)
  {
    if (isProcessing) return;

    var pgnName = Path.GetFileName(filePath);
    fileName = pgnName;
    logger.LogInformation("PGN file opened {File}", pgnName);

    isProcessing = true;
    processingStatus = "Parsing PGN…";
    StateHasChanged();
    var parsed = false;
    try
    {
      List<ChessLibrary.PGNTypes.PgnGame> games;
      try
      {
        games = await Task.Run(() => FullPGNParser.parsePgnFile(filePath).ToList());
      }
      catch (Exception ex)
      {
        logger.LogError(ex, "Failed to parse PGN file {File}", pgnName);
        return;
      }
      if (games.Count == 0)
      {
        logger.LogWarning("No games found in {File} — not a PGN file?", pgnName);
        return;
      }
      loadedGames = games;
      availableEngines = games
        .SelectMany(g => new[] { g.GameMetaData.White, g.GameMetaData.Black })
        .Where(n => !string.IsNullOrWhiteSpace(n))
        .Select(n => n.Trim())
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(n => n, StringComparer.OrdinalIgnoreCase)
        .ToList();
      // A selection made for the previous file may not exist in this one.
      if (!availableEngines.Contains(refPlayer, StringComparer.OrdinalIgnoreCase)) refPlayer = "";
      compareSelection = compareSelection.Where(e => availableEngines.Contains(e, StringComparer.OrdinalIgnoreCase)).ToArray();
      parsed = true;
    }
    finally
    {
      isProcessing = false;
      processingStatus = "";
      StateHasChanged();
    }
    if (parsed) await RunAnalysis();
  }

  /// <summary>
  /// Runs the analysis on the games already in memory with the current engine selection.
  /// Apply calls this directly; loading a file calls it once the file is parsed.
  /// </summary>
  private async Task RunAnalysis()
  {
    if (isProcessing || loadedGames.Count == 0) return;
    var games = loadedGames;
    var pgnName = fileName;
    deviationListCritical.Clear();
    deviationListAll.Clear();
    positionDeviations.Clear();
    engineConsistency.Clear();
    coverage = null;
    selectedPosition = null;
    resultDescription1 = "";
    resultDescription2 = "";

    isProcessing = true;
    processingStatus = $"Analyzing move deviations in {games.Count:N0} games…";
    StateHasChanged();
    try
    {
      var comparList = compareSelection.ToList();
      focusEngines = new HashSet<string>(
        new[] { refPlayer }.Concat(comparList).Where(e => !string.IsNullOrWhiteSpace(e)).Select(e => e.Trim()),
        StringComparer.OrdinalIgnoreCase);
      // Deviation analysis compares games pairwise — quadratic-ish work that must not
      // run on the dispatcher. Materialize the lazy sequences once inside the task
      // instead of re-running the whole analysis on every LINQ enumeration below.
      var (deviations, critical, desc1, desc2, positions) = await Task.Run(() =>
      {
        var devs = DeviationAnalysis.findMoveDifferencesInPGN(games, refPlayer, comparList).ToList();
        var crit = devs.Where(e => e.Result != e.DevRes).ToList();
        // Guarded separately from the legacy analysis: scan replays every game, and a
        // truncated [FEN] tag makes LoadFen throw. Without this, one bad game in a file would
        // blank the whole page, including the reference-replay results that worked before.
        // F# hands back a reference Tuple, not a C# value tuple.
        Tuple<FSharpList<DeviationAnalysis.PositionDeviation>,
              FSharpList<DeviationAnalysis.EngineSelfSummary>,
              DeviationAnalysis.OpeningCoverage> positionResult = null;
        try
        {
          positionResult = DeviationAnalysis.analyzePositionDeviations(games);
        }
        catch (Exception ex)
        {
          logger.LogError(ex, "Position-keyed deviation analysis failed for {File}", pgnName);
        }

        var sb = new StringBuilder();
        foreach (var deviator in crit.Select(e => e.PlayerToDeviate).Distinct())
        {
          var playerDeviations = crit.Where(e => e.PlayerToDeviate == deviator).ToList();
          var playerScore = playerDeviations.Sum(e => GetScore(e));
          sb.AppendLine($"Player: {deviator} did deviate {playerDeviations.Count} times and resulted in a calculated net score of: {playerScore}");
        }
        var sb1 = new StringBuilder();
        foreach (var deviator in devs.Select(e => e.PlayerToDeviate).Distinct())
        {
          var playerDeviations = devs.Where(e => e.PlayerToDeviate == deviator).ToList();
          var playerScore = playerDeviations.Sum(e => GetScore(e));
          sb1.AppendLine($"Player: {deviator} did deviate {playerDeviations.Count} times and resulted in a calculated net score of: {playerScore}");
        }
        return (devs, crit, sb.ToString(), sb1.ToString(), positionResult);
      });

      deviationListAll.AddRange(deviations);
      deviationListCritical.AddRange(critical);
      resultDescription1 = desc1;
      resultDescription2 = desc2;

      // F# returns the three views as a tuple; Item3 carries how reliably opening moves
      // could be identified, which decides whether the self numbers can be trusted.
      positionDeviations = positions?.Item1?.ToList() ?? new();
      engineConsistency = positions?.Item2?.ToList() ?? new();
      coverage = positions?.Item3;
      selectedPosition = null;
      typeFilter = "all";
      logger.LogInformation(resultDescription1);
      logger.LogInformation(resultDescription2);
      logger.LogInformation("Done with calculation");
      currentPage = 0;
    }
    catch (Exception ex)
    {
      logger.LogError(ex, "Deviation analysis failed for {File}", pgnName);
    }
    finally
    {
      isProcessing = false;
      processingStatus = "";
      StateHasChanged();
    }
  }


}

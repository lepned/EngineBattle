@page "/results/ordo"
@page "/ordo"
@inject ILogger<OrdoResults> logger
@inject GlobalSettingsService SettingsService
@inject IDialogService DialogService
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog

<PageTitle>Ordo Ratings</PageTitle>

<div class="tool-page">
	<h1>Ordo Ratings</h1>
	<div class="tool-subtitle">Elo ratings, win/draw/loss and head-to-head statistics</div>

	<div style="max-width:700px">
		<div class="tool-input-group">
			<label>Reference engine name</label>
			<input class="tool-input" style="width:100%" @bind="refEngine" />
		</div>
		<div class="tool-input-group">
			<label>Full path to the Ordo executable</label>
			<div style="display:flex; align-items:stretch;">
				<input class="tool-input" style="width:100%; border-right:none; border-top-right-radius:0; border-bottom-right-radius:0;" @bind="executablePath" />
				<button class="browse-btn" title="Browse" @onclick="@(() => BrowseFile(v => executablePath = v, executablePath, "*.exe"))"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
			</div>
		</div>
	</div>

	<div class="tool-controls">
		<button class="tool-upload-btn" @onclick="BrowsePgnFile">Load pgn file</button>
	</div>

	<div class="file-name">@fileOpenName</div>

	<h2>Ordo-like table</h2>
	<div class="tool-table-container" style="max-width:1300px">
		<table class="tool-table">
			<thead>
				<tr>
					<th>Player</th>
					<th>Elo</th>
					<th>Error</th>
					<th>Points</th>
					<th>Played</th>
					<th>%</th>
					<th>CFS%</th>
					<th>Speed</th>
					<th>W</th>
					<th>D</th>
					<th>L</th>
					<th>D%</th>
					<th>Wscore</th>
					<th>Bscore</th>
					<th>Pairs</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in engineLineData)
				{
					<tr>
						<td>@item.Player</td>
						<td>@item.Elo</td>
						<td>@item.Error.ToString("F0")</td>
						<td>@item.Points</td>
						<td>@item.Played</td>
						<td>@item.Percent.ToString("F0")</td>
						<td>@item.CFS.ToString("F0")</td>
						<td>@FormatSpeedWithEps(item)</td>
						<td>@item.Win</td>
						<td>@item.Draw</td>
						<td>@item.Loss</td>
						<td>@item.D</td>
						<td>@item.WhiteScore</td>
						<td>@item.BlackScore</td>
						<td>@item.PairsString</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

@code {

	private List<PlayerResult> engineLineData = new();
	private string fileOpenName = "";
	private Int64 testDuration = 0;
	private string refEngine = string.Empty;
	private string executablePath = "";
	string FormatSpeedWithEps(PlayerResult p)
	{
		var baseSpeed = GameAnalysis.Formatting.formatNPS(p.MedSpeed);
		if (p.EPS > 0.0)
			return $"{baseSpeed} ({GameAnalysis.Formatting.formatEPS(p.EPS)})";
		return baseSpeed;
	}

	string CheckForNanAndInfinity(double value)
	{
		//if positive infinity return the + infinity symbol
		if (double.IsPositiveInfinity(value))
		{
			return "∞";
		}

		//if negative infinity return the - infinity symbol
		if (double.IsNegativeInfinity(value))
		{
			return "∞";
		}

		//if NaN return the three dashes
		if (double.IsNaN(value))
		{
			return "---";
		}

		return value.ToString("F0");
	}

	bool isChallenger(PlayerResult data)
	{
		var higher = engineLineData.Any(e => (double)e.Played * 1.5 < data.Played);
		return higher;
	}

	private async Task BrowsePgnFile()
	{
		var initialDir = SettingsService.Settings.PgnOutputFolder;
		var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
		{
			{ x => x.InitialPath, initialDir },
			{ x => x.FileFilter, "*.pgn" },
			{ x => x.Mode, FileBrowserMode.File }
		};
		var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
		var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select File", parameters, options);
		var result = await dialog.Result;
		if (result == null || result.Canceled) return;
		var fullPath = (string)result.Data!;

		engineLineData.Clear();
		var pgnName = Path.GetFileName(fullPath);
		fileOpenName = pgnName;
		logger.LogInformation("PGN file opened {File}", pgnName);
		var games = FullPGNParser.parsePgnFile(fullPath).ToList();
		var (allResults, consoleRes, devSummary, engineStats, cross, fraction) = DeviationAnalysis.analyzeDeviations(games);
		GameAnalysis.PGNCalculator.idealizedEloPrint(cross);
		var pentaDefault = Statistics.Pentanomial.formatPerEngineDefault(games);
		//var pentaAlt = Utilities.Pentanomial.formatAllMatchups(games, 200);
		//var both = pentaAlt + "\n\n" + pentaDefault;
		logger.LogInformation("Pentanomial results:\n{Penta}", pentaDefault);
		testDuration = allResults.Sum(r => r.GameTime);
		var testTime = TimeSpan.FromMilliseconds(testDuration);
		var msg = $"Total test duration: {testTime.Days} days, {testTime.Hours} hours and  {testTime.Minutes} minutes";
		logger.LogInformation(msg);
		if (devSummary.Count() > 0)
		{
			var consoleDeviationSummary = DeviationAnalysis.printDeviationsToConsole(devSummary);
			logger.LogInformation("Fraction of games with deviation: {Fraction}", fraction);
			logger.LogInformation(consoleDeviationSummary);
		}
		logger.LogInformation(consoleRes);
		var ordered = engineStats.OrderByDescending(e => e.Points).ThenBy(e => e.Played).ToList();
		engineLineData.AddRange(ordered);
		//UpdateSpeed(games, playerRes, engineLineData);
		logger.LogInformation("PGN file parsed {File}", pgnName);
		StateHasChanged();
		if (!string.IsNullOrEmpty(executablePath))
		{
			// Or the appropriate path on macOS/Linux
			var cmd = GameAnalysis.OrdoHelper.createOrdoCommand(executablePath, fullPath, refEngine);
			var ordoCommandString = $"\n Ordo command: {cmd.Arguments} \n";
			Console.WriteLine(ordoCommandString);
			var ordo = await GameAnalysis.OrdoHelper.runCommandAsync(cmd, engineLineData, System.Threading.CancellationToken.None);
			Console.WriteLine(ordo);
		}

		if (cross.Count > 2)
		{
			var crossTableConsole = GameAnalysis.OrdoHelper.printStatsMatrix(cross);
			logger.LogInformation(crossTableConsole);
		}
		logger.LogInformation("Done with calculation");
		StateHasChanged();
	}

	private string FormatNodes(double nodes)
	{
		if (nodes > 1_000_000_000)
		{
			var giga = nodes / 1_000_000_000;
			return giga.ToString("F2") + "G"; //G
		}

		else if (nodes > 1_000_000)
		{
			var mill = nodes / 1_000_000;
			return mill.ToString("F2") + "M"; //M
		}

		else if (nodes > 1_000)
		{
			var mill = nodes / 1_000;
			return mill.ToString("F1") + "K"; //K
		}

		else
		{
			return nodes.ToString("F1"); //nps
		}
	}


	protected override Task OnInitializedAsync()
	{
		var s = SettingsService.Settings;
		if (!string.IsNullOrEmpty(s.OrdoExePath))
			executablePath = s.OrdoExePath;
		return base.OnInitializedAsync();
	}

	private async Task BrowseFile(Action<string> setter, string currentValue, string filter)
	{
		var initialDir = !string.IsNullOrEmpty(currentValue)
			? (File.Exists(currentValue) ? Path.GetDirectoryName(currentValue) ?? ""
			   : Directory.Exists(currentValue) ? currentValue
			   : Path.GetDirectoryName(currentValue) ?? "")
			: "";
		var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
		{
			{ x => x.InitialPath, initialDir },
			{ x => x.FileFilter, filter },
			{ x => x.Mode, FileBrowserMode.File }
		};
		var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
		var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select File", parameters, options);
		var result = await dialog.Result;
		if (result != null && !result.Canceled) { setter((string)result.Data!); StateHasChanged(); }
	}
}

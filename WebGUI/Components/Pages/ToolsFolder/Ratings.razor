@page "/results/ratings"
@inject ILogger<Ratings> logger
@inject GlobalSettingsService SettingsService
@inject IDialogService DialogService
@inject IJSRuntime JS
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog

<PageTitle>Ratings</PageTitle>

<div class="tool-page">
	<h1>Ratings</h1>
	<div class="tool-subtitle">Elo ratings of every player of a PGN from one fit of all its games (the model Ordo uses), with error bars, the confidence for superiority, win/draw/loss and speed</div>

	<div class="tool-controls">
		<button class="tool-upload-btn" @onclick="BrowsePgnFile" disabled="@isProcessing">Load pgn file</button>
		@if (engineLineData.Count > 0)
		{
			<label style="margin-left:16px">Reference engine</label>
			<select class="tool-input" style="width:320px" @bind="anchorChoice" @bind:after="RerateAsync">
				<option value="">@(autoAnchor == null ? "pool average at 0" : baseStats.Count == 2 ? $"{autoAnchor} at 0 (the match's first player)" : $"{autoAnchor} at 0 (plays every game)")</option>
				@if (autoAnchor != null)
				{
					<option value="@PoolAverage">pool average at 0</option>
				}
				@foreach (var name in playerNames)
				{
					<option value="@name">@name at 0</option>
				}
			</select>
			<button class="tool-upload-btn" style="margin-left:16px" @onclick="CopyTable" title="The table as text, as the console prints it, to the clipboard (and the console)">@copyLabel</button>
		}
	</div>

	<div class="file-name">@fileOpenName</div>

	@if (isProcessing)
	{
		<div class="file-name" style="display:flex; align-items:center; gap:10px;">
			<MudProgressCircular Indeterminate="true" Size="Size.Small" />
			<span>@processingStatus</span>
			<button class="tool-upload-btn" @onclick="CancelProcessing">Cancel</button>
		</div>
	}

	@if (fitSummary.Length > 0)
	{
		<div class="file-name">@fitSummary</div>
	}

	<h2>Ratings</h2>
	<div class="tool-table-container" style="max-width:1300px">
		<table class="tool-table">
			<thead>
				<tr>
					<th>Player</th>
					<th>Elo</th>
					<th>Error</th>
					<th>Points</th>
					<th>Played</th>
					<th>%</th>
					<th title="Confidence that this player is stronger than the next row">CFS%</th>
					<th>Speed</th>
					<th>W</th>
					<th>D</th>
					<th>L</th>
					<th>D%</th>
					<th>Wscore</th>
					<th>Bscore</th>
					<th>Pairs</th>
				</tr>
			</thead>
			<tbody>
				@foreach (var item in engineLineData)
				{
					<tr>
						<td>@item.Player</td>
						<td>@FormatElo(item)</td>
						<td>@FormatError(item)</td>
						<td>@item.Points</td>
						<td>@item.Played</td>
						<td>@item.Percent.ToString("F0")</td>
						<td>@(item.CFS < 0 ? "---" : item.CFS.ToString())</td>
						<td>@FormatSpeedWithEps(item)</td>
						<td>@item.Win</td>
						<td>@item.Draw</td>
						<td>@item.Loss</td>
						<td>@item.D</td>
						<td>@item.WhiteScore</td>
						<td>@item.BlackScore</td>
						<td>@item.PairsString</td>
					</tr>
				}
			</tbody>
		</table>
	</div>
</div>

@code {
	private const string PoolAverage = "*average*";

	private List<PlayerResult> engineLineData = new();
	private List<string> playerNames = new();
	private List<PlayerResult> baseStats = new();
	private Result[] allResults = Array.Empty<Result>();
	private List<ChessLibrary.PGNTypes.PgnGame> loadedGames = new();
	private string fileOpenName = "";
	private string fitSummary = "";
	private string anchorChoice = "";
	// the reference the tables choose themselves (PGNCalculator.defaultAnchor); null = the pool average
	private string autoAnchor = null;
	private string copyLabel = "Copy table as text";
	private Microsoft.FSharp.Core.FSharpOption<RatingFit.Fit> currentFit = null;
	private List<CrossTableEntry> crossTable = new();
	private Int64 testDuration = 0;

	string FormatElo(PlayerResult p) => Double.IsNaN(p.Elo) ? "---" : (Math.Abs(p.Elo) < 0.5 ? 0.0 : p.Elo).ToString("F0");

	// an anchor has no error: its rating is the reference
	string FormatError(PlayerResult p) =>
		p.Error == 0.0 ? "----" : Double.IsNaN(p.Error) ? "---" : Double.IsInfinity(p.Error) ? "∞" : p.Error.ToString("F0");

	string FormatSpeedWithEps(PlayerResult p)
	{
		var baseSpeed = GameAnalysis.Formatting.formatNPS(p.MedSpeed);
		if (p.EPS > 0.0)
			return $"{baseSpeed} ({GameAnalysis.Formatting.formatEPS(p.EPS)})";
		return baseSpeed;
	}

	private bool isProcessing;
	private string processingStatus = "";
	private System.Threading.CancellationTokenSource processingCts;

	private void CancelProcessing() => processingCts?.Cancel();

	private void SetStatus(string status)
	{
		processingStatus = status;
		StateHasChanged();
	}

	/// The table with the chosen reference: the pipeline's own choice (two players: the first at 0,
	/// one in every game: that one, otherwise the pool average), the pool average, or a player at 0. The fit runs off the
	/// dispatcher: an archive of a thousand names takes a moment.
	private async Task RerateAsync()
	{
		if (baseStats.Count == 0) return;
		var choice = anchorChoice;
		var (list, summary) = await Task.Run(() => RateWith(choice));
		engineLineData = list;
		fitSummary = summary;
		StateHasChanged();
	}

	private (List<PlayerResult>, string) RateWith(string choice)
	{
		Microsoft.FSharp.Core.FSharpOption<string> anchor =
			choice == "" ? (autoAnchor != null ? Microsoft.FSharp.Core.FSharpOption<string>.Some(autoAnchor) : null)
			: choice == PoolAverage ? null
			: Microsoft.FSharp.Core.FSharpOption<string>.Some(choice);
		var (rated, fit) = GameAnalysis.PGNCalculator.rerate(anchor, allResults, baseStats);
		var list = rated.ToList();
		// two players: the paired-openings error, as the standings show it
		GameAnalysis.PGNCalculator.populatePentanomialError(list, loadedGames);
		currentFit = fit;
		var summary = "";
		if (fit != null)
		{
			var f = fit.Value;
			var groups = f.Groups.Length > 1 ? $" · {f.Groups.Length} groups of players the games do not connect: ratings compare within a group only" : "";
			summary = $"{allResults.Length:N0} games · white advantage {(Math.Abs(f.WhiteAdvantage) < 0.05 ? 0.0 : f.WhiteAdvantage):+0.0;-0.0;0.0} ± {f.WhiteAdvantageError:0.0} (not in the ratings) · draw rate for equal opponents {f.DrawRate:0.00} % ± {f.DrawRateError:0.00}{groups}";
		}
		// the library's order: the CFS chain follows it
		return (GameAnalysis.StandingsTable.byTableOrder(list).ToList(), summary);
	}

	/// The table with the chosen reference as the console prints it: to the clipboard, and to the console and the log.
	private async Task CopyTable()
	{
		if (engineLineData.Count == 0) return;
		var text = GameAnalysis.StandingsTable.getResultsAndPairsInConsoleFormat(engineLineData, crossTable)
		           + GameAnalysis.PGNCalculator.ratingFitLines(currentFit)
		           + (engineLineData.Count == 2 ? Statistics.Pentanomial.formatSingleMatchupCompact(loadedGames) : "");
		Console.WriteLine(text);
		logger.LogInformation("{Table}", text);
		try
		{
			await JS.InvokeVoidAsync("navigator.clipboard.writeText", text);
			copyLabel = "Copied ✓";
		}
		catch
		{
			copyLabel = "Written to the console";
		}
		StateHasChanged();
		await Task.Delay(1500);
		copyLabel = "Copy table as text";
		try { StateHasChanged(); } catch (ObjectDisposedException) { }
	}

	private async Task BrowsePgnFile()
	{
		if (isProcessing) return;
		var initialDir = SettingsService.Settings.PgnOutputFolder;
		var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
		{
			{ x => x.InitialPath, initialDir },
			{ x => x.FileFilter, "*.pgn" },
			{ x => x.Mode, FileBrowserMode.File }
		};
		var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
		var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select File", parameters, options);
		var result = await dialog.Result;
		if (result == null || result.Canceled) return;
		var fullPath = (string)result.Data!;

		engineLineData.Clear();
		baseStats.Clear();
		playerNames.Clear();
		allResults = Array.Empty<Result>();
		fitSummary = "";
		anchorChoice = "";
		autoAnchor = null;
		var pgnName = Path.GetFileName(fullPath);
		fileOpenName = pgnName;
		logger.LogInformation("PGN file opened {File}", pgnName);

		// All heavy stages run OFF the dispatcher: previously the whole pipeline ran
		// inline in this dialog continuation, so on a big PGN the dialog could not
		// even close until the multi-minute analysis finished.
		processingCts?.Dispose();
		processingCts = new System.Threading.CancellationTokenSource();
		var ct = processingCts.Token;
		isProcessing = true;
		SetStatus("Parsing PGN…");
		try
		{
			List<ChessLibrary.PGNTypes.PgnGame> games;
			try
			{
				games = await Task.Run(() => FullPGNParser.parsePgnFile(fullPath).ToList(), ct);
			}
			catch (Exception ex) when (ex is not OperationCanceledException)
			{
				logger.LogError(ex, "Failed to parse PGN file {File}", pgnName);
				return;
			}
			if (games.Count == 0)
			{
				logger.LogWarning("No games found in {File} — not a PGN file?", pgnName);
				return;
			}
			ct.ThrowIfCancellationRequested();

			// Standings/crosstable only — deviation analysis is for EB's own tournaments
			// (repeated openings) and does not belong in generic PGN result parsing; on a
			// TCEC archive it multiplied the runtime tenfold for a meaningless number.
			SetStatus($"Rating {games.Count:N0} games…");
			var (consoleRes, engineStats, cross, results) =
				await Task.Run(() => GameAnalysis.PGNCalculator.getEngineDataResults(games), ct);
			ct.ThrowIfCancellationRequested();

			SetStatus("Computing pentanomial…");
			var pentaDefault = await Task.Run(() =>
			{
				// Console dump only for crosstables of sane size — with an archive PGN
				// (1384 engines) this printed a 1384-line table for no benefit
				if (cross.Count <= 30)
					GameAnalysis.PGNCalculator.idealizedEloPrint(cross);
				return Statistics.Pentanomial.formatPerEngineDefault(games);
			}, ct);
			logger.LogInformation("Pentanomial results:\n{Penta}", pentaDefault);
			testDuration = results.Sum(r => r.GameTime);
			var testTime = TimeSpan.FromMilliseconds(testDuration);
			var msg = $"Total test duration: {testTime.Days} days, {testTime.Hours} hours and  {testTime.Minutes} minutes";
			logger.LogInformation(msg);
			logger.LogInformation("{Standings}", consoleRes);
			loadedGames = games;
			allResults = results;
			crossTable = cross.ToList();
			baseStats = engineStats.ToList();
			playerNames = baseStats.Select(p => p.Player).OrderBy(n => n).ToList();
			var auto = GameAnalysis.PGNCalculator.defaultAnchorOf(baseStats.Select(p => p.Player), allResults);
			autoAnchor = auto == null ? null : auto.Value;
			await RerateAsync();
			logger.LogInformation("PGN file parsed {File}", pgnName);
			StateHasChanged();

			// The full W-D-L matrix is quadratic in players: for an archive PGN with
			// 1384 engines it was a 27 MB string logged as one line. Cap it at a size
			// a human could actually read.
			if (cross.Count > 2 && cross.Count <= 30)
			{
				var crossTableConsole = await Task.Run(() => GameAnalysis.StandingsTable.printStatsMatrix(cross), ct);
				logger.LogInformation(crossTableConsole);
			}
			logger.LogInformation("Done with calculation");
		}
		catch (OperationCanceledException)
		{
			logger.LogInformation("PGN analysis cancelled by user");
		}
		catch (Exception ex)
		{
			logger.LogError(ex, "PGN analysis failed for {File}", pgnName);
		}
		finally
		{
			isProcessing = false;
			processingStatus = "";
			StateHasChanged();
		}
	}
}

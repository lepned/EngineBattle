@page "/tools/engine-creator"
@page "/engineJSONCreator"
@inject ILogger<DefaultEngineJsonCreator> logger
@inject GlobalSettingsService SettingsService
@inject IDialogService DialogService
@using WebGUI.Services
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog
@using System.Text.Json
@using System.Text.Json.Nodes

<PageTitle>Engine Creator</PageTitle>

<div class="settings-container">
    <h2>Engine Creator</h2>
    <div class="settings-description">Probe a chess engine executable to generate a default engine.json configuration file.</div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-@statusType">
            <span>@statusMessage</span>
            <button class="dismiss-btn" @onclick="() => statusMessage = string.Empty">&times;</button>
        </div>
    }

    <div class="main-grid">
    <!-- Left column: Base config + JSON preview -->
    <div>
    <div class="settings-section">
        <h4>Base Configuration</h4>
        <div class="section-hint">Optionally load an existing engine.json to carry over its settings into the new config.</div>

        <div class="field-row">
            <div class="field-group">
                <label>Base engine.json</label>
                <input type="text" @bind="baseConfigPath" />
                <small>Existing engine.json to copy settings from</small>
            </div>
            <button class="browse-btn" title="Browse" @onclick="@(() => BrowseFile(v => baseConfigPath = v, baseConfigPath, "*.json"))"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
        </div>

        <div class="button-row">
            <button class="btn btn-outline" @onclick="LoadBaseConfig">Load base config</button>
        </div>

        @if (baseConfig != null)
        {
            <div class="alert alert-info" style="margin-top: 0.75rem;">
                <span>Base config loaded: @baseConfig.Name — settings will be applied on probe.</span>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(jsonPreview))
    {
        <div class="settings-section">
            <h4>JSON Preview</h4>
            <div class="section-hint">Review and edit the generated configuration before saving.</div>

            <textarea class="json-preview" @bind="jsonPreview" rows="20"></textarea>

            <div class="button-row">
                <button class="btn btn-success" @onclick="SaveJson">Save JSON</button>
            </div>
        </div>
    }
    </div>

    <!-- Right column: Engine probe -->
    <div class="settings-section">
        <h4>Engine</h4>
        <div class="section-hint">Select the engine executable to probe and the output folder for the generated JSON.</div>

        <div class="field-row">
            <div class="field-group">
                <label>Engine executable path</label>
                <input type="text" @bind="enginePath" />
                <small>Full path to the engine executable</small>
            </div>
            <button class="browse-btn" title="Browse" @onclick="@(() => BrowseFile(v => enginePath = v, enginePath, "*.exe"))"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
        </div>

        <div class="field-row">
            <div class="field-group">
                <label>Output folder</label>
                <input type="text" @bind="outputFolder" />
                <small>Folder where the engine.json file will be saved</small>
            </div>
            <button class="browse-btn" title="Browse" @onclick="@(() => BrowseFolder(v => outputFolder = v, outputFolder))"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
        </div>

        <div class="button-row">
            <button class="btn btn-primary" @onclick="ProbeEngine" disabled="@isProbing">
                @if (isProbing)
                {
                    <span class="spinner"></span>
                    <text>Probing...</text>
                }
                else
                {
                    <text>Probe Engine</text>
                }
            </button>
        </div>
    </div>
    </div>
</div>

@code {
    private string baseConfigPath = "";
    private string enginePath = "";
    private string outputFolder = "";
    private string jsonPreview = "";
    private CoreTypes.EngineConfig baseConfig;
    private string statusMessage = "";
    private string statusType = "info";
    private bool isProbing;
    private string probedEngineName = "";

    protected override void OnInitialized()
    {
        outputFolder = SettingsService.Settings.EngineDefsFolder;
    }

    private void LoadBaseConfig()
    {
        statusMessage = "";
        baseConfig = null;

        if (string.IsNullOrWhiteSpace(baseConfigPath))
        {
            statusMessage = "Base config path is empty.";
            statusType = "warning";
            return;
        }

        if (!File.Exists(baseConfigPath))
        {
            statusMessage = $"File not found: {baseConfigPath}";
            statusType = "error";
            return;
        }

        try
        {
            var json = File.ReadAllText(baseConfigPath);
            var options = new JsonSerializerOptions { PropertyNameCaseInsensitive = true, AllowTrailingCommas = true };
            baseConfig = JsonSerializer.Deserialize<CoreTypes.EngineConfig>(json, options);

            // Pre-fill engine path from base config if the field is empty
            if (string.IsNullOrWhiteSpace(enginePath) && !string.IsNullOrWhiteSpace(baseConfig.Path))
                enginePath = baseConfig.Path;

            statusMessage = $"Loaded base config: {baseConfig.Name}";
            statusType = "success";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error loading base config: {ex.Message}";
            statusType = "error";
        }
    }

    private async Task ProbeEngine()
    {
        statusMessage = "";
        jsonPreview = "";

        if (string.IsNullOrWhiteSpace(enginePath))
        {
            statusMessage = "Engine executable path is required.";
            statusType = "warning";
            return;
        }

        if (!File.Exists(enginePath))
        {
            statusMessage = $"File not found: {enginePath}";
            statusType = "error";
            return;
        }

        isProbing = true;
        StateHasChanged();

        try
        {
            // The probe and the def are the shared EngineProbe module - the mkdef verb is the
            // same code without a screen. What the page adds is the base def and the two
            // folders from Settings.
            var probed = await Task.Run(() => ChessLibrary.EngineProbe.probe(enginePath, 15000));
            if (probed.IsError)
            {
                statusMessage = probed.ErrorValue;
                statusType = "error";
                return;
            }
            var built = ChessLibrary.EngineProbe.buildForGui(
                probed.ResultValue, baseConfig,
                SettingsService.Settings.NeuralNetFolder ?? "",
                SettingsService.Settings.TablebaseFolder ?? "");
            if (built.IsError)
            {
                statusMessage = built.ErrorValue;
                statusType = "error";
                return;
            }
            var defs = built.ResultValue.Options;
            jsonPreview = ChessLibrary.EngineProbe.toJson(built.ResultValue);
            probedEngineName = Path.GetFileNameWithoutExtension(ChessLibrary.EngineProbe.defFileName(built.ResultValue));

            var baseNote = baseConfig != null ? $" (with settings from {baseConfig.Name})" : "";
            statusMessage = $"Successfully probed {probedEngineName} — {defs.Count} UCI options detected.{baseNote}";
            statusType = "success";
        }
        catch (OperationCanceledException)
        {
            statusMessage = "Engine probe timed out after 15 seconds. The engine may be unresponsive or not a valid UCI engine.";
            statusType = "error";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error probing engine: {ex.Message}";
            statusType = "error";
            logger.LogError(ex, "Failed to probe engine at {Path}", enginePath);
        }
        finally
        {
            isProbing = false;
        }
    }

    private async Task SaveJson()
    {
        statusMessage = "";

        if (string.IsNullOrWhiteSpace(jsonPreview))
        {
            statusMessage = "Nothing to save — probe an engine first.";
            statusType = "warning";
            return;
        }

        if (string.IsNullOrWhiteSpace(outputFolder))
        {
            statusMessage = "Output folder path is required.";
            statusType = "warning";
            return;
        }

        if (!Directory.Exists(outputFolder))
        {
            statusMessage = $"Output folder does not exist: {outputFolder}";
            statusType = "error";
            return;
        }

        try
        {
            var outPath = GetUniqueFilePath(outputFolder, probedEngineName);
            await File.WriteAllTextAsync(outPath, jsonPreview);
            statusMessage = $"Saved to {outPath}";
            statusType = "success";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving file: {ex.Message}";
            statusType = "error";
            logger.LogError(ex, "Failed to save engine JSON");
        }
    }

    private static string GetUniqueFilePath(string folder, string baseName)
    {
        var path = Path.Combine(folder, $"{baseName}.json");
        if (!File.Exists(path))
            return path;

        for (int i = 1; i <= 99; i++)
        {
            path = Path.Combine(folder, $"{baseName}_{i:D2}.json");
            if (!File.Exists(path))
                return path;
        }
        return path;
    }

    private async Task BrowseFolder(Action<string> setter, string currentValue)
    {
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, currentValue },
            { x => x.Mode, FileBrowserMode.Folder }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select Folder", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) { setter((string)result.Data!); StateHasChanged(); }
    }

    private async Task BrowseFile(Action<string> setter, string currentValue, string filter)
    {
        var initialDir = !string.IsNullOrEmpty(currentValue)
            ? (File.Exists(currentValue) ? Path.GetDirectoryName(currentValue) ?? ""
               : Directory.Exists(currentValue) ? currentValue
               : Path.GetDirectoryName(currentValue) ?? "")
            : "";
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, initialDir },
            { x => x.FileFilter, filter },
            { x => x.Mode, FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select File", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) { setter((string)result.Data!); StateHasChanged(); }
    }
}

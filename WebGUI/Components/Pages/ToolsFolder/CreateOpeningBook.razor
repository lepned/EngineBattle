@page "/tools/pgn-tools"
@page "/tools/opening-book"
@page "/results/pgn-utilities"
@page "/createOpeningBook"
@page "/pgnUtilities"
@inject ILogger<CreateOpeningBook> logger
@inject GlobalSettingsService SettingsService
@inject IDialogService DialogService
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog
@using Microsoft.FSharp.Core
@implements IDisposable

<PageTitle>PGN Tools</PageTitle>

<div class="tool-page pgn-tools-compact">
  <h1>PGN Tools</h1>
  <div class="tool-subtitle">Create opening books, transform and clean up PGN files</div>

  @if (!string.IsNullOrEmpty(statusMessage))
  {
    <div style="margin:8px 0; font-weight:500; color:@(isError ? "#ef5350" : "#8b9cd0")">@statusMessage</div>
  }

  @if (isProcessing)
  {
    <div style="display:flex; align-items:center; gap:8px; margin:8px 0;">
      <div class="tool-spinner"></div>
      <span>@processingLabel</span>
    </div>
  }

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="tool-section">
      <h2>Opening Book from TCEC/CCC Games</h2>
      <p>Creates a PGN-based opening book from a PGN file downloaded from TCEC/CCC archives.</p>
      <div class="tool-input-group">
        <label>Output file path</label>
        <input type="text" class="tool-input" style="width:100%" @bind="pgnOpeningFullName" />
      </div>
      <button class="tool-upload-btn" @onclick="BrowseCreateOpeningBookPgnFile" disabled="@isProcessing">Load PGN file</button>
    </div>

    <div class="tool-section">
      <h2>Opening Book from EPD</h2>
      <p>Converts an EPD file to PGN. Output saved as <code>&lt;filename&gt;.pgn</code> in the output directory.</p>
      <div class="tool-input-group">
        <label>Output directory path</label>
        <div style="display:flex; gap:4px; align-items:center;">
          <input type="text" class="tool-input" style="width:100%" @bind="epdToPgnFileName" />
          <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small"
                         OnClick="@(() => BrowseFolder(v => epdToPgnFileName = v, epdToPgnFileName))" />
        </div>
      </div>
      <button class="tool-upload-btn" @onclick="BrowseEpdToPgnFile" disabled="@isProcessing">Load EPD file</button>
    </div>
  </div>

  @* Polyglot books: made from games, and read back as PGN openings (PolyglotLines, as eb-cli book make/export) *@
  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="tool-section">
      <h2>Polyglot Book from PGN Games</h2>
      <p>Makes a Polyglot book (<code>.bin</code>) from games. Every move up to Max ply is counted, and a move's weight is its score for the side that played it: 2 for a win, 1 for a draw, 0 for a loss, added up over the games. For tournaments (OpeningsPath) and the analysis page's Book card.</p>
      <div class="tool-input-group">
        <label>Games (.pgn)</label>
        <div style="display:flex; gap:4px; align-items:center;">
          <input type="text" class="tool-input" style="width:100%" @bind="makeGamesPath" />
          <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small"
                         OnClick="@(() => BrowseFileTo(v => { makeGamesPath = v; makeBookPath = Path.ChangeExtension(v, ".bin"); }, makeGamesPath, "*.pgn", "Select the games"))" />
        </div>
      </div>
      <div class="tool-input-group">
        <label>Book (.bin)</label>
        <input type="text" class="tool-input" style="width:100%" @bind="makeBookPath" />
      </div>
      <div style="display:flex; gap:12px; align-items:end; flex-wrap:wrap;">
        <div class="tool-input-group" style="margin-bottom:0"><label>Max ply</label><input type="number" class="tool-input" style="width:90px" @bind="makeMaxPly" min="1" max="200" /></div>
        <div class="tool-input-group" style="margin-bottom:0"><label>Min games per move</label><input type="number" class="tool-input" style="width:90px" @bind="makeMinGames" min="1" /></div>
        <label style="display:flex; gap:6px; align-items:center;" title="Results do not count: also for opening files whose lines have no result"><input type="checkbox" @bind="makeUniform" /> Every move weighs 1</label>
      </div>
      <button class="tool-action-btn" style="margin-top:8px;" @onclick="MakePolyglotBook" disabled="@(isProcessing || string.IsNullOrWhiteSpace(makeGamesPath) || string.IsNullOrWhiteSpace(makeBookPath))">Make book</button>
    </div>

    <div class="tool-section">
      <h2>PGN Openings from a Polyglot Book</h2>
      <p>Writes a book's lines as a PGN opening file. <b>Tree</b>: every move with at least the share of its position's weight. <b>Draw</b>: lines drawn by the book's weights, the very openings a tournament plays with this book, OpeningsPly = max ply and the seed (a tournament with OpeningsSkip starts that many lines further on).</p>
      <div class="tool-input-group">
        <label>Book (.bin)</label>
        <div style="display:flex; gap:4px; align-items:center;">
          <input type="text" class="tool-input" style="width:100%" @bind="exportBookPath" />
          <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small"
                         OnClick="@(() => BrowseFileTo(v => { exportBookPath = v; exportPgnPath = Path.ChangeExtension(v, ".pgn"); }, exportBookPath, "*.bin", "Select a Polyglot book"))" />
        </div>
      </div>
      <div class="tool-input-group">
        <label>Openings (.pgn)</label>
        <input type="text" class="tool-input" style="width:100%" @bind="exportPgnPath" />
      </div>
      <div style="display:flex; gap:12px; align-items:end; flex-wrap:wrap;">
        <div class="tool-input-group" style="margin-bottom:0"><label>Mode</label>
          <select class="tool-input" style="width:100px" @bind="exportMode"><option value="tree">Tree</option><option value="draw">Draw</option></select></div>
        <div class="tool-input-group" style="margin-bottom:0"><label>Max ply</label><input type="number" class="tool-input" style="width:80px" @bind="exportMaxPly" min="1" max="200" /></div>
        @if (exportMode == "tree")
        {
          <div class="tool-input-group" style="margin-bottom:0"><label>Min share %</label><input type="number" class="tool-input" style="width:80px" @bind="exportMinShare" min="0" max="100" step="1" /></div>
          <div class="tool-input-group" style="margin-bottom:0"><label>Max lines</label><input type="number" class="tool-input" style="width:100px" @bind="exportMaxLines" min="1" /></div>
        }
        else
        {
          <div class="tool-input-group" style="margin-bottom:0"><label>Lines</label><input type="number" class="tool-input" style="width:100px" @bind="exportCount" min="1" /></div>
          <div class="tool-input-group" style="margin-bottom:0"><label>Seed</label><input type="number" class="tool-input" style="width:100px" @bind="exportSeed" /></div>
        }
      </div>
      <button class="tool-action-btn" style="margin-top:8px;" @onclick="ExportPolyglotBook" disabled="@(isProcessing || string.IsNullOrWhiteSpace(exportBookPath) || string.IsNullOrWhiteSpace(exportPgnPath))">Write openings</button>
    </div>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="tool-section">
      <h2>Generate Chess960 Positions</h2>
      <p>Creates an EPD file with random Chess960 positions. Output saved as <code>Chess960_{N}.epd</code> or <code>Chess960Double_{N}.epd</code>.</p>
      <div class="tool-input-group">
        <label>Output folder path</label>
        <div style="display:flex; gap:4px; align-items:center;">
          <input type="text" class="tool-input" style="width:100%" @bind="chess960Path" />
          <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small"
                         OnClick="@(() => BrowseFolder(v => chess960Path = v, chess960Path))" />
        </div>
      </div>
      <div class="tool-input-group">
        <label>Number of positions</label>
        <input type="number" class="tool-input" style="width:120px" @bind="numberOfPositions" min="1" max="960" step="1" />
      </div>
      <div style="display:flex; gap:8px;">
        <button class="tool-action-btn" @onclick="GenerateChess960Positions" disabled="@isProcessing">Create FRC book</button>
        <button class="tool-action-btn" @onclick="GenerateDoubleChess960Positions" disabled="@isProcessing">Create DFRC book</button>
      </div>
    </div>

    <div class="tool-section">
      <h2>Shuffle PGN</h2>
      <p>Shuffle games from an existing PGN file. Output saved as <code>Shuffled_&lt;filename&gt;</code>.</p>
      <div class="tool-input-group">
        <label>Output folder path</label>
        <div style="display:flex; gap:4px; align-items:center;">
          <input type="text" class="tool-input" style="width:100%" @bind="shuffleOutputPath" />
          <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small"
                         OnClick="@(() => BrowseFolder(v => shuffleOutputPath = v, shuffleOutputPath))" />
        </div>
      </div>
      <button class="tool-upload-btn" @onclick="BrowseShufflePgnFile" disabled="@isProcessing">Pick PGN file</button>
    </div>
  </div>

  <div class="tool-section">
    <h2>Remove Engine from PGN</h2>
    <p class="tool-section-desc">Remove all games associated with a specific engine. Output saved as <code>&lt;filename&gt;_&lt;engine&gt;_Removed.pgn</code>.</p>
    <div class="tool-controls">
      <div class="tool-input-group" style="margin-bottom:0; flex:1; max-width:300px;">
        <label>Output folder</label>
        <input class="tool-input" style="width:100%" @bind="removeEnginePath" />
      </div>
      <div class="tool-input-group" style="margin-bottom:0; flex:1; max-width:300px;">
        <label>Engine name to remove</label>
        <input class="tool-input" style="width:100%" @bind="removeEngineName" />
      </div>
      <button class="tool-upload-btn" style="align-self:flex-end;" @onclick="BrowseRemoveEnginePgnFile">Pick PGN file</button>
    </div>
  </div>

  <div style="display:grid; grid-template-columns:1fr 1fr; gap:16px;">
    <div class="tool-section">
      <h2>Export-Ready PGN</h2>
      <p class="tool-section-desc">Ensure blank lines between games for proper formatting. Output saved as <code>&lt;filename&gt;_ExportReady.pgn</code>.</p>
      <div class="tool-input-group">
        <label>Output folder</label>
        <input class="tool-input" style="width:100%" @bind="removeEnginePath" />
      </div>
      <button class="tool-upload-btn" @onclick="BrowseExportReadyPgnFile">Pick PGN file</button>
    </div>

    <div class="tool-section">
      <h2>Minimal PGN</h2>
      <p class="tool-section-desc">Strip all engine annotations from a PGN file.</p>
      <div class="tool-input-group">
        <label>Output file path</label>
        <input class="tool-input" style="width:100%" @bind="minimalPGNpath" />
      </div>
      <button class="tool-upload-btn" @onclick="BrowseMinimalPgnFile">Pick PGN file</button>
    </div>
  </div>
</div>

@code {

	// Opening book fields
	private string pgnOpeningFullName = "";
	private string epdToPgnFileName = "";
	private string chess960Path = "";
	private string shuffleOutputPath = "";
	private int numberOfPositions = 960;

	// Polyglot book fields (the defaults are eb-cli book make/export's)
	private string makeGamesPath = "";
	private string makeBookPath = "";
	private int makeMaxPly = 30;
	private int makeMinGames = 3;
	private bool makeUniform;
	private string exportBookPath = "";
	private string exportPgnPath = "";
	private string exportMode = "tree";
	private int exportMaxPly = 16;
	private double exportMinShare = 10;
	private int exportMaxLines = 10000;
	private int exportCount = 500;
	private int exportSeed;

	// a book being made stops when the page goes away (makeBook's progress callback throws)
	private readonly CancellationTokenSource pageCts = new();
	public void Dispose() { pageCts.Cancel(); pageCts.Dispose(); }

	/// <summary>Whether an output file may be written: yes when it does not exist, or when the user says to write over it.</summary>
	private async Task<bool> MayWrite(string path)
	{
		if (!File.Exists(path)) return true;
		var answer = await DialogService.ShowMessageBox("File exists", $"{path} exists. Write over it?", yesText: "Write over it", cancelText: "Cancel");
		return answer == true;
	}

	// PGN utility fields
	private string removeEnginePath = "";
	private string minimalPGNpath = "";
	private string removeEngineName = "";

	// Shared state
	private bool isProcessing;
	private string processingLabel = "";
	private string statusMessage = "";
	private bool isError;

	private void SetStatus(string message, bool error = false)
	{
		statusMessage = message;
		isError = error;
	}

	// --- Opening Book methods ---

	private async Task GenerateChess960Positions()
	{
		SetStatus("");
		isProcessing = true;
		processingLabel = "Generating Chess960 positions...";
		StateHasChanged();
		try
		{
			await Task.Run(() => ChessUtilities.Chess960.writeChess960PositionsToFile(chess960Path, numberOfPositions));
			SetStatus($"FRC book written to {chess960Path}");
		}
		catch (Exception ex)
		{
			logger.LogError(ex, "Failed to generate Chess960 positions");
			SetStatus($"Error: {ex.Message}", true);
		}
		finally
		{
			isProcessing = false;
			StateHasChanged();
		}
	}

	private async Task GenerateDoubleChess960Positions()
	{
		SetStatus("");
		isProcessing = true;
		processingLabel = "Generating DFRC positions...";
		StateHasChanged();
		try
		{
			await Task.Run(() => ChessUtilities.Chess960.writeChess960DoublePositionsToFile(chess960Path, numberOfPositions));
			SetStatus($"DFRC book written to {chess960Path}");
		}
		catch (Exception ex)
		{
			logger.LogError(ex, "Failed to generate DFRC positions");
			SetStatus($"Error: {ex.Message}", true);
		}
		finally
		{
			isProcessing = false;
			StateHasChanged();
		}
	}

	private async Task BrowseShufflePgnFile()
	{
		var filePath = await BrowsePgnFile();
		if (filePath == null) return;

		var pgnName = Path.GetFileName(filePath);
		logger.LogInformation("PGN file opened {File}", pgnName);
		SetStatus("");
		isProcessing = true;
		processingLabel = $"Shuffling {pgnName}...";
		StateHasChanged();

		try
		{
			await Task.Run(() =>
			{
				var games = FullPGNParser.parsePgnFileWithRaw(filePath);
				var outputPath = Path.Combine(shuffleOutputPath, $"Shuffled_{pgnName}");
				PGNHelper.shufflePgnGames(outputPath, games);
				SetStatus($"Shuffled opening book written to {outputPath}");
				logger.LogInformation("Opening book was shuffled and written to {Path}", outputPath);
			});
		}
		catch (Exception ex)
		{
			logger.LogError(ex, "Failed to shuffle PGN file");
			SetStatus($"Error: {ex.Message}", true);
		}
		finally
		{
			isProcessing = false;
			StateHasChanged();
		}
	}

	private async Task BrowseCreateOpeningBookPgnFile()
	{
		var filePath = await BrowsePgnFile();
		if (filePath == null) return;

		var pgnName = Path.GetFileName(filePath);
		logger.LogInformation("PGN file opened {File}", pgnName);
		SetStatus("");
		isProcessing = true;
		processingLabel = $"Creating opening book from {pgnName}...";
		StateHasChanged();

		try
		{
			await Task.Run(() =>
			{
				var games = FullPGNParser.parsePgnFile(filePath);
				PGNWriter.writeOpeningPgnFile(games, pgnOpeningFullName);
				SetStatus($"Opening book created and written to {pgnOpeningFullName}");
				logger.LogInformation("Opening book created from {File}. Written to {Path}", pgnName, pgnOpeningFullName);
			});
		}
		catch (Exception ex)
		{
			logger.LogError(ex, "Failed to create opening book from PGN");
			SetStatus($"Error: {ex.Message}", true);
		}
		finally
		{
			isProcessing = false;
			StateHasChanged();
		}
	}

	private async Task BrowseEpdToPgnFile()
	{
		var initialDir = SettingsService.Settings.OpeningsFolder;
		var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
		{
			{ x => x.InitialPath, initialDir },
			{ x => x.FileFilter, "*.epd" },
			{ x => x.Mode, FileBrowserMode.File }
		};
		var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
		var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select EPD File", parameters, options);
		var result = await dialog.Result;
		if (result == null || result.Canceled) return;
		var filePath = (string)result.Data!;

		var epdName = Path.GetFileName(filePath);
		logger.LogInformation("EPD file opened {File}", epdName);
		SetStatus("");
		isProcessing = true;
		processingLabel = $"Converting {epdName} to PGN...";
		StateHasChanged();

		try
		{
			await Task.Run(() =>
			{
				var fileNameWithoutExt = Path.GetFileNameWithoutExtension(filePath);
				// epdToPgnFileName IS the output directory (filled by the folder browser) —
				// Path.GetDirectoryName on it returned its PARENT, writing the PGN one level up.
				var directory = epdToPgnFileName?.Trim();
				if (string.IsNullOrEmpty(directory) || !Directory.Exists(directory))
				{
					SetStatus("Output directory path is not valid.", true);
					return;
				}
				var newFilePath = Path.Combine(directory, fileNameWithoutExt + ".pgn");
				var games = EPDExtractor.readEPDs(filePath).ToList();
				PGNWriter.writeOpeningPgnFromEPD(games, newFilePath);
				SetStatus($"Opening book written to {newFilePath}");
				logger.LogInformation("Opening book written to {Path}", newFilePath);
			});
		}
		catch (Exception ex)
		{
			logger.LogError(ex, "Failed to convert EPD to PGN");
			SetStatus($"Error: {ex.Message}", true);
		}
		finally
		{
			isProcessing = false;
			StateHasChanged();
		}
	}

	// --- PGN Utility methods ---

	private string GetRemoveFileName(string pgn, string playerToRemove)
	{
		string fileName = Path.GetFileNameWithoutExtension(pgn);
		string fileExt = Path.GetExtension(pgn);
		return Path.Combine(removeEnginePath, $"{fileName}_{playerToRemove}_Removed{fileExt}");
	}

	private string GetExportFileName(string pgn)
	{
		string fileName = Path.GetFileNameWithoutExtension(pgn);
		string fileExt = Path.GetExtension(pgn);
		return Path.Combine(removeEnginePath, $"{fileName}_ExportReady{fileExt}");
	}

	private async Task BrowseMinimalPgnFile()
	{
		SetStatus("");
		if (string.IsNullOrEmpty(minimalPGNpath))
		{
			SetStatus("Output file path is not specified", true);
			return;
		}
		var filePath = await BrowsePgnFile();
		if (filePath == null) return;

		var pgnName = Path.GetFileName(filePath);
		logger.LogInformation("PGN file opened {File}", pgnName);
		try
		{
			var games = FullPGNParser.parsePgnFile(filePath);
			PGNWriter.writeMinimalPgnFile(games, minimalPGNpath);
			SetStatus($"Minimal PGN written to {minimalPGNpath}");
			logger.LogInformation("Done with writing minimal PGN file to {Path}", minimalPGNpath);
		}
		catch (Exception ex)
		{
			SetStatus($"Error: {ex.Message}", true);
			logger.LogError(ex, "Failed to process PGN file {File}", pgnName);
		}
	}

	private async Task BrowseExportReadyPgnFile()
	{
		SetStatus("");
		if (string.IsNullOrEmpty(removeEnginePath))
		{
			SetStatus("Output folder is not specified", true);
			return;
		}
		var filePath = await BrowsePgnFile();
		if (filePath == null) return;

		var pgnName = Path.GetFileName(filePath);
		logger.LogInformation("PGN file opened {File} for export", pgnName);
		try
		{
			var games = FullPGNParser.parsePgnFileWithRaw(filePath);
			var exportPath = GetExportFileName(pgnName);
			PGNWriter.ensureBlankLinesBetweenGames(exportPath, games);
			SetStatus($"Export-ready PGN written to {exportPath}");
			logger.LogInformation("PGN-file was made ready for export and written to {Path}", exportPath);
		}
		catch (Exception ex)
		{
			SetStatus($"Error: {ex.Message}", true);
			logger.LogError(ex, "Failed to process PGN file {File}", pgnName);
		}
	}

	private async Task BrowseRemoveEnginePgnFile()
	{
		SetStatus("");
		if (string.IsNullOrEmpty(removeEnginePath))
		{
			SetStatus("Output folder is not specified", true);
			return;
		}
		if (string.IsNullOrEmpty(removeEngineName))
		{
			SetStatus("Engine name is not specified", true);
			return;
		}
		var filePath = await BrowsePgnFile();
		if (filePath == null) return;

		var pgnName = Path.GetFileName(filePath);
		logger.LogInformation("PGN file opened {File}", pgnName);
		try
		{
			var games = FullPGNParser.parsePgnFileWithRaw(filePath);
			var fileNamePath = GetRemoveFileName(pgnName, removeEngineName);
			PGNWriter.removePlayerFromPGN(removeEngineName, games, fileNamePath);
			SetStatus($"Engine '{removeEngineName}' removed. Written to {fileNamePath}");
			logger.LogInformation("Engine {Engine} was removed from PGN-file and written to {Path}", removeEngineName, fileNamePath);
		}
		catch (Exception ex)
		{
			SetStatus($"Error: {ex.Message}", true);
			logger.LogError(ex, "Failed to process PGN file {File}", pgnName);
		}
	}

	// --- Shared helpers ---

	protected override Task OnInitializedAsync()
	{
		var s = SettingsService.Settings;
		if (!string.IsNullOrEmpty(s.PgnOutputFolder))
		{
			pgnOpeningFullName = Path.Combine(s.PgnOutputFolder, "openingbookCreator1.pgn");
			epdToPgnFileName = s.PgnOutputFolder;
			removeEnginePath = s.PgnOutputFolder;
			minimalPGNpath = Path.Combine(s.PgnOutputFolder, "minimalPGN1.pgn");
		}
		if (!string.IsNullOrEmpty(s.OpeningsFolder))
		{
			chess960Path = s.OpeningsFolder;
			shuffleOutputPath = s.OpeningsFolder;
		}
		return base.OnInitializedAsync();
	}

	// --- Polyglot books ---

	private async Task MakePolyglotBook()
	{
		// the run uses the values as they are now: the fields stay editable while it runs
		var games = makeGamesPath;
		var bookPath = makeBookPath;
		var minGames = makeMinGames;
		if (makeMaxPly < 1 || minGames < 1) { SetStatus("Max ply and min games must be 1 or more.", true); return; }
		if (!File.Exists(games)) { SetStatus($"Games not found: {games}", true); return; }
		if (string.Equals(Path.GetFullPath(games), Path.GetFullPath(bookPath), StringComparison.OrdinalIgnoreCase))
		{ SetStatus("The book would be written over the games: give the book its own path.", true); return; }
		if (!await MayWrite(bookPath)) return;
		var name = Path.GetFileName(games);
		var token = pageCts.Token;
		SetStatus("");
		isProcessing = true;
		processingLabel = $"Making a book from {name}...";
		StateHasChanged();
		try
		{
			var options = new ChessLibrary.PolyglotLines.MakeOptions(makeMaxPly, minGames, makeUniform);
			var sw = System.Diagnostics.Stopwatch.StartNew();
			var summary = await Task.Run(() =>
				ChessLibrary.PolyglotLines.makeBook(FullPGNParser.parsePgnFile(games), options, bookPath,
					FuncConvert.FromAction<int>(n =>
					{
						token.ThrowIfCancellationRequested();
						_ = InvokeAsync(() => { processingLabel = $"Making a book from {name}: {n:N0} games read..."; StateHasChanged(); });
					})), token);
			var skipped = summary.Skipped > 0 ? $", {summary.Skipped:N0} skipped (Chess960, another variant, or no result)" : "";
			var cut = summary.Broken > 0 ? $", {summary.Broken:N0} cut short at a move that could not be played" : "";
			if (summary.Used == 0)
				SetStatus($"No book written: none of the {summary.Games:N0} games could be used (Chess960, another variant, or no result)."
				          + (makeUniform ? "" : " An opening file whose lines end in * has no results: tick Every move weighs 1."), true);
			else if (summary.Moves == 0)
				SetStatus($"No book written: no move was played in {minGames} games or more ({summary.Used:N0} games used{skipped}). Lower the min games.", true);
			else
				SetStatus($"Book written to {bookPath}: {summary.Positions:N0} positions, {summary.Moves:N0} moves from {summary.Used:N0} games{skipped}{cut}, in {sw.Elapsed.TotalSeconds:0.0} s.");
			logger.LogInformation("Polyglot book from {File}: {Moves} moves, {Positions} positions", name, summary.Moves, summary.Positions);
		}
		catch (OperationCanceledException) { }
		catch (Exception ex)
		{
			logger.LogError(ex, "Failed to make a Polyglot book");
			SetStatus($"Error: {ex.Message}", true);
		}
		finally
		{
			isProcessing = false;
			StateHasChanged();
		}
	}

	private async Task ExportPolyglotBook()
	{
		// the run uses the values as they are now: the fields stay editable while it runs
		var bookPath = exportBookPath;
		var pgnPath = exportPgnPath;
		var maxPly = exportMaxPly;
		var count = exportCount;
		var seed = exportSeed;
		var minShare = exportMinShare;
		var maxLines = exportMaxLines;
		var draw = exportMode == "draw";
		if (maxPly < 1) { SetStatus("Max ply must be 1 or more.", true); return; }
		if (!File.Exists(bookPath)) { SetStatus($"Book not found: {bookPath}", true); return; }
		var problem = ChessLibrary.PolyglotFormat.sizeProblem(Path.GetFileName(bookPath), new FileInfo(bookPath).Length);
		if (FSharpOption<string>.get_IsSome(problem)) { SetStatus(problem.Value, true); return; }
		if (draw && count < 1) { SetStatus("Lines must be 1 or more.", true); return; }
		if (!draw && (minShare < 0 || minShare > 100 || maxLines < 1)) { SetStatus("Min share is 0 to 100, max lines 1 or more.", true); return; }
		if (!await MayWrite(pgnPath)) return;
		SetStatus("");
		isProcessing = true;
		processingLabel = $"Writing openings from {Path.GetFileName(bookPath)}...";
		StateHasChanged();
		try
		{
			var (written, note) = await Task.Run(() =>
			{
				// nothing is written when there are no lines: a file already at the path is kept
				if (draw)
				{
					var lines = ChessLibrary.PolyglotLines.lines(bookPath, count, seed, maxPly);
					if (lines.Length > 0) ChessLibrary.PolyglotLines.writePgn(pgnPath, lines);
					return (lines.Length, lines.Length < count ? $" The book gives {lines.Length} different lines of up to {maxPly} plies; {count} were asked for." : "");
				}
				var (tree, capped) = ChessLibrary.PolyglotLines.exportTree(bookPath, maxPly, minShare, maxLines);
				if (tree.Length > 0) ChessLibrary.PolyglotLines.writePgn(pgnPath, tree);
				return (tree.Length, capped ? $" Stopped at {maxLines} lines: raise max lines or min share for the whole tree." : "");
			});
			if (written == 0)
				SetStatus(draw ? "No lines, nothing written: the book does not hold the start position."
				               : "No lines, nothing written: the book does not hold the start position, or no move has the share asked for.", true);
			else
				SetStatus($"{written:N0} openings written to {pgnPath}.{note}");
		}
		catch (Exception ex)
		{
			logger.LogError(ex, "Failed to write openings from a Polyglot book");
			SetStatus($"Error: {ex.Message}", true);
		}
		finally
		{
			isProcessing = false;
			StateHasChanged();
		}
	}

	/// <summary>A file picked in the file browser, starting where the current value is (or the Openings folder).</summary>
	private async Task BrowseFileTo(Action<string> setter, string currentValue, string filter, string title)
	{
		var initialDir = !string.IsNullOrWhiteSpace(currentValue) && File.Exists(currentValue)
			? Path.GetDirectoryName(currentValue) ?? ""
			: (filter == "*.pgn" ? SettingsService.Settings.PgnOutputFolder : SettingsService.Settings.OpeningsFolder) ?? "";
		var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
		{
			{ x => x.InitialPath, initialDir },
			{ x => x.FileFilter, filter },
			{ x => x.Mode, FileBrowserMode.File }
		};
		var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
		var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>(title, parameters, options);
		var result = await dialog.Result;
		if (result != null && !result.Canceled) { setter((string)result.Data!); StateHasChanged(); }
	}

	private async Task<string> BrowsePgnFile()
	{
		var initialDir = SettingsService.Settings.PgnOutputFolder;
		var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
		{
			{ x => x.InitialPath, initialDir },
			{ x => x.FileFilter, "*.pgn" },
			{ x => x.Mode, FileBrowserMode.File }
		};
		var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
		var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select PGN File", parameters, options);
		var result = await dialog.Result;
		if (result == null || result.Canceled) return null;
		return (string)result.Data!;
	}

	private async Task BrowseFolder(Action<string> setter, string currentValue)
	{
		var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>

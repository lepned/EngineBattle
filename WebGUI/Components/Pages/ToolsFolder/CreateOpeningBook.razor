@page "/tools/opening-book"
@page "/createOpeningBook"
@inject ILogger<CreateOpeningBook> logger
@inject GlobalSettingsService SettingsService
@inject IDialogService DialogService
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog

<InputFile id="pgnCreateInput" OnChange="@CreateOpeningBookFromPgnAsync" hidden />
<InputFile id="bookEvalInput" OnChange="@EvaluateAndSortOpeningBookAsync" hidden />
<InputFile id="epdToPgnInput" OnChange="@ConvertEpdToPgnAsync" hidden />
<InputFile id="pgnShuffleInput" OnChange="@ShufflePgnOpeningBookAsync" hidden />

<PageTitle>Opening Book</PageTitle>

<div class="tool-page">
  <h1>Opening Book Tools</h1>
  <div class="tool-subtitle">Create, evaluate and shuffle chess opening books</div>

  <div class="tool-section">
    <h2>Generate Chess960 Positions</h2>
    <p>Creates an EPD file containing random Chess960 positions, suitable for use as an opening book.</p>
    <div class="tool-controls">
      <div class="tool-input-group" style="margin-bottom:0; flex:1; max-width:400px;">
        <label>Output folder path</label>
        <div style="display:flex; gap:4px; align-items:center;">
          <input type="text" class="tool-input" style="width:100%" @bind="chess960Path" />
          <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small"
                         OnClick="@(() => BrowseFolder(v => chess960Path = v, chess960Path))" />
        </div>
      </div>
      <div class="tool-input-group" style="margin-bottom:0">
        <label>Number of positions</label>
        <input type="number" class="tool-input" style="width:120px" @bind="numberOfPositions" min="1" max="960" step="1" />
      </div>
    </div>
    <div style="display:flex; gap:12px; margin-top:12px;">
      <button class="tool-action-btn" @onclick="GenerateChess960Positions">Create FRC book</button>
      <button class="tool-action-btn" @onclick="GenerateDoubleChess960Positions">Create DFRC book</button>
    </div>
  </div>

  <div class="tool-section">
    <h2>Opening Book from PGN</h2>
    <p>Creates a PGN-based opening book from a PGN file downloaded from TCEC/CCC archives.</p>
    <div class="tool-input-group" style="max-width:500px;">
      <label>Output file path</label>
      <input type="text" class="tool-input" style="width:100%" @bind="pgnOpeningFullName" />
    </div>
    <label for="pgnCreateInput" class="tool-upload-btn">Load PGN file</label>
  </div>

  <div class="tool-section">
    <h2>Opening Book from EPD</h2>
    <p>Creates an opening book from an EPD file.</p>
    <div class="tool-input-group" style="max-width:500px;">
      <label>Output directory path</label>
      <div style="display:flex; gap:4px; align-items:center;">
        <input type="text" class="tool-input" style="width:100%" @bind="epdToPgnFileName" />
        <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small"
                       OnClick="@(() => BrowseFolder(v => epdToPgnFileName = v, epdToPgnFileName))" />
      </div>
    </div>
    <label for="epdToPgnInput" class="tool-upload-btn">Load EPD file</label>
  </div>

  <div class="tool-section">
    <h2>Out-of-Book Evaluation</h2>
    <p>
      Generates a new opening book by evaluating positions from an existing book.
      Ensure engines are defined in tournament.json and engine names match engine.json.
    </p>
    <div class="tool-controls">
      <div class="tool-input-group" style="margin-bottom:0; flex:1; min-width:200px;">
        <label>Engine names (comma separated)</label>
        <input type="text" class="tool-input" style="width:100%" placeholder="stockfish, lc0" @bind="engineName" />
      </div>
      <div class="tool-input-group" style="margin-bottom:0; flex:1; min-width:160px;">
        <label>Nodes (comma separated)</label>
        <input type="text" class="tool-input" style="width:100%" placeholder="1000, 1" @bind="nodes" />
      </div>
      <div class="tool-input-group" style="margin-bottom:0">
        <label>Number of openings</label>
        <input type="text" class="tool-input" style="width:120px" @bind="numberOfOpenings" />
      </div>
    </div>
    <div class="tool-controls">
      <div class="tool-input-group" style="margin-bottom:0">
        <label>Min eval (cp)</label>
        <input type="text" class="tool-input" style="width:100px" @bind="minEvalScore" />
      </div>
      <div class="tool-input-group" style="margin-bottom:0">
        <label>Max eval (cp)</label>
        <input type="text" class="tool-input" style="width:100px" @bind="maxEvalScore" />
      </div>
      <div class="tool-input-group" style="margin-bottom:0">
        <label>Max eval diff (cp)</label>
        <input type="text" class="tool-input" style="width:100px" @bind="maxEvalDiff" />
      </div>
    </div>
    <div style="margin-top:12px;">
      <label for="bookEvalInput" class="tool-upload-btn">Pick, evaluate and sort opening book</label>
    </div>
  </div>

  <div class="tool-section">
    <h2>Shuffle PGN Opening Book</h2>
    <p>Generate a new opening book by shuffling the games from an existing PGN file. The output is saved as <code>Shuffled_&lt;filename&gt;</code> in the specified folder.</p>
    <div class="tool-input-group" style="max-width:500px;">
      <label>Output folder path</label>
      <div style="display:flex; gap:4px; align-items:center;">
        <input type="text" class="tool-input" style="width:100%" @bind="shuffleOutputPath" />
        <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small"
                       OnClick="@(() => BrowseFolder(v => shuffleOutputPath = v, shuffleOutputPath))" />
      </div>
    </div>
    <label for="pgnShuffleInput" class="tool-upload-btn">Pick PGN file</label>
  </div>
</div>


@code {

	private string pgnOpeningFullName = "";
	private string epdToPgnFileName = "";
	private string chess960Path = "";
	private string shuffleOutputPath = "";
	private int numberOfPositions = 960;
	private string engineName = "CeresV2 T3";
	private string minEvalScore = "60";
	private string maxEvalScore = "75";
	private string maxEvalDiff = "50";
	private string nodes = "1000";
	private string numberOfOpenings = "500";
	IBrowserFile browserFile;

	private void GenerateChess960Positions()
	{
		ChessUtilities.Chess960.writeChess960PositionsToFile(chess960Path, numberOfPositions);
	}

	private async Task EvaluateAndSortOpeningBookAsync(InputFileChangeEventArgs e)
	{
		var pgnName = e.File.Name;
		logger.LogInformation("PGN file opened {File}", pgnName);
		var env = AppPaths.BaseDir;
		var fullPath = Path.Combine(env, pgnName);
		var nOpenings = GetRequestedOpeningCount();
		await using (FileStream fs = new(fullPath, FileMode.Create))
		{
			browserFile = e.File;
			await browserFile.OpenReadStream(maxAllowedSize: 1024 * 300000).CopyToAsync(fs);
		}
		if (pgnName.ToLower().EndsWith(".pgn"))
		{
			var games = FullPGNParser.parsePgnFile(fullPath).Take(nOpenings).ToList();
			WriteEvaluatedPgnOpenings(pgnName, games);
			File.Delete(fullPath);
		}
		else if (pgnName.ToLower().EndsWith(".epd"))
		{
			var positions = EPDExtractor.readEPDs(fullPath).Take(nOpenings).ToList();
			WriteEvaluatedEpdOpenings(pgnName, positions);
			File.Delete(fullPath);
		}
		else
		{
			logger.LogInformation("File type not supported");
		}
	}

	private void WriteEvaluatedEpdOpenings(string epdName, List<EPDTypes.EPDEntry> positions)
	{
		var totalSw = System.Diagnostics.Stopwatch.StartNew();
		var tourny = ChessLibrary.Tournament.Manager.loadTournament();
		var configs = tourny.EngineSetup.Engines.ToList();

		var engineParts = engineName
			.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
			.Select(part => part.Trim())
			.ToArray();

		var candidates =
			engineParts.Select(part => configs
				.Where(e => e.Name.IndexOf(part, StringComparison.OrdinalIgnoreCase) >= 0))
				.SelectMany(e => e).ToList();

		candidates = candidates.OrderBy(e => engineParts.ToList().IndexOf(e.Name)).ToList();
		var candidatesString = string.Join(", ", candidates.Select(c => c.Name));

		var nodeList = nodes.Split(',').Select(n => int.Parse(n.Trim())).ToList();
		var zipped = candidates.Zip(nodeList);
		var concatenated = zipped.Select(z => $"{z.First.Name} ({z.Second:N0}N)").ToList();
		var concatenatedString = string.Join(", ", concatenated);

		if (candidates.Count == 0)
		{
			Console.WriteLine($"No enigne with name {engineName} is present in tournament.json file. Failed to sort openings");
			return;
		}

		if (nodeList.Count == 0)
		{
			Console.WriteLine($"No nodes were provided. Failed to sort openings");
			return;
		}

		if (nodeList.Count != candidates.Count)
		{
			Console.WriteLine($"Number of nodes and engines do not match. Failed to sort openings");
			return;
		}

		string outPutDir = $"{chess960Path}/BookEvals";
		var filePath = Path.Combine(outPutDir, $"BookEval_{epdName}_{concatenatedString}.epd");
		logger.LogInformation($"Sorting openings based on Eval with use of {concatenatedString} started...");
		var positionEvalsWithMoves = PuzzleEngineAnalysis.performPositionEvalTestOnEpdPositions(nodeList, candidates, positions, minEvalScore, maxEvalScore, maxEvalDiff);

		if (!Directory.Exists(outPutDir))
		{
			Directory.CreateDirectory(outPutDir);
		}

		using (FileStream stream = File.Create(filePath))
		{
			using (StreamWriter fs = new StreamWriter(stream))
			{
				foreach (var epd in positionEvalsWithMoves)
				{
					var theSame = epd.EPD.FEN == epd.EPD.Id?.Value;
					var summary = theSame ?
						$"{epd.EPD.FEN}; id \"opening analysis by EB\"; other \"{epd.Summary}\";" :
						$"{epd.EPD.FEN}; id \"{epd.EPD.Id?.Value}\"; other \"{epd.Summary}\";";
					fs.WriteLine(summary);
				}
			}
		}

		logger.LogInformation($"Done sorting openings based on {nodes} node(s) Eval with use of {concatenatedString}.");
		logger.LogInformation($"Evaluated opening book {epdName}: {positionEvalsWithMoves.Count} openings passed evaluation out of {positions.Count} analyzed. Output written to {filePath}");
		totalSw.Stop();
		logger.LogInformation($"Total time: {FormatHms(totalSw.Elapsed)}.");
	}

	private void WriteEvaluatedPgnOpenings(string pgnName, List<PGNTypes.PgnGame> games)
	{
		var totalSw = System.Diagnostics.Stopwatch.StartNew();

		var tourny = ChessLibrary.Tournament.Manager.loadTournament();
		var configs = tourny.EngineSetup.Engines.ToList();

		var engineParts = engineName
			.Split(new[] { ',' }, StringSplitOptions.RemoveEmptyEntries)
			.Select(part => part.Trim())
			.ToArray();

		var candidates =
			engineParts.Select(part => configs
				.Where(e => e.Name.IndexOf(part, StringComparison.OrdinalIgnoreCase) >= 0))
				.SelectMany(e => e).ToList();

		var candidatesString = string.Join(", ", candidates.Select(c => c.Name));
		var nodeList = nodes.Split(',').Select(n => int.Parse(n.Trim())).ToList();
		var zipped = candidates.Zip(nodeList);
		var concatenated = zipped.Select(z => $"{z.First.Name} ({z.Second:N0}N)").ToList();
		var concatenatedString = string.Join(", ", concatenated);
		if (candidates.Count == 0)
		{
			Console.WriteLine($"No enigne with name {engineName} is present in tournament.json file. Failed to sort openings");
			return;
		}

		if (nodeList.Count == 0)
		{
			Console.WriteLine($"No nodes were provided. Failed to sort openings");
			return;
		}

		if (nodeList.Count != candidates.Count)
		{
			Console.WriteLine($"Number of nodes and engines do not match. Failed to sort openings");
			return;
		}

		string outPutDir = $"{chess960Path}/BookEvals";
		var filePath = Path.Combine(outPutDir, $"BookEval_{pgnName}_{concatenatedString}.pgn");
		logger.LogInformation($"Sorting openings based on Eval with use of {concatenatedString} started...");
		var positionEvalsWithMoves = PuzzleEngineAnalysis.performPositionEvalTestOnPgnGames(nodeList, candidates, games, minEvalScore, maxEvalScore, maxEvalDiff);

		if (!Directory.Exists(outPutDir))
		{
			Directory.CreateDirectory(outPutDir);
		}

		var writeSw = System.Diagnostics.Stopwatch.StartNew();
		using (FileStream stream = File.Create(filePath))
		{
			using (StreamWriter fs = new StreamWriter(stream))
			{
				foreach (var pgn in positionEvalsWithMoves)
				{
					var eval = $"[MaxEval \"{pgn.MaxEval} by {pgn.MaxEngine}, {pgn.MaxMove}\"]";
					var raw = pgn.Pgn.Raw.TrimStart(new char[] { ' ', '\r', '\n' });
					raw = raw.TrimEnd(new char[] { ' ', '\r', '\n' });
					var lastBracketIndex = raw.LastIndexOf("]");
					string summary;
					if (lastBracketIndex >= 0)
					{
						var headers = raw.Substring(0, lastBracketIndex + 1);
						var moves = raw.Substring(lastBracketIndex + 1);
						summary = $"{headers}\n{eval}{moves}\n";
					}
					else
					{
						summary = $"{eval}\n{raw}\n";
					}

					fs.WriteLine(summary);
				}
			}
		}
		logger.LogInformation($"Done sorting openings based on {nodes} node(s) Eval with use of {concatenatedString}.");
		logger.LogInformation($"Evaluated opening book {pgnName}: {positionEvalsWithMoves.Count} openings passed evaluation out of {games.Count} analyzed. Output written to {filePath}");

		totalSw.Stop();
		logger.LogInformation($"Total time: {FormatHms(totalSw.Elapsed)}.");
	}

	public string FormatHms(TimeSpan ts)
	{
		int hours = (int)ts.TotalHours;
		int minutes = ts.Minutes;
		int seconds = ts.Seconds;
		return $"{hours}h {minutes}m {seconds}s";
	}

	private void GenerateDoubleChess960Positions()
	{
		ChessUtilities.Chess960.writeChess960DoublePositionsToFile(chess960Path, numberOfPositions);
	}

	private async Task ShufflePgnOpeningBookAsync(InputFileChangeEventArgs e)
	{
		var pgnName = e.File.Name;
		logger.LogInformation("PGN file opened {File}", pgnName);
		var env = AppPaths.BaseDir;
		var fullPath = Path.Combine(env, pgnName);
		await using (FileStream fs = new(fullPath, FileMode.Create))
		{
			browserFile = e.File;
			await browserFile.OpenReadStream(maxAllowedSize: 1024 * 300000).CopyToAsync(fs);
		}
		var games = FullPGNParser.parsePgnFileWithRaw(fullPath);
		var filePath = Path.Combine(shuffleOutputPath, $"Shuffled_{pgnName}");
		PGNHelper.shufflePgnGames(filePath, games);
		logger.LogInformation("Opening book was shuffled and written to path", filePath);
		File.Delete(fullPath);
	}

	private int GetRequestedOpeningCount()
	{
		if (int.TryParse(numberOfOpenings, out int nOpenings))
		{
			return nOpenings;
		}
		else
		{
			logger.LogError("Failed to parse numberOfOpenings: {NumberOfOpenings}", numberOfOpenings);
			return 10;
		}
	}

	private async Task CreateOpeningBookFromPgnAsync(InputFileChangeEventArgs e)
	{
		var pgnName = e.File.Name;
		logger.LogInformation("PGN file opened {File}", pgnName);
		var env = AppPaths.BaseDir;
		var fullPath = Path.Combine(env, pgnName);
		await using (FileStream fs = new(fullPath, FileMode.Create))
		{
			browserFile = e.File;
			await browserFile.OpenReadStream(maxAllowedSize: 1024 * 300000).CopyToAsync(fs);
		}

		var games = FullPGNParser.parsePgnFile(fullPath);
		PGNWriter.writeOpeningPgnFile(games, pgnOpeningFullName);
		logger.LogInformation("Opening book created: analyzed {GameCount} games. Written to {Path}", games.Count(), pgnOpeningFullName);
		File.Delete(fullPath);
	}

	private async Task ConvertEpdToPgnAsync(InputFileChangeEventArgs e)
	{
		var pgnName = e.File.Name;
		logger.LogInformation("EPD file opened {File}", pgnName);
		var env = AppPaths.BaseDir;
		var fullPath = Path.Combine(env, pgnName);
		await using (FileStream fs = new(fullPath, FileMode.Create))
		{
			browserFile = e.File;
			await browserFile.OpenReadStream(maxAllowedSize: 1024 * 300000).CopyToAsync(fs);
		}

		var fileNameWithoutExt = Path.GetFileNameWithoutExtension(fullPath);
		var directory = Path.GetDirectoryName(epdToPgnFileName);
		var newFilePath = Path.Combine(directory, fileNameWithoutExt + ".pgn");

		var games = EPDExtractor.readEPDs(fullPath).ToList();
		PGNWriter.writeOpeningPgnFromEPD(games, newFilePath);
		logger.LogInformation("Opening book written to path", newFilePath);
		File.Delete(fullPath);
	}

	protected override Task OnInitializedAsync()
	{
		var s = SettingsService.Settings;
		if (!string.IsNullOrEmpty(s.PgnOutputFolder))
		{
			pgnOpeningFullName = Path.Combine(s.PgnOutputFolder, "openingbookCreator1.pgn");
			epdToPgnFileName = s.PgnOutputFolder;
		}
		if (!string.IsNullOrEmpty(s.OpeningsFolder))
		{
			chess960Path = s.OpeningsFolder;
			shuffleOutputPath = s.OpeningsFolder;
		}
		return base.OnInitializedAsync();
	}

	private async Task BrowseFolder(Action<string> setter, string currentValue)
	{
		var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
		{
			{ x => x.InitialPath, currentValue },
			{ x => x.Mode, FileBrowserMode.Folder }
		};
		var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
		var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select Folder", parameters, options);
		var result = await dialog.Result;
		if (result != null && !result.Canceled) { setter((string)result.Data!); StateHasChanged(); }
	}
}

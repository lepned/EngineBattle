@page "/results/search-metrics"
@page "/searchCalc"
@inject ILogger<SearchCalculator> logger

<InputFile id="fileInput" OnChange="@OpenPGNFile" hidden />

<PageTitle>Search Metrics</PageTitle>

<div class="tool-page">
  <h1>Search Metrics</h1>
  <div class="tool-subtitle">Node distribution and search statistics from LogLiveStats</div>

  <div class="tool-controls">
    <label for="fileInput" class="tool-upload-btn">Load pgn file</label>
  </div>

  <div class="file-name">@fileOpenName</div>

  <div class="tool-tab-bar">
    <button class="tool-tab @(activeView == ViewMode.Summary ? "active" : "")" @onclick='() => SetView(ViewMode.Summary)'>Summary</button>
    <button class="tool-tab @(activeView == ViewMode.PerGame ? "active" : "")" @onclick='() => SetView(ViewMode.PerGame)'>Per Game</button>
    <button class="tool-tab @(activeView == ViewMode.PerMove ? "active" : "")" @onclick='() => SetView(ViewMode.PerMove)'>Per Move</button>
  </div>

  <div class="tool-table-container">
    <table class="tool-table sortable">
      <thead>
        <tr>
          <th @onclick='() => SortBy("Player")'>Player @SortIndicator("Player")</th>
          @if (activeView == ViewMode.PerGame)
          {
            <th @onclick='() => SortBy("Game")'>Game# @SortIndicator("Game")</th>
          }
          @if (activeView == ViewMode.PerMove)
          {
            <th @onclick='() => SortBy("Move")'>Move @SortIndicator("Move")</th>
            <th @onclick='() => SortBy("Q1")'>Q1 @SortIndicator("Q1")</th>
            <th @onclick='() => SortBy("Q2")'>Q2 @SortIndicator("Q2")</th>
          }
          <th @onclick='() => SortBy("N")'>N @SortIndicator("N")</th>
          <th @onclick='() => SortBy("N1")'>N1 @SortIndicator("N1")</th>
          <th @onclick='() => SortBy("N2")'>N2 @SortIndicator("N2")</th>
          <th @onclick='() => SortBy("N1/N")'>N1/N @SortIndicator("N1/N")</th>
          <th @onclick='() => SortBy("N2/N")'>N2/N @SortIndicator("N2/N")</th>
          <th @onclick='() => SortBy("N2/N1")'>N2/N1 @SortIndicator("N2/N1")</th>
          <th @onclick='() => SortBy("MT")'>MT @SortIndicator("MT")</th>
          @if (activeView != ViewMode.PerMove)
          {
            <th @onclick='() => SortBy("TopP")'>TopP @SortIndicator("TopP")</th>
          }
          @if (activeView == ViewMode.PerMove)
          {
            <th @onclick='() => SortBy("TL")'>TL @SortIndicator("TL")</th>
            <th @onclick='() => SortBy("TR")'>TR @SortIndicator("TR")</th>
          }
        </tr>
      </thead>
      <tbody>
        @foreach (var item in GetPagedItems())
        {
          <tr>
            <td>@item.Player</td>
            @if (activeView == ViewMode.PerGame)
            {
              <td class="tc">@item.GameNr</td>
            }
            @if (activeView == ViewMode.PerMove)
            {
              <td>@item.GameNr</td>
              <td>@item.Q1</td>
              <td>@item.Q2</td>
            }
            <td>@FormatNodes(item.Navg)</td>
            <td>@FormatNodes(item.N1avg)</td>
            <td>@FormatNodes(item.N2avg)</td>
            <td>@item.FractN1N.ToString(FractionFormat)</td>
            <td>@item.FractN2N.ToString(FractionFormat)</td>
            <td>@item.FractN2N1.ToString(FractionFormat)</td>
            <td>@item.MoveTimeMs.ToString("N0")</td>
            @if (activeView != ViewMode.PerMove)
            {
              <td>@item.TopPMovePercent.ToString("P0")</td>
            }
            @if (activeView == ViewMode.PerMove)
            {
              <td>@item.TimeLeftMs</td>
              <td>@(((double)item.MoveTimeMs / (double)(item.TimeLeftMs + item.MoveTimeMs)).ToString("P2"))</td>
            }
          </tr>
        }
      </tbody>
    </table>
    <div class="tool-pager">
      <span>@(totalItems) items</span>
      <select @bind="pageSize" @bind:after="ResetPage">
        <option value="10">10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
      <span>per page</span>
      <button disabled="@(currentPage <= 0)" @onclick="PrevPage">Prev</button>
      <span>Page @(currentPage + 1) / @totalPages</span>
      <button disabled="@(currentPage >= totalPages - 1)" @onclick="NextPage">Next</button>
    </div>
  </div>
</div>

@code {

  private enum ViewMode { Summary, PerGame, PerMove }

  private List<SearchData> nodeRatios = new();
  private List<SearchData> nodeSummaryRatio = new();
  private List<SearchData> nodePerMoveRatios = new();
  private string fileOpenName = "";
  IBrowserFile browserFile;

  // View state
  private ViewMode activeView = ViewMode.Summary;

  private List<SearchData> ActiveDataSource => activeView switch
  {
    ViewMode.Summary => nodeSummaryRatio,
    ViewMode.PerGame => nodeRatios,
    ViewMode.PerMove => nodePerMoveRatios,
    _ => nodeSummaryRatio
  };

  private string FractionFormat => activeView == ViewMode.Summary ? "P1" : "P0";

  private void SetView(ViewMode view)
  {
    activeView = view;
    currentPage = 0;
    sortColumn = view switch
    {
      ViewMode.Summary => "Player",
      ViewMode.PerGame => "Game",
      ViewMode.PerMove => "N2",
      _ => "Player"
    };
    sortAscending = view != ViewMode.PerMove;
  }

  // Sorting state
  private string sortColumn = "Player";
  private bool sortAscending = true;

  // Pagination state
  private int currentPage = 0;
  private int pageSize = 25;
  private int totalItems => ActiveDataSource.Count;
  private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalItems / pageSize));

  private void SortBy(string column)
  {
    if (sortColumn == column)
      sortAscending = !sortAscending;
    else
    {
      sortColumn = column;
      sortAscending = true;
    }
    currentPage = 0;
  }

  private MarkupString SortIndicator(string column)
  {
    if (sortColumn != column)
      return new MarkupString("<span class=\"sort-arrow\">&#9650;</span>");
    var arrow = sortAscending ? "&#9650;" : "&#9660;";
    return new MarkupString($"<span class=\"sort-arrow active\">{arrow}</span>");
  }

  private IEnumerable<SearchData> GetSortedItems()
  {
    var items = ActiveDataSource.AsEnumerable();
    items = sortColumn switch
    {
      "Player" => sortAscending ? items.OrderBy(x => x.Player) : items.OrderByDescending(x => x.Player),
      "Game" => sortAscending ? items.OrderBy(x => x.GameNr) : items.OrderByDescending(x => x.GameNr),
      "Move" => sortAscending ? items.OrderBy(x => x.GameNr) : items.OrderByDescending(x => x.GameNr),
      "Q1" => sortAscending ? items.OrderBy(x => x.Q1) : items.OrderByDescending(x => x.Q1),
      "Q2" => sortAscending ? items.OrderBy(x => x.Q2) : items.OrderByDescending(x => x.Q2),
      "N" => sortAscending ? items.OrderBy(x => x.Navg) : items.OrderByDescending(x => x.Navg),
      "N1" => sortAscending ? items.OrderBy(x => x.N1avg) : items.OrderByDescending(x => x.N1avg),
      "N2" => sortAscending ? items.OrderBy(x => x.N2avg) : items.OrderByDescending(x => x.N2avg),
      "N1/N" => sortAscending ? items.OrderBy(x => x.FractN1N) : items.OrderByDescending(x => x.FractN1N),
      "N2/N" => sortAscending ? items.OrderBy(x => x.FractN2N) : items.OrderByDescending(x => x.FractN2N),
      "N2/N1" => sortAscending ? items.OrderBy(x => x.FractN2N1) : items.OrderByDescending(x => x.FractN2N1),
      "MT" => sortAscending ? items.OrderBy(x => x.MoveTimeMs) : items.OrderByDescending(x => x.MoveTimeMs),
      "TopP" => sortAscending ? items.OrderBy(x => x.TopPMovePercent) : items.OrderByDescending(x => x.TopPMovePercent),
      "TL" => sortAscending ? items.OrderBy(x => x.TimeLeftMs) : items.OrderByDescending(x => x.TimeLeftMs),
      "TR" => sortAscending ? items.OrderBy(x => (double)x.MoveTimeMs / (x.TimeLeftMs + x.MoveTimeMs)) : items.OrderByDescending(x => (double)x.MoveTimeMs / (x.TimeLeftMs + x.MoveTimeMs)),
      _ => items
    };
    return items;
  }

  private IEnumerable<SearchData> GetPagedItems()
  {
    return GetSortedItems().Skip(currentPage * pageSize).Take(pageSize);
  }

  private void PrevPage() { if (currentPage > 0) currentPage--; }
  private void NextPage() { if (currentPage < totalPages - 1) currentPage++; }
  private void ResetPage() { currentPage = 0; }

  private async Task OpenPGNFile(InputFileChangeEventArgs e)
  {
    var pgnName = e.File.Name;
    fileOpenName = pgnName;
    logger.LogInformation("PGN file opened {File}", pgnName);
    var env = AppPaths.BaseDir;
    var fullPath = Path.Combine(env, pgnName);
    await using (FileStream fs = new(fullPath, FileMode.Create))
    {
      browserFile = e.File;
      await browserFile.OpenReadStream(maxAllowedSize: 1024 * 300000).CopyToAsync(fs);
    }

    var games = FullPGNParser.parsePgnFile(fullPath).ToList();
    var allRes = PGNStatistics.calculateMedianAndAvgSpeedSummaryInPgnFile(games, 0);

    var summaryOfLogLiveStats =
      PGNStatistics.calculateNodeRatioPerPGNfile(games)
      .ToList();

    var allIndividualGamesWithLogLiveStats =
      PGNStatistics.calculateNodeRatioPerGameInPgnFile(games, 100000)
      .OrderBy(e => e.GameNr)
      .ToList();

    var allIndividualMovesPerGamesWithLogLiveStats =
      PGNStatistics.calculateNodeRatioPerMovePerGameInPgnFile(games, 1000)
      .OrderByDescending(e => e.N2avg)
      .ToList();

    nodeRatios = allIndividualGamesWithLogLiveStats;
    nodePerMoveRatios = allIndividualMovesPerGamesWithLogLiveStats;
    nodeSummaryRatio = summaryOfLogLiveStats;
    currentPage = 0;

    logger.LogInformation("Done with calculation");
    File.Delete(fullPath);
    StateHasChanged();
    await Task.CompletedTask;
  }
  private string FormatTime(Int64 mt, Int64 tl)
  {
    var frac = (double)mt / (double)(tl + mt);
    return frac.ToString("P0");
  }

  private string FormatNodes(double nodes)
  {
    if (nodes > 1_000_000_000)
    {
      var giga = nodes / 1_000_000_000;
      return giga.ToString("F2") + "G"; //G
    }

    else if (nodes > 1_000_000)
    {
      var mill = nodes / 1_000_000;
      return mill.ToString("F2") + "M"; //M
    }

    else if (nodes > 1_000)
    {
      var mill = nodes / 1_000;
      return mill.ToString("F1") + "K"; //K
    }

    else
    {
      return nodes.ToString("F1"); //nps
    }
  }

  private string FormatNPS(double nps)
  {
    if (nps > 1_000_000_000)
    {
      var mill = nps / 1_000_000_000;
      return mill.ToString("F1") + "Gnps"; //Gnps
    }
    else if (nps > 1_000_000)
    {
      var mill = nps / 1_000_000;
      return mill.ToString("F1") + "Mnps"; //Mnps
    }

    else if (nps > 1_000)
    {
      var thousand = nps / 1_000;
      return thousand.ToString("F1") + "Knps"; //Knps
    }

    else
    {
      return nps.ToString("F1") + " nps"; //nps
    }
  }

  protected override Task OnInitializedAsync()
  {
    return base.OnInitializedAsync();
  }

}

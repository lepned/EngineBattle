@page "/results/pgn-utilities"
@page "/pgnUtilities"
@inject ILogger<RemoveEngineFromPGN> logger
@inject GlobalSettingsService SettingsService

<InputFile id="fileInput" OnChange="@OpenPGNFile" hidden />
<InputFile id="pgnReady" OnChange="@MakePGNExportReady" hidden />
<InputFile id="pgnMinimal" OnChange="@MinimalPGN" hidden />

<PageTitle>PGN Utilities</PageTitle>

<div class="tool-page">
	<h1>PGN Utilities</h1>
	<div class="tool-subtitle">Remove engines, fix formatting and strip annotations from PGN files</div>

	<div class="tool-section">
		<h2>Remove Engine from PGN</h2>
		<p class="tool-section-desc">Remove all games associated with a specific engine name from a PGN file.</p>
		<div style="max-width:600px">
			<div class="tool-input-group">
				<label>Output folder</label>
				<input class="tool-input" style="width:100%" @bind="path" />
			</div>
			<div class="tool-input-group">
				<label>Engine name to remove</label>
				<input class="tool-input" style="width:100%" @bind="engineName" />
			</div>
		</div>
		<div class="tool-controls">
			<label for="fileInput" class="tool-upload-btn">Pick PGN file</label>
		</div>
	</div>

	<div class="tool-section">
		<h2>Export-Ready PGN</h2>
		<p class="tool-section-desc">Ensure there are blank lines between games in the PGN file for proper formatting.</p>
		<div style="max-width:600px">
			<div class="tool-input-group">
				<label>Output folder</label>
				<input class="tool-input" style="width:100%" @bind="path" />
			</div>
		</div>
		<div class="tool-controls">
			<label for="pgnReady" class="tool-upload-btn">Pick PGN file</label>
		</div>
	</div>

	<div class="tool-section">
		<h2>Minimal PGN</h2>
		<p class="tool-section-desc">Create a stripped-down PGN file with all engine annotations removed.</p>
		<div style="max-width:600px">
			<div class="tool-input-group">
				<label>Output file path</label>
				<input class="tool-input" style="width:100%" @bind="minimalPGNpath" />
			</div>
		</div>
		<div class="tool-controls">
			<label for="pgnMinimal" class="tool-upload-btn">Pick PGN file</label>
		</div>
	</div>
</div>

@code {

	private string path = "";
	private string minimalPGNpath = "";
	private string engineName = string.Empty;
	IBrowserFile browserFile;

	private string GetFileName(string pgn, string playerToRemove)
	{
		string fileName = Path.GetFileNameWithoutExtension(pgn);
		string fileExt = Path.GetExtension(pgn);
		string outputFile = Path.Combine(path, $"{fileName}_{playerToRemove}_Removed{fileExt}");
		return outputFile;
	}

	private string GetExportFileName(string pgn)
	{
		string fileName = Path.GetFileNameWithoutExtension(pgn);
		string fileExt = Path.GetExtension(pgn);
		string outputFile = Path.Combine(path, $"{fileName}_ExportReady{fileExt}");
		return outputFile;
	}

	private async Task MinimalPGN(InputFileChangeEventArgs e)
	{
		if (string.IsNullOrEmpty(minimalPGNpath))
		{
			logger.LogError("Output file path is not specified");
			return;
		}
		var pgnName = e.File.Name;
		logger.LogInformation("PGN file opened {File}", pgnName);
		var env = AppPaths.BaseDir;
		var fullPath = Path.Combine(env, pgnName);
		await using (FileStream fs = new(fullPath, FileMode.Create))
		{
			browserFile = e.File;
			await browserFile.OpenReadStream(maxAllowedSize: 1024 * 300000).CopyToAsync(fs);
		}

		var games = FullPGNParser.parsePgnFile(fullPath);
		PGNWriter.writeMinimalPgnFile(games, minimalPGNpath);
		logger.LogInformation($"Done with writing minimal PGN file to {minimalPGNpath}");
		File.Delete(fullPath);
		await Task.CompletedTask;
	}

	private async Task MakePGNExportReady(InputFileChangeEventArgs e)
	{
		if (string.IsNullOrEmpty(path))
		{
			logger.LogError("Output folder is not specified");
			return;
		}
		var pgnName = e.File.Name;
		logger.LogInformation("PGN file opened {File} for export", pgnName);
		var env = AppPaths.BaseDir;
		var fullPath = Path.Combine(env, pgnName);
		await using (FileStream fs = new(fullPath, FileMode.Create))
		{
			browserFile = e.File;
			await browserFile.OpenReadStream(maxAllowedSize: 1024 * 300000).CopyToAsync(fs);
		}

		var games = FullPGNParser.parsePgnFileWithRaw(fullPath);
		var exportPath = GetExportFileName(pgnName);
		PGNWriter.ensureBlankLinesBetweenGames(exportPath, games);
		File.Delete(fullPath);
		logger.LogInformation($"PGN-file was made ready for export and written to path {exportPath}");
	}


	private async Task OpenPGNFile(InputFileChangeEventArgs e)
	{
		if (string.IsNullOrEmpty(path))
		{
			logger.LogError("Output folder is not specified");
			return;
		}
		if (engineName == string.Empty)
		{
			logger.LogError("Engine name is not specified");
			return;
		}
		var pgnName = e.File.Name;
		logger.LogInformation("PGN file opened {File}", pgnName);
		var env = AppPaths.BaseDir;
		var fullPath = Path.Combine(env, pgnName);
		await using (FileStream fs = new(fullPath, FileMode.Create))
		{
			browserFile = e.File;
			await browserFile.OpenReadStream(maxAllowedSize: 1024 * 300000).CopyToAsync(fs);
		}

		var games = FullPGNParser.parsePgnFileWithRaw(fullPath);
		var fileNamePath = GetFileName(pgnName, engineName);
		PGNWriter.removePlayerFromPGN(engineName, games, fileNamePath);
		File.Delete(fullPath);
		logger.LogInformation($"Engine {engineName} was removed from PGN-file and written to path {fileNamePath}");
	}

	protected override Task OnInitializedAsync()
	{
		var s = SettingsService.Settings;
		if (!string.IsNullOrEmpty(s.PgnOutputFolder))
		{
			path = s.PgnOutputFolder;
			minimalPGNpath = Path.Combine(s.PgnOutputFolder, "minimalPGN1.pgn");
		}
		return base.OnInitializedAsync();
	}

}

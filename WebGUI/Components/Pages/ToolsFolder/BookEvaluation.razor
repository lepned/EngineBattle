@page "/tools/book-evaluation"
@inject ILogger<BookEvaluation> logger
@inject GlobalSettingsService SettingsService
@inject IDialogService DialogService
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog
@using Microsoft.FSharp.Core
@using Microsoft.FSharp.Collections

<PageTitle>Book Evaluation</PageTitle>

<div class="tool-page">
    <h1>Out-of-Book Evaluation</h1>
    <div class="tool-subtitle">Evaluate positions from an existing opening book using engines to filter and sort by eval balance</div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div style="margin:8px 0; font-weight:500; color:@(isError ? "#ef5350" : "#8b9cd0")">@statusMessage</div>
    }

    <div class="tool-section">
        <h2>Engines</h2>

        <div class="oob-grid">
            <div class="oob-grid-header">Engine</div>
            <div class="oob-grid-header">Config</div>
            <div class="oob-grid-header">Mode</div>
            <div class="oob-grid-header">Value</div>
            <div class="oob-grid-header"></div>
            @foreach (var eng in oobEngines)
            {
                <div class="oob-grid-cell oob-engine-name" title="@eng.FilePath">@eng.Config.Name</div>
                <div class="oob-grid-cell oob-engine-file">@Path.GetFileName(eng.FilePath)</div>
                <div class="oob-grid-cell">
                    <select class="tool-input oob-mode-select" value="@eng.Mode" @onchange="@(e => { if (Enum.TryParse<SearchMode>(e.Value?.ToString(), out var m)) { eng.Mode = m; eng.SearchValue = m == SearchMode.Time ? 3000 : 10000; } })">
                        <option value="@SearchMode.Nodes">Nodes</option>
                        <option value="@SearchMode.Time">Time ms</option>
                    </select>
                </div>
                <div class="oob-grid-cell"><input type="text" class="tool-input oob-nodes-input" value="@eng.SearchValue.ToString("N0")" @onchange="@(e => { if (int.TryParse(e.Value?.ToString()?.Replace(",", "").Replace(" ", ""), out var n) && n > 0) eng.SearchValue = n; })" /></div>
                <div class="oob-grid-cell oob-remove-cell"><button class="oob-remove-btn" @onclick="@(() => RemoveEngine(eng))" title="Remove">&times;</button></div>
            }
        </div>

        <button class="tool-action-btn" style="margin-top:6px;" @onclick="BrowseAndAddEngine" disabled="@isProcessing">+ Add Engine</button>
    </div>

    <div class="tool-section">
        <h2>Parameters</h2>
        <div class="tool-controls">
            <div class="tool-input-group" style="margin-bottom:0">
                <label>Number of openings</label>
                <input type="text" class="tool-input" style="width:120px" @bind="numberOfOpenings" />
            </div>
            <div class="tool-input-group" style="margin-bottom:0">
                <label>Min eval (cp)</label>
                <input type="text" class="tool-input" style="width:100px" @bind="minEvalScore" />
            </div>
            <div class="tool-input-group" style="margin-bottom:0">
                <label>Max eval (cp)</label>
                <input type="text" class="tool-input" style="width:100px" @bind="maxEvalScore" />
            </div>
            <div class="tool-input-group" style="margin-bottom:0">
                <label>Max eval diff (cp)</label>
                <input type="text" class="tool-input" style="width:100px" @bind="maxEvalDiff" />
            </div>
        </div>

        <div class="tool-input-group" style="max-width:500px; margin-top:8px;">
            <label>Output folder</label>
            <div style="display:flex; gap:4px; align-items:center;">
                <input type="text" class="tool-input" style="width:100%" @bind="outputFolder" />
                <MudIconButton Icon="@Icons.Material.Filled.FolderOpen" Size="Size.Small"
                               OnClick="@(() => BrowseFolder(v => outputFolder = v, outputFolder))" />
            </div>
        </div>
    </div>

    <div class="tool-section">
        <h2>Run</h2>
        <p>Output saved as <code>BookEval_&lt;book&gt;_&lt;engines&gt;.epd/.pgn</code> in the output folder.</p>
        <div class="tool-controls">
            <button class="tool-upload-btn" @onclick="BrowseOpeningBookFile" disabled="@isProcessing">Pick opening book</button>
            @if (!string.IsNullOrEmpty(oobSelectedFile))
            {
                <span class="file-name" style="margin:0;">@Path.GetFileName(oobSelectedFile)</span>
            }
        </div>
        <div style="margin-top:8px; display:flex; gap:16px;">
            <button class="tool-action-btn" @onclick="EvaluateAndSortFile" disabled="@(isProcessing || string.IsNullOrEmpty(oobSelectedFile))">Evaluate and sort</button>
            @if (isProcessing)
            {
                <button class="tool-cancel-btn" @onclick="CancelRun">Stop</button>
            }
        </div>
        @if (isProcessing)
        {
            <div class="puzzle-progress" style="margin-top:8px;">
                <div class="puzzle-progress-header">
                    <span class="puzzle-progress-label">@processingLabel</span>
                    @if (progressTotal > 0)
                    {
                        <span class="puzzle-progress-count">@progressProcessed / @progressTotal</span>
                    }
                </div>
                <div class="puzzle-progress-track">
                    <div class="puzzle-progress-fill" style="width:@(progressTotal > 0 ? $"{(double)progressProcessed / progressTotal * 100:F1}%" : "0%")"></div>
                </div>
            </div>
        }
    </div>

    @if (lastRows != null)
    {
        <div class="tool-section">
            <h2>Results</h2>
            <div class="tool-table-container" style="max-width:700px;">
                <table class="tool-table">
                    <tbody>
                        @foreach (var row in lastRows)
                        {
                            <tr><td>@row.Item1</td><td style="@RowStyle(row.Item1)">@row.Item2</td></tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    }
</div>

@code {

    private string minEvalScore = "80";
    private string maxEvalScore = "100";
    private string maxEvalDiff = "40";
    private string numberOfOpenings = "500";
    private string outputFolder = "";
    private bool isProcessing;
    private string processingLabel = "";
    private string statusMessage = "";
    private bool isError;
    private int progressProcessed;
    private int progressTotal;
    private CancellationTokenSource cts;
    // the Results table, the same rows the bookeval verb prints (BookEvaluation.summaryRows)
    private FSharpList<Tuple<string, string>> lastRows;

    private static string RowStyle(string label) =>
        label == "Status" ? "color:#ef5350;" : label == "Output file" ? "word-break:break-all;" : "";

    private List<OobEngineEntry> oobEngines = new();
    private string oobSelectedFile = "";

    private enum SearchMode { Nodes, Time }

    private class OobEngineEntry
    {
        public CoreTypes.EngineConfig Config { get; set; }
        public string FilePath { get; set; } = "";
        public SearchMode Mode { get; set; } = SearchMode.Nodes;
        public int SearchValue { get; set; } = 10000;

        public TimeControlTypes.TimeControlCommands.SearchLimit ToSearchLimit() => Mode switch
        {
            SearchMode.Time => TimeControlTypes.TimeControlCommands.SearchLimit.NewTimeLimit(SearchValue),
            _ => TimeControlTypes.TimeControlCommands.SearchLimit.NewNodeLimit(SearchValue)
        };
    }

    private void SetStatus(string message, bool error = false)
    {
        statusMessage = message;
        isError = error;
    }

    private void CancelRun()
    {
        cts?.Cancel();
    }

    private void OnProgress(int processed, int total)
    {
        progressProcessed = processed;
        progressTotal = total;
        InvokeAsync(StateHasChanged);
    }

    private async Task BrowseAndAddEngine()
    {
        var initialDir = SettingsService.Settings.EngineDefsFolder;
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, initialDir },
            { x => x.FileFilter, "*.json" },
            { x => x.Mode, FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select Engine Config", parameters, options);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;
        var filePath = (string)result.Data!;

        try
        {
            var config = Configuration.JSON.readSingleEngineConfig(filePath);
            if (oobEngines.Any(e => e.FilePath.Equals(filePath, StringComparison.OrdinalIgnoreCase)))
            {
                SetStatus($"{config.Name} is already in the list.", true);
                return;
            }
            oobEngines.Add(new OobEngineEntry { Config = config, FilePath = filePath, Mode = SearchMode.Nodes, SearchValue = 10000 });
            SetStatus($"Added {config.Name}");
        }
        catch (Exception ex)
        {
            SetStatus($"Failed to load engine config: {ex.Message}", true);
        }
    }

    private void RemoveEngine(OobEngineEntry entry)
    {
        oobEngines.Remove(entry);
    }

    private async Task BrowseOpeningBookFile()
    {
        var initialDir = SettingsService.Settings.OpeningsFolder;
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, initialDir },
            { x => x.FileFilter, "*.pgn;*.epd" },
            { x => x.Mode, FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select PGN or EPD File", parameters, options);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;

        oobSelectedFile = (string)result.Data!;
        logger.LogInformation("Opening book selected: {File}", Path.GetFileName(oobSelectedFile));
        SetStatus($"Selected: {Path.GetFileName(oobSelectedFile)}");
    }

    private async Task EvaluateAndSortFile()
    {
        if (string.IsNullOrEmpty(oobSelectedFile) || !File.Exists(oobSelectedFile))
        {
            SetStatus("Please pick an opening book file first.", true);
            return;
        }

        if (string.IsNullOrEmpty(outputFolder))
        {
            SetStatus("Please set an output folder.", true);
            return;
        }

        var fileName = Path.GetFileName(oobSelectedFile);
        SetStatus("");
        lastRows = null;
        isProcessing = true;
        progressProcessed = 0;
        progressTotal = 0;
        processingLabel = $"Evaluating positions from {fileName}...";
        cts?.Dispose();
        cts = new CancellationTokenSource();
        StateHasChanged();

        try
        {
            var nOpenings = GetRequestedOpeningCount();
            if (fileName.ToLower().EndsWith(".pgn"))
            {
                var games = FullPGNParser.parsePgnFileWithRaw(oobSelectedFile).Take(nOpenings).ToList();
                await Task.Run(() => WriteEvaluatedPgnOpenings(fileName, games));
            }
            else if (fileName.ToLower().EndsWith(".epd"))
            {
                var positions = EPDExtractor.readEPDs(oobSelectedFile).Take(nOpenings).ToList();
                await Task.Run(() => WriteEvaluatedEpdOpenings(fileName, positions));
            }
            else
            {
                SetStatus("File type not supported. Use .pgn or .epd files.", true);
            }
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to evaluate opening book");
            SetStatus($"Error: {ex.Message}", true);
        }
        finally
        {
            isProcessing = false;
            StateHasChanged();
        }
    }

    private void WriteEvaluatedEpdOpenings(string epdName, List<EPDTypes.EPDEntry> positions) =>
        RunBookEval(epdName, positions.Count, "epd", (engines, filter) =>
        {
            var outcome = ChessLibrary.BookEvaluation.evaluateEpds(engines, filter, positions, OnProgress, cts.Token);
            return (outcome.Results.Count, outcome.Evaluated, outcome.Removed, outcome.Skipped, outcome.Failure, outcome.Cancelled,
                    path => ChessLibrary.BookEvaluation.writeEpds(path, outcome.Results));
        });

    private void WriteEvaluatedPgnOpenings(string pgnName, List<PGNTypes.PgnGame> games) =>
        RunBookEval(pgnName, games.Count, "pgn", (engines, filter) =>
        {
            var outcome = ChessLibrary.BookEvaluation.evaluatePgns(engines, filter, games, OnProgress, cts.Token);
            return (outcome.Results.Count, outcome.Evaluated, outcome.Removed, outcome.Skipped, outcome.Failure, outcome.Cancelled,
                    path => ChessLibrary.BookEvaluation.writePgns(path, outcome.Results));
        });

    // One run (ChessLibrary/Analysis/BookEvaluation.fs, shared with the bookeval verb): what passed
    // is written even when the run stopped early, and an engine failure is shown, not an empty result.
    private void RunBookEval(string sourceName, int total, string ext,
        Func<FSharpList<ChessLibrary.BookEvaluation.BookEngine>, ChessLibrary.BookEvaluation.Filter,
             (int Passed, int Evaluated, int Removed, int Skipped, FSharpOption<string> Failure, bool Cancelled, Action<string> Write)> evaluate)
    {
        if (oobEngines.Count == 0) { SetStatus("No engines configured. Add at least one engine.", true); return; }
        if (oobEngines.Any(e => e.SearchValue <= 0)) { SetStatus("All search values must be positive integers.", true); return; }
        var engines = ListModule.OfSeq(oobEngines.Select(e =>
            new ChessLibrary.BookEvaluation.BookEngine(e.Config, e.ToSearchLimit())));
        ChessLibrary.BookEvaluation.Filter filter;
        try { filter = ChessLibrary.BookEvaluation.parseFilter(minEvalScore, maxEvalScore, maxEvalDiff, oobEngines.Count); }
        catch (FormatException) { SetStatus("Min eval, max eval and max diff must be numbers.", true); return; }
        var label = ChessLibrary.BookEvaluation.engineLabel(engines);

        var totalSw = System.Diagnostics.Stopwatch.StartNew();
        var filePath = Path.Combine(outputFolder, "BookEvals", $"BookEval_{sourceName}_{label}.{ext}");
        logger.LogInformation("Book evaluation of {File} with {Engines} started", sourceName, label);
        var r = evaluate(engines, filter);
        r.Write(filePath);
        totalSw.Stop();

        lastRows = ChessLibrary.BookEvaluation.summaryRows(sourceName, total, r.Passed, r.Evaluated, r.Removed, r.Skipped,
            r.Failure, r.Cancelled, engines, minEvalScore, maxEvalScore, maxEvalDiff, totalSw.Elapsed, filePath);
        logger.LogInformation("Evaluated {File}: {Passed}/{Evaluated} passed. Written to {Path}", sourceName, r.Passed, r.Evaluated, filePath);
        if (FSharpOption<string>.get_IsSome(r.Failure))
        {
            logger.LogWarning("Book evaluation stopped: {Reason}", r.Failure.Value);
            SetStatus($"Stopped: {r.Failure.Value} — what passed before is saved.", true);
        }
        else SetStatus((r.Cancelled ? "Cancelled — partial results saved." : "Evaluation complete.")
                       + (r.Skipped > 0 ? $" {r.Skipped} unreadable opening(s) skipped." : ""));
    }

    private int GetRequestedOpeningCount()
    {
        if (int.TryParse(numberOfOpenings, out int nOpenings))
            return nOpenings;
        logger.LogError("Failed to parse numberOfOpenings: {NumberOfOpenings}", numberOfOpenings);
        return 10;
    }

    protected override Task OnInitializedAsync()
    {
        var s = SettingsService.Settings;
        if (!string.IsNullOrEmpty(s.OpeningsFolder))
            outputFolder = s.OpeningsFolder;

        foreach (var path in new[] { s.DefaultEnginePath, s.SecondaryEnginePath })
        {
            if (string.IsNullOrEmpty(path) || !File.Exists(path)) continue;
            try
            {
                var config = Configuration.JSON.readSingleEngineConfig(path);
                if (!string.IsNullOrEmpty(config.Name))
                    oobEngines.Add(new OobEngineEntry { Config = config, FilePath = path, Mode = SearchMode.Nodes, SearchValue = 10000 });
            }
            catch { }
        }

        return base.OnInitializedAsync();
    }

    private async Task BrowseFolder(Action<string> setter, string currentValue)
    {
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, currentValue },
            { x => x.Mode, FileBrowserMode.Folder }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select Folder", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled) { setter((string)result.Data!); StateHasChanged(); }
    }
}

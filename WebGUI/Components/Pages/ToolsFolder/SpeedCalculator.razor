@page "/speed"
@inject ILogger<SpeedCalculator> logger

<InputFile id="fileInput" OnChange="@OpenPGNFile" hidden />

<PageTitle>Engine Speed</PageTitle>

<div class="tool-page">
  <h1>Engine Speed</h1>
  <div class="tool-subtitle">NPS, depth and node statistics per engine and game</div>

  <div class="tool-controls">
    <label for="fileInput" class="tool-upload-btn">Load pgn file</label>
    <div class="tool-input-group" style="margin-bottom:0">
      <label>Min move time (secs)</label>
      <input type="number" class="tool-input" style="width:120px" @bind="minMoveTimeInSecs" min="0" step="1" />
    </div>
  </div>

  <div class="file-name">@fileOpenName</div>

  <div class="tool-tab-bar">
    <button class="tool-tab @(activeView == ViewMode.Median ? "active" : "")" @onclick='() => SetView(ViewMode.Median)'>Median</button>
    <button class="tool-tab @(activeView == ViewMode.Average ? "active" : "")" @onclick='() => SetView(ViewMode.Average)'>Average</button>
    <button class="tool-tab @(activeView == ViewMode.PerGame ? "active" : "")" @onclick='() => SetView(ViewMode.PerGame)'>Per Game</button>
  </div>

  <div class="tool-table-container">
    @if (activeView == ViewMode.Median || activeView == ViewMode.Average)
    {
      <table class="tool-table sortable">
        <thead>
          <tr>
            <th @onclick='() => SortBy("Player")'>Player @SortIndicator("Player")</th>
            <th @onclick='() => SortBy("Games")'>Games @SortIndicator("Games")</th>
            <th @onclick='() => SortBy("Nodes")'>Nodes @SortIndicator("Nodes")</th>
            <th @onclick='() => SortBy("NPS")'>NPS @SortIndicator("NPS")</th>
            <th @onclick='() => SortBy("Depth")'>Depth @SortIndicator("Depth")</th>
            <th @onclick='() => SortBy("SD")'>SD @SortIndicator("SD")</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in GetPagedSummaryItems())
          {
            <tr>
              <td>@item.Player</td>
              <td>@item.Games</td>
              <td>@FormatNodes(item.AvgNodes)</td>
              <td>@FormatNodes(item.AvgNPS)</td>
              <td>@item.AvgDepth.ToString("F0")</td>
              <td>@item.AvgSelfDepth.ToString("F0")</td>
            </tr>
          }
        </tbody>
      </table>
    }
    else
    {
      <table class="tool-table sortable dense">
        <thead>
          <tr>
            <th @onclick='() => SortBy("Player")'>Player @SortIndicator("Player")</th>
            <th @onclick='() => SortBy("Game")'>Game# @SortIndicator("Game")</th>
            <th @onclick='() => SortBy("AvgNodes")'>AvgNodes @SortIndicator("AvgNodes")</th>
            <th @onclick='() => SortBy("MedNodes")'>MedNodes @SortIndicator("MedNodes")</th>
            <th @onclick='() => SortBy("AvgNPS")'>AvgNPS @SortIndicator("AvgNPS")</th>
            <th @onclick='() => SortBy("MedNPS")'>MedNPS @SortIndicator("MedNPS")</th>
            <th @onclick='() => SortBy("AvgDepth")'>AvgDepth @SortIndicator("AvgDepth")</th>
            <th @onclick='() => SortBy("MedDepth")'>MedDepth @SortIndicator("MedDepth")</th>
            <th @onclick='() => SortBy("AvgSD")'>AvgSD @SortIndicator("AvgSD")</th>
            <th @onclick='() => SortBy("MedSD")'>MedSD @SortIndicator("MedSD")</th>
          </tr>
        </thead>
        <tbody>
          @foreach (var item in GetPagedGameItems())
          {
            <tr>
              <td>@item.Player</td>
              <td class="tc">@item.GameNr</td>
              <td class="tc">@FormatNodes(item.AvgNodes)</td>
              <td class="tc">@FormatNodes(item.MedianNodes)</td>
              <td class="tc">@FormatNodes(item.AvgNps)</td>
              <td class="tc">@FormatNodes(item.MedianNps)</td>
              <td class="tc">@item.AvgDepth.ToString("F0")</td>
              <td class="tc">@item.MedianDepth.ToString("F0")</td>
              <td class="tc">@item.AvgSD.ToString("F0")</td>
              <td class="tc">@item.MedianSD.ToString("F0")</td>
            </tr>
          }
        </tbody>
      </table>
    }
    <div class="tool-pager">
      <span>@(totalItems) items</span>
      <select @bind="pageSize" @bind:after="ResetPage">
        <option value="10">10</option>
        <option value="25">25</option>
        <option value="50">50</option>
        <option value="100">100</option>
      </select>
      <span>per page</span>
      <button disabled="@(currentPage <= 0)" @onclick="PrevPage">Prev</button>
      <span>Page @(currentPage + 1) / @totalPages</span>
      <button disabled="@(currentPage >= totalPages - 1)" @onclick="NextPage">Next</button>
    </div>
  </div>
</div>

@code {

  private enum ViewMode { Median, Average, PerGame }

  private int minMoveTimeInSecs = 0;
  private List<SummaryEngineStat> medianSpeedTable = new();
  private List<SummaryEngineStat> averageSpeedTable = new();
  private List<EngineStatsPerGame> allGamesSpeedTable = new();
  private string fileOpenName = "";
  IBrowserFile browserFile;

  // View state
  private ViewMode activeView = ViewMode.Median;

  private List<SummaryEngineStat> ActiveSummarySource => activeView == ViewMode.Average ? averageSpeedTable : medianSpeedTable;

  private void SetView(ViewMode view)
  {
    activeView = view;
    currentPage = 0;
    sortColumn = view switch
    {
      ViewMode.Median => "NPS",
      ViewMode.Average => "NPS",
      ViewMode.PerGame => "Game",
      _ => "Player"
    };
    sortAscending = view == ViewMode.PerGame;
  }

  // Sorting state
  private string sortColumn = "NPS";
  private bool sortAscending = false;

  // Pagination state
  private int currentPage = 0;
  private int pageSize = 25;
  private int totalItems => activeView == ViewMode.PerGame ? allGamesSpeedTable.Count : ActiveSummarySource.Count;
  private int totalPages => Math.Max(1, (int)Math.Ceiling((double)totalItems / pageSize));

  private void SortBy(string column)
  {
    if (sortColumn == column)
      sortAscending = !sortAscending;
    else
    {
      sortColumn = column;
      sortAscending = true;
    }
    currentPage = 0;
  }

  private MarkupString SortIndicator(string column)
  {
    if (sortColumn != column)
      return new MarkupString("<span class=\"sort-arrow\">&#9650;</span>");
    var arrow = sortAscending ? "&#9650;" : "&#9660;";
    return new MarkupString($"<span class=\"sort-arrow active\">{arrow}</span>");
  }

  private IEnumerable<SummaryEngineStat> GetSortedSummaryItems()
  {
    var items = ActiveSummarySource.AsEnumerable();
    items = sortColumn switch
    {
      "Player" => sortAscending ? items.OrderBy(x => x.Player) : items.OrderByDescending(x => x.Player),
      "Games" => sortAscending ? items.OrderBy(x => x.Games) : items.OrderByDescending(x => x.Games),
      "Nodes" => sortAscending ? items.OrderBy(x => x.AvgNodes) : items.OrderByDescending(x => x.AvgNodes),
      "NPS" => sortAscending ? items.OrderBy(x => x.AvgNPS) : items.OrderByDescending(x => x.AvgNPS),
      "Depth" => sortAscending ? items.OrderBy(x => x.AvgDepth) : items.OrderByDescending(x => x.AvgDepth),
      "SD" => sortAscending ? items.OrderBy(x => x.AvgSelfDepth) : items.OrderByDescending(x => x.AvgSelfDepth),
      _ => items
    };
    return items;
  }

  private IEnumerable<EngineStatsPerGame> GetSortedGameItems()
  {
    var items = allGamesSpeedTable.AsEnumerable();
    items = sortColumn switch
    {
      "Player" => sortAscending ? items.OrderBy(x => x.Player) : items.OrderByDescending(x => x.Player),
      "Game" => sortAscending ? items.OrderBy(x => x.GameNr) : items.OrderByDescending(x => x.GameNr),
      "AvgNodes" => sortAscending ? items.OrderBy(x => x.AvgNodes) : items.OrderByDescending(x => x.AvgNodes),
      "MedNodes" => sortAscending ? items.OrderBy(x => x.MedianNodes) : items.OrderByDescending(x => x.MedianNodes),
      "AvgNPS" => sortAscending ? items.OrderBy(x => x.AvgNps) : items.OrderByDescending(x => x.AvgNps),
      "MedNPS" => sortAscending ? items.OrderBy(x => x.MedianNps) : items.OrderByDescending(x => x.MedianNps),
      "AvgDepth" => sortAscending ? items.OrderBy(x => x.AvgDepth) : items.OrderByDescending(x => x.AvgDepth),
      "MedDepth" => sortAscending ? items.OrderBy(x => x.MedianDepth) : items.OrderByDescending(x => x.MedianDepth),
      "AvgSD" => sortAscending ? items.OrderBy(x => x.AvgSD) : items.OrderByDescending(x => x.AvgSD),
      "MedSD" => sortAscending ? items.OrderBy(x => x.MedianSD) : items.OrderByDescending(x => x.MedianSD),
      _ => items
    };
    return items;
  }

  private IEnumerable<SummaryEngineStat> GetPagedSummaryItems()
  {
    return GetSortedSummaryItems().Skip(currentPage * pageSize).Take(pageSize);
  }

  private IEnumerable<EngineStatsPerGame> GetPagedGameItems()
  {
    return GetSortedGameItems().Skip(currentPage * pageSize).Take(pageSize);
  }

  private void PrevPage() { if (currentPage > 0) currentPage--; }
  private void NextPage() { if (currentPage < totalPages - 1) currentPage++; }
  private void ResetPage() { currentPage = 0; }

  private async Task OpenPGNFile(InputFileChangeEventArgs e)
  {
    var pgnName = e.File.Name;
    fileOpenName = pgnName;
    logger.LogInformation("PGN file opened {File}", pgnName);
    var env = AppPaths.BaseDir;
    var fullPath = Path.Combine(env, pgnName);
    await using (FileStream fs = new(fullPath, FileMode.Create))
    {
      browserFile = e.File;
      await browserFile.OpenReadStream(maxAllowedSize: 1024 * 300000).CopyToAsync(fs);
    }

    var games = FullPGNParser.parsePgnFile(fullPath).ToList();
    var allRes = PGNStatistics.calculateMedianAndAvgSpeedSummaryInPgnFile(games,minMoveTimeInSecs);
    var minMoveTimeInMs = minMoveTimeInSecs * 1000;
    medianSpeedTable =
      allRes.Where(e => e.Median )
      .OrderByDescending(e => e.AvgNPS).ToList();
    var avgSpeedTable =
      allRes.Where(e => e.Median == false)
          .OrderByDescending(e => e.AvgNPS).ToList();

    logger.LogInformation("PGN file parsed {File}", pgnName);

    logger.LogInformation("\nMedian speed calculated\n");
    var summary = ConsoleHelper.writeSummaryEngineStatsToConsole(medianSpeedTable);
    logger.LogInformation(summary);

    logger.LogInformation("\nAverage speed calculated\n");
    var avgSummary = ConsoleHelper.writeSummaryEngineStatsToConsole(avgSpeedTable);
    logger.LogInformation(avgSummary);

    StateHasChanged();
    averageSpeedTable =
      allRes.Where(e => e.Median == false)
      .OrderByDescending(e => e.AvgNPS).ToList();

    var allIndividualGames =
      PGNStatistics.calculateMedianAndAvgSpeedPerGameInPgnFile(games)
      .Where(e => e.AvgNps > 0)
      .OrderBy(e => e.GameNr)
      .ToList();

    allGamesSpeedTable = allIndividualGames;
    logger.LogInformation("\nSpeed per game calculated\n");
    var consoleSummary = ConsoleHelper.writeEngineStatsToConsole(allIndividualGames);
    logger.LogInformation(consoleSummary);

    currentPage = 0;
    logger.LogInformation("Done with calculation");
    File.Delete(fullPath);
    StateHasChanged();
    await Task.CompletedTask;
  }

  private string FormatNodes(double nodes)
  {
    if (nodes > 1_000_000_000)
    {
      var giga = nodes / 1_000_000_000;
      return giga.ToString("F2") + "G";//G
    }

    else if (nodes > 1_000_000)
    {
      var mill = nodes / 1_000_000;
      return mill.ToString("F2") + "M";//M
    }

    else if (nodes > 1_000)
    {
      var mill = nodes / 1_000;
      return mill.ToString("F1") + "K";//K
    }

    else
    {
      return nodes.ToString("F1"); //nps
    }
  }

  private string FormatNPS(double nps)
  {
    if (nps > 1_000_000_000)
    {
      var mill = nps / 1_000_000_000;
      return mill.ToString("F1") + "Gnps";//Gnps
    }
    else if (nps > 1_000_000)
    {
      var mill = nps / 1_000_000;
      return mill.ToString("F1") + "Mnps";//Mnps
    }

    else if (nps > 1_000)
    {
      var thousand = nps / 1_000;
      return thousand.ToString("F1") + "Knps";//Knps
    }

    else
    {
      return nps.ToString("F1") + " nps";//nps
    }
  }

  protected override Task OnInitializedAsync()
  {
    return base.OnInitializedAsync();
  }

}

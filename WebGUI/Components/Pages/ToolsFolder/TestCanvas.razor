@page "/tools/epd-visualizer"
@page "/testCanvas"
@using WebGUI.Components.Layout.VisualizationLayout
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog

@inject ILogger<TestCanvas> logger
@inject IDialogService DialogService
@inject GlobalSettingsService SettingsService

<PageTitle>Test canvas</PageTitle>

<div class="tool-page">
  <h1>EPD Position Analyzer</h1>
  <div class="tool-subtitle">Visualize and analyze EPD position files</div>

  <div class="tool-controls">
    <button class="tool-upload-btn" @onclick="BrowseEpdFile">Load EPD file</button>
  </div>


</div>

<TBTestVisualization EPDList="EPDList" TBEPDList="TBEPDList" />

@code {

  private List<EPDTypes.EPDEntry> EPDList = new();
  private List<EPDTypes.TablebaseEPDEntry> TBEPDList = new();

  private async Task BrowseEpdFile()
  {
    var filePath = await BrowseFile("*.epd", SettingsService.Settings.OpeningsFolder, "Select EPD File");
    if (filePath == null) return;

    logger.LogInformation("EPD file opened {File}", Path.GetFileName(filePath));
    var epds = EPDExtractor.readEPDs(filePath).Take(1500).ToList();
    if (epds.Count == 0)
    {
      logger.LogInformation("No EPDs found in file");
      return;
    }
    EPDList.Clear();
    TBEPDList.Clear();
    EPDList.AddRange(epds);
    StateHasChanged();
  }

  private async Task<string> BrowseFile(string fileFilter, string initialDir, string title)
  {
    var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
    {
      { x => x.InitialPath, initialDir },
      { x => x.FileFilter, fileFilter },
      { x => x.Mode, FileBrowserMode.File }
    };
    var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
    var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>(title, parameters, options);
    var result = await dialog.Result;
    if (result == null || result.Canceled) return null;
    return (string)result.Data!;
  }

}

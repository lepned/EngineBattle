@page "/tools/epd-visualizer"
@page "/testCanvas"
@using WebGUI.Components.Layout.VisualizationLayout
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog

@inject ILogger<TestCanvas> logger
@inject IDialogService DialogService
@inject GlobalSettingsService SettingsService

<PageTitle>Test canvas</PageTitle>

<div class="tool-page">
  <h1>EPD Position Analyzer</h1>
  <div class="tool-subtitle">Visualize and analyze EPD position files</div>

  <div class="tool-controls">
    <button class="tool-upload-btn" @onclick="BrowseEpdFile">Load EPD file</button>
  </div>

  @if (!string.IsNullOrEmpty(result))
  {
    <div class="file-name">@result</div>
  }
</div>

<TBTestVisualization EPDList="EPDList" TBEPDList="TBEPDList" />

@code {

  private List<EPDTypes.EPDEntry> EPDList = new();
  private List<EPDTypes.TablebaseEPDEntry> TBEPDList = new();
  private List<PGNTypes.PgnGame> PGNgames = new();
  private string result;

  private async Task BrowseRecordsPgnFile()
  {
    var filePath = await BrowseFile("*.pgn", SettingsService.Settings.PgnOutputFolder, "Select Records PGN File");
    if (filePath == null) return;

    logger.LogInformation("File opened {File}", Path.GetFileName(filePath));
    var netFile = TestsTypes.records(filePath).OrderByDescending(e => e.QDn).Take(250);
    var epds = netFile.Select((e, id) => EPDExtractor.mapChessRecordToEPD(e, id));
    EPDList.Clear();
    TBEPDList.Clear();
    EPDList.AddRange(epds);
    logger.LogInformation(result);
    StateHasChanged();
  }

  private async Task BrowseTablebasePgnFile()
  {
    var filePath = await BrowseFile("*.pgn", SettingsService.Settings.PgnOutputFolder, "Select Tablebase PGN File");
    if (filePath == null) return;

    logger.LogInformation("File opened {File}", Path.GetFileName(filePath));
    var testList = PGNHelper.readTableBaseResults(filePath).ToList();
    var tourny = ChessLibrary.Tournament.Manager.loadTournament();
    var configs = tourny.EngineSetup.Engines.ToList();
    var head = configs.First();
    var results = await PuzzleEngineAnalysis.performQValueTestOnTB(1, head, testList);
    EPDList.Clear();
    TBEPDList.Clear();
    var ordered = results.CorrectPuzzles.OrderBy(e => e.EPD.FEN).ToList();
    TBEPDList.AddRange(ordered);
    logger.LogInformation("Number of endings: " + TBEPDList.Count.ToString());
    var res = (double)results.Correct / (double)results.TotalNumber;
    result = $"Percentage of endings correct: {res.ToString("P1")}, Total: {results.TotalNumber} Correct: {results.Correct} Wrong: {results.Wrong}";
    logger.LogInformation(result);
    StateHasChanged();
  }

  private async Task BrowseEpdFile()
  {
    var filePath = await BrowseFile("*.epd", SettingsService.Settings.OpeningsFolder, "Select EPD File");
    if (filePath == null) return;

    logger.LogInformation("EPD file opened {File}", Path.GetFileName(filePath));
    var epds = EPDExtractor.readEPDs(filePath).Take(1500).ToList();
    if (epds.Count == 0)
    {
      logger.LogInformation("No EPDs found in file");
      return;
    }
    EPDList.Clear();
    TBEPDList.Clear();
    StateHasChanged();
    EPDList.AddRange(epds);
  }

  private async Task BrowsePgnFile()
  {
    var filePath = await BrowseFile("*.pgn", SettingsService.Settings.PgnOutputFolder, "Select PGN File");
    if (filePath == null) return;

    logger.LogInformation("PGN file opened {File}", Path.GetFileName(filePath));
    PGNgames = FullPGNParser.parsePgnFile(filePath).ToList();
    StateHasChanged();
  }

  private async Task<string> BrowseFile(string fileFilter, string initialDir, string title)
  {
    var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
    {
      { x => x.InitialPath, initialDir },
      { x => x.FileFilter, fileFilter },
      { x => x.Mode, FileBrowserMode.File }
    };
    var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
    var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>(title, parameters, options);
    var result = await dialog.Result;
    if (result == null || result.Canceled) return null;
    return (string)result.Data!;
  }

  private void StripText(string path, string savePath)
  {
    var lines = File.ReadAllLines(path);
    var stripped = lines.Where(e => e.Contains("WRONG"));
    File.WriteAllLines(savePath, stripped);
  }

  protected override Task OnAfterRenderAsync(bool firstRender)
  {
    if(firstRender)
    {
      var fullPath = @"C:/Dev/Chess/Lichess/TBTraining/latestDump.txt";
      var savedTo = @"C:/Dev/Chess/Lichess/TBTraining/latestStrippedDump.txt";

      if (File.Exists(fullPath))
      {
        StripText(fullPath, savedTo);
        TBEPDList = PGNHelper.readTableBaseResults(savedTo).ToList();
        StateHasChanged();
      }
    }
    return base.OnAfterRenderAsync(firstRender);
  }
}

@page "/settings"
@inject GlobalSettingsService SettingsService
@inject IDialogService DialogService
@using WebGUI.Services
@using static WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog

<PageTitle>Settings</PageTitle>

<div class="settings-container">
    <h2>Global Settings</h2>
    <div class="settings-description">Configure common paths and defaults used across EngineBattle.</div>

    <div class="settings-help @(showHelp ? "" : "collapsed")">
        <h4 class="collapsible-header" @onclick="() => showHelp = !showHelp">
            Quick Guide
            <span class="collapse-indicator">@(showHelp ? "▾" : "▸")</span>
        </h4>
        @if (showHelp)
        {
            <div class="settings-help-content">
                <p><b>General</b> — Set your startup page and default engines. Default engines auto-load in analysis and review pages, saving you from re-browsing every session.</p>
                <p><b>Paths & Tools</b> — PGN save path for analysis games and the Ordo rating tool path.</p>
                <p><b>Folders</b> — Directory paths populate the file browser bookmarks and set initial browse locations. Configure these once and every file picker starts in the right place.</p>
                <p><b>Analysis</b> — Search limits, chart lines, MultiPV, and policy thresholds. These defaults apply when opening analysis pages.</p>
                <p><b>Game Review</b> — How deeply each move is analyzed during game review (mode, time, nodes, depth).</p>
                <p><b>Tournament</b> — Delay between games (GPU cooling) and move overhead (communication buffer).</p>
                <p style="margin-bottom:0"><i>Click <b>Save</b> to persist changes. Settings are stored in <code>Data/globalSettings.json</code>.</i></p>
            </div>
        }
    </div>

    @if (!string.IsNullOrEmpty(statusMessage))
    {
        <div class="alert alert-@statusType">
            <span>@statusMessage</span>
            <button class="dismiss-btn" @onclick="() => statusMessage = string.Empty">&times;</button>
        </div>
    }

    <div class="settings-grid">

    @* Row 1: General (startup + engines) *@
    <div class="settings-section">
        <h4>General</h4>
        <div class="section-hint">Startup page and default engines for analysis.</div>
        <div class="field-group">
            <label>Startup Page</label>
            <select @bind="startupPage">
                <option value="">Home</option>
                <optgroup label="Most used">
                    <option value="/tournament">Run Tournament</option>
                    <option value="/analysis/single">Single Engine Analysis</option>
                    <option value="/analysis/dual">Dual Engine Analysis</option>
                    <option value="/analysis/game-review">Game Review</option>
                    <option value="/play/computer">Play vs Computer</option>
                    <option value="/tools/engine-creator">Engine Creator</option>
                    <option value="/tools/tournament-creator">Tournament Creator</option>
                </optgroup>
                <optgroup label="Puzzles">
                    <option value="/puzzles/tutorial">Puzzle Tutorial</option>
                    <option value="/puzzles/download">Download Puzzle Data</option>
                    <option value="/puzzles/lichess">Lichess Puzzles</option>
                    <option value="/puzzles/eret">ERET Test</option>
                </optgroup>
                <optgroup label="Tools">
                    <option value="/tools/epd-visualizer">EPD Visualizer</option>
                    <option value="/tools/opening-book">Opening Book</option>
                    <option value="/tools/puzzle-creator">Lichess Puzzle Creator</option>
                    <option value="/tools/eret-creator">ERET Creator</option>
                </optgroup>
                <optgroup label="Results & Stats">
                    <option value="/results/ordo">Ordo Table</option>
                    <option value="/results/book-exit-speed">Book Exit Speed</option>
                    <option value="/results/engine-speed">Engine Speed</option>
                    <option value="/results/backend-metrics">Backend Metrics</option>
                    <option value="/results/search-metrics">Search Metrics</option>
                    <option value="/results/move-deviation">Move Deviation</option>
                    <option value="/results/pgn-utilities">PGN Utilities</option>
                </optgroup>
                <optgroup label="Setup & Settings">
                    <option value="/setup/tournament">Tournament Setup</option>
                    <option value="/setup/engines">Engine Setup</option>
                    <option value="/tournament/shortcuts">Tournament Shortcuts</option>
                    <option value="/analysis/shortcuts">Analysis Shortcuts</option>
                </optgroup>
            </select>
            <small>Page to open when the app starts</small>
        </div>

        <div class="field-row">
            <div class="field-group">
                <label>Default Engine</label>
                <input type="text" @bind="defaultEnginePath" />
                <small>Primary engine for analysis and review</small>
            </div>
            <button class="browse-btn" title="Browse" @onclick="@(() => BrowseFile(v => defaultEnginePath = v, EngineInitialDir(defaultEnginePath), "*.json"))"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
        </div>

        <div class="field-row">
            <div class="field-group">
                <label>Secondary Engine</label>
                <input type="text" @bind="secondaryEnginePath" />
                <small>Second engine for Dual Analysis</small>
            </div>
            <button class="browse-btn" title="Browse" @onclick="@(() => BrowseFile(v => secondaryEnginePath = v, EngineInitialDir(secondaryEnginePath), "*.json"))"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
        </div>
    </div>

    <div class="settings-section">
        <h4>Paths & Tools</h4>
        <div class="section-hint">External file paths and executables.</div>

        <div class="field-row">
            <div class="field-group">
                <label>Analysis Games</label>
                <input type="text" @bind="analysisGamesPath" />
                <small>File where analysis games are saved (.pgn)</small>
            </div>
            <button class="browse-btn" title="Browse" @onclick="@(() => BrowseFile(v => analysisGamesPath = v, analysisGamesPath, "*.pgn"))"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
        </div>

        <div class="field-row">
            <div class="field-group">
                <label>Ordo Executable</label>
                <input type="text" @bind="ordoExePath" />
                <small>Full path to the Ordo rating tool</small>
            </div>
            <button class="browse-btn" title="Browse" @onclick="@(() => BrowseFile(v => ordoExePath = v, ordoExePath, "*.exe"))"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
        </div>
    </div>

    @* Folders (full width, internal multi-col) *@
    <div class="settings-section span-full">
        <h4>Folders</h4>
        <div class="section-hint">Directory paths only — do not include filenames.</div>

        <div class="folders-grid">
            <div class="field-row">
                <div class="field-group">
                    <label>Engine Definitions</label>
                    <input type="text" @bind="engineDefsFolder" />
                    <small>Engine .json config files</small>
                </div>
                <button class="browse-btn" title="Browse" @onclick="() => BrowseFolder(v => engineDefsFolder = v, engineDefsFolder)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
            </div>

            <div class="field-row">
                <div class="field-group">
                    <label>Openings</label>
                    <input type="text" @bind="openingsFolder" />
                    <small>Opening books (.pgn/.epd)</small>
                </div>
                <button class="browse-btn" title="Browse" @onclick="() => BrowseFolder(v => openingsFolder = v, openingsFolder)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
            </div>

            <div class="field-row">
                <div class="field-group">
                    <label>PGN Output</label>
                    <input type="text" @bind="pgnOutputFolder" />
                    <small>Folder for saving PGN files</small>
                </div>
                <button class="browse-btn" title="Browse" @onclick="() => BrowseFolder(v => pgnOutputFolder = v, pgnOutputFolder)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
            </div>

            <div class="field-row">
                <div class="field-group">
                    <label>Tournament Configs</label>
                    <input type="text" @bind="tournamentConfigFolder" />
                    <small>Tournament .json config files</small>
                </div>
                <button class="browse-btn" title="Browse" @onclick="() => BrowseFolder(v => tournamentConfigFolder = v, tournamentConfigFolder)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
            </div>

            <div class="field-row">
                <div class="field-group">
                    <label>Tablebase</label>
                    <input type="text" @bind="tablebaseFolder" />
                    <small>Syzygy tablebase folder</small>
                </div>
                <button class="browse-btn" title="Browse" @onclick="() => BrowseFolder(v => tablebaseFolder = v, tablebaseFolder)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
            </div>

            <div class="field-row">
                <div class="field-group">
                    <label>Neural Networks</label>
                    <input type="text" @bind="neuralNetFolder" />
                    <small>Neural network weights</small>
                </div>
                <button class="browse-btn" title="Browse" @onclick="() => BrowseFolder(v => neuralNetFolder = v, neuralNetFolder)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
            </div>

            <div class="field-row">
                <div class="field-group">
                    <label>Puzzle Configs</label>
                    <input type="text" @bind="puzzleConfigFolder" />
                    <small>Puzzle and ERET config files</small>
                </div>
                <button class="browse-btn" title="Browse" @onclick="() => BrowseFolder(v => puzzleConfigFolder = v, puzzleConfigFolder)"><svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="currentColor"><path d="M10 4H4c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h16c1.1 0 2-.9 2-2V8c0-1.1-.9-2-2-2h-8l-2-2z"/></svg></button>
            </div>
        </div>
    </div>

    @* Row 3: Analysis | Game Review | Tournament *@
    <div class="settings-section">
        <h4>Analysis</h4>
        <div class="section-hint">Default values for engine analysis sessions.</div>
        <div class="number-row">
            <div class="field-group">
                <label>Search Time (ms)</label>
                <input type="number" @bind="defaultSearchTimeMs" min="100" max="600000" />
            </div>
            <div class="field-group">
                <label>Search Nodes</label>
                <input type="number" @bind="defaultSearchNodes" min="1" max="1000000000" />
            </div>
        </div>
        <div class="number-row">
            <div class="field-group">
                <label>Chart Lines</label>
                <input type="number" @bind="chartLines" min="1" max="20" />
                <small>CP chart lines to display</small>
            </div>
            <div class="field-group">
                <label>MultiPV Lines</label>
                <input type="number" @bind="defaultMultiPV" min="1" max="20" />
                <small>Default engine PV lines</small>
            </div>
        </div>
        <div class="number-row">
            <div class="field-group">
                <label>Policy Distribution Filter</label>
                <input type="text" @bind="policyDistributionMinMaxFilter" />
                <small>Min,Max probability range (e.g. 0.4,0.6)</small>
            </div>
            <div class="field-group">
                <label>Min Policy Threshold</label>
                <input type="number" @bind="minPolicyThreshold" min="0" max="1" step="0.01" />
                <small>Min probability for overlay display</small>
            </div>
        </div>
        <div class="field-group">
            <label class="checkbox-label">
                <input type="checkbox" @bind="combineWhiteAndBlackMoves" />
                Combine White & Black Moves
            </label>
            <small>Merge white and black move data in policy charts</small>
        </div>
    </div>

    <div class="settings-section @(showGameReview ? "" : "collapsed")">
        <h4 class="collapsible-header" @onclick="() => showGameReview = !showGameReview">
            Game Review
            <span class="collapse-indicator">@(showGameReview ? "▾" : "▸")</span>
        </h4>
        @if (showGameReview)
        {
            <div class="number-row" style="margin-top:0.5rem">
                <div class="field-group">
                    <label>Mode</label>
                    <select @bind="reviewSearchMode">
                        <option value="Time">Time</option>
                        <option value="Nodes">Nodes</option>
                        <option value="Depth">Depth</option>
                    </select>
                </div>
                <div class="field-group">
                    <label>Time (ms)</label>
                    <input type="number" @bind="reviewTimePerMove" min="100" max="600000" />
                </div>
            </div>
            <div class="number-row">
                <div class="field-group">
                    <label>Nodes</label>
                    <input type="number" @bind="reviewNodes" min="1" max="1000000000" />
                </div>
                <div class="field-group">
                    <label>Depth</label>
                    <input type="number" @bind="reviewDepth" min="1" max="100" />
                </div>
            </div>
        }
    </div>

    <div class="settings-section">
        <h4>Tournament</h4>
        <div class="section-hint">Default values for tournament configuration.</div>
        <div class="number-row">
            <div class="field-group">
                <label>Delay Between Games (sec)</label>
                <input type="number" @bind="delayBetweenGamesSec" min="0" max="300" />
            </div>
            <div class="field-group">
                <label>Move Overhead (ms)</label>
                <input type="number" @bind="moveOverheadMs" min="0" max="5000" />
            </div>
        </div>
    </div>

    </div> @* end settings-grid *@

    <div class="button-row">
        <button class="btn btn-primary" @onclick="SaveSettings">Save</button>
        <button class="btn btn-outline" @onclick="ResetToDefaults">Reset to Defaults</button>
    </div>
</div>

@code {
    private string engineDefsFolder = "";
    private string openingsFolder = "";
    private string pgnOutputFolder = "";
    private string tournamentConfigFolder = "";
    private string tablebaseFolder = "";
    private string neuralNetFolder = "";
    private string puzzleConfigFolder = "";
    private string analysisGamesPath = "";
    private string ordoExePath = "";
    private double defaultSearchTimeMs = 3000;
    private int defaultSearchNodes = 100000;
    private int delayBetweenGamesSec = 20;
    private int moveOverheadMs = 100;
    private string startupPage = "";

    private string defaultEnginePath = "";
    private string secondaryEnginePath = "";
    private int chartLines = 4;
    private string policyDistributionMinMaxFilter = "0.4,0.6";
    private bool combineWhiteAndBlackMoves = true;
    private int defaultMultiPV = 10;
    private double minPolicyThreshold = 0.05;

    private string reviewSearchMode = "Time";
    private int reviewTimePerMove = 1000;
    private int reviewNodes = 5000;
    private int reviewDepth = 18;
    private bool showGameReview = true;
    private bool showHelp = false;

    private string statusMessage = "";
    private string statusType = "info";

    protected override void OnInitialized()
    {
        LoadFromService();
    }

    private void LoadFromService()
    {
        var s = SettingsService.Settings;
        engineDefsFolder = s.EngineDefsFolder;
        openingsFolder = s.OpeningsFolder;
        pgnOutputFolder = s.PgnOutputFolder;
        tournamentConfigFolder = s.TournamentConfigFolder;
        tablebaseFolder = s.TablebaseFolder;
        neuralNetFolder = s.NeuralNetFolder;
        puzzleConfigFolder = s.PuzzleConfigFolder;
        analysisGamesPath = s.AnalysisGamesPath;
        ordoExePath = s.OrdoExePath;
        defaultEnginePath = s.DefaultEnginePath;
        secondaryEnginePath = s.SecondaryEnginePath;
        defaultSearchTimeMs = s.DefaultSearchTimeMs;
        defaultSearchNodes = s.DefaultSearchNodes;
        chartLines = s.ChartLines;
        policyDistributionMinMaxFilter = s.PolicyDistributionMinMaxFilter;
        combineWhiteAndBlackMoves = s.CombineWhiteAndBlackMoves;
        defaultMultiPV = s.DefaultMultiPV;
        minPolicyThreshold = s.MinPolicyThreshold;
        delayBetweenGamesSec = s.DelayBetweenGamesSec;
        moveOverheadMs = s.MoveOverheadMs;
        startupPage = s.StartupPage;
        reviewSearchMode = s.ReviewSearchMode;
        reviewTimePerMove = s.ReviewTimePerMove;
        reviewNodes = s.ReviewNodes;
        reviewDepth = s.ReviewDepth;
    }

    private void SaveSettings()
    {
        try
        {
            var settings = new GlobalSettings
            {
                EngineDefsFolder = engineDefsFolder ?? "",
                OpeningsFolder = openingsFolder ?? "",
                PgnOutputFolder = pgnOutputFolder ?? "",
                TournamentConfigFolder = tournamentConfigFolder ?? "",
                TablebaseFolder = tablebaseFolder ?? "",
                NeuralNetFolder = neuralNetFolder ?? "",
                PuzzleConfigFolder = puzzleConfigFolder ?? "",
                AnalysisGamesPath = analysisGamesPath ?? "",
                OrdoExePath = ordoExePath ?? "",
                LastBrowsedPath = SettingsService.Settings.LastBrowsedPath,
                RecentBrowsePaths = SettingsService.Settings.RecentBrowsePaths,
                DefaultEnginePath = defaultEnginePath ?? "",
                SecondaryEnginePath = secondaryEnginePath ?? "",
                DefaultSearchTimeMs = defaultSearchTimeMs,
                DefaultSearchNodes = defaultSearchNodes,
                ChartLines = chartLines,
                PolicyDistributionMinMaxFilter = policyDistributionMinMaxFilter ?? "0.4,0.6",
                CombineWhiteAndBlackMoves = combineWhiteAndBlackMoves,
                DefaultMultiPV = defaultMultiPV,
                MinPolicyThreshold = minPolicyThreshold,
                DelayBetweenGamesSec = delayBetweenGamesSec,
                MoveOverheadMs = moveOverheadMs,
                StartupPage = startupPage ?? "",
                ReviewSearchMode = reviewSearchMode ?? "Time",
                ReviewTimePerMove = reviewTimePerMove,
                ReviewNodes = reviewNodes,
                ReviewDepth = reviewDepth,
            };
            SettingsService.Save(settings);
            statusMessage = "Settings saved.";
            statusType = "success";
        }
        catch (Exception ex)
        {
            statusMessage = $"Error saving settings: {ex.Message}";
            statusType = "error";
        }
    }

    private void ResetToDefaults()
    {
        var defaults = new GlobalSettings();
        engineDefsFolder = defaults.EngineDefsFolder;
        openingsFolder = defaults.OpeningsFolder;
        pgnOutputFolder = defaults.PgnOutputFolder;
        tournamentConfigFolder = defaults.TournamentConfigFolder;
        tablebaseFolder = defaults.TablebaseFolder;
        neuralNetFolder = defaults.NeuralNetFolder;
        puzzleConfigFolder = defaults.PuzzleConfigFolder;
        analysisGamesPath = defaults.AnalysisGamesPath;
        ordoExePath = defaults.OrdoExePath;
        defaultEnginePath = defaults.DefaultEnginePath;
        secondaryEnginePath = defaults.SecondaryEnginePath;
        defaultSearchTimeMs = defaults.DefaultSearchTimeMs;
        defaultSearchNodes = defaults.DefaultSearchNodes;
        chartLines = defaults.ChartLines;
        policyDistributionMinMaxFilter = defaults.PolicyDistributionMinMaxFilter;
        combineWhiteAndBlackMoves = defaults.CombineWhiteAndBlackMoves;
        defaultMultiPV = defaults.DefaultMultiPV;
        minPolicyThreshold = defaults.MinPolicyThreshold;
        delayBetweenGamesSec = defaults.DelayBetweenGamesSec;
        moveOverheadMs = defaults.MoveOverheadMs;
        startupPage = defaults.StartupPage;
        reviewSearchMode = defaults.ReviewSearchMode;
        reviewTimePerMove = defaults.ReviewTimePerMove;
        reviewNodes = defaults.ReviewNodes;
        reviewDepth = defaults.ReviewDepth;
        statusMessage = "Reset to defaults — click Save to persist.";
        statusType = "info";
    }

    private async Task BrowseFolder(Action<string> setter, string currentValue)
    {
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, currentValue },
            { x => x.Mode, FileBrowserMode.Folder }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select Folder", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            setter((string)result.Data!);
            StateHasChanged();
        }
    }

    private string EngineInitialDir(string path) =>
        !string.IsNullOrEmpty(path) ? path : engineDefsFolder;

    private async Task BrowseFile(Action<string> setter, string currentValue, string filter)
    {
        var initialDir = !string.IsNullOrEmpty(currentValue)
            ? (File.Exists(currentValue) ? Path.GetDirectoryName(currentValue) ?? ""
               : Directory.Exists(currentValue) ? currentValue
               : Path.GetDirectoryName(currentValue) ?? "")
            : "";
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, initialDir },
            { x => x.FileFilter, filter },
            { x => x.Mode, FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select File", parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            setter((string)result.Data!);
            StateHasChanged();
        }
    }
}

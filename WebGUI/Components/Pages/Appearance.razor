@page "/appearance"
@inject GlobalSettingsService SettingsService
@inject BoardThemeService BoardThemeSvc
@inject IJSRuntime JS
@inject JavaScriptInteropService JsInteropService
@using System.Text.Json
@using WebGUI.Services
@using WebGUI.Components.Layout.ChessboardLayout

<PageTitle>Appearance</PageTitle>

<div class="appearance-container">
    <h2>Appearance</h2>
    <div class="appearance-description">
        Text and menu size for the whole application, and themes, piece sets, coordinates and
        effects for every chessboard. Changes apply immediately.
    </div>

    <div class="appearance-layout">
        <div class="appearance-controls">
            <div class="controls-col">

            <div class="appearance-section @SectionClass("interface")">
                <h4 class="collapsible-header" @onclick='() => Toggle("interface")'>
                    <span class="section-title">Text &amp; menu <span class="scope-badge all">Whole application</span></span>
                    <span class="collapse-indicator">@Indicator("interface")</span>
                </h4>
                <div style="display:flex; gap:1rem;">
                    <div class="field-group" style="flex:1; margin-bottom:0;">
                        <label>Text size</label>
                        <select @bind="uiFontScale" @bind:after="Apply">
                            <option value="small">Small</option>
                            <option value="normal">Normal</option>
                            <option value="large">Large</option>
                            <option value="xlarge">Extra Large</option>
                        </select>
                    </div>
                    <div class="field-group" style="flex:1; margin-bottom:0;">
                        <label>Menu width</label>
                        <select @bind="navDrawerWidth" @bind:after="Apply">
                            <option value="narrow">Narrow</option>
                            <option value="normal">Normal</option>
                            <option value="wide">Wide</option>
                        </select>
                    </div>
                </div>
                <small>Text scales everywhere, boards keep their size. Widen the menu if larger text makes entries wrap.</small>
            </div>

            @* Collapsed by default, and it should stay that way: the corner control on the
               tournament page sets all of these at once by looking ("save" there makes what is
               on screen the baseline), and this is the rare case where one region wants a
               different size from the rest.

               These are the SIZES themselves, in px, per screen: the largest each region may
               use before the tables shrink to fit their boxes. A region with no number of its
               own uses the built-in default - or, for an older tournament.json that still
               carries sizes, the number in that file - until it is given one here or by "save". *@
            <div class="appearance-section @SectionClass("fontgroups")">
                <h4 class="collapsible-header" @onclick='() => Toggle("fontgroups")'>
                    <span class="section-title">Text per region <span class="scope-badge tournament">Tournament page</span></span>
                    <span class="collapse-indicator">@Indicator("fontgroups")</span>
                </h4>
                @* The A-/A+ nudge on the tournament page multiplies every number below until "save"
                   there folds it in. It is set where its effect can be seen, so this page only says
                   when one is pending - otherwise these px would not match the page - and can
                   drop it. *@
                @if (tournamentFontPct != 100)
                {
                    <div class="coord-color-row" style="margin-bottom:0.5rem;">
                        <small style="flex:1;">
                            The tournament page scales these by @tournamentFontPct% on this screen (A&minus;/A+).
                            Press "save" there to make it the numbers here.
                        </small>
                        <button type="button" @onclick="ResetTournamentFontScale"
                                title="Drop the A-/A+ nudge on this screen: the tournament page goes back to the numbers below">reset to 100%</button>
                    </div>
                }
                @foreach (var g in GlobalSettings.FontGroups)
                {
                    <div class="field-group" style="margin-bottom:0.35rem;">
                        <label>@g.Label</label>
                        <div class="coord-color-row">
                            <input type="range" min="8" max="40" step="1" value="@GroupPx(g.Key)"
                                   @oninput="e => { groupPx[g.Key] = int.Parse((string)e.Value); touchedGroups.Add(g.Key); }" @onchange="Apply" />
                            <span class="piece-scale-value">@GroupPx(g.Key) px@(FallbackLabel(g.Key))</span>
                            @if (groupPx.ContainsKey(g.Key))
                            {
                                <button type="button" @onclick="() => ClearGroup(g.Key)"
                                        title="Drop this region's own size and go back to the default">default</button>
                            }
                        </div>
                    </div>
                }
                <small>
                    The largest size each region may use on this screen; the tables still shrink
                    to fit their boxes. Easier than the sliders: A&minus;/A+ in the corner of the
                    tournament page scales all of them together, and "save" there makes the sizes
                    on screen these numbers.
                </small>
            </div>

            @* Which charts and panels the tournament page shows, and how the charts are drawn.
               Each one is a three-way choice: follow (whatever tournament.json says, else the
               built-in default - the label says which value that is right now), on, or off.
               Per screen, like the sizes: a 1080p laptop wants fewer charts than a 4K monitor.
               The four chart toggles are also in the corner control on the page itself. *@
            <div class="appearance-section @SectionClass("tournamentpage")">
                <h4 class="collapsible-header" @onclick='() => Toggle("tournamentpage")'>
                    <span class="section-title">Charts &amp; panels <span class="scope-badge tournament">Tournament page</span></span>
                    <span class="collapse-indicator">@Indicator("tournamentpage")</span>
                </h4>
                @foreach (var (key, label) in DisplayFlags)
                {
                    <div class="field-group" style="margin-bottom:0.35rem;">
                        <label>@label</label>
                        <select @bind="displayChoice[key]" @bind:after="() => ApplyDisplay(key)">
                            <option value="">follow (@(FallbackFlag(key) ? "on" : "off"))</option>
                            <option value="on">on</option>
                            <option value="off">off</option>
                        </select>
                    </div>
                }
                <div class="field-group" style="margin-bottom:0.35rem;">
                    <label>Crosstable in the left column</label>
                    <select @bind="displayChoice[CrosstableKey]" @bind:after="() => ApplyDisplay(CrosstableKey)">
                        <option value="">follow (@FallbackCrosstable())</option>
                        <option value="cycle">cycle - takes turns with the standings in the same box</option>
                        <option value="below">below - a box of its own under the standings</option>
                        <option value="none">none - standings only</option>
                    </select>
                </div>
                @foreach (var (key, label, min, max, step) in DisplayNumbers)
                {
                    <div class="field-group" style="margin-bottom:0.35rem;">
                        <label>@label</label>
                        <div class="coord-color-row">
                            <input type="number" min="@min" max="@max" step="@step" placeholder="@FallbackNumber(key)"
                                   @bind="displayChoice[key]" @bind:after="() => ApplyDisplay(key)" style="width:6rem" />
                            <span class="piece-scale-value">@(string.IsNullOrEmpty(displayChoice[key]) ? $"follow ({FallbackNumber(key)})" : "")</span>
                            @if (!string.IsNullOrEmpty(displayChoice[key]))
                            {
                                <button type="button" @onclick="() => { displayChoice[key] = string.Empty; ApplyDisplay(key); }"
                                        title="Drop this screen’s own value and follow">follow</button>
                            }
                        </div>
                    </div>
                }
                <small>
                    "Follow" means whatever the tournament.json in use says, or the built-in default
                    when it says nothing - the value in brackets is what that is right now. On and
                    off are yours, for this screen, whatever tournament is loaded.
                </small>
            </div>

            <div class="appearance-section @SectionClass("theme")">
                <h4 class="collapsible-header" @onclick='() => Toggle("theme")'>
                    <span class="section-title">Theme <span class="scope-badge all">All boards</span></span>
                    <span class="collapse-indicator">@Indicator("theme")</span>
                </h4>
                <div class="preset-grid">
                    @foreach (var (key, name, light, dark) in BoardThemeService.PresetSwatches)
                    {
                        <button class="preset-card @(themePreset == key ? "selected" : "")"
                                @onclick="() => SelectPreset(key)">
                            <span class="swatch">
                                <span style="background:@light"></span><span style="background:@dark"></span>
                                <span style="background:@dark"></span><span style="background:@light"></span>
                            </span>
                            <span class="preset-name">@name</span>
                        </button>
                    }
                    <button class="preset-card @(themePreset == "custom" ? "selected" : "")"
                            @onclick='() => SelectPreset("custom")'>
                        <span class="swatch">
                            <span style="background:@customLight"></span><span style="background:@customDark"></span>
                            <span style="background:@customDark"></span><span style="background:@customLight"></span>
                        </span>
                        <span class="preset-name">Custom</span>
                    </button>
                </div>

                @if (themePreset == "custom")
                {
                    <div class="color-row">
                        <div class="color-field">
                            <label>Light squares</label>
                            <input type="color" value="@customLight"
                                   @oninput="e => customLight = (string)e.Value" @onchange="Apply" />
                        </div>
                        <div class="color-field">
                            <label>Dark squares</label>
                            <input type="color" value="@customDark"
                                   @oninput="e => customDark = (string)e.Value" @onchange="Apply" />
                        </div>
                        <div class="color-field">
                            <label>Move highlight</label>
                            <input type="color" value="@customHighlight"
                                   @oninput="e => customHighlight = (string)e.Value" @onchange="Apply" />
                        </div>
                    </div>
                }
                <div class="field-group">
                    <label>Board Frame</label>
                    <select @bind="frameWidth" @bind:after="Apply">
                        <option value="off">Off</option>
                        <option value="thin">Thin</option>
                        <option value="medium">Medium</option>
                        <option value="thick">Thick</option>
                    </select>
                    <small>Frame around the board, python-chess style — also hosts outside coordinates</small>
                </div>
                <div class="field-group">
                    <label>Frame Color</label>
                    <div class="coord-color-row">
                        <select @bind="frameColorMode" @bind:after="Apply">
                            <option value="auto">Theme default</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (frameColorMode == "custom")
                        {
                            <input type="color" value="@frameColor"
                                   @oninput="e => frameColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                </div>
            </div>

            <div class="appearance-section @SectionClass("pieces")">
                <h4 class="collapsible-header" @onclick='() => Toggle("pieces")'>
                    <span class="section-title">Pieces <span class="scope-badge all">All boards</span></span>
                    <span class="collapse-indicator">@Indicator("pieces")</span>
                </h4>
                <div class="pieceset-grid">
                    @foreach (var set in pieceSets)
                    {
                        <button class="pieceset-card @(pieceSet == set ? "selected" : "")"
                                @onclick="() => SelectPieceSet(set)">
                            <span class="pieceset-thumbs">
                                <img src="@BoardThemeSvc.PieceImg(set, "wK")" alt="wK" />
                                <img src="@BoardThemeSvc.PieceImg(set, "bN")" alt="bN" />
                            </span>
                            <span class="pieceset-name">@set</span>
                        </button>
                    }
                </div>
                <small>Add your own set as a folder under wwwroot/pieces (wK.svg … bP.svg)</small>
                <div class="field-group">
                    <label>Piece Size</label>
                    <div class="coord-color-row">
                        <input type="range" min="80" max="100" step="5" value="@pieceScale"
                               @oninput="e => pieceScale = int.Parse((string)e.Value)" @onchange="Apply" />
                        <span class="piece-scale-value">@pieceScale%</span>
                    </div>
                    <small>Piece size as a share of the square — smaller leaves breathing room</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("coords")">
                <h4 class="collapsible-header" @onclick='() => Toggle("coords")'>
                    <span class="section-title">Coordinates <span class="scope-badge all">All boards</span></span>
                    <span class="collapse-indicator">@Indicator("coords")</span>
                </h4>
                <div class="field-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="tournamentCoordinates" @bind:after="Apply" />
                        Coordinates on Tournament Boards
                    </label>
                    <small>Show a1–h8 on the live tournament board (PV boards and grid tiles never show them — too small to read)</small>
                </div>
                <div class="field-group">
                    <label>Placement</label>
                    <select @bind="coordinatePlacement" @bind:after="Apply">
                        <option value="inside">Inside the squares</option>
                        <option value="outside">Outside, in the frame</option>
                    </select>
                    <small>Outside coordinates sit in the board frame; with the frame off, an invisible gutter makes room for them, and large coordinate sizes widen the frame to fit</small>
                </div>
                <div class="field-group">
                    <label>Size</label>
                    <select @bind="coordinateSize" @bind:after="Apply">
                        <option value="small">Small</option>
                        <option value="medium">Medium</option>
                        <option value="large">Large</option>
                        <option value="xlarge">Extra Large</option>
                    </select>
                </div>
                <div class="field-group">
                    <label>Color</label>
                    <div class="coord-color-row">
                        <select @bind="coordinateColorMode" @bind:after="Apply">
                            <option value="auto">Auto (contrast)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (coordinateColorMode == "custom")
                        {
                            <input type="color" value="@coordinateColor"
                                   @oninput="e => coordinateColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Auto uses the opposite square color for contrast on any theme</small>
                </div>
            </div>

            </div>
            <div class="controls-col">

            <div class="appearance-section @SectionClass("pvarrows")">
                <h4 class="collapsible-header" @onclick='() => Toggle("pvarrows")'>
                    <span class="section-title">PV Arrows <span class="scope-badge tournament">Tournament &amp; live</span></span>
                    <span class="collapse-indicator">@Indicator("pvarrows")</span>
                </h4>
                <div class="field-group">
                    <label>Arrow Color</label>
                    <div class="coord-color-row">
                        <select @bind="arrowMode" @bind:after="Apply">
                            <option value="auto">Default</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (arrowMode == "custom")
                        {
                            <input type="color" value="@arrowColor"
                                   @oninput="e => arrowColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Best-move / PV arrows on live tournament boards</small>
                </div>
                <div class="field-group">
                    <label>White Move Arrow</label>
                    <div class="coord-color-row">
                        <select @bind="whiteMoveArrowMode" @bind:after="Apply">
                            <option value="auto">Default (light)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (whiteMoveArrowMode == "custom")
                        {
                            <input type="color" value="@whiteMoveArrowColor"
                                   @oninput="e => whiteMoveArrowColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>White's best move when both engines' moves are shown</small>
                </div>
                <div class="field-group">
                    <label>Black Move Arrow</label>
                    <div class="coord-color-row">
                        <select @bind="blackMoveArrowMode" @bind:after="Apply">
                            <option value="auto">Default (dark)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (blackMoveArrowMode == "custom")
                        {
                            <input type="color" value="@blackMoveArrowColor"
                                   @oninput="e => blackMoveArrowColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Black's best move when both engines' moves are shown</small>
                </div>
                <div class="field-group">
                    <label>Arrow Width</label>
                    <select @bind="arrowWidth" @bind:after="Apply">
                        <option value="thin">Thin</option>
                        <option value="normal">Normal</option>
                        <option value="thick">Thick</option>
                        <option value="xthick">Extra Thick</option>
                    </select>
                    <small>Scales all board arrows, including policy indicators</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("policy")">
                <h4 class="collapsible-header" @onclick='() => Toggle("policy")'>
                    <span class="section-title">Policy Overlay <span class="scope-badge analysis">Analysis</span></span>
                    <span class="collapse-indicator">@Indicator("policy")</span>
                </h4>
                <div class="field-group">
                    <label>Policy Move Indicator</label>
                    <select @bind="policyIndicator" @bind:after="Apply">
                        <option value="line">Line</option>
                        <option value="none">None</option>
                    </select>
                    <small>A line from the origin square into the value badge, or no indicator at all</small>
                </div>
                <div class="field-group">
                    <label>Indicator Color</label>
                    <div class="coord-color-row">
                        <select @bind="policyArrowMode" @bind:after="Apply">
                            <option value="auto">Default (black)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (policyArrowMode == "custom")
                        {
                            <input type="color" value="@policyArrowColor"
                                   @oninput="e => policyArrowColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Color of the policy-move line</small>
                </div>
                <div class="field-group">
                    <label>Indicator Prominence</label>
                    <select @bind="policyArrowProminence" @bind:after="Apply">
                        <option value="faint">Faint</option>
                        <option value="medium">Medium</option>
                        <option value="strong">Strong</option>
                    </select>
                    <small>Opacity of the policy-move line</small>
                </div>
                <div class="field-group">
                    <label>Policy Label Style</label>
                    <select @bind="policyLabelStyle" @bind:after="Apply">
                        <option value="circle">Circle background</option>
                        <option value="plain">Plain text</option>
                    </select>
                    <small>Dark circle behind policy values, or the value alone on the square</small>
                </div>
                <div class="field-group">
                    <label>Policy Label Color</label>
                    <div class="coord-color-row">
                        <select @bind="policyLabelMode" @bind:after="Apply">
                            <option value="auto">Default (yellow)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (policyLabelMode == "custom")
                        {
                            <input type="color" value="@policyLabelColor"
                                   @oninput="e => policyLabelColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Policy percentage labels on analysis boards</small>
                </div>
                <div class="field-group">
                    <label>Policy Label Background</label>
                    <div class="coord-color-row">
                        <select @bind="policyLabelBgMode" @bind:after="Apply">
                            <option value="auto">Default (dark)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (policyLabelBgMode == "custom")
                        {
                            <input type="color" value="@policyLabelBgColor"
                                   @oninput="e => policyLabelBgColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Circle/pill behind policy values (Circle background style only)</small>
                </div>
                <div class="field-group">
                    <label>Policy Label Size</label>
                    <select @bind="policyLabelSize" @bind:after="Apply">
                        <option value="small">Small</option>
                        <option value="medium">Medium</option>
                        <option value="large">Large</option>
                    </select>
                    <small>Font and chip size of the policy values</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("highlight")">
                <h4 class="collapsible-header" @onclick='() => Toggle("highlight")'>
                    <span class="section-title">Highlight <span class="scope-badge all">All boards</span></span>
                    <span class="collapse-indicator">@Indicator("highlight")</span>
                </h4>
                <div class="field-group">
                    <label>Last-Move Highlight Style</label>
                    <select @bind="highlightStyle" @bind:after="Apply">
                        <option value="replace">Replace square color</option>
                        <option value="tint">Translucent tint</option>
                        <option value="frame">Border frame</option>
                    </select>
                </div>
                <div class="field-group">
                    <label>Last-Move Highlight Color</label>
                    <div class="coord-color-row">
                        <select @bind="moveHighlightMode" @bind:after="Apply">
                            <option value="auto">Theme default</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (moveHighlightMode == "custom")
                        {
                            <input type="color" value="@moveHighlightColor"
                                   @oninput="e => moveHighlightColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Overrides the theme's last-move highlight on any preset</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("evalbar")">
                <h4 class="collapsible-header" @onclick='() => Toggle("evalbar")'>
                    <span class="section-title">Eval Bar <span class="scope-badge all">All boards</span></span>
                    <span class="collapse-indicator">@Indicator("evalbar")</span>
                </h4>
                <div class="field-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="showEvalBar" @bind:after="Apply" />
                        Show eval bar
                    </label>
                    <small>Vertical win-probability bar on boards with a live eval — analysis pages, Game Review, tournament board and live games grid (the broadcast page always shows it; never shown in Play vs Computer)</small>
                </div>
                <div class="field-group">
                    <label>Placement</label>
                    <select @bind="evalBarPlacement" @bind:after="Apply">
                        <option value="left">Left side of the frame</option>
                        <option value="right">Right side of the frame</option>
                    </select>
                    <small>The bar is drawn in the board frame; a frame is added if none is set. Dual Analysis ignores the side — it shows one bar per engine, one on each. PV boards and grid tiles keep their bar beside the board, being too small for a frame.</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("banner")">
                <h4 class="collapsible-header" @onclick='() => Toggle("banner")'>
                    <span class="section-title">Tournament header <span class="scope-badge all">Tournament page</span></span>
                    <span class="collapse-indicator">@Indicator("banner")</span>
                </h4>
                <div class="field-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="useNewTournamentBanner" @bind:after="Apply" />
                        Use the new tournament header
                    </label>
                    <small>Label above value, with the win and draw rules beside the counters that run against them, and a progress bar for the games played. Turn it off to go back to the old two-row header while the new one is being proven.</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("effects")">
                <h4 class="collapsible-header" @onclick='() => Toggle("effects")'>
                    <span class="section-title">Interaction &amp; Effects <span class="scope-badge analysis">Analysis &amp; play</span></span>
                    <span class="collapse-indicator">@Indicator("effects")</span>
                </h4>
                <div class="field-group">
                    <label>Selection Ring</label>
                    <div class="coord-color-row">
                        <select @bind="selRingMode" @bind:after="Apply">
                            <option value="auto">Default (green)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (selRingMode == "custom")
                        {
                            <input type="color" value="@selRingColor"
                                   @oninput="e => selRingColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Ring around the selected piece for click-to-move</small>
                </div>
                <div class="field-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="animateMoves" @bind:after="Apply" />
                        Animate Moves
                    </label>
                    <small>Pieces glide to their destination square on interactive boards</small>
                </div>
                <div class="field-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="showLegalMoves" @bind:after="Apply" />
                        Show Legal Moves
                    </label>
                    <small>Dots on the squares a picked-up piece may go to, a ring on a capture - rules only, no evaluation</small>
                </div>
                <div class="field-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="premoves" @bind:after="Apply" />
                        Premoves
                    </label>
                    <small>Queue your next move while the computer is thinking; it is played the moment your turn comes, if it is still legal</small>
                </div>
            </div>

            <div class="appearance-actions">
                <button class="btn btn-outline" @onclick="ResetAppearance">Reset to Defaults</button>
            </div>

            </div>
        </div>

        <div class="appearance-preview">
            <div class="preview-board-row">
            <div class="preview-board-main">
            <EbChessboard Fen="r1bqkbnr/pppp1ppp/2n5/4p3/2B1P3/5N2/PPPP1PPP/RNBQK2R b KQkq - 3 3"
                          SizePx="null" ShowCoordinates="true"
                          LastMoveFrom="f1" LastMoveTo="c4" LastMoveColor="w"
                          LightSquareColor="@Preview.LightSquare"
                          DarkSquareColor="@Preview.DarkSquare"
                          HighlightColor="@Preview.HighlightWhite"
                          HighlightColorBlack="@Preview.HighlightBlack"
                          PieceSet="@Preview.PieceSet"
                          PieceScale="@(pieceScale / 100.0)"
                          CoordinateSizeCss="@BoardThemeService.CoordSizeCss(coordinateSize)"
                          CoordinateColorCss="@EffectiveCoordColor"
                          SelectionRingColorCss="@EffectiveSelRing"
                          FrameWidthPct="@EffectiveFramePct"
                          FrameColorCss="@EffectivePreviewFrameColor"
                          CoordinatePlacement="@coordinatePlacement"
                          GutterLeft="@(evalBarPlacement == "right" ? null : PreviewGutterBar)"
                          GutterRight="@(evalBarPlacement == "right" ? PreviewGutterBar : null)"
                          SelectedSquare="c6"
                          Arrows="@PreviewArrows" Labels="@PreviewLabels" />
            </div>
            </div>
            <div class="preview-tiles">
                <div class="preview-tile">
                    @* Matches the real tiles: slim bar beside the board, no coordinates,
                       no frame — the grid's own layout, not the setting above. *@
                    <div class="preview-tile-row @(evalBarPlacement == "right" ? "eval-right" : "")">
                    @if (showEvalBar)
                    {
                        <EvalBar Cp="@((double?)0.9)" />
                    }
                    <EbChessboard Fen="r1bqkbnr/pppp1ppp/2n5/4p3/2B1P3/5N2/PPPP1PPP/RNBQK2R b KQkq - 3 3"
                                  SizePx="170" ShowCoordinates="false"
                                  LastMoveFrom="f1" LastMoveTo="c4" LastMoveColor="w"
                                  LightSquareColor="@Preview.LightSquare"
                                  DarkSquareColor="@Preview.DarkSquare"
                                  HighlightColor="@Preview.HighlightWhite"
                                  HighlightColorBlack="@Preview.HighlightBlack"
                                  PieceSet="@Preview.PieceSet"
                                  PieceScale="@(pieceScale / 100.0)"
                                  CoordinateSizeCss="@BoardThemeService.CoordSizeCss(coordinateSize)"
                                  CoordinateColorCss="@EffectiveCoordColor"
                                  FrameWidthPct="0" />
                    </div>
                    <small>Live-games grid tile — slim bar beside the board, no coordinates or frame at this size</small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string uiFontScale = "normal";
    private string navDrawerWidth = "normal";
    private int tournamentFontPct = 100;
    // Only the regions the user gave a size of their own, in px, for this screen; everything
    // else shows what the tournament page would use without one.
    private Dictionary<string, int> groupPx = new();
    // The regions moved on THIS page. Apply() writes only these: the settings file is shared
    // with the tournament page, whose "save" may have written other regions since this page was
    // opened, and rewriting the whole dictionary from this page would put them back.
    private readonly HashSet<string> touchedGroups = new();
    private bool fontScaleReset;

    // The charts-and-panels choices, as the selects show them: "" (follow), "on", "off" for the
    // flags, and the number as text for the three numbers ("" = follow). Written back one key
    // at a time, so a choice made elsewhere (the corner control) is never overwritten.
    private static readonly (string Key, string Label)[] DisplayFlags =
    {
        ("ShowEval", "Evaluation chart"),
        ("ShowNps", "Nodes per second chart"),
        ("ShowTime", "Time usage chart"),
        ("ShowNodes", "Nodes per move chart"),
        ("UseNpm", "Nodes per move in the standings, instead of per second"),
        ("ShowCrosstableBetweenGames", "Crosstable between games"),
    };
    private const string CrosstableKey = "CrosstableWithStandings";
    private static readonly (string Key, string Label, string Min, string Max, string Step)[] DisplayNumbers =
    {
        ("NumberOfLines", "Lines in the MCTS charts", "1", "10", "1"),
        ("Qdiff", "Q difference cut-off for the charts", "0.1", "3", "0.1"),
        ("AutoCycleTimeInSec", "Seconds between the tables the standings box cycles through", "5", "120", "5"),
    };
    private Dictionary<string, string> displayChoice = new();
    // tournament.json as it is now, read once - the page falls back to it for a region with no
    // size of its own, so the number shown here has to be the same one. Null when there is no
    // file or it cannot be read; the built-in defaults apply then, on the page as here.
    private ChessLibrary.LayoutTypes.LayoutOption fileLayout;
    // Empty until the browser answers, and empty for good if it never does; the scale is then
    // stored as the shared default instead of under a screen of its own.
    private string screenKey = "";
    private string themePreset = "eb-blue";
    private string customLight = "#B1D8DB";
    private string customDark = "#619EB3";
    private string customHighlight = "#FAFAD2";
    private string pieceSet = "wikipedia";
    private int pieceScale = 100;
    private bool animateMoves = true;
    private bool showLegalMoves = true;
    private bool premoves = true;
    private bool tournamentCoordinates = true;
    private string coordinateSize = "medium";
    private string coordinateColorMode = "auto";
    private string coordinateColor = "#888888";
    private string coordinatePlacement = "inside";
    private string frameWidth = "off";
    private string frameColorMode = "auto";
    private string frameColor = "#3B3733";
    private string highlightStyle = "replace";
    private string moveHighlightMode = "auto";
    private string moveHighlightColor = "#FAFAD2";
    private bool showEvalBar = true;
    private string evalBarPlacement = "left";
    private string selRingMode = "auto";
    private string selRingColor = "#14551E";
    private string arrowMode = "auto";
    private string arrowColor = "#9D8989";
    private string arrowWidth = "normal";
    private string whiteMoveArrowMode = "auto";
    private string whiteMoveArrowColor = "#cfece0";
    private string blackMoveArrowMode = "auto";
    private string blackMoveArrowColor = "#383231";
    private bool useNewTournamentBanner;
    private string policyLabelMode = "auto";
    private string policyLabelColor = "#FFEB3B";
    private string policyLabelStyle = "circle";
    private string policyIndicator = "arrow";
    private string policyArrowMode = "auto";
    private string policyArrowColor = "#000000";
    private string policyArrowProminence = "faint";
    private string policyLabelBgMode = "auto";
    private string policyLabelBgColor = "#3C3C3C";
    private string policyLabelSize = "medium";
    private IReadOnlyList<string> pieceSets = new[] { "wikipedia" };

    private BoardTheme Preview =>
        BoardThemeService.Preview(themePreset, customLight, customDark, customHighlight, pieceSet,
            moveHighlightMode == "custom" ? moveHighlightColor : "");

    // Preview overrides: fixed color, or empty string = force default (so previewing "Auto"
    // works even before the change is persisted).
    private string EffectiveCoordColor => coordinateColorMode == "custom" ? coordinateColor : "";
    private string EffectiveSelRing => selRingMode == "custom" ? selRingColor : "";
    private RenderFragment PreviewGutterBar =>
        showEvalBar ? @<EvalBar Cp="@((double?)0.9)" /> : null;

    // Frame preview mirrors the theme resolution, including the outside-coords coupling
    // and the per-preset default frame color.
    private (double Pct, string Color) EffectiveFrame =>
        BoardThemeService.ResolveFrame(frameWidth, frameColorMode == "custom" ? frameColor : "",
            coordinatePlacement, BoardThemeService.PresetFrameColor(themePreset, customDark), coordinateSize);
    // The real boards widen their own frame to fit an eval bar (ModernChessboard /
    // StreamingChessboard). The preview draws its bar the same way, so it has to apply the
    // same floor — otherwise Frame = Off would show a preview with no bar at all while
    // every actual board shows one.
    private double EffectiveFramePct =>
        showEvalBar
            ? Math.Max(EffectiveFrame.Pct, BoardThemeService.MinGutterPctForEvalBar)
            : EffectiveFrame.Pct;

    private string EffectivePreviewFrameColor =>
        showEvalBar && EffectiveFrame.Pct <= 0 ? "transparent" : EffectiveFrame.Color;
    private string EffectiveArrowColor => arrowMode == "custom" ? arrowColor : "#9D8989";
    private string EffectivePolicyLabelColor => policyLabelMode == "custom" ? policyLabelColor : "#FFEB3B";
    private string EffectivePolicyArrowColor => policyArrowMode == "custom" ? policyArrowColor : "black";
    private string EffectiveWhiteMoveArrow => whiteMoveArrowMode == "custom" ? whiteMoveArrowColor : "#cfece0";
    private string EffectiveBlackMoveArrow => blackMoveArrowMode == "custom" ? blackMoveArrowColor : "#383231";
    private double EffectivePolicyArrowOpacity => BoardThemeService.PolicyIndicatorOpacity(policyArrowProminence);
    private string EffectivePolicyLabelBg => BoardThemeService.PolicyLabelBg(policyLabelBgMode == "custom" ? policyLabelBgColor : "");
    private double EffectivePolicyFontPx => BoardThemeService.PolicyLabelFontPx(policyLabelSize);
    private double EffectivePolicyChipPct => BoardThemeService.PolicyLabelChipPct(policyLabelSize);

    // Sample overlays, mirroring the real boards so custom colors are previewed against
    // their true context. Both are legal moves for Black here (Nf6, a6), and the labels
    // cover a dark (f6) and a light (a6) square — legibility depends on the square shade.
    // g8->f6 is a tournament-style PV arrow (themed color/width, always an arrow);
    // a7->a6 is a policy move drawn per the indicator setting (faint black arrow /
    // origin dot / none), with the analysis circle backing per the label style.
    private IReadOnlyList<EbArrow> PreviewArrows
    {
        get
        {
            var arrows = new List<EbArrow>
            {
                new EbArrow("g8", "f6", EffectiveArrowColor),
                // Dual best-move arrows (streaming board when both engines' moves are shown)
                new EbArrow("b1", "c3", EffectiveWhiteMoveArrow),
                new EbArrow("f8", "e7", EffectiveBlackMoveArrow),
            };
            if (policyIndicator == "line")
                arrows.Add(new EbArrow("a7", "a6", EffectivePolicyArrowColor, EffectivePolicyArrowOpacity, 0.3, "line"));
            return arrows;
        }
    }
    // f6 shows a deliberately long value (100.2K) to prove the pill encloses it.
    // No ponder-badge sample here: its fixed 19px font is sized for the large streaming
    // board and overflows on preview-sized squares.
    private IReadOnlyList<EbSquareLabel> PreviewLabels =>
        policyLabelStyle == "plain"
            ? new[]
            {
                new EbSquareLabel("f6", "100.2K", EffectivePolicyLabelColor, "transparent", EffectivePolicyChipPct, EffectivePolicyFontPx),
                new EbSquareLabel("a6", "12%", EffectivePolicyLabelColor, "transparent", EffectivePolicyChipPct, EffectivePolicyFontPx),
            }
            : new[]
            {
                new EbSquareLabel("f6", "100.2K", EffectivePolicyLabelColor, EffectivePolicyLabelBg, EffectivePolicyChipPct, EffectivePolicyFontPx, null, 0.9, true),
                new EbSquareLabel("a6", "12%", EffectivePolicyLabelColor, EffectivePolicyLabelBg, EffectivePolicyChipPct, EffectivePolicyFontPx, null, 0.9, true),
            };

    protected override void OnInitialized()
    {
        pieceSets = BoardThemeSvc.GetAvailablePieceSets();
        var s = SettingsService.Settings;
        uiFontScale = s.UiFontScale is "small" or "large" or "xlarge" ? s.UiFontScale : "normal";
        tournamentFontPct = (int)Math.Round(s.FontScaleFor(screenKey) * 100);
        groupPx = LoadGroupPx(s);
        displayChoice = LoadDisplayChoice(s);
        // JSON.readTournamentJson is a parse and nothing else. Manager.loadTournament() is not:
        // it re-reads every engine definition and consumes the one-shot cup bracket path override,
        // which a cup resume in another tab sets and expects to find still there.
        try
        {
            var path = System.IO.Path.Combine(Environment.CurrentDirectory, "wwwroot", "tournament.json");
            fileLayout = ChessLibrary.Configuration.JSON.readTournamentJson(path)?.Value?.LayoutOption;
        }
        catch { fileLayout = null; }
        navDrawerWidth = s.NavDrawerWidth is "narrow" or "wide" ? s.NavDrawerWidth : "normal";
        themePreset = string.IsNullOrEmpty(s.BoardThemePreset) ? "eb-blue" : s.BoardThemePreset;
        customLight = s.BoardCustomLightColor ?? "#B1D8DB";
        customDark = s.BoardCustomDarkColor ?? "#619EB3";
        customHighlight = s.BoardCustomHighlightColor ?? "#FAFAD2";
        pieceSet = string.IsNullOrEmpty(s.BoardPieceSet) ? "wikipedia" : s.BoardPieceSet;
        pieceScale = s.BoardPieceScale is >= 80 and <= 100 ? s.BoardPieceScale : 100;
        animateMoves = s.BoardAnimateMoves;
        showLegalMoves = s.BoardShowLegalMoves;
        premoves = s.BoardPremoves;
        tournamentCoordinates = s.ShowTournamentBoardCoordinates;
        coordinateSize = string.IsNullOrEmpty(s.BoardCoordinateSize) ? "medium" : s.BoardCoordinateSize;
        coordinateColorMode = string.IsNullOrEmpty(s.BoardCoordinateColor) ? "auto" : "custom";
        if (coordinateColorMode == "custom") coordinateColor = s.BoardCoordinateColor;
        coordinatePlacement = s.BoardCoordinatePlacement == "outside" ? "outside" : "inside";
        frameWidth = s.BoardFrameWidth is "thin" or "medium" or "thick" ? s.BoardFrameWidth : "off";
        frameColorMode = string.IsNullOrEmpty(s.BoardFrameColor) ? "auto" : "custom";
        if (frameColorMode == "custom") frameColor = s.BoardFrameColor;
        highlightStyle = s.BoardHighlightStyle is "tint" or "frame" ? s.BoardHighlightStyle : "replace";
        moveHighlightMode = string.IsNullOrEmpty(s.BoardMoveHighlightColor) ? "auto" : "custom";
        if (moveHighlightMode == "custom") moveHighlightColor = s.BoardMoveHighlightColor;
        showEvalBar = s.ShowEvalBar;
        evalBarPlacement = s.EvalBarPlacement == "right" ? "right" : "left";
        useNewTournamentBanner = s.UseNewTournamentBanner;
        selRingMode = string.IsNullOrEmpty(s.BoardSelectionRingColor) ? "auto" : "custom";
        if (selRingMode == "custom") selRingColor = s.BoardSelectionRingColor;
        arrowMode = string.IsNullOrEmpty(s.BoardArrowColor) ? "auto" : "custom";
        if (arrowMode == "custom") arrowColor = s.BoardArrowColor;
        arrowWidth = string.IsNullOrEmpty(s.BoardArrowWidth) ? "normal" : s.BoardArrowWidth;
        whiteMoveArrowMode = string.IsNullOrEmpty(s.BoardWhiteMoveArrowColor) ? "auto" : "custom";
        if (whiteMoveArrowMode == "custom") whiteMoveArrowColor = s.BoardWhiteMoveArrowColor;
        blackMoveArrowMode = string.IsNullOrEmpty(s.BoardBlackMoveArrowColor) ? "auto" : "custom";
        if (blackMoveArrowMode == "custom") blackMoveArrowColor = s.BoardBlackMoveArrowColor;
        policyLabelMode = string.IsNullOrEmpty(s.BoardPolicyLabelColor) ? "auto" : "custom";
        if (policyLabelMode == "custom") policyLabelColor = s.BoardPolicyLabelColor;
        policyLabelStyle = s.BoardPolicyLabelStyle == "plain" ? "plain" : "circle";
        policyIndicator = s.BoardPolicyIndicator == "none" ? "none" : "line";
        policyArrowMode = string.IsNullOrEmpty(s.BoardPolicyIndicatorColor) ? "auto" : "custom";
        if (policyArrowMode == "custom") policyArrowColor = s.BoardPolicyIndicatorColor;
        policyArrowProminence = s.BoardPolicyIndicatorProminence is "medium" or "strong" ? s.BoardPolicyIndicatorProminence : "faint";
        policyLabelBgMode = string.IsNullOrEmpty(s.BoardPolicyLabelBgColor) ? "auto" : "custom";
        if (policyLabelBgMode == "custom") policyLabelBgColor = s.BoardPolicyLabelBgColor;
        policyLabelSize = s.BoardPolicyLabelSize is "small" or "large" ? s.BoardPolicyLabelSize : "medium";
    }

    // Collapsible sections: Theme and Pieces start open, the rest collapsed.
    private readonly HashSet<string> openSections = new() { "interface", "theme", "pieces" };
    private string SectionClass(string key) => openSections.Contains(key) ? "" : "collapsed";
    private string Indicator(string key) => openSections.Contains(key) ? "▾" : "▸";
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;
        screenKey = await JsInteropService.GetScreenBucketAsync(JS);
        // This screen has numbers of its own; show those.
        tournamentFontPct = (int)Math.Round(SettingsService.Settings.FontScaleFor(screenKey) * 100);
        groupPx = LoadGroupPx(SettingsService.Settings);
        displayChoice = LoadDisplayChoice(SettingsService.Settings);
        StateHasChanged();
    }

    /// <summary>
    /// Drops the A-/A+ nudge on this screen, so the tournament page renders the numbers shown
    /// here. 100% is stored under the screen's key rather than the entry removed, as the
    /// tournament page does: without an entry the screen falls back to the shared default,
    /// which another screen may have set to something else. With no screen key the shared
    /// default is the one in use, so that is the one reset.
    /// </summary>
    private void ResetTournamentFontScale()
    {
        tournamentFontPct = 100;
        fontScaleReset = true;
        Apply();
        fontScaleReset = false;
    }

    private void ResetTournamentFontScale(GlobalSettings merged)
    {
        if (string.IsNullOrEmpty(screenKey)) merged.TournamentFontScale = 1.0;
        else merged.TournamentFontScaleByScreen[screenKey] = 1.0;
    }

    private Dictionary<string, string> LoadDisplayChoice(GlobalSettings s)
    {
        var l = s.TournamentLayoutFor(screenKey);
        var d = new Dictionary<string, string>();
        string Flag(bool? v) => v is null ? "" : v.Value ? "on" : "off";
        d["ShowEval"] = Flag(l?.ShowEval); d["ShowNps"] = Flag(l?.ShowNps); d["ShowTime"] = Flag(l?.ShowTime);
        d["ShowNodes"] = Flag(l?.ShowNodes); d["UseNpm"] = Flag(l?.UseNpm);
        d["ShowCrosstableBetweenGames"] = Flag(l?.ShowCrosstableBetweenGames);
        d[CrosstableKey] = l?.CrosstableWithStandings is "cycle" or "below" or "none" ? l.CrosstableWithStandings : "";
        d["NumberOfLines"] = l?.NumberOfLines is > 0 ? l.NumberOfLines.Value.ToString() : "";
        d["Qdiff"] = l?.Qdiff is > 0 ? l.Qdiff.Value.ToString(System.Globalization.CultureInfo.InvariantCulture) : "";
        d["AutoCycleTimeInSec"] = l?.AutoCycleTimeInSec is > 0 ? l.AutoCycleTimeInSec.Value.ToString() : "";
        return d;
    }

    /// What "follow" gives right now: the file in use, normalised, else the built-in default.
    private ChessLibrary.LayoutTypes.LayoutOption Followed => ChessLibrary.LayoutTypes.LayoutOption.Normalize(fileLayout);

    private bool FallbackFlag(string key) => key switch
    {
        "ShowEval" => Followed.Charts.ShowEval,
        "ShowNps" => Followed.Charts.ShowNPS,
        "ShowTime" => Followed.Charts.ShowTime,
        "ShowNodes" => Followed.Charts.ShowNodes,
        "UseNpm" => Followed.UseNPM,
        "ShowCrosstableBetweenGames" => Followed.ShowCrosstableBetweenGames,
        _ => false
    };

    private string FallbackCrosstable() =>
        Followed.CrosstableWithStandings.IsCycle ? "cycle" : Followed.CrosstableWithStandings.IsBelow ? "below" : "none";

    private string FallbackNumber(string key) => key switch
    {
        "NumberOfLines" => Followed.Charts.NumberOfLines.ToString(),
        "Qdiff" => Followed.Charts.Qdiff.ToString("0.#", System.Globalization.CultureInfo.InvariantCulture),
        "AutoCycleTimeInSec" => Followed.AutoCycleTimeInSec.ToString(),
        _ => ""
    };

    /// One key, written straight away - the page has no other state to merge with, and the
    /// tournament page may have changed a neighbour since this page was opened.
    private void ApplyDisplay(string key)
    {
        var current = SettingsService.Settings;
        var merged = JsonSerializer.Deserialize<GlobalSettings>(JsonSerializer.Serialize(current)) ?? new GlobalSettings();
        var l = merged.TournamentLayoutForWrite(screenKey);
        var v = displayChoice.TryGetValue(key, out var raw) ? raw?.Trim() ?? "" : "";
        bool? flag = v == "on" ? true : v == "off" ? false : null;
        var inv = System.Globalization.CultureInfo.InvariantCulture;
        switch (key)
        {
            case "ShowEval": l.ShowEval = flag; break;
            case "ShowNps": l.ShowNps = flag; break;
            case "ShowTime": l.ShowTime = flag; break;
            case "ShowNodes": l.ShowNodes = flag; break;
            case "UseNpm": l.UseNpm = flag; break;
            case "ShowCrosstableBetweenGames": l.ShowCrosstableBetweenGames = flag; break;
            case CrosstableKey: l.CrosstableWithStandings = v is "cycle" or "below" or "none" ? v : ""; break;
            case "NumberOfLines": l.NumberOfLines = int.TryParse(v, out var n) && n > 0 ? n : null; break;
            case "Qdiff": l.Qdiff = double.TryParse(v.Replace(',', '.'), System.Globalization.NumberStyles.Float, inv, out var q) && q > 0 ? q : null; break;
            case "AutoCycleTimeInSec": l.AutoCycleTimeInSec = int.TryParse(v, out var a) && a > 0 ? a : null; break;
            default: return;
        }
        SettingsService.Save(merged);
    }

    /// The sizes this screen saved, for the regions that exist.
    private Dictionary<string, int> LoadGroupPx(GlobalSettings s) =>
        (s.TournamentLayoutFor(screenKey)?.FontPx ?? new())
            .Where(kv => kv.Value > 0 && GlobalSettings.FontGroups.Any(g => g.Key == kv.Key))
            .ToDictionary(kv => kv.Key, kv => kv.Value);

    /// What a region shows: its own size if it has one, otherwise what the page uses without
    /// one - the number in tournament.json if that file has one, else the built-in default.
    private int GroupPx(string key) => groupPx.TryGetValue(key, out var v) ? v : FallbackPx(key);

    private int FallbackPx(string key)
    {
        var file = GlobalSettings.FileFontPx(fileLayout, key);
        return file > 0 ? file : GlobalSettings.DefaultFontPx(key);
    }

    /// Says where an unset number comes from, so a slider that reads 25 next to a page that
    /// shows 25 is not a mystery.
    private string FallbackLabel(string key) =>
        groupPx.ContainsKey(key) ? ""
        : GlobalSettings.FileFontPx(fileLayout, key) > 0 ? " (tournament.json)"
        : " (default)";

    private void ClearGroup(string key)
    {
        groupPx.Remove(key);
        touchedGroups.Add(key);
        Apply();
    }

    private void Toggle(string key)
    {
        if (!openSections.Remove(key)) openSections.Add(key);
    }

    private void SelectPreset(string key) { themePreset = key; Apply(); }
    private void SelectPieceSet(string set) { pieceSet = set; Apply(); }

    // Instant apply: persist only this page's fields on top of the CURRENT settings, so a
    // concurrently edited Settings page is never clobbered (merge, not snapshot).
    private void Apply()
    {
        var current = SettingsService.Settings;
        var merged = JsonSerializer.Deserialize<GlobalSettings>(JsonSerializer.Serialize(current)) ?? new GlobalSettings();
        merged.UiFontScale = uiFontScale;
        merged.NavDrawerWidth = navDrawerWidth;
        if (fontScaleReset) ResetTournamentFontScale(merged);
        if (touchedGroups.Count > 0)
        {
            var live = merged.TournamentLayoutForWrite(screenKey).FontPx;
            foreach (var key in touchedGroups)
            {
                if (groupPx.TryGetValue(key, out var px) && px > 0) live[key] = px;
                else live.Remove(key);
            }
        }
        merged.BoardThemePreset = themePreset;
        merged.BoardCustomLightColor = customLight;
        merged.BoardCustomDarkColor = customDark;
        merged.BoardCustomHighlightColor = customHighlight;
        merged.BoardPieceSet = pieceSet;
        merged.BoardPieceScale = pieceScale;
        merged.BoardAnimateMoves = animateMoves;
        merged.BoardShowLegalMoves = showLegalMoves;
        merged.BoardPremoves = premoves;
        merged.ShowTournamentBoardCoordinates = tournamentCoordinates;
        merged.BoardCoordinateSize = coordinateSize;
        merged.BoardCoordinateColor = coordinateColorMode == "custom" ? coordinateColor : "";
        merged.BoardCoordinatePlacement = coordinatePlacement;
        merged.BoardFrameWidth = frameWidth;
        merged.BoardFrameColor = frameColorMode == "custom" ? frameColor : "";
        merged.BoardHighlightStyle = highlightStyle;
        merged.BoardMoveHighlightColor = moveHighlightMode == "custom" ? moveHighlightColor : "";
        merged.ShowEvalBar = showEvalBar;
        merged.EvalBarPlacement = evalBarPlacement;
        merged.UseNewTournamentBanner = useNewTournamentBanner;
        merged.BoardSelectionRingColor = selRingMode == "custom" ? selRingColor : "";
        merged.BoardArrowColor = arrowMode == "custom" ? arrowColor : "";
        merged.BoardArrowWidth = arrowWidth;
        merged.BoardWhiteMoveArrowColor = whiteMoveArrowMode == "custom" ? whiteMoveArrowColor : "";
        merged.BoardBlackMoveArrowColor = blackMoveArrowMode == "custom" ? blackMoveArrowColor : "";
        merged.BoardPolicyLabelColor = policyLabelMode == "custom" ? policyLabelColor : "";
        merged.BoardPolicyLabelStyle = policyLabelStyle;
        merged.BoardPolicyIndicator = policyIndicator;
        merged.BoardPolicyIndicatorColor = policyArrowMode == "custom" ? policyArrowColor : "";
        merged.BoardPolicyIndicatorProminence = policyArrowProminence;
        merged.BoardPolicyLabelBgColor = policyLabelBgMode == "custom" ? policyLabelBgColor : "";
        merged.BoardPolicyLabelSize = policyLabelSize;
        SettingsService.Save(merged);
    }

    private void ResetAppearance()
    {
        var d = new GlobalSettings();
        themePreset = d.BoardThemePreset;
        customLight = d.BoardCustomLightColor;
        customDark = d.BoardCustomDarkColor;
        customHighlight = d.BoardCustomHighlightColor;
        pieceSet = d.BoardPieceSet;
        pieceScale = d.BoardPieceScale;
        animateMoves = d.BoardAnimateMoves;
        showLegalMoves = d.BoardShowLegalMoves;
        premoves = d.BoardPremoves;
        tournamentCoordinates = d.ShowTournamentBoardCoordinates;
        coordinateSize = d.BoardCoordinateSize;
        coordinateColorMode = "auto";
        coordinatePlacement = d.BoardCoordinatePlacement;
        frameWidth = d.BoardFrameWidth;
        frameColorMode = "auto";
        highlightStyle = d.BoardHighlightStyle;
        moveHighlightMode = "auto";
        showEvalBar = d.ShowEvalBar;
        evalBarPlacement = d.EvalBarPlacement;
        selRingMode = "auto";
        arrowMode = "auto";
        arrowWidth = d.BoardArrowWidth;
        whiteMoveArrowMode = "auto";
        blackMoveArrowMode = "auto";
        policyLabelMode = "auto";
        policyLabelStyle = d.BoardPolicyLabelStyle;
        policyIndicator = d.BoardPolicyIndicator;
        policyArrowMode = "auto";
        policyArrowProminence = d.BoardPolicyIndicatorProminence;
        policyLabelBgMode = "auto";
        policyLabelSize = d.BoardPolicyLabelSize;
        Apply();
    }
}

@page "/appearance"
@inject GlobalSettingsService SettingsService
@inject BoardThemeService BoardThemeSvc
@using System.Text.Json
@using WebGUI.Services
@using WebGUI.Components.Layout.ChessboardLayout

<PageTitle>Board Appearance</PageTitle>

<div class="appearance-container">
    <h2>Board Appearance</h2>
    <div class="appearance-description">
        Themes, piece sets, coordinates and effects for every chessboard in EngineBattle.
        Changes apply immediately to all boards.
    </div>

    <div class="appearance-layout">
        <div class="appearance-controls">
            <div class="controls-col">

            <div class="appearance-section @SectionClass("theme")">
                <h4 class="collapsible-header" @onclick='() => Toggle("theme")'>
                    <span class="section-title">Theme <span class="scope-badge all">All boards</span></span>
                    <span class="collapse-indicator">@Indicator("theme")</span>
                </h4>
                <div class="preset-grid">
                    @foreach (var (key, name, light, dark) in BoardThemeService.PresetSwatches)
                    {
                        <button class="preset-card @(themePreset == key ? "selected" : "")"
                                @onclick="() => SelectPreset(key)">
                            <span class="swatch">
                                <span style="background:@light"></span><span style="background:@dark"></span>
                                <span style="background:@dark"></span><span style="background:@light"></span>
                            </span>
                            <span class="preset-name">@name</span>
                        </button>
                    }
                    <button class="preset-card @(themePreset == "custom" ? "selected" : "")"
                            @onclick='() => SelectPreset("custom")'>
                        <span class="swatch">
                            <span style="background:@customLight"></span><span style="background:@customDark"></span>
                            <span style="background:@customDark"></span><span style="background:@customLight"></span>
                        </span>
                        <span class="preset-name">Custom</span>
                    </button>
                </div>

                @if (themePreset == "custom")
                {
                    <div class="color-row">
                        <div class="color-field">
                            <label>Light squares</label>
                            <input type="color" value="@customLight"
                                   @oninput="e => customLight = (string)e.Value" @onchange="Apply" />
                        </div>
                        <div class="color-field">
                            <label>Dark squares</label>
                            <input type="color" value="@customDark"
                                   @oninput="e => customDark = (string)e.Value" @onchange="Apply" />
                        </div>
                        <div class="color-field">
                            <label>Move highlight</label>
                            <input type="color" value="@customHighlight"
                                   @oninput="e => customHighlight = (string)e.Value" @onchange="Apply" />
                        </div>
                    </div>
                }
            </div>

            <div class="appearance-section @SectionClass("pieces")">
                <h4 class="collapsible-header" @onclick='() => Toggle("pieces")'>
                    <span class="section-title">Pieces <span class="scope-badge all">All boards</span></span>
                    <span class="collapse-indicator">@Indicator("pieces")</span>
                </h4>
                <div class="pieceset-grid">
                    @foreach (var set in pieceSets)
                    {
                        <button class="pieceset-card @(pieceSet == set ? "selected" : "")"
                                @onclick="() => SelectPieceSet(set)">
                            <span class="pieceset-thumbs">
                                <img src="@BoardThemeSvc.PieceImg(set, "wK")" alt="wK" />
                                <img src="@BoardThemeSvc.PieceImg(set, "bN")" alt="bN" />
                            </span>
                            <span class="pieceset-name">@set</span>
                        </button>
                    }
                </div>
                <small>Add your own set as a folder under wwwroot/pieces (wK.svg … bP.svg)</small>
            </div>

            <div class="appearance-section @SectionClass("coords")">
                <h4 class="collapsible-header" @onclick='() => Toggle("coords")'>
                    <span class="section-title">Coordinates <span class="scope-badge all">All boards</span></span>
                    <span class="collapse-indicator">@Indicator("coords")</span>
                </h4>
                <div class="field-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="tournamentCoordinates" @bind:after="Apply" />
                        Coordinates on Tournament Boards
                    </label>
                    <small>Show a1–h8 on live tournament and PV boards (small tiles always hide them)</small>
                </div>
                <div class="field-group">
                    <label>Size</label>
                    <select @bind="coordinateSize" @bind:after="Apply">
                        <option value="small">Small</option>
                        <option value="medium">Medium</option>
                        <option value="large">Large</option>
                        <option value="xlarge">Extra Large</option>
                    </select>
                </div>
                <div class="field-group">
                    <label>Color</label>
                    <div class="coord-color-row">
                        <select @bind="coordinateColorMode" @bind:after="Apply">
                            <option value="auto">Auto (contrast)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (coordinateColorMode == "custom")
                        {
                            <input type="color" value="@coordinateColor"
                                   @oninput="e => coordinateColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Auto uses the opposite square color for contrast on any theme</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("highlight")">
                <h4 class="collapsible-header" @onclick='() => Toggle("highlight")'>
                    <span class="section-title">Highlight <span class="scope-badge all">All boards</span></span>
                    <span class="collapse-indicator">@Indicator("highlight")</span>
                </h4>
                <div class="field-group">
                    <label>Last-Move Highlight Style</label>
                    <select @bind="highlightStyle" @bind:after="Apply">
                        <option value="replace">Replace square color</option>
                        <option value="tint">Translucent tint</option>
                        <option value="frame">Border frame</option>
                    </select>
                </div>
                <div class="field-group">
                    <label>Last-Move Highlight Color</label>
                    <div class="coord-color-row">
                        <select @bind="moveHighlightMode" @bind:after="Apply">
                            <option value="auto">Theme default</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (moveHighlightMode == "custom")
                        {
                            <input type="color" value="@moveHighlightColor"
                                   @oninput="e => moveHighlightColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Overrides the theme's last-move highlight on any preset</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("evalbar")">
                <h4 class="collapsible-header" @onclick='() => Toggle("evalbar")'>
                    <span class="section-title">Eval Bar <span class="scope-badge all">Analysis &amp; tournament</span></span>
                    <span class="collapse-indicator">@Indicator("evalbar")</span>
                </h4>
                <div class="field-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="showEvalBar" @bind:after="Apply" />
                        Show eval bar beside the board
                    </label>
                    <small>Vertical win-probability bar on Single/Dual Analysis, Game Review and the live tournament board (the broadcast page always shows it; never shown in Play vs Computer)</small>
                </div>
            </div>

            </div>
            <div class="controls-col">

            <div class="appearance-section @SectionClass("pvarrows")">
                <h4 class="collapsible-header" @onclick='() => Toggle("pvarrows")'>
                    <span class="section-title">PV Arrows <span class="scope-badge tournament">Tournament &amp; live</span></span>
                    <span class="collapse-indicator">@Indicator("pvarrows")</span>
                </h4>
                <div class="field-group">
                    <label>Arrow Color</label>
                    <div class="coord-color-row">
                        <select @bind="arrowMode" @bind:after="Apply">
                            <option value="auto">Default</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (arrowMode == "custom")
                        {
                            <input type="color" value="@arrowColor"
                                   @oninput="e => arrowColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Best-move / PV arrows on live tournament boards</small>
                </div>
                <div class="field-group">
                    <label>White Move Arrow</label>
                    <div class="coord-color-row">
                        <select @bind="whiteMoveArrowMode" @bind:after="Apply">
                            <option value="auto">Default (light)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (whiteMoveArrowMode == "custom")
                        {
                            <input type="color" value="@whiteMoveArrowColor"
                                   @oninput="e => whiteMoveArrowColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>White's best move when both engines' moves are shown</small>
                </div>
                <div class="field-group">
                    <label>Black Move Arrow</label>
                    <div class="coord-color-row">
                        <select @bind="blackMoveArrowMode" @bind:after="Apply">
                            <option value="auto">Default (dark)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (blackMoveArrowMode == "custom")
                        {
                            <input type="color" value="@blackMoveArrowColor"
                                   @oninput="e => blackMoveArrowColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Black's best move when both engines' moves are shown</small>
                </div>
                <div class="field-group">
                    <label>Arrow Width</label>
                    <select @bind="arrowWidth" @bind:after="Apply">
                        <option value="thin">Thin</option>
                        <option value="normal">Normal</option>
                        <option value="thick">Thick</option>
                        <option value="xthick">Extra Thick</option>
                    </select>
                    <small>Scales all board arrows, including policy indicators</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("policy")">
                <h4 class="collapsible-header" @onclick='() => Toggle("policy")'>
                    <span class="section-title">Policy Overlay <span class="scope-badge analysis">Analysis</span></span>
                    <span class="collapse-indicator">@Indicator("policy")</span>
                </h4>
                <div class="field-group">
                    <label>Policy Move Indicator</label>
                    <select @bind="policyIndicator" @bind:after="Apply">
                        <option value="line">Line</option>
                        <option value="none">None</option>
                    </select>
                    <small>A line from the origin square into the value badge, or no indicator at all</small>
                </div>
                <div class="field-group">
                    <label>Indicator Color</label>
                    <div class="coord-color-row">
                        <select @bind="policyArrowMode" @bind:after="Apply">
                            <option value="auto">Default (black)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (policyArrowMode == "custom")
                        {
                            <input type="color" value="@policyArrowColor"
                                   @oninput="e => policyArrowColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Color of the policy-move line</small>
                </div>
                <div class="field-group">
                    <label>Indicator Prominence</label>
                    <select @bind="policyArrowProminence" @bind:after="Apply">
                        <option value="faint">Faint</option>
                        <option value="medium">Medium</option>
                        <option value="strong">Strong</option>
                    </select>
                    <small>Opacity of the policy-move line</small>
                </div>
                <div class="field-group">
                    <label>Policy Label Style</label>
                    <select @bind="policyLabelStyle" @bind:after="Apply">
                        <option value="circle">Circle background</option>
                        <option value="plain">Plain text</option>
                    </select>
                    <small>Dark circle behind policy values, or the value alone on the square</small>
                </div>
                <div class="field-group">
                    <label>Policy Label Color</label>
                    <div class="coord-color-row">
                        <select @bind="policyLabelMode" @bind:after="Apply">
                            <option value="auto">Default (yellow)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (policyLabelMode == "custom")
                        {
                            <input type="color" value="@policyLabelColor"
                                   @oninput="e => policyLabelColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Policy percentage labels on analysis boards</small>
                </div>
                <div class="field-group">
                    <label>Policy Label Background</label>
                    <div class="coord-color-row">
                        <select @bind="policyLabelBgMode" @bind:after="Apply">
                            <option value="auto">Default (dark)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (policyLabelBgMode == "custom")
                        {
                            <input type="color" value="@policyLabelBgColor"
                                   @oninput="e => policyLabelBgColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Circle/pill behind policy values (Circle background style only)</small>
                </div>
                <div class="field-group">
                    <label>Policy Label Size</label>
                    <select @bind="policyLabelSize" @bind:after="Apply">
                        <option value="small">Small</option>
                        <option value="medium">Medium</option>
                        <option value="large">Large</option>
                    </select>
                    <small>Font and chip size of the policy values</small>
                </div>
            </div>

            <div class="appearance-section @SectionClass("effects")">
                <h4 class="collapsible-header" @onclick='() => Toggle("effects")'>
                    <span class="section-title">Interaction &amp; Effects <span class="scope-badge analysis">Analysis &amp; play</span></span>
                    <span class="collapse-indicator">@Indicator("effects")</span>
                </h4>
                <div class="field-group">
                    <label>Selection Ring</label>
                    <div class="coord-color-row">
                        <select @bind="selRingMode" @bind:after="Apply">
                            <option value="auto">Default (green)</option>
                            <option value="custom">Custom</option>
                        </select>
                        @if (selRingMode == "custom")
                        {
                            <input type="color" value="@selRingColor"
                                   @oninput="e => selRingColor = (string)e.Value" @onchange="Apply" />
                        }
                    </div>
                    <small>Ring around the selected piece for click-to-move</small>
                </div>
                <div class="field-group">
                    <label class="checkbox-label">
                        <input type="checkbox" @bind="animateMoves" @bind:after="Apply" />
                        Animate Moves
                    </label>
                    <small>Pieces glide to their destination square on interactive boards</small>
                </div>
            </div>

            <div class="appearance-actions">
                <button class="btn btn-outline" @onclick="ResetAppearance">Reset to Defaults</button>
            </div>

            </div>
        </div>

        <div class="appearance-preview">
            <div class="preview-board-row">
            @if (showEvalBar)
            {
                <EvalBar Cp="@((double?)0.9)" />
            }
            <div class="preview-board-main">
            <EbChessboard Fen="r1bqkbnr/pppp1ppp/2n5/4p3/2B1P3/5N2/PPPP1PPP/RNBQK2R b KQkq - 3 3"
                          SizePx="null" ShowCoordinates="true"
                          LastMoveFrom="f1" LastMoveTo="c4" LastMoveColor="w"
                          LightSquareColor="@Preview.LightSquare"
                          DarkSquareColor="@Preview.DarkSquare"
                          HighlightColor="@Preview.HighlightWhite"
                          HighlightColorBlack="@Preview.HighlightBlack"
                          PieceSet="@Preview.PieceSet"
                          CoordinateSizeCss="@BoardThemeService.CoordSizeCss(coordinateSize)"
                          CoordinateColorCss="@EffectiveCoordColor"
                          SelectionRingColorCss="@EffectiveSelRing"
                          SelectedSquare="c6"
                          Arrows="@PreviewArrows" Labels="@PreviewLabels" />
            </div>
            </div>
            <div class="preview-tiles">
                <div class="preview-tile">
                    <EbChessboard Fen="r1bqkbnr/pppp1ppp/2n5/4p3/2B1P3/5N2/PPPP1PPP/RNBQK2R b KQkq - 3 3"
                                  SizePx="170" ShowCoordinates="@tournamentCoordinates"
                                  LastMoveFrom="f1" LastMoveTo="c4" LastMoveColor="w"
                                  LightSquareColor="@Preview.LightSquare"
                                  DarkSquareColor="@Preview.DarkSquare"
                                  HighlightColor="@Preview.HighlightWhite"
                                  HighlightColorBlack="@Preview.HighlightBlack"
                                  PieceSet="@Preview.PieceSet"
                                  CoordinateSizeCss="@BoardThemeService.CoordSizeCss(coordinateSize)"
                                  CoordinateColorCss="@EffectiveCoordColor" />
                    <small>Tournament tile (coordinates auto-hide below 200px)</small>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    private string themePreset = "eb-blue";
    private string customLight = "#B1D8DB";
    private string customDark = "#619EB3";
    private string customHighlight = "#FAFAD2";
    private string pieceSet = "wikipedia";
    private bool animateMoves = true;
    private bool tournamentCoordinates = true;
    private string coordinateSize = "medium";
    private string coordinateColorMode = "auto";
    private string coordinateColor = "#888888";
    private string highlightStyle = "replace";
    private string moveHighlightMode = "auto";
    private string moveHighlightColor = "#FAFAD2";
    private bool showEvalBar = true;
    private string selRingMode = "auto";
    private string selRingColor = "#14551E";
    private string arrowMode = "auto";
    private string arrowColor = "#9D8989";
    private string arrowWidth = "normal";
    private string whiteMoveArrowMode = "auto";
    private string whiteMoveArrowColor = "#cfece0";
    private string blackMoveArrowMode = "auto";
    private string blackMoveArrowColor = "#383231";
    private string policyLabelMode = "auto";
    private string policyLabelColor = "#FFEB3B";
    private string policyLabelStyle = "circle";
    private string policyIndicator = "arrow";
    private string policyArrowMode = "auto";
    private string policyArrowColor = "#000000";
    private string policyArrowProminence = "faint";
    private string policyLabelBgMode = "auto";
    private string policyLabelBgColor = "#3C3C3C";
    private string policyLabelSize = "medium";
    private IReadOnlyList<string> pieceSets = new[] { "wikipedia" };

    private BoardTheme Preview =>
        BoardThemeService.Preview(themePreset, customLight, customDark, customHighlight, pieceSet,
            moveHighlightMode == "custom" ? moveHighlightColor : "");

    // Preview overrides: fixed color, or empty string = force default (so previewing "Auto"
    // works even before the change is persisted).
    private string EffectiveCoordColor => coordinateColorMode == "custom" ? coordinateColor : "";
    private string EffectiveSelRing => selRingMode == "custom" ? selRingColor : "";
    private string EffectiveArrowColor => arrowMode == "custom" ? arrowColor : "#9D8989";
    private string EffectivePolicyLabelColor => policyLabelMode == "custom" ? policyLabelColor : "#FFEB3B";
    private string EffectivePolicyArrowColor => policyArrowMode == "custom" ? policyArrowColor : "black";
    private string EffectiveWhiteMoveArrow => whiteMoveArrowMode == "custom" ? whiteMoveArrowColor : "#cfece0";
    private string EffectiveBlackMoveArrow => blackMoveArrowMode == "custom" ? blackMoveArrowColor : "#383231";
    private double EffectivePolicyArrowOpacity => BoardThemeService.PolicyIndicatorOpacity(policyArrowProminence);
    private string EffectivePolicyLabelBg => BoardThemeService.PolicyLabelBg(policyLabelBgMode == "custom" ? policyLabelBgColor : "");
    private double EffectivePolicyFontPx => BoardThemeService.PolicyLabelFontPx(policyLabelSize);
    private double EffectivePolicyChipPct => BoardThemeService.PolicyLabelChipPct(policyLabelSize);

    // Sample overlays, mirroring the real boards so custom colors are previewed against
    // their true context. Both are legal moves for Black here (Nf6, a6), and the labels
    // cover a dark (f6) and a light (a6) square — legibility depends on the square shade.
    // g8->f6 is a tournament-style PV arrow (themed color/width, always an arrow);
    // a7->a6 is a policy move drawn per the indicator setting (faint black arrow /
    // origin dot / none), with the analysis circle backing per the label style.
    private IReadOnlyList<EbArrow> PreviewArrows
    {
        get
        {
            var arrows = new List<EbArrow>
            {
                new EbArrow("g8", "f6", EffectiveArrowColor),
                // Dual best-move arrows (streaming board when both engines' moves are shown)
                new EbArrow("b1", "c3", EffectiveWhiteMoveArrow),
                new EbArrow("f8", "e7", EffectiveBlackMoveArrow),
            };
            if (policyIndicator == "line")
                arrows.Add(new EbArrow("a7", "a6", EffectivePolicyArrowColor, EffectivePolicyArrowOpacity, 0.3, "line"));
            return arrows;
        }
    }
    // f6 shows a deliberately long value (100.2K) to prove the pill encloses it.
    // No ponder-badge sample here: its fixed 19px font is sized for the large streaming
    // board and overflows on preview-sized squares.
    private IReadOnlyList<EbSquareLabel> PreviewLabels =>
        policyLabelStyle == "plain"
            ? new[]
            {
                new EbSquareLabel("f6", "100.2K", EffectivePolicyLabelColor, "transparent", EffectivePolicyChipPct, EffectivePolicyFontPx),
                new EbSquareLabel("a6", "12%", EffectivePolicyLabelColor, "transparent", EffectivePolicyChipPct, EffectivePolicyFontPx),
            }
            : new[]
            {
                new EbSquareLabel("f6", "100.2K", EffectivePolicyLabelColor, EffectivePolicyLabelBg, EffectivePolicyChipPct, EffectivePolicyFontPx, null, 0.9, true),
                new EbSquareLabel("a6", "12%", EffectivePolicyLabelColor, EffectivePolicyLabelBg, EffectivePolicyChipPct, EffectivePolicyFontPx, null, 0.9, true),
            };

    protected override void OnInitialized()
    {
        pieceSets = BoardThemeSvc.GetAvailablePieceSets();
        var s = SettingsService.Settings;
        themePreset = string.IsNullOrEmpty(s.BoardThemePreset) ? "eb-blue" : s.BoardThemePreset;
        customLight = s.BoardCustomLightColor ?? "#B1D8DB";
        customDark = s.BoardCustomDarkColor ?? "#619EB3";
        customHighlight = s.BoardCustomHighlightColor ?? "#FAFAD2";
        pieceSet = string.IsNullOrEmpty(s.BoardPieceSet) ? "wikipedia" : s.BoardPieceSet;
        animateMoves = s.BoardAnimateMoves;
        tournamentCoordinates = s.ShowTournamentBoardCoordinates;
        coordinateSize = string.IsNullOrEmpty(s.BoardCoordinateSize) ? "medium" : s.BoardCoordinateSize;
        coordinateColorMode = string.IsNullOrEmpty(s.BoardCoordinateColor) ? "auto" : "custom";
        if (coordinateColorMode == "custom") coordinateColor = s.BoardCoordinateColor;
        highlightStyle = s.BoardHighlightStyle is "tint" or "frame" ? s.BoardHighlightStyle : "replace";
        moveHighlightMode = string.IsNullOrEmpty(s.BoardMoveHighlightColor) ? "auto" : "custom";
        if (moveHighlightMode == "custom") moveHighlightColor = s.BoardMoveHighlightColor;
        showEvalBar = s.ShowEvalBar;
        selRingMode = string.IsNullOrEmpty(s.BoardSelectionRingColor) ? "auto" : "custom";
        if (selRingMode == "custom") selRingColor = s.BoardSelectionRingColor;
        arrowMode = string.IsNullOrEmpty(s.BoardArrowColor) ? "auto" : "custom";
        if (arrowMode == "custom") arrowColor = s.BoardArrowColor;
        arrowWidth = string.IsNullOrEmpty(s.BoardArrowWidth) ? "normal" : s.BoardArrowWidth;
        whiteMoveArrowMode = string.IsNullOrEmpty(s.BoardWhiteMoveArrowColor) ? "auto" : "custom";
        if (whiteMoveArrowMode == "custom") whiteMoveArrowColor = s.BoardWhiteMoveArrowColor;
        blackMoveArrowMode = string.IsNullOrEmpty(s.BoardBlackMoveArrowColor) ? "auto" : "custom";
        if (blackMoveArrowMode == "custom") blackMoveArrowColor = s.BoardBlackMoveArrowColor;
        policyLabelMode = string.IsNullOrEmpty(s.BoardPolicyLabelColor) ? "auto" : "custom";
        if (policyLabelMode == "custom") policyLabelColor = s.BoardPolicyLabelColor;
        policyLabelStyle = s.BoardPolicyLabelStyle == "plain" ? "plain" : "circle";
        policyIndicator = s.BoardPolicyIndicator == "none" ? "none" : "line";
        policyArrowMode = string.IsNullOrEmpty(s.BoardPolicyIndicatorColor) ? "auto" : "custom";
        if (policyArrowMode == "custom") policyArrowColor = s.BoardPolicyIndicatorColor;
        policyArrowProminence = s.BoardPolicyIndicatorProminence is "medium" or "strong" ? s.BoardPolicyIndicatorProminence : "faint";
        policyLabelBgMode = string.IsNullOrEmpty(s.BoardPolicyLabelBgColor) ? "auto" : "custom";
        if (policyLabelBgMode == "custom") policyLabelBgColor = s.BoardPolicyLabelBgColor;
        policyLabelSize = s.BoardPolicyLabelSize is "small" or "large" ? s.BoardPolicyLabelSize : "medium";
    }

    // Collapsible sections: Theme and Pieces start open, the rest collapsed.
    private readonly HashSet<string> openSections = new() { "theme", "pieces" };
    private string SectionClass(string key) => openSections.Contains(key) ? "" : "collapsed";
    private string Indicator(string key) => openSections.Contains(key) ? "▾" : "▸";
    private void Toggle(string key)
    {
        if (!openSections.Remove(key)) openSections.Add(key);
    }

    private void SelectPreset(string key) { themePreset = key; Apply(); }
    private void SelectPieceSet(string set) { pieceSet = set; Apply(); }

    // Instant apply: persist only this page's fields on top of the CURRENT settings, so a
    // concurrently edited Settings page is never clobbered (merge, not snapshot).
    private void Apply()
    {
        var current = SettingsService.Settings;
        var merged = JsonSerializer.Deserialize<GlobalSettings>(JsonSerializer.Serialize(current)) ?? new GlobalSettings();
        merged.BoardThemePreset = themePreset;
        merged.BoardCustomLightColor = customLight;
        merged.BoardCustomDarkColor = customDark;
        merged.BoardCustomHighlightColor = customHighlight;
        merged.BoardPieceSet = pieceSet;
        merged.BoardAnimateMoves = animateMoves;
        merged.ShowTournamentBoardCoordinates = tournamentCoordinates;
        merged.BoardCoordinateSize = coordinateSize;
        merged.BoardCoordinateColor = coordinateColorMode == "custom" ? coordinateColor : "";
        merged.BoardHighlightStyle = highlightStyle;
        merged.BoardMoveHighlightColor = moveHighlightMode == "custom" ? moveHighlightColor : "";
        merged.ShowEvalBar = showEvalBar;
        merged.BoardSelectionRingColor = selRingMode == "custom" ? selRingColor : "";
        merged.BoardArrowColor = arrowMode == "custom" ? arrowColor : "";
        merged.BoardArrowWidth = arrowWidth;
        merged.BoardWhiteMoveArrowColor = whiteMoveArrowMode == "custom" ? whiteMoveArrowColor : "";
        merged.BoardBlackMoveArrowColor = blackMoveArrowMode == "custom" ? blackMoveArrowColor : "";
        merged.BoardPolicyLabelColor = policyLabelMode == "custom" ? policyLabelColor : "";
        merged.BoardPolicyLabelStyle = policyLabelStyle;
        merged.BoardPolicyIndicator = policyIndicator;
        merged.BoardPolicyIndicatorColor = policyArrowMode == "custom" ? policyArrowColor : "";
        merged.BoardPolicyIndicatorProminence = policyArrowProminence;
        merged.BoardPolicyLabelBgColor = policyLabelBgMode == "custom" ? policyLabelBgColor : "";
        merged.BoardPolicyLabelSize = policyLabelSize;
        SettingsService.Save(merged);
    }

    private void ResetAppearance()
    {
        var d = new GlobalSettings();
        themePreset = d.BoardThemePreset;
        customLight = d.BoardCustomLightColor;
        customDark = d.BoardCustomDarkColor;
        customHighlight = d.BoardCustomHighlightColor;
        pieceSet = d.BoardPieceSet;
        animateMoves = d.BoardAnimateMoves;
        tournamentCoordinates = d.ShowTournamentBoardCoordinates;
        coordinateSize = d.BoardCoordinateSize;
        coordinateColorMode = "auto";
        highlightStyle = d.BoardHighlightStyle;
        moveHighlightMode = "auto";
        showEvalBar = d.ShowEvalBar;
        selRingMode = "auto";
        arrowMode = "auto";
        arrowWidth = d.BoardArrowWidth;
        whiteMoveArrowMode = "auto";
        blackMoveArrowMode = "auto";
        policyLabelMode = "auto";
        policyLabelStyle = d.BoardPolicyLabelStyle;
        policyIndicator = d.BoardPolicyIndicator;
        policyArrowMode = "auto";
        policyArrowProminence = d.BoardPolicyIndicatorProminence;
        policyLabelBgMode = "auto";
        policyLabelSize = d.BoardPolicyLabelSize;
        Apply();
    }
}

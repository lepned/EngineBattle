@using WebGUI.Components.Layout.ChessboardLayout

<h4 class="mud-centerTxt mb-3">@moveTitle</h4>
<MudGrid>
  <MudItem md="4" lg="5">
    <div>@board1Header</div>
    <EbChessboard Fen="@fenPrev" SizePx="null" ShowCoordinates="false"
                  LastMoveFrom="@move1From" LastMoveTo="@move1To" LastMoveColor="@moveColor" />
    <div>@board1Subtitle</div>
  </MudItem>
  <MudItem md="4" lg="5">
    <div>@board2Header</div>
    <EbChessboard Fen="@fenDev" SizePx="null" ShowCoordinates="false"
                  LastMoveFrom="@move2From" LastMoveTo="@move2To" LastMoveColor="@moveColor" />
    <div>@board2Subtitle</div>
  </MudItem>
</MudGrid>


@code {

  [Parameter] public TypesDef.CoreTypes.MoveDeviation MoveDeviationInput { get; set; }
  [Parameter] public bool OwnDeviations { get; set; }

  private string moveTitle;
  private string board1Header;
  private string board1Subtitle;
  private string board2Header;
  private string board2Subtitle;
  private string fenPrev;
  private string fenDev;
  private string moveColor;
  private string move1From;
  private string move1To;
  private string move2From;
  private string move2To;

  protected override void OnParametersSet()
  {
    if (MoveDeviationInput is null) return;

    fenPrev = MoveDeviationInput.PrevFen;
    fenDev = MoveDeviationInput.DevFen;
    moveColor = MoveDeviationInput.Color;
    move1From = MoveDeviationInput.PrevSanMove.Item2.Substring(0, 2);
    move1To = MoveDeviationInput.PrevSanMove.Item2.Substring(2, 2);
    move2From = MoveDeviationInput.DevSanMove.Item2.Substring(0, 2);
    move2To = MoveDeviationInput.DevSanMove.Item2.Substring(2, 2);

    var (prevPGN, devPGN) = MoveDeviationInput.PgnGamePair;
    moveTitle =
      OwnDeviations ? $"Move deviation by {MoveDeviationInput.PlayerToDeviate} compared to own game" :
      $"Move deviation by {MoveDeviationInput.PlayerToDeviate} compared to {MoveDeviationInput.Opponent}";
    board1Header = $"Game#: {prevPGN.GameNumber} Black: {prevPGN.GameMetaData.Black}";
    board1Subtitle = $"White: {prevPGN.GameMetaData.White} :  {prevPGN.GameMetaData.Result}";
    board2Header = $"Game#: {devPGN.GameNumber} Black: {devPGN.GameMetaData.Black}";
    board2Subtitle = $"White: {devPGN.GameMetaData.White} :  {devPGN.GameMetaData.Result}";
  }
}

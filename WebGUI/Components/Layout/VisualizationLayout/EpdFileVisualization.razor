@using WebGUI
@using WebGUI.Services

@using System.Text

@inject ILogger<EpdFileVisualization> Logger
@inject IDialogService DialogService
@inject GlobalSettingsService SettingsService

<MudFab Class="ml-3 mb-3 mt-6" Color="Color.Default" Label="Load EPD-file" Size="Size.Large" StartIcon="@Icons.Material.Filled.DownloadForOffline" OnClick="BrowseEpdFile" />
<MudPaper >
  <MudGrid>
    @foreach (var epd in EPDs)
    {    
      <MudItem sm=2 md="2" lg="2" Class="pa-2">
        <EPDVisualization  EPD="@epd" />
      </MudItem>
    }

  </MudGrid>
</MudPaper>

@code {

  private List<EPDTypes.EPDEntry> EPDs = new();

  string GetHeader(EPDTypes.EPDEntry EPD)
  {
    StringBuilder msgBuilder = new StringBuilder();

    if (EPD.BestMove != null)
    {
      msgBuilder.Append("BestMove: ").Append(EPD.BestMove.Value.Trim());
    }
    else if (EPD.AvoidMove != null)
    {
      msgBuilder.Append("AvoidMove: ").Append(EPD.AvoidMove.Value.Trim());
    }
    else if (EPD.Other != null)
    {
      if (!string.IsNullOrEmpty(EPD.Id?.Value))
      {
        msgBuilder.Append(EPD.Id.Value).Append(": ");
      }
      if (!string.IsNullOrEmpty(EPD.Other?.Value))
      {
        msgBuilder.Append(EPD.Other.Value);
      }
    }

    return msgBuilder.ToString();
  }

  private async Task BrowseEpdFile()
  {
    var initialDir = SettingsService.Settings.OpeningsFolder;
    var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
    {
      { x => x.InitialPath, initialDir },
      { x => x.FileFilter, "*.epd" },
      { x => x.Mode, WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog.FileBrowserMode.File }
    };
    var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
    var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select File", parameters, options);
    var result = await dialog.Result;
    if (result == null || result.Canceled) return;
    var filePath = (string)result.Data!;

    Logger.LogInformation("EPD file opened {File}", Path.GetFileName(filePath));
    EPDs = EPDExtractor.readEPDs(filePath).Take(100).ToList();
  }
}


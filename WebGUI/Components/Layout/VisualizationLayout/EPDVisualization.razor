@using System.Text
@using WebGUI.Components.Layout.ChessboardLayout

<MudText Typo="Typo.h6"> @header </MudText>
<MudText Typo="Typo.subtitle1"> @subHeader</MudText>
@if (EPD is not null)
{
	<EbChessboard Fen="@EPD.FEN" SizePx="null" ShowCoordinates="false" Arrows="@arrows" />
	<MudTextField T="string" Lines="2" Underline="false" Text="@EPD.FEN" Style="font-size:11px;" />
}


@code {

	[Parameter] public EPDTypes.EPDEntry EPD { get; set; }

	private string subHeader = string.Empty;
	private string header = string.Empty;
	private IReadOnlyList<EbArrow> arrows = Array.Empty<EbArrow>();

	string GetHeader(EPDTypes.EPDEntry epd)
	{
		StringBuilder msgBuilder = new StringBuilder();

		if (epd.BestMove != null)
		{
			msgBuilder.Append("BestMove: ").Append(epd.BestMove.Value.Trim());
		}
		else if (epd.AvoidMove != null)
		{
			msgBuilder.Append("AvoidMove: ").Append(epd.AvoidMove.Value.Trim());
		}

		return msgBuilder.ToString();
	}

	string GetSubHeader(EPDTypes.EPDEntry epd)
	{
		return epd.Id != null ? epd.Id.Value : string.Empty;
	}

	protected override void OnParametersSet()
	{
		if (EPD is null) return;

		var arrowList = new List<EbArrow>();
		bool evalHeaderInUse = !string.IsNullOrEmpty(EPD.Other?.Value) && EPD.Other.Value.Contains("eval");

		if (!string.IsNullOrEmpty(EPD.Other?.Value) && !evalHeaderInUse)
		{
			var correctAndWrongMove = EPD.Other.Value.Split(",");
			var correct = correctAndWrongMove[0].Trim();
			if (correct.Length >= 4)
				arrowList.Add(new EbArrow(correct.Substring(0, 2), correct.Substring(2, 2), "green"));
			if (correctAndWrongMove.Length > 1)
			{
				var wrong = correctAndWrongMove[1].Trim();
				if (wrong.Length >= 4)
					arrowList.Add(new EbArrow(wrong.Substring(0, 2), wrong.Substring(2, 2), "crimson"));
			}
		}
		arrows = arrowList;

		header = evalHeaderInUse ? "" : GetHeader(EPD);
		subHeader = evalHeaderInUse ? EPD.Other.Value : GetSubHeader(EPD);
		if (string.IsNullOrEmpty(header) && string.IsNullOrEmpty(subHeader))
			header = "Header not found";
	}
}

@using WebGUI.Components.Layout.ChessboardLayout

<h3 class="mud-centerTxt mt-5">@boardHeader</h3>
<div class="@Style">
	<EbChessboard Fen="@FEN" SizePx="null" ShowCoordinates="false" Arrows="@arrows" />
</div>


@code {

	[Parameter] public string FEN { get; set; }
	[Parameter] public int BoardNr { get; set; }
	[Parameter] public string Move { get; set; }
	[Parameter] public string MovePlayed { get; set; }
	[Parameter] public string Style { get; set; }
	[Parameter] public bool Solved { get; set; }
	[Parameter] public string BoardId { get; set; }

	private string boardHeader => $"Board {BoardNr}";
	private IReadOnlyList<EbArrow> arrows = Array.Empty<EbArrow>();

	protected override void OnParametersSet()
	{
		var arrowList = new List<EbArrow>();
		if (!string.IsNullOrEmpty(Move) && Move.Length >= 4)
		{
			arrowList.Add(new EbArrow(Move.Substring(0, 2), Move.Substring(2, 2), "green"));

			var wrongMovePlayed = !Solved && !string.IsNullOrEmpty(MovePlayed) && MovePlayed.Length >= 4;
			if (wrongMovePlayed)
				arrowList.Add(new EbArrow(MovePlayed.Substring(0, 2), MovePlayed.Substring(2, 2), "crimson"));
		}
		arrows = arrowList;
	}
}

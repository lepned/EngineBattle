@* The whole play-vs-engine game - clocks, take back, results, PGN - as a component, so a
   page can put it next to its own controls. Play vs Computer hosts it as is; Lc0 Contempt
   feeds it the engine and the setoption lines contempt needs. *@
@using System.Globalization
@using System.Threading
@using WebGUI.Components.Layout.ChessboardLayout
@using WebGUI.Services
@using System.Timers
@using Microsoft.FSharp.Core
@using static ChessLibrary.EngineTypes
@inject ILogger<PlayVsEngineGame> logger
@inject NotifierService Notifier
@inject IDialogService DialogService
@inject GlobalSettingsService SettingsService
@inject NavigationManager navManager
@inject AnalysisNavigationService AnalysisNav
@implements IAsyncDisposable

<div class="play-vs-computer">
    <div class="pvc-shell">
        <div class="pvc-topbar">
            @* side and time control are locked during a game *@
            <fieldset class="pvc-controls" disabled="@gameActive" style="border:0;margin:0;padding:0;min-width:0;">
                <div class="pvc-field">
                    <label for="timeControlSelect">Time Control</label>
                    <select id="timeControlSelect" @bind="selectedTimeControlId">
                        @foreach (var tc in timeControls)
                        {
                            <option value="@tc.Id">@tc.Label</option>
                        }
                        <option value="custom">Custom</option>
                    </select>
                </div>
                    @if (IsCustomTimeControl)
                    {
                        <div class="pvc-field">
                            <label for="customMode">Limit By</label>
                            <select id="customMode" @bind="customLimitMode">
                                <option value="Time">Time</option>
                                <option value="Nodes">Nodes</option>
                                <option value="Infinite">Infinite</option>
                            </select>
                        </div>

                        @if (customLimitMode == "Time")
                        {
                            <div class="pvc-field pvc-toggle">
                                <label for="sameForBoth">Same for both</label>
                                <input id="sameForBoth" type="checkbox" @bind="customSameForBoth" />
                            </div>

                            @if (customSameForBoth)
                            {
                                <div class="pvc-field">
                                    <label for="customMinutes">Minutes</label>
                                    <input id="customMinutes" type="number" min="0" max="180" @bind="customMinutes" />
                                </div>
                                <div class="pvc-field">
                                    <label for="customIncrement">Increment (s)</label>
                                    <input id="customIncrement" type="number" min="0" max="120" @bind="customIncrementSeconds" />
                                </div>
                            }
                            else
                            {
                                <div class="pvc-field">
                                    <label for="whiteMinutes">White minutes</label>
                                    <input id="whiteMinutes" type="number" min="0" max="180" @bind="customWhiteMinutes" />
                                </div>
                                <div class="pvc-field">
                                    <label for="whiteIncrement">White increment</label>
                                    <input id="whiteIncrement" type="number" min="0" max="120" @bind="customWhiteIncrementSeconds" />
                                </div>
                                <div class="pvc-field">
                                    <label for="blackMinutes">Black minutes</label>
                                    <input id="blackMinutes" type="number" min="0" max="180" @bind="customBlackMinutes" />
                                </div>
                                <div class="pvc-field">
                                    <label for="blackIncrement">Black increment</label>
                                    <input id="blackIncrement" type="number" min="0" max="120" @bind="customBlackIncrementSeconds" />
                                </div>
                            }
                        }
                        else if (customLimitMode == "Nodes")
                        {
                            <div class="pvc-field">
                                <label for="customNodes">Node Limit</label>
                                <input id="customNodes" type="number" min="1" max="10000000" @bind="customNodeLimit" />
                            </div>
                        }
                    }
                <div class="pvc-field">
                    <label for="playAsSelect">Play As</label>
                    <select id="playAsSelect" @bind="selectedSide">
                        <option value="White">White</option>
                        <option value="Black">Black</option>
                    </select>
                </div>
            </fieldset>
            <div class="pvc-actions">
                @if (ShowEngineLoader)
                {
                    <button class="pvc-upload @(engineReady ? string.Empty : "warn")" @onclick="BrowseEngineJsonFile">Load Engine</button>
                }
                <button class="pvc-btn" @onclick="StartGame" disabled="@(!engineReady || engineInitializing)">Start Game</button>
                <button class="pvc-btn secondary" @onclick="RestartGame" disabled="@(!engineReady || engineInitializing)">Restart</button>
                <button class="pvc-btn secondary" @onclick="ForceComputerMove" disabled="@(!CanForceMove)">Force Move</button>
                <button class="pvc-btn secondary" @onclick="OfferTakeback" disabled="@(!CanTakeback)">Take Back</button>
                <button class="pvc-btn secondary" @onclick="Abort" disabled="@(!gameActive)">Abort</button>
                <button class="pvc-btn danger" @onclick="ResignGame" disabled="@(!gameActive)">Resign</button>
            </div>
        </div>

        <div class="pvc-main">
            <div class="pvc-board-card">
                <div class="pvc-players-bar">
                    @PlayerIcon(false)
                    <span>@(Engine?.Name ?? "Computer")</span>
                    @if (clockEnabled)
                    {
                        <span class="pvc-inline-clock">@FormatTime(humanIsWhite ? blackTime : whiteTime)</span>
                    }
                    @if (gameActive && IsEngineThinking())
                    {
                        <span class="pvc-thinking">thinking...</span>
                    }
                    <span class="pvc-spacer"></span>
                    @if (clockEnabled)
                    {
                        <span class="pvc-inline-clock">@FormatTime(humanIsWhite ? whiteTime : blackTime)</span>
                    }
                    <span>You</span>
                    @PlayerIcon(true)
                </div>
                <div class="pvc-status">
                    <span>@gameStatus</span>
                    @if (premoveQueued != null)
                    {
                        <span class="pvc-premove" title="Played the moment your turn comes, if it is still legal. Click the board to cancel."> · premove @premoveQueued queued</span>
                    }
                </div>
                @* navigation during a game would look like a move; moves only on the player's turn *@
                <ModernChessboard @ref="chessboardRef" ShowFenField="false" FENposition="@fen" ShowChessNavButtons="@(!gameActive)" ShowMoveList="true"
                            MakeMoveListClickable="true" MoveListPosition="MoveListPosition.Right"
                            AllowMoves="@HumanMayMove" AllowNavigation="@(!gameActive)"
                            ShowSizeSlider="true" SizeKey="play-vs-computer"
                            OnMoveMadeOnBoard="OnHumanMove" OnNewFENOnBoard="OnBoardFenChanged" OnBoardFlipped="OnBoardFlipped"
                            ShowPositionStatus="false"
                            ShowLegalDestinations="@SettingsService.Settings.BoardShowLegalMoves"
                            AllowPremove="@(gameActive && SettingsService.Settings.BoardPremoves)"
                            PremoveSide="@(humanIsWhite ? "w" : "b")"
                            OnPremoveSet="OnPremoveSet" OnPremoveCleared="OnPremoveCleared"
                            ChessBoard="@board" />
            </div>

            <div class="pvc-panel">
                <h3>Results</h3>
                @if (gameResults.Count == 0)
                {
                    <p class="pvc-muted">No games recorded yet.</p>
                }
                else
                {
                    <table class="pvc-results">
                        <thead>
                            <tr>
                                <th>Date</th>
                                <th>Result</th>
                                <th>Reason</th>
                                <th>Moves</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var row in gameResults)
                            {
                                <tr>
                                    <td>@(row.When == DateTime.MinValue ? "--" : row.When.ToString("MM/dd HH:mm"))</td>
                                    <td>@row.Result</td>
                                    <td>@row.Reason</td>
                                    <td>@row.Moves</td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                <h3 style="margin-top:16px;">Save PGN</h3>
                <div class="pvc-save">
                    <input type="text" placeholder="C:/dev/chess/mygames.pgn" @bind="gamesPath" />
                    <button class="pvc-btn secondary" @onclick="SaveGameToPgn">Save PGN</button>
                    <button class="pvc-btn secondary" @onclick="ReviewGame" disabled="@(board.SanMovesPlayed.Count == 0)">Review Game</button>
                </div>
            </div>
        </div>
    </div>
</div>

@code {

    [Parameter] public EngineConfig Engine { get; set; }
    /// The Load Engine button. A host that picks the engine itself hides it.
    [Parameter] public bool ShowEngineLoader { get; set; } = true;
    /// setoption lines sent right after the engine starts and again whenever a new list is
    /// passed - contempt, for one. Lc0 takes them between searches, so a change during a
    /// game reaches the next move.
    [Parameter] public IReadOnlyList<EngineOption> EngineOptions { get; set; }
    /// The PGN Event tag of saved and reviewed games.
    [Parameter] public string PgnEvent { get; set; } = "Play vs computer";
    /// The position after every move, human or engine, and at the start of a game.
    [Parameter] public EventCallback<string> OnPositionChanged { get; set; }
    /// The engine's UCI option names once it has answered `uci` - what a host needs to know
    /// whether the engine understands the options it is about to send.
    [Parameter] public EventCallback<IReadOnlyCollection<string>> OnEngineReady { get; set; }
    /// The base minutes of the time control in use whenever it is applied (a new game), null
    /// when there is no clock (nodes, infinite). Lc0's calibration Elo depends on it.
    [Parameter] public EventCallback<double?> OnTimeControlApplied { get; set; }

    private IReadOnlyList<EngineOption> appliedEngineOptions;
    // the engine being started or running (a host change while it loads replaces it too)
    private string engineNameStarted;
    // counts engine starts and replacements: a start finishing under an older count is dropped
    private int engineGeneration;
    private EngineConfig engineParamSeen;
    private record TimeControlOption(string Id, string Label, int Minutes, int IncrementSeconds);

    private readonly List<TimeControlOption> timeControls = new()
    {
        new TimeControlOption("1+0", "1+0", 1, 0),
        new TimeControlOption("1+1", "1+1", 1, 1),
        new TimeControlOption("2+1", "2+1", 2, 1),
        new TimeControlOption("3+2", "3+2", 3, 2),
        new TimeControlOption("5+0", "5+0", 5, 0),
        new TimeControlOption("5+3", "5+3", 5, 3),
        new TimeControlOption("10+0", "10+0", 10, 0),
        new TimeControlOption("10+5", "10+5", 10, 5),
        new TimeControlOption("15+10", "15+10", 15, 10),
        new TimeControlOption("30+0", "30+0", 30, 0),
    };

    private string selectedTimeControlId = "3+2";
    private int customMinutes = 3;
    private int customIncrementSeconds = 2;
    private int customWhiteMinutes = 3;
    private int customWhiteIncrementSeconds = 2;
    private int customBlackMinutes = 3;
    private int customBlackIncrementSeconds = 2;
    private int customNodeLimit = 1;
    private string customLimitMode = "Time";
    private bool customSameForBoth = true;
    private int incrementSeconds = 2;
    private int baseMinutes = 3;
    private int whiteBaseMinutes = 3;
    private int blackBaseMinutes = 3;
    private int whiteIncrementSeconds = 2;
    private int blackIncrementSeconds = 2;
    private System.Timers.Timer clockTimer;
    private bool boardFlipped;
    private string gameStatus = "";
    private Chess.Board board = new();
    private string fen = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
    private int numberOfNodes = 1;
    private string gamesPath = Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.MyDocuments), "chess", "mygames.pgn");
    private readonly CancellationTokenSource disposeCts = new();
    private ModernChessboard chessboardRef;
    private readonly List<GameResult> gameResults = new();
    private bool resultRecorded;
    private record GameResult(DateTime When, string Result, string Reason, string Moves, string FinalFen);
    private string lastResultTag = "*";
    private string lastResultReason = string.Empty;
    // an engine config is there to play
    private bool engineReady => Engine != null;
    private bool clockEnabled = true;

    // ── The game (ChessLibrary/Analysis/PlayModel.fs): turns, clocks, the engine's search, the result ──
    private PlayModel.State model = PlayModel.initial;
    // the model's clock: real elapsed time
    private readonly System.Diagnostics.Stopwatch stopwatch = System.Diagnostics.Stopwatch.StartNew();
    private TimeSpan Now => stopwatch.Elapsed;

    private bool gameActive => model.Phase.IsPlaying;
    private bool engineInitializing => model.Engine.IsStarting;
    private bool humanIsWhite => model.HumanWhite;
    private bool HumanToMove => humanIsWhite == (board.Position.STM == 0);
    private bool HumanMayMove => gameActive && model.Engine.IsReady && !model.Pending && HumanToMove;
    private TimeSpan whiteTime => PlayModel.remaining(model, true, Now);
    private TimeSpan blackTime => PlayModel.remaining(model, false, Now);

    private bool IsCustomTimeControl => selectedTimeControlId == "custom";
    private bool CanForceMove => gameActive && !HumanToMove && model.Current != null;
    private bool CanTakeback => gameActive && !model.Pending && model.Ply > 0 && !playingEngineMove;
    private bool playingEngineMove;
    private string selectedSide
    {
        get => humanIsWhite ? "White" : "Black";
        set => _ = SetHumanSide(value == "White");
    }
    private string WhitePlayerLabel => humanIsWhite ? "You" : Engine?.Name ?? "Computer";
    private string BlackPlayerLabel => humanIsWhite ? Engine?.Name ?? "Computer" : "You";
    private RenderFragment PlayerIcon(bool isHuman) => isHuman
        ? @<MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" />
        : !string.IsNullOrEmpty(Engine?.LogoPath)
            ? @<img class="pvc-engine-logo" src="@Engine.LogoPath" alt="@(Engine.Name)" />
            : @<MudIcon Icon="@Icons.Material.Filled.SmartToy" Size="Size.Small" />;

    private bool IsEngineThinking() => model.Current != null;

    private ChessLibrary.AnalysisEngine analyzer;

    protected override void OnInitialized()
    {
        var s = SettingsService.Settings;
        if (!string.IsNullOrEmpty(s.AnalysisGamesPath))
            gamesPath = s.AnalysisGamesPath;
        if (Engine == null && !string.IsNullOrEmpty(s.DefaultEnginePath))
        {
            try
            {
                Engine = Configuration.JSON.readSingleEngineConfig(s.DefaultEnginePath);
            }
            catch { }
        }
        ApplyTimeControl();
        LoadSavedGamesFromPgn();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
            await OnTimeControlApplied.InvokeAsync(clockEnabled ? whiteBaseMinutes : null);
    }

    protected override async Task OnParametersSetAsync()
    {
        // Only a host-supplied change counts; the component's own Load Engine sets Engine too,
        // and a failed load must keep the button off until the next real change.
        if (ReferenceEquals(Engine, engineParamSeen)) return;
        engineParamSeen = Engine;
        // A different engine from the host: the running one is for the old config, and its game ends.
        if (!model.Engine.IsNotStarted && Engine != null && engineNameStarted != null && Engine.Name != engineNameStarted)
            await ReplaceEngine();
    }

    /// The old engine quits; a game with it is aborted.
    private async Task ReplaceEngine()
    {
        EngineQuit.OffThread(analyzer, logger);
        analyzer = null;
        engineNameStarted = null;
        engineGeneration++;
        await Send(PlayModel.Event.NewEngineGone("the engine was changed", Now));
    }

    private async Task Send(PlayModel.Event e)
    {
        var result = PlayModel.step(model, e);
        model = result.Item1;
        foreach (var effect in result.Item2)
            await Execute(effect);
    }

    private async Task Execute(PlayModel.Effect effect)
    {
        switch (effect)
        {
            case PlayModel.Effect.Search search:
                RunSearch(search.Item);
                break;
            case PlayModel.Effect.PlayEngineMove play:
                await PlayEngineMove(play.uci);
                break;
            case PlayModel.Effect.StepBack back:
                await TakeBack(back.plies);
                break;
            case PlayModel.Effect.ClockRunning running:
                if (running.Item) StartClock(); else StopClock();
                break;
            case PlayModel.Effect.Ended ended:
                EndGame(ended.result, ended.reason, ended.status);
                break;
            case PlayModel.Effect.ShowStatus status:
                gameStatus = status.Item;
                break;
            default:
                // the load runs on; the model hears EngineReady or EngineGone when it is done
                if (effect.IsStartEngine) _ = StartEngineNow();
                else if (effect.IsQuitEngine) { EngineQuit.OffThread(analyzer, logger); analyzer = null; engineGeneration++; }
                else if (effect.IsNewGame) analyzer?.NewGame();
                else if (effect.IsStopEngine) analyzer?.Stop();
                else if (effect.IsPlayPremove) _ = PlayPremoveLater();
                break;
        }
    }

    /// The board as the model sees it: whose turn, how far, and whether the rules ended the game.
    private PlayModel.Facts Facts()
    {
        var ply = board.MovesAndFenPlayed?.Count ?? 0;
        return new PlayModel.Facts(board.Position.STM == 0, ply, BoardEnd());
    }

    private FSharpOption<PlayModel.BoardEnd> BoardEnd()
    {
        bool noLegalMoves = !board.AnyLegalMove();
        var pos = board.Position;
        bool inCheck = ChessLibrary.MoveGeneration.InCheck(in pos) != 0UL;
        if (noLegalMoves) return inCheck ? PlayModel.BoardEnd.Checkmate : PlayModel.BoardEnd.Stalemate;
        if (board.InsufficientMaterial()) return PlayModel.BoardEnd.InsufficientMaterial;
        if (board.ClaimThreeFoldRep()) return PlayModel.BoardEnd.Threefold;
        // the backstop for endings where mate cannot be forced but the position is not dead
        if (board.Position.Count50 >= 100) return PlayModel.BoardEnd.FiftyMoves;
        return FSharpOption<PlayModel.BoardEnd>.None;
    }

    private PlayModel.TimeControl CurrentTimeControl()
    {
        if (clockEnabled)
            return PlayModel.TimeControl.NewClocked(TimeSpan.FromMinutes(whiteBaseMinutes), TimeSpan.FromMinutes(blackBaseMinutes),
                TimeSpan.FromSeconds(whiteIncrementSeconds), TimeSpan.FromSeconds(blackIncrementSeconds));
        return IsCustomTimeControl && customLimitMode == "Nodes"
            ? PlayModel.TimeControl.NewNodesPerMove(numberOfNodes)
            : PlayModel.TimeControl.Unlimited;
    }

    private async Task StartEngineNow()
    {
        var config = Engine;
        if (config == null)
        {
            await Send(PlayModel.Event.NewEngineGone("no engine loaded", Now));
            return;
        }
        engineNameStarted = config.Name;
        var generation = ++engineGeneration;
        bool Stale() => generation != engineGeneration || disposeCts.IsCancellationRequested;
        StateHasChanged();
        ChessLibrary.AnalysisEngine created;
        try
        {
            var onUpdate = FuncConvert.FromAction<SearchUpdate>(u => HandleSearchUpdate(u, generation));
            created = await Task.Run(() => EngineHelper.createAnalysisEngine(onUpdate, config, logger, false));
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Engine initialization failed");
            // replaced meanwhile: this one's failure is not news
            if (!Stale())
                await Send(PlayModel.Event.NewEngineGone(ex.Message, Now));
            return;
        }
        if (Stale())
        {
            EngineQuit.OffThread(created, logger);
            return;
        }
        try
        {
            analyzer = created;
            await OnAnalyzerCreated();
            await Send(PlayModel.Event.NewEngineReady(Now));
            StateHasChanged();
        }
        catch (Exception ex) { logger.LogError(ex, "Starting the game after the engine start failed"); }
    }

    private void RunSearch(PlayModel.Go go)
    {
        if (analyzer == null) return;
        // a new option list (contempt) goes first, with ucinewgame
        if (!ReferenceEquals(EngineOptions, appliedEngineOptions))
            ApplyEngineOptions();
        var command = go switch
        {
            PlayModel.Go.GoNodes n => TimeControlTypes.TimeControlCommands.createNodes(n.Item),
            PlayModel.Go.GoClock c => TimeControlTypes.TimeControlCommands.createTimeControlWithIncrement(c.wtime, c.btime, c.winc, c.binc),
            _ => throw new InvalidOperationException()
        };
        var id = analyzer.AnalyseBoard(board, command);
        model = PlayModel.step(model, PlayModel.Event.NewStarted(id)).Item1;
    }

    // A new list instance is sent right before the engine's next move, followed by ucinewgame:
    // Lc0 keeps its tree between moves and the old nodes keep the old contempt. Only a freshly
    // started engine, with no tree yet, gets the options at once.
    private void ApplyEngineOptions(bool engineJustStarted = false)
    {
        if (analyzer == null) return;
        appliedEngineOptions = EngineOptions;
        if (EngineOptions == null) return;
        // Echoed to the console (the desktop app has one too): the exact lines the engine got.
        var name = Engine?.Name ?? "engine";
        var when = engineJustStarted ? "at start" : "before its next move";
        ChessLibrary.RuntimeUtilities.ConsoleUtils.printInColor(ConsoleColor.Cyan, $"[{name}] setoptions {when}:");
        foreach (var option in EngineOptions)
        {
            ChessLibrary.RuntimeUtilities.ConsoleUtils.printInColor(ConsoleColor.Cyan, $"  setoption name {option.Name} value {option.Value}");
            analyzer.SetOption(option);
        }
        if (!engineJustStarted)
        {
            ChessLibrary.RuntimeUtilities.ConsoleUtils.printInColor(ConsoleColor.Cyan, "  ucinewgame");
            analyzer.NewGame();
        }
    }

    private async Task OnAnalyzerCreated()
    {
        appliedEngineOptions = null;
        ApplyEngineOptions(engineJustStarted: true);
        if (OnEngineReady.HasDelegate)
        {
            IReadOnlyCollection<string> names = analyzer.GetUCICommands().Keys.ToList();
            await OnEngineReady.InvokeAsync(names);
        }
    }

    private void ApplyTimeControl()
    {
        clockEnabled = true;

        if (IsCustomTimeControl)
        {
            if (customLimitMode == "Nodes")
            {
                numberOfNodes = Math.Max(1, customNodeLimit);
                clockEnabled = false;
            }
            else if (customLimitMode == "Infinite")
            {
                clockEnabled = false;
                whiteBaseMinutes = 300;
                blackBaseMinutes = 300;
                whiteIncrementSeconds = 0;
                blackIncrementSeconds = 0;
            }
            else
            {
                if (customSameForBoth)
                {
                    baseMinutes = Math.Max(0, customMinutes);
                    incrementSeconds = Math.Max(0, customIncrementSeconds);
                    whiteBaseMinutes = baseMinutes;
                    blackBaseMinutes = baseMinutes;
                    whiteIncrementSeconds = incrementSeconds;
                    blackIncrementSeconds = incrementSeconds;
                }
                else
                {
                    whiteBaseMinutes = Math.Max(0, customWhiteMinutes);
                    blackBaseMinutes = Math.Max(0, customBlackMinutes);
                    whiteIncrementSeconds = Math.Max(0, customWhiteIncrementSeconds);
                    blackIncrementSeconds = Math.Max(0, customBlackIncrementSeconds);
                }
            }
            return;
        }

        var selected = timeControls.FirstOrDefault(tc => tc.Id == selectedTimeControlId) ?? timeControls[0];
        baseMinutes = selected.Minutes;
        incrementSeconds = selected.IncrementSeconds;
        whiteBaseMinutes = baseMinutes;
        blackBaseMinutes = baseMinutes;
        whiteIncrementSeconds = incrementSeconds;
        blackIncrementSeconds = incrementSeconds;
    }

    private async Task StartGame()
    {
        if (!engineReady || Engine == null)
        {
            gameStatus = "Load engine.json before starting a game.";
            StateHasChanged();
            return;
        }

        ApplyTimeControl();
        // the board reset and Start in one go: a bestmove of the old game can't land in between
        board.ResetBoardState();
        fen = board.FEN();
        resultRecorded = false;
        chessboardRef?.ClearPremove();
        await Send(PlayModel.Event.NewStart(CurrentTimeControl(), humanIsWhite, Facts(), Now));
        if (chessboardRef != null) await chessboardRef.ResetGameState();
        await OnTimeControlApplied.InvokeAsync(clockEnabled ? whiteBaseMinutes : null);
        await OnPositionChanged.InvokeAsync(board.FEN());
        StateHasChanged();
    }

    private Task RestartGame() => StartGame();

    private async Task ResignGame()
    {
        await Send(PlayModel.Event.NewResign(Now));
        StateHasChanged();
    }

    private async Task Abort()
    {
        await Send(PlayModel.Event.NewAbort(Now));
        StateHasChanged();
    }

    private Task ForceComputerMove() => Send(PlayModel.Event.Force);

    private async Task OfferTakeback()
    {
        if (!CanTakeback) return;
        chessboardRef?.ClearPremove();
        await Send(PlayModel.Event.NewTakeback(Now));
        StateHasChanged();
    }

    /// The board steps back without telling this page (a step back is not a move), then the model hears where it landed.
    private async Task TakeBack(int plies)
    {
        if (chessboardRef != null)
            for (var i = 0; i < plies; i++)
                await chessboardRef.StepBack(notifyParent: false);
        fen = board.FEN();
        await Send(PlayModel.Event.NewTookBack(Facts(), Now));
        await OnPositionChanged.InvokeAsync(fen);
    }

    private async Task SetHumanSide(bool playWhite)
    {
        if (humanIsWhite == playWhite) return;
        await Send(PlayModel.Event.NewSideChanged(playWhite));
        await EnsureBoardOrientation();
        await InvokeAsync(StateHasChanged);
    }

    private async Task EnsureBoardOrientation()
    {
        var shouldBeFlipped = !humanIsWhite;
        if (boardFlipped != shouldBeFlipped && chessboardRef is not null)
        {
            await chessboardRef.RotateBoard();
        }
    }

    // Between games the board's flip picks the side; during one it only turns the board.
    private async Task OnBoardFlipped(bool isFlipped)
    {
        boardFlipped = isFlipped;
        await Send(PlayModel.Event.NewSideChanged(!isFlipped));
        await InvokeAsync(StateHasChanged);
    }

    private void EndGame(string result, string reason, string statusMessage)
    {
        chessboardRef?.ClearPremove();
        gameStatus = statusMessage;
        lastResultTag = ComputeResultTag(result);
        lastResultReason = reason;
        RecordResult(result, reason);
    }
    private void RecordResult(string result, string reason)
    {
        if (resultRecorded)
        {
            return;
        }

        resultRecorded = true;
        var moveCount = board.MovesAndFenPlayed?.Count ?? 0;
        var moves = moveCount.ToString(CultureInfo.InvariantCulture);
        gameResults.Insert(0, new GameResult(DateTime.Now, result, reason, moves, board.FEN()));
    }

    private string ComputeResultTag(string result)
    {
        return result switch
        {
            "Draw" => "1/2-1/2",
            "Win" => humanIsWhite ? "1-0" : "0-1",
            "Loss" => humanIsWhite ? "0-1" : "1-0",
            _ => "*"
        };
    }

    private string CurrentTimeControlTag()
    {
        if (IsCustomTimeControl && customLimitMode == "Nodes")
        {
            return $"nodes={numberOfNodes}";
        }
        if (IsCustomTimeControl && customLimitMode == "Infinite")
        {
            return "infinite";
        }
        if (IsCustomTimeControl && customLimitMode == "Time" && !customSameForBoth)
        {
            return $"w={whiteBaseMinutes}+{whiteIncrementSeconds},b={blackBaseMinutes}+{blackIncrementSeconds}";
        }
        return $"{baseMinutes}+{incrementSeconds}";
    }

    private void LoadSavedGamesFromPgn()
    {
        if (string.IsNullOrWhiteSpace(gamesPath))
        {
            return;
        }

        if (!File.Exists(gamesPath))
        {
            return;
        }

        try
        {
            var parsedGames = FullPGNParser.parsePgnFile(gamesPath).ToList();
            var loaded = new List<GameResult>();
            foreach (var game in parsedGames)
            {
                if (game == null)
                {
                    continue;
                }

                var meta = game.GameMetaData;
                var when = ParsePgnDate(meta.Date);
                var moves = meta.Moves > 0 ? meta.Moves : (game.Mainline?.Count ?? 0);
                var reasonTag = GetTerminationTag(meta);
                var reason = reasonTag ?? (meta.Result == "*" ? "" : meta.Reason.ToString());
                var result = MapPgnResult(meta.Result);
                loaded.Add(new GameResult(when, result, reason, moves.ToString(CultureInfo.InvariantCulture), game.Fen));
            }

            if (loaded.Count > 0)
            {
                gameResults.Clear();
                gameResults.AddRange(loaded);
            }
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "Failed to load PGN games from {path}", gamesPath);
        }
    }

    private static DateTime ParsePgnDate(string date)
    {
        if (string.IsNullOrWhiteSpace(date))
        {
            return DateTime.MinValue;
        }

        var formats = new[]
        {
            "yyyy.MM.dd.HH:mm",
            "yyyy.MM.dd.HH:mm:ss",
            "yyyy.MM.dd",
        };

        if (DateTime.TryParseExact(date, formats, CultureInfo.InvariantCulture, DateTimeStyles.None, out var parsed))
        {
            return parsed;
        }

        if (DateTime.TryParse(date, CultureInfo.InvariantCulture, DateTimeStyles.None, out parsed))
        {
            return parsed;
        }

        return DateTime.MinValue;
    }

    private static string MapPgnResult(string result)
    {
        return result switch
        {
            "1-0" => "White",
            "0-1" => "Black",
            "1/2-1/2" => "Draw",
            "*" => "Unfinished",
            _ => string.IsNullOrWhiteSpace(result) ? "Unknown" : result
        };
    }

    private static string GetTerminationTag(ChessLibrary.PGNTypes.GameMetadata meta)
    {
        if (meta == null || meta.OtherTags == null || meta.OtherTags.IsEmpty)
            return null;

        foreach (var tag in meta.OtherTags)
        {
            if (tag.Key != null && tag.Key.Equals("Termination", StringComparison.OrdinalIgnoreCase)
                && !string.IsNullOrWhiteSpace(tag.Value))
                return tag.Value;
        }
        return null;
    }

    // The timer only shows the clocks and asks the model whether a flag fell; the time itself is real elapsed time.
    private void StartClock()
    {
        StopClock();
        clockTimer = new System.Timers.Timer(200);
        clockTimer.Elapsed += OnClockTick;
        clockTimer.Start();
    }

    private void StopClock()
    {
        clockTimer?.Stop();
        clockTimer?.Dispose();
        clockTimer = null;
    }

    private void OnClockTick(object sender, ElapsedEventArgs e)
    {
        if (disposeCts.IsCancellationRequested) return;
        try
        {
            _ = InvokeAsync(async () =>
            {
                try
                {
                    await Send(PlayModel.Event.NewTick(Now));
                    StateHasChanged();
                }
                catch (Exception ex) { logger.LogError(ex, "Clock tick failed"); }
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async Task OnHumanMove(string move)
    {
        // the model takes only the player's own move on its turn (the board also raises this for the engine's move)
        var ply = model.Ply;
        await Send(PlayModel.Event.NewHumanMoved(Facts(), Now));
        if (model.Ply != ply) await OnPositionChanged.InvokeAsync(board.FEN());
        StateHasChanged();
    }

    private string FormatTime(TimeSpan t)
    {
        if (!clockEnabled)
        {
            return customLimitMode == "Nodes" ? $"{numberOfNodes} nodes" : "∞";
        }

        if (t.TotalHours >= 1)
        {
            return $"{(int)t.TotalHours}:{t.Minutes:00}:{t.Seconds:00}";
        }
        return t.ToString(@"mm\:ss");
    }

    /// The engine's bestmove on the board; one that is not legal here is refused and ends the game.
    private async Task PlayEngineMove(string uci)
    {
        var before = board.MovesAndFenPlayed?.Count ?? 0;
        try
        {
            if (!string.IsNullOrEmpty(uci) && uci != "0000") board.PlayUciMove(uci);
        }
        catch (Exception ex)
        {
            logger.LogWarning(ex, "The engine's move {Move} could not be played", uci);
        }
        if ((board.MovesAndFenPlayed?.Count ?? 0) != before + 1)
        {
            await Send(PlayModel.Event.NewEngineMoveRefused(uci, Now));
            return;
        }
        var lastMove = board.MovesAndFenPlayed.LastOrDefault();
        // the move is on the board but not yet in the model: no takeback in between
        playingEngineMove = true;
        try
        {
            if (lastMove != null)
                await Notifier.UpdateFenMoveToBoard(lastMove);
        }
        finally { playingEngineMove = false; }
        fen = board.FEN();
        await Send(PlayModel.Event.NewEngineMoved(Facts(), Now));
        await OnPositionChanged.InvokeAsync(fen);
    }

    // After the current events are done: the premove is an ordinary human move and goes through the model again.
    private async Task PlayPremoveLater()
    {
        await Task.Yield();
        if (chessboardRef?.PendingPremove == null) return;
        try { await chessboardRef.TryPlayQueuedMove(); }
        catch (Exception ex) { logger.LogError(ex, "Playing the queued premove failed"); }
    }
    // The queued premove shows next to the status line, where the player is already looking.
    // Its own field: the status text is rewritten by the clock and the turn changes.
    private string premoveQueued;
    private void OnPremoveSet(string uci) => premoveQueued = gameActive ? uci : null;
    private void OnPremoveCleared() => premoveQueued = null;

    // On the engine's delivery thread: marshalled to the dispatcher, where the model runs. A replaced
    // engine's updates are dropped (search ids restart with each engine).
    private void HandleSearchUpdate(SearchUpdate update, int generation)
    {
        if (disposeCts.IsCancellationRequested) return;
        try
        {
            _ = InvokeAsync(async () =>
            {
                if (disposeCts.IsCancellationRequested || generation != engineGeneration) return;
                try
                {
                    await Send(PlayModel.Event.NewResult(update.SearchId, update.Update, Now));
                    StateHasChanged();
                }
                catch (Exception ex) { logger.LogError(ex, "Error handling engine update on play-vs-computer page"); }
            });
        }
        catch (ObjectDisposedException) { }
    }
    private void OnBoardFenChanged(string newFen)
    {
        logger.LogDebug("Board FEN changed: {Fen}", newFen);
        fen = newFen;
    }

    private async Task BrowseEngineJsonFile()
    {
        var initialDir = SettingsService.Settings.EngineDefsFolder;
        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, initialDir },
            { x => x.FileFilter, "*.json" },
            { x => x.Mode, WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog.FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select File", parameters, options);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;
        var filePath = (string)result.Data!;

        var name = Path.GetFileName(filePath);
        logger.LogInformation("Engine.json file opened {File}", name);

        EngineConfig engineConfig;
        try
        {
            engineConfig = JSON.readSingleEngineConfig(filePath);
        }
        catch (Exception ex)
        {
            // the engine in use stays
            logger.LogError(ex, "Failed to load engine configuration from {file}", name);
            gameStatus = $"Error loading engine: {ex.Message}";
            StateHasChanged();
            return;
        }
        await ReplaceEngine();
        Engine = engineConfig;
        engineParamSeen = engineConfig;
        await Send(PlayModel.Event.LoadEngine);
        StateHasChanged();
    }

    /// The game as PGN: the headers, the start position and the moves.
    private string GamePgn()
    {
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"[Event \"{PgnEvent}\"]");
        sb.AppendLine($"[Date \"{DateTime.Now.ToString("yyyy.MM.dd.HH:mm", CultureInfo.InvariantCulture)}\"]");
        sb.AppendLine($"[White \"{WhitePlayerLabel}\"]");
        sb.AppendLine($"[Black \"{BlackPlayerLabel}\"]");
        sb.AppendLine($"[Result \"{(gameActive ? "*" : lastResultTag)}\"]");
        sb.AppendLine($"[TimeControl \"{CurrentTimeControlTag()}\"]");
        if (!string.IsNullOrWhiteSpace(lastResultReason))
            sb.AppendLine($"[Termination \"{lastResultReason}\"]");
        sb.AppendLine($"[Fen \"{board.StartPosition}\"]");
        sb.AppendLine();
        sb.AppendLine(board.GetMoveHistory());
        return sb.ToString();
    }

    private void ReviewGame()
    {
        var games = ChessLibrary.FullPGNParser.parsePgnString(GamePgn());
        var gameList = games.ToList();
        if (gameList.Count > 0)
        {
            AnalysisNav.ReviewGames = gameList;
            AnalysisNav.ReviewCurrentGame = gameList[0];
            navManager.NavigateTo("/analysis/game-review");
        }
    }

    private async Task SaveGameToPgn(MouseEventArgs args)
    {
        try
        {
            var directory = Path.GetDirectoryName(gamesPath);
            if (!string.IsNullOrEmpty(directory) && !Directory.Exists(directory))
            {
                Directory.CreateDirectory(directory);
            }
            
            File.AppendAllText(gamesPath, Environment.NewLine + GamePgn());
            logger.LogInformation("Game successfully saved to {path}", gamesPath);
            gameStatus = $"Game saved to {Path.GetFileName(gamesPath)}";
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to save game to {path}", gamesPath);
            gameStatus = $"Error saving game: {ex.Message}";
        }
        
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        disposeCts.Cancel();
        StopClock();
        EngineQuit.OffThread(analyzer, logger);
        logger.LogInformation("Disposing engines in {component}", "play-vs-engine game");
        disposeCts.Dispose();
        await Task.CompletedTask;
    }
}

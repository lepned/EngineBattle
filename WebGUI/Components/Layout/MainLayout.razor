@using WebGUI.Services;
@using Toolbelt.Blazor.HotKeys2
@inherits LayoutComponentBase
@implements IAsyncDisposable
@inject NotifierService notify
@inject IJSRuntime JS
@inject GlobalSettingsService SettingsService
@inject JavaScriptInteropService JsInteropService
@inject HotKeys HotKeys

<MudThemeProvider Theme="theme" @bind-IsDarkMode="isDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

@* Interface scale. Nothing is emitted for "normal", so the page is byte-for-byte what it was
   before the setting existed. *@
@if (fontSizeCss is not null)
{
  <style>html { font-size: @fontSizeCss; }</style>
}

<MudLayout>
  @* No app bar: it held the drawer toggle, the name and the logo, and the drawer's own header
     shows the name and the logo already. The toggle became the button below, which costs a
     corner instead of a full-width strip across every page. *@
  @if (!_drawerOpen)
  {
    <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit"
                   Class="eb-drawer-toggle" aria-label="Show navigation"
                   OnClick="@((e) => DrawerToggle())" />
  }
  <MudDrawer @bind-Open="@_drawerOpen">
    <MudDrawerHeader Class="mudblazor-brand d-flex justify-center" LinkToIndex="true">
      <img src="Img/EngineBattle.png" style="width:170px; height:181px; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.3));" />
    </MudDrawerHeader>
    <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Color="Color.Inherit"
                   Class="eb-drawer-close" aria-label="Hide navigation"
                   OnClick="@((e) => DrawerToggle())" />
    <NavMenu />
  </MudDrawer>

  <MudMainContent Class="pl-2">
    @Body
  </MudMainContent>
</MudLayout>

@code {
  bool _drawerOpen = true;
  MudTheme theme = new();
  private bool isDarkMode = true;
  private IJSObjectReference _chessModule;
  private HotKeysContext keyContext;

  // Interface scale from settings; null = leave the stylesheets alone.
  private string fontSizeCss;
  private string drawerWidth;

  /// Re-reads the two interface settings; true when either differs from what is rendered.
  private bool ReadInterfaceSettings()
  {
    var s = SettingsService.Settings;
    var font = UiScale.FontSizeCss(s.UiFontScale);
    var width = UiScale.DrawerWidthCss(s.NavDrawerWidth);
    var changed = font != fontSizeCss || width != drawerWidth;
    fontSizeCss = font;
    if (width != drawerWidth)
    {
      drawerWidth = width;
      // The width belongs in the theme, not on the drawer. MudThemeProvider emits it as
      // --mud-drawer-width-left at :root, which BOTH the drawer and the main-content margin
      // read. MudDrawer.Width only resizes the drawer element and leaves the margin at the
      // old value, so the drawer either overlapped the page or left a gap beside it.
      // A new theme instance, because the provider re-renders on reference change.
      theme = new MudTheme { LayoutProperties = BuildLayout(width) };
    }
    return changed;
  }

  // The room MudMainContent leaves for an app bar is dealt with in site.css, not here:
  // MudBlazor 8.5.1 never emits --mud-appbar-height, so LayoutProperties.AppbarHeight has no
  // effect at all. DrawerWidthLeft, which it does emit, is set below.
  private static LayoutProperties BuildLayout(string drawerWidth) =>
    drawerWidth is null
      ? new LayoutProperties()
      : new LayoutProperties { DrawerWidthLeft = drawerWidth };

  protected override void OnInitialized() => ReadInterfaceSettings();

  // Fires on EVERY settings save, from the saving circuit's thread. Marshal onto this
  // circuit, and only re-lay-out the boards when one of our two values actually changed -
  // a board-theme save must not trigger 25 resize frames.
  private void Settings_OnSettingsChanged()
  {
    _ = InvokeAsync(async () =>
    {
      if (!ReadInterfaceSettings()) return;
      StateHasChanged();
      await ResizeChessboardsAfterDelay();
    });
  }

  void DrawerToggle()
  {
    _drawerOpen = !_drawerOpen;
    _ = ResizeChessboardsAfterDelay();
  }

  async Task Notify_IsFullScreenRequested(bool isFullScreenRequested)
  {
    _drawerOpen = !isFullScreenRequested;
    await ResizeChessboardsAfterDelay();
    StateHasChanged();
  }

  private async Task ResizeChessboardsAfterDelay()
  {
    try
    {
      _chessModule = _chessModule ?? await JsInteropService.ImportModuleAsync(JS);
      for (int i = 0; i < 25; i++)
      {
        await Task.Delay(16);
        await _chessModule.InvokeVoidAsync("triggerResizeEvent");
      }
    }
    catch { }
  }

  protected override async Task OnAfterRenderAsync(bool firstRender)
  {
    if (firstRender)
    {
      notify.IsFullScreenRequested += Notify_IsFullScreenRequested;
      SettingsService.OnSettingsChanged += Settings_OnSettingsChanged;

      // The drawer is reachable without the mouse, and without anything on screen.
      keyContext = HotKeys.CreateContext()
        .Add(ModKey.Ctrl, Key.b, (() => DrawerToggle()), "Show or hide the navigation");

      try
      {
        _chessModule = await JsInteropService.ImportModuleAsync(JS);
        await _chessModule.InvokeVoidAsync("watchDrawerToggleCorner", 80);
      }
      catch { /* the corner watcher is a convenience, never a requirement */ }
    }
    await base.OnAfterRenderAsync(firstRender);
  }

  public async ValueTask DisposeAsync()
  {
    notify.IsFullScreenRequested -= Notify_IsFullScreenRequested;
    SettingsService.OnSettingsChanged -= Settings_OnSettingsChanged;
    if (keyContext is not null) await keyContext.DisposeAsync();
  }
 
}
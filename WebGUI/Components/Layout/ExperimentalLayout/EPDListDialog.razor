@using WebGUI.Components.Layout

@* Dialog shell only — the list is EpdPositionList, shared with SingleAnalysis's column. *@

<MudDialog Class="pa-2" Style="width: 45%; max-width: 45%;">
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Class="mr-2" />
            <MudText Typo="Typo.h6">EPD List (@EPDs.Count positions)</MudText>
            <MudSpacer />
        </div>
    </TitleContent>
    <DialogContent>
        <EpdPositionList EPDs="@EPDs" SelectedItems="@SelectedItems"
                         SearchString="@SearchString" SearchStringChanged="@(s => SearchString = s)"
                         OnEpdSelected="SelectEpd" MaxTableHeight="65vh" />
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Cancel">Close</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [Parameter] public List<EPDTypes.EPDEntry> EPDs { get; set; } = new();
    [Parameter] public HashSet<EPDTypes.EPDEntry> SelectedItems { get; set; } = new();
    [Parameter] public string SearchString { get; set; } = "";
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    private void Cancel() => MudDialog.Cancel();

    // The host expects the picked entry and the search text back, so a reopened dialog can
    // restore the filter.
    private void SelectEpd(EPDTypes.EPDEntry epd) =>
        MudDialog.Close(DialogResult.Ok((epd, SearchString)));
}

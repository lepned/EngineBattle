   @inject IWebHostEnvironment Environment
   @using Markdig

<div class="markdown-content">
    @((MarkupString)markdownContent)
</div>

@code {

    [Parameter]
    public string FileName { get; set; }
    private string markdownContent = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var filePath = Path.Combine(Environment.ContentRootPath, "wwwroot", FileName ?? "");
            var raw = await File.ReadAllTextAsync(filePath);
            var pipeline = new Markdig.MarkdownPipelineBuilder().UseAdvancedExtensions().Build();
            markdownContent = Markdig.Markdown.ToHtml(raw, pipeline);
        }
        catch (Exception)
        {
            // Missing file, missing subfolder (DirectoryNotFoundException), bad path —
            // show the not-found message instead of crashing the embedding page
            markdownContent = $"<p>Documentation file not found: {FileName}</p>";
        }
    }
}


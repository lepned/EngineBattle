@using WebGUI.Components.Layout

@* Dialog shell only. The list itself is PgnGameList, shared with SingleAnalysis's right
   column — DualAnalysis has an engine panel on both sides of the board and no room for a
   column, but there is no reason for the two to look different. *@

<MudDialog Class="pa-2" Style="width: 45%; max-width: 45%;">
  <TitleContent>
    <div class="d-flex align-center">
      <MudIcon Icon="@Icons.Material.Filled.SportsEsports" Class="mr-2" />
      <MudText Typo="Typo.h6">PGN Game List (@Games.Count games)</MudText>
      <MudSpacer />
    </div>
  </TitleContent>
  <DialogContent>
    <PgnGameList Games="@Games" SelectedItems="@SelectedItems"
                 SearchString="@SearchString" SearchStringChanged="@(s => SearchString = s)"
                 OnGameSelected="SelectGame" MaxTableHeight="65vh" />
  </DialogContent>
  <DialogActions>
    <MudButton Color="Color.Primary" OnClick="Cancel">Close</MudButton>
  </DialogActions>
</MudDialog>

@code {
    [Parameter] public List<PGNTypes.PgnGame> Games { get; set; } = new();
    [Parameter] public HashSet<PGNTypes.PgnGame> SelectedItems { get; set; } = new();
    [Parameter] public string SearchString { get; set; } = "";
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; }

    private void Cancel() => MudDialog.Cancel();

    // The host expects the picked game and the search text back, so a reopened dialog can
    // restore the filter.
    private void SelectGame(PGNTypes.PgnGame game) =>
        MudDialog.Close(DialogResult.Ok((game, SearchString)));
}

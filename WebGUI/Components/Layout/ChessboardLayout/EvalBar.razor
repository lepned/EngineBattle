@using System.Globalization
@using WebGUI.Services
@implements IDisposable
@inject BoardThemeService ThemeService

@* The slot is the transparent stretch target; the bar proper is inset by the board-frame
   width so it spans the squares, not the frame/gutter. Vertical percent offsets resolve
   against the slot HEIGHT (= the board's outer size), so the inset is exact in every
   host regardless of the surrounding column's width. *@
<div class="eb-evalbar-slot" style="@InsetStyle">
    <div class="eb-evalbar @(Flipped ? "flipped" : "") @(HasEval ? "" : "idle")" title="@Tooltip">
        <div class="eb-evalbar-white" style="height:@WhitePercent"></div>
    </div>
</div>

@code {
    /// <summary>Eval in pawns from white's perspective (positive = white better).</summary>
    [Parameter] public double? Cp { get; set; }
    /// <summary>Mate distance from white's perspective (positive = white mates).</summary>
    [Parameter] public int? Mate { get; set; }
    /// <summary>True when the board is shown with black at the bottom.</summary>
    [Parameter] public bool Flipped { get; set; }

    private bool HasEval => Cp.HasValue || Mate.HasValue;

    private string InsetStyle =>
        ThemeService.Current.FramePct > 0
            ? $"--eb-evalbar-inset:{ThemeService.Current.FramePct.ToString("0.###", CultureInfo.InvariantCulture)}%;"
            : "";

    // Same logistic lichess uses to map centipawns to winning chances.
    private double WhiteShare =>
        Mate is int m ? (m > 0 ? 1.0 : 0.0)
        : Cp is double cp ? Math.Clamp(1.0 / (1.0 + Math.Exp(-0.368208 * cp)), 0.05, 0.95)
        : 0.5;

    private string WhitePercent => (100.0 * WhiteShare).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    private string Tooltip =>
        Mate is int m ? (m > 0 ? $"M{m}" : $"-M{-m}")
        : Cp is double cp ? cp.ToString("+0.00;-0.00", CultureInfo.InvariantCulture)
        : "no eval";

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    // Raised from the settings page's circuit; marshal to this component's dispatcher.
    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
    }
}

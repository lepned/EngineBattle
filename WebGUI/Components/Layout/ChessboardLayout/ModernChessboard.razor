    // ── Move input (click-to-move and drag & drop both funnel into TryUserMove) ──
    private bool isLegalMove(string moveStr)
    {
        var allMoves = ChessBoard.GetLegalMoves();
        return allMoves.Any(e => e.Item1.Contains(moveStr));
    }

    private bool isLegalPieceMove(string startSq)
    {
        // From-square only: a bare Contains also matched destination squares, so clicking
        // an empty square that is some move's target used to "select" it.
        var allMoves = ChessBoard.GetLegalMoves();
        return allMoves.Any(e => e.Item1.StartsWith(startSq));
    }

    private string GetMoveStr(string move)
    {
        var allMoves = ChessBoard.GetLegalMoves();
        var res = allMoves.Where(e => e.Item1.Contains(move));
        if (res.Count() > 1) return "promotion:" + move;
        var m = res.FirstOrDefault(e => e.Item1.Contains(move));
        return m?.Item1;
    }

    private async Task OnBoardSquareClicked(string square)
    {
        if (showPromotionDialog) return;

        if (selectedSquare is null)
        {
            if (isLegalPieceMove(square)) selectedSquare = square;
        }
        else if (square == selectedSquare)
        {
            selectedSquare = null;
        }
        else if (isLegalMove(selectedSquare + square))
        {
            await TryUserMove(selectedSquare, square);
        }
        else
        {
            selectedSquare = isLegalPieceMove(square) ? square : null;
        }
        StateHasChanged();
    }

    private async Task TryUserMove(string fromSq, string toSq, bool animate = true)
    {
        selectedSquare = null;
        var moveStr = fromSq + toSq;
        if (!isLegalMove(moveStr)) return;

        var resolved = GetMoveStr(moveStr);
        if (resolved is null) return;
        if (resolved.StartsWith("promotion:"))
        {
            OpenPromotionDialog(moveStr);
            return;
        }
        // Dropped pieces are already at their destination; gliding them in again looks broken.
        if (!animate) ebBoard?.SuppressNextAnimation();
        await UpdateNewMove(resolved, true);
    }

    [JSInvokable]
    public bool CanDragFrom(string square)
    {
        var ok = !showPromotionDialog && isLegalPieceMove(square);
        if (ok && ShowSafeSquarePreview)
        {
            dragFromSquare = square;
            _ = InvokeAsync(StateHasChanged);
        }
        return ok;
    }

    /// <summary>Raised from JS whenever a drag ends for any reason (drop, cancel, refused
    /// source, dispose) — clears drag-scoped transient UI like the safe-square preview.</summary>
    [JSInvokable]
    public Task OnBoardDragEnd() =>
        InvokeAsync(() =>
        {
            if (dragFromSquare == null) return;
            dragFromSquare = null;
            StateHasChanged();
        });

    [JSInvokable]
    public Task OnBoardDragDrop(string fromSq, string toSq) =>
        InvokeAsync(async () =>
        {
            await TryUserMove(fromSq, toSq, animate: false);
            StateHasChanged();
        });

    private async Task UpdateNewMove(string move, bool invokeMove = true)
    {
        if (invokeMove)
        {
            var moveIsProvided = !string.IsNullOrEmpty(move);
            if (moveIsProvided)
            {
                var mover = ChessBoard.Position.STM == 0 ? "w" : "b";
                ChessBoard.PlayUciMove(move);
                await ClearOverlayOnPositionChange();
                // fen must be current BEFORE notifying the page: pages echo the fen back
                // via Notifier -> OnReceivedFen, whose same-position guard must match or
                // it clears the last-move highlight we just set.
                fenWithMoves = ChessBoard.PositionWithMoves();
                fen = ChessBoard.FEN();
                lastMoveFrom = move.Substring(0, 2);
                lastMoveTo = move.Substring(2, 2);
                lastMoveColor = mover;
                await OnMoveMadeOnBoard.InvokeAsync(move);
                firstNNMoves.Clear();
                secondNNMoves.Clear();
            }

            fenWithMoves = ChessBoard.PositionWithMoves();
            fen = ChessBoard.FEN();
            var lastNNMoves = GetNNValues(currentId);
            var lastFenMove = ChessBoard.MovesAndFenPlayed.Last();
            await DisplayMoveAnnotation(lastNNMoves, currentId);
            UpdateVariationsDisplay();
            StateHasChanged();
        }
    }

    // ── Engine / board operations ──
    public async Task ResetEngine() => await Notifier.NotifyEngineToReset(true);

    public async Task RotateBoard()
    {
        isBoardFlipped = !isBoardFlipped;
        if (OnBoardFlipped.HasDelegate)
            await OnBoardFlipped.InvokeAsync(isBoardFlipped);
        StateHasChanged();
    }

    public async Task WriteTextAsync()
    {
        var fen = ChessBoard.FEN();
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", fen);
    }

    private async Task UpdateFenWithMovesInput()
    {
        try
        {
            stopAutoPlay = true;
            if (!string.IsNullOrEmpty(fenWithMoves))
            {
                ChessBoard.ResetBoardState();
                fenWithMoves = fenWithMoves.TrimStart().TrimEnd();
                ChessBoard.PlayFenWithMoves(fenWithMoves);
                fen = ChessBoard.FEN();
                await ClearOverlayOnPositionChange();
                await SetPosition(fen, false);
                await OnNewFENOnBoard.InvokeAsync(fen);
                UpdateVariationsDisplay();
                await ScrollToCurrentMove();
            }
            StateHasChanged();
        }
        catch (Exception)
        {
            logger.LogError("Error parsing FEN with moves: " + fenWithMoves);
        }
    }

    private async Task PrepareChessboard()
    {
        objRef = DotNetObjectReference.Create(this);
        chessJSmodule = await JsInteropService.ImportModuleAsync(JS);
        if (String.IsNullOrEmpty(FENposition)) FENposition = startPos;
        fen = FENposition;
        dragHandle = await chessJSmodule.InvokeAsync<IJSObjectReference>("attachBoardDrag", board, objRef);
        StateHasChanged();
    }

    public async Task ResetGameState()
    {
        stopAutoPlay = true;
        moveStr = string.Empty;
        moveHeader = string.Empty;
        moveList = string.Empty;
        fen = startPos;
        ChessBoard.ResetBoardState();
        ChessBoard.LoadFen(fen);
        ClearBoardMarkers();
        await ClearOverlayOnPositionChange();
        UpdateVariationsDisplay();
        // Fresh session first (hosts clear skip sets), then the position notification —
        // so the auto-search triggered by the new FEN is not skipped as "analyzed".
        await OnBoardReset.InvokeAsync();
        // Tell the host page the position changed — without this the page keeps the old
        // FEN, Notifier.UpdateFen never fires, and auto-search silently stops.
        await OnNewFENOnBoard.InvokeAsync(fen);
        StateHasChanged();
    }

    private void ClearBoardMarkers()
    {
        lastMoveFrom = lastMoveTo = null;
        lastMoveColor = null;
        selectedSquare = null;
        showPromotionDialog = false;
    }

    private Task SetPosition(string fen, bool withCallback = false)
    {
        ClearBoardMarkers();
        moveList = string.Empty;
        UpdateVariationsDisplay();
        return Task.CompletedTask;
    }

    // ── Overlay display ──
    // Invariant, like CandidateMoves and the Plotly hover strings: these numbers sit beside
    // that table on the same screen, and a comma here against a dot there reads as a bug.
    private static readonly System.Globalization.CultureInfo Inv = System.Globalization.CultureInfo.InvariantCulture;

    private string FormatNodes(double nodes)
    {
        if (nodes > 1_000_000_000) return (nodes / 1_000_000_000).ToString("F1", Inv) + "B";
        else if (nodes > 1_000_000) return (nodes / 1_000_000).ToString("F1", Inv) + "M";
        else if (nodes > 1_000) return (nodes / 1_000).ToString("F1", Inv) + "K";
        else return nodes.ToString("F0", Inv);
    }

    private record OverlayEntry(string FromSq, string ToSq, string Text);

    private List<OverlayEntry> GetDisplayData(List<NNValues> nnMoves, OverlaySettings overlay)
    {
        MinPolicyThreshold = OverlaySetting.MinPolicyThreshold * 100;
        var currentOverlaySetting = overlay;
        if (!OverlaySetting.IsOverlaySettingsEnabled || nnMoves.Count == 0) return new List<OverlayEntry>();
        var firstMove = nnMoves.FirstOrDefault();
        if (firstMove.Nodes == 1) currentOverlaySetting = OverlaySettings.Policy;
        var moves = nnMoves.Skip(1).Where(e => e.P > MinPolicyThreshold).ToList();

        Func<NNValues, string> text = currentOverlaySetting switch
        {
            OverlaySettings.Policy => e => e.P.ToString("F1", Inv),
            OverlaySettings.SearchPolicy => e => (e.Nodes * 100.0 / (double)firstMove.Nodes).ToString("F1", Inv),
            OverlaySettings.Q => e => e.Q.ToString("F2", Inv),
            OverlaySettings.V => e => e.V.ToString("F2", Inv),
            OverlaySettings.QVDiff => e => (e.Q - e.V).ToString("F2", Inv),
            OverlaySettings.E => e => (2 * e.E).ToString("F2", Inv),
            OverlaySettings.Nodes => e => FormatNodes(e.Nodes),
            _ => null
        };
        if (text is null) return new List<OverlayEntry>();

        return moves.Select(e => new OverlayEntry(e.LANMove.Substring(0, 2), e.LANMove.Substring(2, 2), text(e))).ToList();
    }

    private async Task DisplayMoveAnnotation(List<NNValues> moves, string id)
    {
        var overlay = OverlaySetting.GetOverlaySetting(id);
        var data = GetDisplayData(moves, overlay);
        if (data.Count > 0)
        {
            // A themeable line connects origin to destination (indicator "line"; "none"
            // draws only the labels). The circle backing is the label's own background
            // (FitText pill), so long values like 100.2K stay enclosed.
            var theme = ThemeService.Current;
            overlayArrows = theme.PolicyIndicator == "line"
                ? data.Select(d => new EbArrow(d.FromSq, d.ToSq, theme.PolicyIndicatorColor, theme.PolicyIndicatorOpacity, 0.3, "line")).ToArray()
                : Array.Empty<EbArrow>();
            overlayCircles = Array.Empty<EbCircle>();
            overlayLabels = theme.PolicyLabelStyle == "plain"
                ? data.Select(d => new EbSquareLabel(d.ToSq, d.Text, theme.PolicyLabelColor, "transparent", theme.PolicyLabelChipPct, theme.PolicyLabelFontPx)).ToArray()
                : data.Select(d => new EbSquareLabel(d.ToSq, d.Text, theme.PolicyLabelColor, theme.PolicyLabelBg, theme.PolicyLabelChipPct, theme.PolicyLabelFontPx, null, 0.9, true)).ToArray();
        }
        else
        {
            overlayArrows = Array.Empty<EbArrow>();
            overlayCircles = Array.Empty<EbCircle>();
            overlayLabels = Array.Empty<EbSquareLabel>();
        }
        await InvokeAsync(StateHasChanged);
    }

    private async Task SetPositionAndMove(MoveAndFen input, bool withCallback = false, bool withAnnotation = false, bool invokeMove = true)
    {
        ClearBoardMarkers();
        lastMoveFrom = input.Move.FromSq;
        lastMoveTo = input.Move.ToSq;
        lastMoveColor = input.Move.Color;
        if (invokeMove)
            await UpdateNewMove(input.Move.FromSq + input.Move.ToSq, true);
    }

    // ── Navigation ──
    private async Task StartOfGame()
    {
        stopAutoPlay = true;
        await ClearOverlayOnPositionChange();
        var startFen = ChessBoard.StartPosition;
        fen = startFen;
        ChessBoard.LoadFen(startFen);
        await SetPosition(startFen);
        await OnNewFENOnBoard.InvokeAsync(fen);
        UpdateVariationsDisplay();
        await ScrollToCurrentMove();
        StateHasChanged();
    }

    private async Task EndOfGame()
    {
        stopAutoPlay = true;
        await ClearOverlayOnPositionChange();
        ChessBoard.EndCurrentVariation();
        var fenAndMove = ChessBoard.MovesAndFenPlayed.LastOrDefault();
        if (fenAndMove != null)
        {
            await OnNotifyMoveAndFen(fenAndMove);
            UpdateVariationsDisplay();
            await OnNewFENOnBoard.InvokeAsync(fen);
            await ScrollToCurrentMove();
        }
        StateHasChanged();
    }

    private async Task NextMove()
    {
        stopAutoPlay = true;
        await ClearOverlayOnPositionChange();
        var next = ChessBoard.TryGetNextMoveAndFen(fen);
        if (next != null)
        {
            var move = next.Value;
            fen = move.FenAfterMove;
            ChessBoard.LoadFen(fen);
            await SetPositionAndMove(move, invokeMove: false);
            await OnMoveMadeOnBoard.InvokeAsync(move.Move.FromSq + move.Move.ToSq);
            UpdateVariationsDisplay();
            await ScrollToCurrentMove();
        }
        StateHasChanged();
    }

    private async Task PreviousMove() => await StepBackInternal(true);

    public async Task StepBack(bool notifyParent = true) => await StepBackInternal(notifyParent);

    private async Task StepBackInternal(bool notifyParent)
    {
        stopAutoPlay = true;
        await ClearOverlayOnPositionChange();
        var prev = ChessBoard.TryGetPreviousMoveAndFen(fen);
        if (prev != null)
        {
            var move = prev.Value;
            fen = move.FenAfterMove;
            ChessBoard.LoadFen(fen);
            await SetPositionAndMove(move, invokeMove: false);
            if (notifyParent && OnMoveMadeOnBoard.HasDelegate)
                await OnMoveMadeOnBoard.InvokeAsync(move.Move.FromSq + move.Move.ToSq);
            UpdateVariationsDisplay();
            await ScrollToCurrentMove();
        }
        StateHasChanged();
    }

    private async Task PlayMoves()
    {
        stopAutoPlay = false;
        fen = ChessBoard.FEN();
        while (!stopAutoPlay && ChessBoard.TryGetNextMoveAndFen(fen) != null)
        {
            await NextMove();
            await Task.Delay(400);
        }
        stopAutoPlay = true;
    }

    // ── Public methods ──
    // Both are NotifierService event handlers invoked from engine/tournament threads,
    // so the whole body must run on the dispatcher (UpdateNewMove renders directly).
    public Task OnReceivedFen(string newPos) => InvokeAsync(async () =>
    {
        // Pages echo the fen back via Notifier right after a move made on this board
        // (OnMoveMadeOnBoard -> Notifier.UpdateFen). Same position = nothing to do —
        // and clearing here would wipe the last-move highlight that was just set.
        if (string.Equals(newPos, fen, StringComparison.Ordinal)) return;

        await ClearOverlayOnPositionChange();
        fen = newPos;
        await SetPosition(newPos, false);
        UpdateVariationsDisplay();
        StateHasChanged();
    });

    public Task OnNotifyMoveAndFen(MoveAndFen input) => InvokeAsync(async () =>
    {
        if (input == null) return;
        if (fen != input.FenAfterMove)
        {
            await ClearOverlayOnPositionChange();
            await SetPositionAndMove(input, invokeMove: true);
            fen = input.FenAfterMove;
            ChessBoard.LoadFen(fen);
        }
        UpdateVariationsDisplay();
        await ScrollToCurrentMove();
        StateHasChanged();
    });

    public Task SetPositionDirect(string targetFen) => InvokeAsync(async () =>
    {
        fen = targetFen;
        ClearBoardMarkers();
        await ScrollToCurrentMove();
        StateHasChanged();
    });

    public async Task OnNotifyOverlaySettings(OverlaySettings overlay, string id)
    {
        if (overlay == OverlaySettings.None)
        {
            if (id == currentId)
            {
                overlayArrows = Array.Empty<EbArrow>();
                overlayCircles = Array.Empty<EbCircle>();
                overlayLabels = Array.Empty<EbSquareLabel>();
                currentId = string.Empty;
                await InvokeAsync(StateHasChanged);
            }
        }
        else
        {
            currentId = id;
            var lastNNMoves = GetNNValues(id);
            await DisplayMoveAnnotation(lastNNMoves, id);
        }
    }

    public async Task OnNotifyMoves(IEnumerable<NNValues> moves, string id)
    {
        var genBefore = _positionGeneration;
        var lastNNMoves = GetNNValues(id);
        lastNNMoves.Clear();
        lastNNMoves.AddRange(moves);
        if (genBefore != _positionGeneration) { lastNNMoves.Clear(); return; }
        if (OverlaySetting.GetOverlaySetting(id) == OverlaySettings.None) return;
        if (string.IsNullOrEmpty(currentId)) currentId = id;
        if (id == currentId) await DisplayMoveAnnotation(lastNNMoves, id);
    }

    // ── Lifecycle ──
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            fen = FENposition;
            await PrepareChessboard();
        }

        try
        {
            if (_pendingScrollToCurrentMove && chessJSmodule is not null)
            {
                var tok = InlineTokens.FirstOrDefault(t => !t.IsBracket && string.Equals(t.Fen, fen, StringComparison.Ordinal));
                if (tok is null)
                {
                    // No token carries this FEN. CurrentNodeHash was the old fallback, but
                    // nothing guarantees it belongs to a rendered move, and a hash with no
                    // element can never be scrolled to. The last mainline token always has
                    // one, and on a live feed it is the move we want anyway.
                    tok = InlineTokens.LastOrDefault(t => !t.IsBracket && !t.IsFromVariation);
                    // First attempt only: the request is retried on later renders, and one
                    // line per render would bury the log on a live feed.
                    if (_scrollAttempts == 0)
                        logger.LogDebug(
                            "Move-list scroll: no token for FEN {Fen}; falling back to {Fallback} of {Count} tokens",
                            fen, tok is null ? "none" : tok.DisplayText, InlineTokens.Count);
                }
                var targetHash = tok?.Hash ?? 0UL;
                if (targetHash == 0UL)
                {
                    ClearPendingScroll();
                    await chessJSmodule.InvokeVoidAsync("scrollDivToEnd", "moveListDiv");
                }
                else
                {
                    // A move arriving live asks for its scroll before its row exists: the
                    // render that adds the row can come after this pass, and clearing the
                    // request here spent it against the previous DOM — the list stayed put
                    // and the newest moves fell below the fold. Hold the request until the
                    // element is really there. Navigation looked fine because it rebuilds
                    // the whole list in the render it triggers itself.
                    var landed = await chessJSmodule.InvokeAsync<bool>(
                        "scrollToMoveListElement", "moveListDiv", $"move-{targetHash}");
                    if (landed || ++_scrollAttempts >= MaxScrollAttempts)
                        ClearPendingScroll();
                }
            }

            if (MoveListFontSize > 0 && MoveListFontSize != moveListFontSize)
            {
                moveListFontSize = MoveListFontSize;
                moveListStyle = $"font-size:{moveListFontSize}px; line-height: 25px; height: {MoveListHeight}px;";
                openingStyle = $"font-size:{moveListFontSize}px";
                StateHasChanged();
            }

            if (MoveListHeight > 0 && MoveListHeight != moveListHeight)
            {
                moveListHeight = MoveListHeight;
                moveListStyle = $"font-size:{moveListFontSize}px; line-height: 25px; height: {MoveListHeight}px;";
                StateHasChanged();
            }
        }
        catch (ObjectDisposedException) { }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
    }

    protected override async Task OnInitializedAsync()
    {
        this.keyContext = this.HotKeys.CreateContext()
            .Add(Key.ArrowRight, (Func<Task>)(async () => await NextMove()), "Next move")
            .Add(Key.ArrowLeft, (Func<Task>)(async () => await PreviousMove()), "Prev move")
            .Add(Key.P, (Func<Task>)(async () => await PlayMoves()), "Play moves")
            .Add(Key.R, (Func<Task>)(async () => await RotateBoard()), "Rotate board")
            .Add(Key.Home, (Func<Task>)(async () => await StartOfGame()), "Start of game")
            .Add(Key.End, (Func<Task>)(async () => await EndOfGame()), "End of game");
        await base.OnInitializedAsync();
    }

    protected override void OnInitialized()
    {
        Notifier.NotifyFenToBoard += OnReceivedFen;
        Notifier.NotifyFen += OnReceivedFen;
        Notifier.NotifyFenAndMove += OnNotifyMoveAndFen;
        Notifier.NotifyMovesWithId += OnNotifyMoves;
        Notifier.NotifyDisplaySettings += OnNotifyOverlaySettings;
        boardSizePx = Math.Clamp(SettingsService.Settings.BoardSizeFor(SizeKey), 360, 900);
        fenWithMoves = startPos;
        fen = startPos;
        UpdateVariationsDisplay();
        base.OnInitialized();
    }

    async ValueTask IAsyncDisposable.DisposeAsync()
    {
        try
        {
            if (dragHandle is not null)
            {
                try { await dragHandle.InvokeVoidAsync("dispose"); }
                catch (Microsoft.JSInterop.JSDisconnectedException) { }
                await dragHandle.DisposeAsync();
            }
            Dispose();
        }
        catch (Exception) { logger.LogError("Error disposing ModernChessboard component."); }
    }

    public void Dispose()
    {
        // Stop a running autoplay loop — it would otherwise keep stepping the board
        // and firing OnMoveMadeOnBoard every 400ms after navigation away
        stopAutoPlay = true;
        this.keyContext?.DisposeAsync();
        Notifier.NotifyFenToBoard -= OnReceivedFen;
        Notifier.NotifyFen -= OnReceivedFen;
        Notifier.NotifyFenAndMove -= OnNotifyMoveAndFen;
        Notifier.NotifyMovesWithId -= OnNotifyMoves;
        Notifier.NotifyDisplaySettings -= OnNotifyOverlaySettings;
        objRef?.Dispose();
    }

    public void UpdateVariationsDisplay()
    {
        VariationLines.Clear();
        InlineMoveHistory = string.Empty;
        InlineTokens.Clear();
        var tokens = ChessBoard.InlineTokensFromGraph();
        InlineTokens.AddRange(tokens.Select(t => new InlineToken(t.Text, t.DisplayText, t.Fen, t.Evaluation, t.MoveCoord, t.IsBracket, t.Hash, t.FromVariation, t.Ply)));
        InlineMoveHistory = string.Join(" ", tokens.Where(t => !t.IsBracket).Select(t => t.DisplayText));

        if (MoveListPosition == MoveListPosition.Right)
            BuildMovePairs();
    }

    // ── Move action menu ──
    private void ShowMoveActionMenu(InlineToken token, MouseEventArgs e)
    {
        if (token == null || token.IsBracket || string.IsNullOrWhiteSpace(token.Fen)) return;
        selectedActionSan = token.Text;
        selectedActionLabel = FormatMoveLabel(token);
        selectedActionFen = token.Fen;
        actionDialogX = e.ClientX;
        actionDialogY = e.ClientY;
        showMoveActionDialog = true;
        StateHasChanged();
    }

    private void CloseMoveActionMenu()
    {
        showMoveActionDialog = false;
        selectedActionLabel = string.Empty;
    }

    private async Task RefreshAfterGraphChange(bool updated, bool jumpToSelectedFen = false)
    {
        if (updated)
        {
            if (jumpToSelectedFen && !string.IsNullOrWhiteSpace(selectedActionFen))
            {
                ChessBoard.LoadFen(selectedActionFen);
                fen = selectedActionFen;
            }
            else
            {
                fen = ChessBoard.FEN();
            }
            await SetPosition(fen);
            await ScrollToCurrentMove();
        }
        CloseMoveActionMenu();
    }

    private string FormatMoveLabel(InlineToken token)
    {
        if (token == null || string.IsNullOrWhiteSpace(token.Text)) return string.Empty;
        var moveNr = (token.Ply / 2) + 1;
        return token.Ply % 2 == 0 ? $"{moveNr}. {token.Text}" : $"{moveNr}... {token.Text}";
    }

    private Task PromoteSelectedVariation()
    {
        var updated = ChessBoard.PromoteVariationToMainline(string.Empty, selectedActionFen);
        return RefreshAfterGraphChange(updated, true);
    }

    private Task DeleteEntireVariation()
    {
        var updated = ChessBoard.RemoveVariationNode(selectedActionSan, selectedActionFen, true);
        ChessBoard.EndCurrentVariation();
        var moveFen = ChessBoard.MovesAndFenPlayed.LastOrDefault();
        if (moveFen != null)
        {
            fen = moveFen.FenAfterMove;
            selectedActionFen = moveFen.FenAfterMove;
            ChessBoard.LoadFen(selectedActionFen);
        }
        return RefreshAfterGraphChange(updated, false);
    }

    private Task DeleteSelectedVariationTail()
    {
        var previous = ChessBoard.TryGetPreviousMoveAndFen(selectedActionFen);
        var updated = ChessBoard.RemoveVariationTail(selectedActionSan, selectedActionFen);
        if (updated && previous != null)
        {
            selectedActionFen = previous.Value.FenAfterMove;
            fen = selectedActionFen;
            ChessBoard.LoadFen(selectedActionFen);
        }
        return RefreshAfterGraphChange(updated, updated && previous != null);
    }

    private async Task OnInlineMoveClick(InlineToken token)
    {
        if (token == null || string.IsNullOrWhiteSpace(token.Fen)) return;
        stopAutoPlay = true;
        await ClearOverlayOnPositionChange();
        ChessBoard.LoadFen(token.Fen);
        var history = ChessBoard.GetMoveHistoryToCurrentFen(token.Fen);
        fen = token.Fen;
        UpdateVariationsDisplay();
        await SetPosition(fen);
        if (!string.IsNullOrWhiteSpace(token.MoveCoord))
            await OnMoveMadeOnBoard.InvokeAsync(token.MoveCoord);
        await ScrollToCurrentMove();
        StateHasChanged();
    }
}

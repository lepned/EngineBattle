    // ── FEN handling ──
    private async Task OnValueChanged(string value)
    {
        fenWithMoves = value;
        fen = value;
        await UpdateFenWithMovesInput();
        UpdateVariationsDisplay();
        StateHasChanged();
    }

    private async void OnItemClick(int index)

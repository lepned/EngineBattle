    // ── NN Overlay ──
    private List<NNValues> GetNNValues(string id)
    {
        if (id == "nnInput1") return firstNNMoves;
        else if (id == "nnInput2") return secondNNMoves;
        return new List<NNValues>();
    }

    private Task ClearOverlayOnPositionChange()
    {
        _positionGeneration++;
        firstNNMoves.Clear();
        secondNNMoves.Clear();
        currentId = string.Empty;
        overlayArrows = Array.Empty<EbArrow>();
        overlayCircles = Array.Empty<EbCircle>();
        overlayLabels = Array.Empty<EbSquareLabel>();

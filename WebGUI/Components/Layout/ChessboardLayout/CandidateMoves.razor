@using System.Globalization
@inject IJSRuntime JS

@* Candidate-move panel for MCTS engines (Lc0/Ceres verbose move stats): top root moves
   by visits, each row showing search share (bar) vs policy prior (tick), nodes, Q and
   WDL — all displayed white-perspective. Fed live by the kibitzer during search. *@

@if (rows.Count == 0)
{
    <div class="cm-empty">waiting for engine move stats…</div>
}
else
{
    <div class="cm-grid @(Detailed ? "detailed" : null)">
        <div class="cm-h">Move</div>
        <div class="cm-h">Search share · <span class="cm-h-prior">▏</span>prior</div>
        <div class="cm-h cm-right">Nodes</div>
        @if (Detailed)
        {
            <div class="cm-h cm-right">P</div>
        }
        <div class="cm-h cm-right">Q</div>
        @if (Detailed)
        {
            <div class="cm-h cm-right">V</div>
        }
        <div class="cm-h">WDL</div>

        @foreach (var r in rows)
        {
            <div class="cm-row @(OnRowClick.HasDelegate ? "clickable" : null) @(IsFocused(r) ? "focused" : null)"
                 title="@RowTitle(r)"
                 @onclick="@(e => RowClicked(r, e.CtrlKey))">
                <div class="cm-san @(r.IsTop ? "top" : "")">@r.San@(IsPreferred(r) ? preferredMark : null)</div>
                <div class="cm-barcell">
                    <div class="cm-track">
                        <div class="cm-fill @(r.IsTop ? "top" : "")" style="width:@Pct(r.NShare)">
                            @if (r.NShare >= 0.18)
                            {
                                <span class="cm-pct inside">@PctLabel(r.NShare)</span>
                            }
                        </div>
                        @if (r.NShare < 0.18)
                        {
                            <span class="cm-pct" style="left:@OutsideLabelLeft(r)">@PctLabel(r.NShare)</span>
                        }
                        <div class="cm-prior" style="left:@Pct(r.PShare)" title="@($"prior {r.PShare * 100:0.0}%")"></div>
                    </div>
                </div>
                <div class="cm-n">@FormatNodes(r.Nodes)</div>
                @if (Detailed)
                {
                    <div class="cm-p">@((r.PShare * 100).ToString("0.0", CultureInfo.InvariantCulture))%</div>
                }
                <div class="cm-q @(r.Q >= 0.05 ? "pos" : r.Q <= -0.05 ? "neg" : "")">
                    @r.Q.ToString("+0.00;-0.00;0.00", CultureInfo.InvariantCulture)
                </div>
                @if (Detailed)
                {
                    <div class="cm-q @(r.V >= 0.05 ? "pos" : r.V <= -0.05 ? "neg" : "")">
                        @r.V.ToString("+0.00;-0.00;0.00", CultureInfo.InvariantCulture)
                    </div>
                }
                @if (r.HasWdl)
                {
                    <div class="cm-wdl-wrap" title="@($"W {r.W:0.0}% · D {r.D:0.0}% · L {r.L:0.0}%")">
                        <div class="cm-wdl">
                            <span class="w" style="width:@($"{r.W:0.#}%")"></span>
                            <span class="d" style="width:@($"{r.D:0.#}%")"></span>
                            <span class="l" style="width:@($"{r.L:0.#}%")"></span>
                        </div>
                        @if (!Detailed)
                        {
                            <span class="cm-wdl-num">@($"{r.W:0}·{r.D:0}·{r.L:0}")</span>
                        }
                    </div>
                }
                else
                {
                    <div class="cm-wdl-num">–</div>
                }
            </div>
        }
    </div>
    <div class="cm-legend">
        <span><i class="sw-top"></i>best move</span>
        <span><i class="sw-n"></i>visit share (N%)</span>
        <span><i class="sw-p"></i>policy prior (P%)</span>
        <span><i class="sw-w"></i>win <i class="sw-d"></i>draw <i class="sw-l"></i>loss</span>
        @if (!string.IsNullOrEmpty(PreferredLanMove))
        {
            <span>@preferredMark = engine choice (first PV move)</span>
        }
        <button class="cm-copy" @onclick="CopyToClipboard"
                title="Copy move stats as text (paste into a Discord code block)">@copyLabel</button>
    </div>
}

@code {
    /// <summary>Verbose move stats of the current search, any order (sorted here by visits).</summary>
    [Parameter] public IReadOnlyList<NNValues> Stats { get; set; }
    /// <summary>FEN the search ran on — decides the white-perspective flip for Q/V/WDL.</summary>
    [Parameter] public string Fen { get; set; } = "";
    [Parameter] public int MaxRows { get; set; } = 5;
    /// <summary>Adds numeric P and V columns for analysis use; broadcast stays compact.</summary>
    [Parameter] public bool Detailed { get; set; }
    /// <summary>Row click, with Ctrl state — hosts wire this to focus-mode selection.</summary>
    [Parameter] public EventCallback<(NNValues Move, bool CtrlKey)> OnRowClick { get; set; }
    /// <summary>LAN moves currently restricting the search (focus mode) — highlighted.</summary>
    [Parameter] public IReadOnlyCollection<string> FocusedMoves { get; set; }
    /// <summary>First move of the engine's main PV (LAN) — its actual move choice, which for
    /// MCTS engines may differ from the max-N move. Marked with * in table and copy output.</summary>
    [Parameter] public string PreferredLanMove { get; set; }
    /// <summary>Engine (and network) that produced these stats — provenance header line in
    /// the copy output. Not rendered in the table.</summary>
    [Parameter] public string SourceDescription { get; set; }
    /// <summary>Latest raw UCI info line(s), top MultiPV first (depth/score/PV + engine
    /// extras) — appended verbatim at the end of the copy output. Not rendered in the table.</summary>
    [Parameter] public string RawInfoLine { get; set; }

    private const string preferredMark = "*";

    private bool IsPreferred(Row r) =>
        !string.IsNullOrEmpty(PreferredLanMove)
        && string.Equals(r.Source.LANMove?.Trim(), PreferredLanMove.Trim(), StringComparison.OrdinalIgnoreCase);

    private record Row(string San, bool IsTop, double NShare, double PShare, long Nodes,
                       double Q, double V, bool HasWdl, double W, double D, double L, NNValues Source);

    private bool IsFocused(Row r) => FocusedMoves != null && FocusedMoves.Contains(r.Source.LANMove);

    private string RowTitle(Row r) =>
        OnRowClick.HasDelegate && !string.IsNullOrEmpty(r.Source.Raw)
            ? $"{r.Source.Raw}\nCtrl+click: restrict search to selected moves"
            : r.Source.Raw ?? "";

    private Task RowClicked(Row r, bool ctrl) =>
        OnRowClick.HasDelegate ? OnRowClick.InvokeAsync((r.Source, ctrl)) : Task.CompletedTask;

    // WL (win-minus-loss) and D (draw prob) ride in the raw info string but are not
    // parsed into NNValues — W = (1-D+WL)/2, L = (1-D-WL)/2.
    private static readonly System.Text.RegularExpressions.Regex WlRegex =
        new(@"\(WL:\s*(-?[0-9.]+)\)", System.Text.RegularExpressions.RegexOptions.Compiled);
    private static readonly System.Text.RegularExpressions.Regex DRegex =
        new(@"\(D:\s*(-?[0-9.]+)\)", System.Text.RegularExpressions.RegexOptions.Compiled);

    // Built once per parameter change — the markup reads it twice (empty check + loop).
    private List<Row> rows = new();

    protected override void OnParametersSet() => rows = BuildRows();

    private List<Row> BuildRows()
    {
        // Verbose move stats end with a "node" entry for the root itself (its N is the
        // whole search) — not a move, and it must not inflate the share denominator.
        var stats = Stats?.Where(s => !string.Equals(s.LANMove?.Trim(), "node", StringComparison.OrdinalIgnoreCase)).ToList();
        if (stats == null || stats.Count == 0) return new();
        var total = stats.Sum(s => Math.Max(0L, s.Nodes));
        if (total <= 0) return new();
        var whiteToMove = !Fen.Contains(" b ");
        var top = stats.OrderByDescending(s => s.Nodes).Take(MaxRows).ToList();

        var result = new List<Row>(top.Count);
        for (int i = 0; i < top.Count; i++)
        {
            var s = top[i];
            var san = string.IsNullOrEmpty(s.SANMove) ? s.LANMove : s.SANMove;
            var q = whiteToMove ? s.Q : -s.Q;
            var v = whiteToMove ? s.V : -s.V;
            var hasWdl = TryParseWdl(s.Raw, out var w, out var d, out var l);
            if (hasWdl && !whiteToMove) (w, l) = (l, w);
            result.Add(new Row(san, i == 0, (double)s.Nodes / total, Math.Clamp(s.P / 100.0, 0, 1),
                               s.Nodes, q, v, hasWdl, w * 100, d * 100, l * 100, s));
        }
        return result;
    }

    private static bool TryParseWdl(string raw, out double w, out double d, out double l)
    {
        (w, d, l) = (0, 0, 0);
        if (string.IsNullOrEmpty(raw)) return false;
        var wlM = WlRegex.Match(raw);
        var dM = DRegex.Match(raw);
        if (!wlM.Success || !dM.Success) return false;
        if (!double.TryParse(wlM.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out var wl) ||
            !double.TryParse(dM.Groups[1].Value, NumberStyles.Float, CultureInfo.InvariantCulture, out d))
            return false;
        w = Math.Clamp((1.0 - d + wl) / 2.0, 0, 1);
        l = Math.Clamp((1.0 - d - wl) / 2.0, 0, 1);
        d = Math.Clamp(d, 0, 1);
        return true;
    }

    private static string Pct(double share) =>
        (share * 100).ToString("0.#", CultureInfo.InvariantCulture) + "%";

    // Low-share rows show their % label outside the bar, starting right after the fill.
    // The prior tick often sits in that same stretch and would draw through the text —
    // when it falls within the label's approximate span, anchor the label past the tick.
    private static string OutsideLabelLeft(Row r)
    {
        var anchor = r.PShare > r.NShare && r.PShare - r.NShare < 0.18 ? r.PShare : r.NShare;
        return $"calc({Pct(anchor)} + 0.45rem)";
    }

    private static string PctLabel(double share) =>
        Math.Round(share * 100).ToString(CultureInfo.InvariantCulture) + "%";

    // ── Copy to clipboard: aligned plain-text table (Discord code-block friendly),
    //    same white-perspective values as displayed, FEN header for provenance. ──
    private string copyLabel = "Copy";

    private string BuildCopyText()
    {
        var inv = CultureInfo.InvariantCulture;
        var sb = new System.Text.StringBuilder();
        sb.AppendLine($"FEN: {Fen}");
        if (!string.IsNullOrWhiteSpace(SourceDescription))
            sb.AppendLine(SourceDescription);
        sb.AppendLine($"{"Move",-8}{"N%",7}{"P%",7}{"Nodes",9}{"Q",8}{"V",8}  WDL%");
        foreach (var r in rows)
        {
            var san = IsPreferred(r) ? r.San + preferredMark : r.San;
            var q = r.Q.ToString("+0.00;-0.00;0.00", inv);
            var v = r.V.ToString("+0.00;-0.00;0.00", inv);
            var wdl = r.HasWdl ? $"{r.W.ToString("0", inv)}-{r.D.ToString("0", inv)}-{r.L.ToString("0", inv)}" : "-";
            sb.AppendLine($"{san,-8}{(r.NShare * 100).ToString("0.0", inv),7}{(r.PShare * 100).ToString("0.0", inv),7}{FormatNodes(r.Nodes),9}{q,8}{v,8}  {wdl}");
        }
        if (rows.Any(IsPreferred))
            sb.AppendLine($"{preferredMark} = engine choice (first PV move)");
        if (!string.IsNullOrWhiteSpace(RawInfoLine))
        {
            // Raw main-line info at the end, after a blank line — the columnar block
            // stays clean, and engine-specific extras survive verbatim.
            sb.AppendLine();
            sb.AppendLine(RawInfoLine.Trim());
        }
        return sb.ToString();
    }

    private async Task CopyToClipboard()
    {
        try
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", BuildCopyText());
            copyLabel = "Copied ✓";
            StateHasChanged();
            await Task.Delay(1500);
            copyLabel = "Copy";
        }
        catch
        {
            // Clipboard unavailable (permissions/non-secure context) — leave the label as-is.
        }
    }

    private static string FormatNodes(long nodes) => nodes switch
    {
        >= 1_000_000_000 => $"{nodes / 1_000_000_000.0:0.##}B",
        >= 1_000_000 => $"{nodes / 1_000_000.0:0.##}M",
        >= 1_000 => $"{nodes / 1_000.0:0.#}K",
        _ => nodes.ToString()
    };
}

@* Native Blazor chessboard — no JS dependency. Renders a FEN as a CSS grid with
   theme support (piece sets, square colors, coordinates). See docs/ChessboardJsDependencies.md
   for the full replacement requirements this component is built against. *@
@using System.IO
@using System.Collections.Concurrent
@using System.Globalization
@using WebGUI.Services
@implements IDisposable
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env
@inject BoardThemeService ThemeService
@inject GlobalSettingsService SettingsService

<div class="eb-board eb-style-@ThemeService.Current.HighlightStyle" style="@RootStyle">
    @{ var board = boardCells; }
    @for (int row = 0; row < 8; row++)
    {
        for (int col = 0; col < 8; col++)
        {
            int rank = Flipped ? row : 7 - row;
            int file = Flipped ? 7 - col : col;
            string sq = SquareName(file, rank);
            bool isLight = (file + rank) % 2 == 1;
            bool highlighted = sq == LastMoveFrom || sq == LastMoveTo;
            bool selected = sq == SelectedSquare;
            char piece = board[rank * 8 + file];
            string squareName = sq;

            <div class="eb-sq @(isLight ? "light" : "dark") @(highlighted ? (LastMoveColor == "b" ? "eb-hl-b" : "eb-hl") : "") @(selected ? "eb-sel" : "")"
                 data-eb-sq="@sq" @onclick="() => HandleClick(squareName)">
                @if (piece != default)
                {
                    @if (animMoves.TryGetValue(sq, out var animFrom))
                    {
                        @* Keyed per animation so Blazor recreates the element and the CSS
                           animation replays even when the destination square is reused. *@
                        <img @key="@($"{sq}#{animVersion}")" class="eb-piece eb-anim" style="@AnimStyle(animFrom, sq)"
                             src="@PieceSrc(piece)" alt="@piece" draggable="false" />
                    }
                    else
                    {
                        <img class="eb-piece" src="@PieceSrc(piece)" alt="@piece" draggable="false" />
                    }
                }
                @if (CoordinatesVisible && col == 0)
                {
                    <span class="eb-coord rank">@(rank + 1)</span>
                }
                @if (CoordinatesVisible && row == 7)
                {
                    <span class="eb-coord file">@((char)('a' + file))</span>
                }
            </div>
        }
    }
    @if (HasOverlay)
    {
        @* Overlay in square units: viewBox 0-8, so strokes, heads and text scale with board size. *@
        <svg class="eb-overlay" viewBox="0 0 8 8" xmlns="http://www.w3.org/2000/svg">
            @foreach (var c in Circles ?? Array.Empty<EbCircle>())
            {
                var (cx, cy) = Center(c.Square);
                <circle cx="@F(cx)" cy="@F(cy)" r="@F(c.Size / 2)" fill="@c.Color" opacity="@F(c.Opacity)" />
            }
            @foreach (var a in Arrows ?? Array.Empty<EbArrow>())
            {
                @if (a.Head == "line")
                {
                    var geo = LineGeometry(a);
                    if (geo is var (x1, y1, cx2, cy2, strokeW2))
                    {
                        <g opacity="@F(a.Opacity)">
                            <line x1="@F(x1)" y1="@F(y1)" x2="@F(cx2)" y2="@F(cy2)"
                                  stroke="@a.Color" stroke-width="@F(strokeW2)" stroke-linecap="round" />
                        </g>
                    }
                }
                else
                {
                    var geo = ArrowGeometry(a);
                    if (geo is var (x1, y1, x2, y2, head, strokeW))
                    {
                        <g opacity="@F(a.Opacity)">
                            <line x1="@F(x1)" y1="@F(y1)" x2="@F(x2)" y2="@F(y2)"
                                  stroke="@a.Color" stroke-width="@F(strokeW)" stroke-linecap="round" />
                            <polygon points="@head" fill="@a.Color" />
                        </g>
                    }
                }
            }
        </svg>
        @* Labels are plain HTML, not SVG text: Blazor renders MarkupString content in the HTML
           namespace even inside <svg>, which breaks SVG <text> rendering. HTML chips also give
           predictable font layout. *@
        @foreach (var l in Labels ?? Array.Empty<EbSquareLabel>())
        {
            <div class="eb-label" style="@LabelCellStyle(l.Square)">
                <span class="eb-label-chip" style="@LabelChipStyle(l)">
                    @foreach (var line in SplitLabel(l.Text))
                    {
                        <span class="eb-label-line">@line</span>
                    }
                </span>
            </div>
        }
    }
</div>

@code {
    public const string StartFen = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";

    [Parameter] public string Fen { get; set; } = StartFen;
    /// <summary>Board width in pixels; null fills the parent container (fluid).</summary>
    [Parameter] public int? SizePx { get; set; } = 400;
    [Parameter] public bool Flipped { get; set; }
    /// <summary>true/false forces coordinates on/off; null follows the user's
    /// tournament-board coordinates setting (Settings → Board Theme).</summary>
    [Parameter] public bool? ShowCoordinates { get; set; }
    /// <summary>Coordinate font-size CSS override (appearance-page live preview); null follows the theme.</summary>
    [Parameter] public string CoordinateSizeCss { get; set; }
    /// <summary>Piece scale override, 0.5–1.0 (appearance-page live preview); null follows the theme.</summary>
    [Parameter] public double? PieceScale { get; set; }
    /// <summary>Coordinate color override (appearance-page live preview); null follows the theme,
    /// where empty means auto (opposite square color).</summary>
    [Parameter] public string CoordinateColorCss { get; set; }
    /// <summary>Selection-ring color override (appearance-page live preview); null follows the theme,
    /// where empty means the default green ring.</summary>
    [Parameter] public string SelectionRingColorCss { get; set; }
    // Colors and piece set default to the app-wide board theme (BoardThemeService,
    // user-configurable on the Settings page). Explicit parameters override the theme.
    // The highlight replaces the square color (as the pre-migration CSS did), and the
    // shade depends on which side made the move (LastMoveColor "w"/"b").
    [Parameter] public string PieceSet { get; set; }
    [Parameter] public string LightSquareColor { get; set; }
    [Parameter] public string DarkSquareColor { get; set; }
    [Parameter] public string HighlightColor { get; set; }
    [Parameter] public string HighlightColorBlack { get; set; }
    [Parameter] public string LastMoveColor { get; set; }

    private string EffLight => LightSquareColor ?? ThemeService.Current.LightSquare;
    private string EffDark => DarkSquareColor ?? ThemeService.Current.DarkSquare;
    private string EffHighlight => HighlightColor ?? ThemeService.Current.HighlightWhite;
    private string EffHighlightBlack => HighlightColorBlack ?? ThemeService.Current.HighlightBlack;
    private string EffPieceSet => PieceSet ?? ThemeService.Current.PieceSet;
    [Parameter] public string LastMoveFrom { get; set; }
    [Parameter] public string LastMoveTo { get; set; }
    [Parameter] public string SelectedSquare { get; set; }
    /// <summary>Glide pieces to their destination when the position changes by a single move
    /// (opt-in for interactive boards; also gated by the BoardAnimateMoves user setting).</summary>
    [Parameter] public bool Animate { get; set; }
    [Parameter] public IReadOnlyList<EbArrow> Arrows { get; set; }
    [Parameter] public IReadOnlyList<EbCircle> Circles { get; set; }
    [Parameter] public IReadOnlyList<EbSquareLabel> Labels { get; set; }
    [Parameter] public EventCallback<string> OnSquareClicked { get; set; }

    // Small boards auto-hide coordinates via a container query in the scoped CSS.
    private bool CoordinatesVisible => ShowCoordinates ?? ThemeService.Current.TournamentCoordinates;

    private string RootStyle =>
        (SizePx.HasValue ? $"width:{SizePx}px;" : "width:100%;") +
        $"--eb-light-square:{EffLight};" +
        $"--eb-dark-square:{EffDark};" +
        $"--eb-highlight:{EffHighlight};" +
        $"--eb-highlight-b:{EffHighlightBlack};" +
        $"--eb-coord-size:{CoordinateSizeCss ?? ThemeService.Current.CoordFontCss};" +
        $"--eb-piece-scale:{(PieceScale ?? ThemeService.Current.PieceScale).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)};" +
        // Only emitted when a fixed color is chosen; otherwise the scoped CSS falls back
        // to the auto contrast rule (opposite square color).
        (string.IsNullOrEmpty(EffCoordColor) ? "" : $"--eb-coord-color:{EffCoordColor};") +
        // Selection ring: custom hex gets 65% alpha appended to match the default ring.
        (string.IsNullOrEmpty(EffSelRing) ? "" : $"--eb-sel-ring:{WithAlpha(EffSelRing, "A6")};");

    private string EffCoordColor => CoordinateColorCss ?? ThemeService.Current.CoordColor;
    private string EffSelRing => SelectionRingColorCss ?? ThemeService.Current.SelRingColor;

    // Append a hex alpha only to plain #rrggbb values; anything else (hand-edited
    // rgba()/named color in the settings file) is passed through untouched.
    private static string WithAlpha(string color, string alphaHex) =>
        color.Length == 7 && color[0] == '#' ? color + alphaHex : color;

    private static string SquareName(int file, int rank) => $"{(char)('a' + file)}{rank + 1}";

    private bool HasOverlay =>
        (Arrows?.Count ?? 0) > 0 || (Circles?.Count ?? 0) > 0 || (Labels?.Count ?? 0) > 0;

    // SVG attribute values must be culture-invariant (nb-NO would emit decimal commas).
    private static string F(double v) => v.ToString("0.###", CultureInfo.InvariantCulture);

    /// <summary>Center of a square in overlay units (0-8), respecting board orientation.</summary>
    private (double x, double y) Center(string sq)
    {
        int file = sq[0] - 'a', rank = sq[1] - '1';
        double col = Flipped ? 7 - file : file;
        double row = Flipped ? rank : 7 - rank;
        return (col + 0.5, row + 0.5);
    }

    private string LabelCellStyle(string sq)
    {
        int file = sq[0] - 'a', rank = sq[1] - '1';
        double col = Flipped ? 7 - file : file;
        double row = Flipped ? rank : 7 - rank;
        return $"left:{F(col * 12.5)}%;top:{F(row * 12.5)}%;";
    }

    // Multi-word labels (e.g. "P:15% N:40%") render one word per line inside the chip.
    private static string[] SplitLabel(string text) =>
        (text ?? string.Empty).Split(' ', StringSplitOptions.RemoveEmptyEntries);

    private string LabelChipStyle(EbSquareLabel l)
    {
        string font;
        if (l.FontPx.HasValue)
        {
            // Legacy fixed-pixel font (old .square-overlay / .circle-piece look)
            font = $"{F(l.FontPx.Value)}px";
        }
        else
        {
            // Font in container-query units so it scales in both fixed and fluid mode.
            // Shrink with the longest line and line count so the text always fits
            // (~0.58em average glyph width for a bold sans font).
            double chipCqi = 12.5 * l.SizePct;
            var lines = SplitLabel(l.Text);
            int maxLen = Math.Max(1, lines.Length == 0 ? 1 : lines.Max(s => s.Length));
            int lineCount = Math.Max(1, lines.Length);
            double fontCqi = Math.Min(
                Math.Min(chipCqi * 0.42, chipCqi * 0.85 / (maxLen * 0.58)),
                chipCqi * 0.95 / (lineCount * 1.15));
            font = $"{F(fontCqi)}cqi";
        }

        // FitText: pill that grows with the content instead of a fixed circle, so long
        // values are always enclosed by the background.
        var dims = l.FitText
            ? $"min-width:{F(l.SizePct * 100)}%;width:auto;height:{F(l.SizePct * 100)}%;" +
              "padding:0 .35em;border-radius:999px;box-sizing:border-box;"
            : $"width:{F(l.SizePct * 100)}%;height:{F(l.SizePct * 100)}%;";
        var style = dims +
                    $"background:{l.BgColor};color:{l.TextColor};font-size:{font};opacity:{F(l.Opacity)};";
        if (!string.IsNullOrEmpty(l.BorderCss)) style += $"border:{l.BorderCss};";
        return style;
    }

    private (double x1, double y1, double x2, double y2, string head, double strokeW)? ArrowGeometry(EbArrow a)
    {
        if (string.IsNullOrEmpty(a.From) || string.IsNullOrEmpty(a.To) || a.From == a.To) return null;
        var (x1, y1) = Center(a.From);
        var (tipX, tipY) = Center(a.To);
        double dx = tipX - x1, dy = tipY - y1;
        double len = Math.Sqrt(dx * dx + dy * dy);
        double ux = dx / len, uy = dy / len;

        // 0.17/0.33 match the pre-migration chessboard2 overrides
        // (.arrow-line-a8dce height 17%, .arrow-head-38dfa height 33%).
        // The user's arrow-width setting scales stroke and head together.
        double scale = ThemeService.Current.ArrowWidthScale;
        double strokeW = 0.17 * a.Width * scale;
        double headLen = 0.33 * scale, headW = 0.45 * scale;
        double baseX = tipX - ux * headLen, baseY = tipY - uy * headLen;
        double px = -uy, py = ux;

        string head = $"{F(tipX)},{F(tipY)} " +
                      $"{F(baseX + px * headW / 2)},{F(baseY + py * headW / 2)} " +
                      $"{F(baseX - px * headW / 2)},{F(baseY - py * headW / 2)}";
        return (x1, y1, baseX, baseY, head, strokeW);
    }

    /// <summary>Plain line from the origin toward the destination center. The label chip
    /// renders above the overlay and covers the ending, so the line visually connects
    /// to the badge.</summary>
    private (double x1, double y1, double cx, double cy, double strokeW)? LineGeometry(EbArrow a)
    {
        if (string.IsNullOrEmpty(a.From) || string.IsNullOrEmpty(a.To) || a.From == a.To) return null;
        var (x1, y1) = Center(a.From);
        var (tipX, tipY) = Center(a.To);
        double dx = tipX - x1, dy = tipY - y1;
        double len = Math.Sqrt(dx * dx + dy * dy);
        double ux = dx / len, uy = dy / len;

        double scale = ThemeService.Current.ArrowWidthScale;
        double strokeW = 0.17 * a.Width * scale;
        // Small stand-off (vs the arrowhead's 0.33): close to the destination center
        // without burying the ending under the label chip. Tuned by eye.
        double cx = tipX - ux * 0.18, cy = tipY - uy * 0.18;
        return (x1, y1, cx, cy, strokeW);
    }

    private char[] ParseBoard()
    {
        var b = new char[64];
        var fen = Fen;
        if (string.IsNullOrWhiteSpace(fen)) return b;
        var rows = fen.Split(' ')[0].Split('/');
        if (rows.Length != 8) return b;
        for (int i = 0; i < 8; i++)
        {
            int rank = 7 - i, file = 0;
            foreach (var c in rows[i])
            {
                if (char.IsDigit(c)) file += c - '0';
                else if (file < 8) b[rank * 8 + file++] = c;
            }
        }
        return b;
    }

    // Piece sets follow the folder convention wwwroot/pieces/{set}/wK.svg (or .png).
    // The extension is probed once per set and cached for the app lifetime.
    private static readonly ConcurrentDictionary<string, string> pieceSetExtensions = new();

    private string PieceSrc(char piece)
    {
        var set = EffPieceSet;
        var name = (char.IsUpper(piece) ? "w" : "b") + char.ToUpperInvariant(piece);
        var ext = pieceSetExtensions.GetOrAdd(set, s =>
        {
            var dir = Path.Combine(Env.WebRootPath, "pieces", s);
            return File.Exists(Path.Combine(dir, "wK.svg")) ? "svg" : "png";
        });
        return $"pieces/{set}/{name}.{ext}";
    }

    // ── Move animation ──────────────────────────────────────────────────────
    // The board is declarative (FEN in, grid out), so a move is detected by diffing
    // the previous and new positions. Only single-move transitions animate; anything
    // else (new game, jumping through a move list, orientation flip) snaps.

    private char[] boardCells = new char[64];
    private string prevFen;
    private bool prevFlipped;
    private bool suppressNextAnimation;
    private readonly Dictionary<string, string> animMoves = new(); // to-square -> from-square
    private int animVersion;

    /// <summary>Skip the animation for the next position change — used after drag &amp; drop,
    /// where the piece is already visually at its destination.</summary>
    public void SuppressNextAnimation() => suppressNextAnimation = true;

    protected override void OnParametersSet()
    {
        var newBoard = ParseBoard();
        // Flipping mirrors the whole grid; a pending glide would replay with wrong offsets.
        if (Flipped != prevFlipped) animMoves.Clear();
        if (Fen != prevFen)
        {
            animMoves.Clear();
            if (Animate && SettingsService.Settings.BoardAnimateMoves
                && !suppressNextAnimation && prevFen != null && Flipped == prevFlipped)
            {
                foreach (var (from, to) in DiffSingleMove(boardCells, newBoard))
                    animMoves[to] = from;
                if (animMoves.Count > 0) animVersion++;
            }
            suppressNextAnimation = false;
            prevFen = Fen;
        }
        prevFlipped = Flipped;
        boardCells = newBoard;
    }

    /// <summary>If the two positions differ by exactly one move (incl. capture, promotion,
    /// en passant, castling — and their reverses when stepping back), returns the gliding
    /// pieces as (from, to) squares; otherwise returns an empty list.</summary>
    private static List<(string from, string to)> DiffSingleMove(char[] oldB, char[] newB)
    {
        var moves = new List<(string, string)>();
        var changed = new List<int>();
        for (int i = 0; i < 64; i++)
            if (oldB[i] != newB[i]) changed.Add(i);
        // 2 = move/capture, 3 = en passant, 4 = castling; anything else is not one move.
        if (changed.Count < 2 || changed.Count > 4) return moves;

        var pairs = new List<(int from, int to)>();
        foreach (var s in changed)
        {
            char moved = oldB[s];
            if (moved == default) continue;
            foreach (var d in changed)
            {
                if (d == s || newB[d] == default) continue;
                bool samePiece = newB[d] == moved;
                bool promotion = !samePiece && char.IsUpper(newB[d]) == char.IsUpper(moved)
                                 && char.ToUpperInvariant(moved) == 'P' && (d / 8 == 0 || d / 8 == 7);
                if (samePiece || promotion) pairs.Add((s, d));
            }
        }

        static string Sq(int i) => SquareName(i % 8, i / 8);

        if (pairs.Count == 1 && changed.Count <= 3)
        {
            moves.Add((Sq(pairs[0].from), Sq(pairs[0].to)));
        }
        else if (pairs.Count == 2 && changed.Count == 4)
        {
            // Castling: both pieces glide. Any other 2-pair diff (two independent moves) snaps.
            char a = oldB[pairs[0].from], b = oldB[pairs[1].from];
            var types = (char.ToUpperInvariant(a), char.ToUpperInvariant(b));
            if (char.IsUpper(a) == char.IsUpper(b) && (types == ('K', 'R') || types == ('R', 'K')))
            {
                moves.Add((Sq(pairs[0].from), Sq(pairs[0].to)));
                moves.Add((Sq(pairs[1].from), Sq(pairs[1].to)));
            }
        }
        return moves;
    }

    /// <summary>Start offset of the glide, in percent of one square, in rendered orientation.</summary>
    private string AnimStyle(string from, string to)
    {
        int ff = from[0] - 'a', fr = from[1] - '1';
        int tf = to[0] - 'a', tr = to[1] - '1';
        double dCol = (Flipped ? tf - ff : ff - tf) * 100;
        double dRow = (Flipped ? fr - tr : tr - fr) * 100;
        return $"--eb-dx:{F(dCol)}%;--eb-dy:{F(dRow)}%;";
    }

    protected override void OnInitialized()
    {
        ThemeService.ThemeChanged += OnThemeChanged;
    }

    // Raised from the settings page's circuit; marshal to this component's dispatcher.
    private void OnThemeChanged() => _ = InvokeAsync(StateHasChanged);

    public void Dispose()
    {
        ThemeService.ThemeChanged -= OnThemeChanged;
    }

    private Task HandleClick(string square) =>
        OnSquareClicked.HasDelegate ? OnSquareClicked.InvokeAsync(square) : Task.CompletedTask;
}

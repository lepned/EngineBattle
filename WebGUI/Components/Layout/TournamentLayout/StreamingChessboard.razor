@using WebGUI.Services
@using WebGUI
@implements IAsyncDisposable
@inject IJSRuntime JS
@inject JavaScriptInteropService JsInteropService
@inject NotifierService Notifier
@inject ILogger<StreamingChessboard> Logger

<MudGrid Justify="Justify.Center">
	<MudItem sm=12>
		<div class="mt-3 streaming-board" style="height:100%;" @ref="element"></div>
	</MudItem>

	@if (!String.IsNullOrEmpty(OpeningName))
	{
		<span style=@openingStyle class="mud-text">@OpeningName</span>
	}

	else
	{
		<span style=@openingStyle class="mud-text">@(startPos)</span>
	}

	@* Feed-mode only: a small Copy-FEN control below the board (normal flow, so it scales with the board
	   and needs no overlay positioning). Hidden in the internal /tournament streaming view. *@
	@if (ShowCopyFen)
	{
		<MudItem sm=12 Class="d-flex align-center justify-center px-2 py-1" Style="gap:8px;">
			<code title="@(string.IsNullOrEmpty(fen) ? startPos : fen)"
				  style="font-family:monospace; font-size:0.72rem; opacity:0.7; white-space:nowrap; overflow:hidden; text-overflow:ellipsis; max-width:70%;">@(string.IsNullOrEmpty(fen) ? startPos : fen)</code>
			<button title="Copy FEN to clipboard" @onclick="CopyFen"
					style="flex:0 0 auto; font-size:0.85rem; line-height:1; cursor:pointer; padding:2px 7px; border:1px solid #555; border-radius:4px; background:#2e2e2e; color:#ddd;">@copyFenLabel</button>
		</MudItem>
	}

	@if (ShowMoveList)
	{
		<MudItem Class="pa-2 mb-1" sm=12 md="12" lg="12">
			<div id="moveListDiv" class="scrollable mb-3 ml-3 mr-3 hideScroll moveList" style=@moveListStyle>
				<span class="openingMoves">@OpeningMoves</span>
				<span> </span>
				@if (moveHistoryTokens.Count > 0)
				{
					var openingCount = OpeningSansForDeviation?.Count ?? 0;
					var referenceCount = ReferenceSansForDeviation?.Count ?? 0;
					foreach (var token in moveHistoryTokens)
					{
						if (token.IsSan && firstDeviationSanIndex.HasValue && token.SanIndex == firstDeviationSanIndex.Value)
						{
							var index = token.SanIndex + openingCount;
							if (index >= 0 && index < referenceCount)
							{
								var prevMove = ReferenceSansForDeviation[index];
								<span class="pv-deviation-black">@($"{token.Text} ")</span>
								<span>@($"({prevMove}) ")</span>
							}
							else
							{
								<span>@($"{token.Text} ")</span>
							}
						}

						else 
						{
							<span>@($"{token.Text} ")</span>
						}						
					}
				}
			</div>
		</MudItem>
	}

</MudGrid>


@code {

	[Parameter] public bool ShowMoveList { get; set; } = true;
	[Parameter] public string OpeningName { get; set; }
	[Parameter] public string OpeningMoves { get; set; }
	[Parameter] public int MoveListFontSize { get; set; }
	[Parameter] public int MoveListHeight { get; set; }
	[Parameter] public string MoveHistory { get; set; }
	[Parameter] public IReadOnlyList<string> OpeningSansForDeviation { get; set; } = Array.Empty<string>();
	[Parameter] public IReadOnlyList<string> ReferenceSansForDeviation { get; set; } = Array.Empty<string>();

	private int moveListFontSize = 8;
	private int moveListHeight = 80;
	private string openingStyle = $"font-size:15px";
	private string moveListStyle = "font-size:18px; height: 199px;";
	private string previousMoveHistory;
	private IReadOnlyList<string> previousReferenceSansForDeviation = Array.Empty<string>();
	private IReadOnlyList<string> previousOpeningSansForDeviation = Array.Empty<string>();
	private readonly List<MoveHistoryToken> moveHistoryTokens = new();
	private int? firstDeviationSanIndex;

	private record MoveHistoryToken(string Text, bool IsSan, int SanIndex);

	private static bool IsMoveNumberToken(string token)
		=> !string.IsNullOrWhiteSpace(token) &&
		   token.EndsWith('.') &&
		   int.TryParse(token.TrimEnd('.'), out _);

	private static bool IsResultToken(string token)
		=> token is "1-0" or "0-1" or "1/2-1/2" or "*";

	private void RebuildMoveHistoryTokensAndDeviation()
	{
		moveHistoryTokens.Clear();
		firstDeviationSanIndex = null;

		var moveHistory = MoveHistory ?? string.Empty;
		var tokens = moveHistory.Split(' ', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

		var sanIndex = -1;
		foreach (var token in tokens)
		{
			if (IsMoveNumberToken(token) || IsResultToken(token))
			{
				moveHistoryTokens.Add(new MoveHistoryToken(token, false, -1));
				continue;
			}

			sanIndex++;
			moveHistoryTokens.Add(new MoveHistoryToken(token, true, sanIndex));
		}

		var opening = OpeningSansForDeviation is null ? Array.Empty<string>() : OpeningSansForDeviation.ToArray();
		var reference = ReferenceSansForDeviation is null ? Array.Empty<string>() : ReferenceSansForDeviation.ToArray();
		var deviationIndex = ChessLibrary.GameAnalysis.MoveHistoryDeviation.FirstDeviationIndex(moveHistory, opening, reference);
		if (deviationIndex.HasValue)
			firstDeviationSanIndex = deviationIndex.Value;
	}

	private async Task ScrollToEnd()
	{
		if (chessJSmodule is null)
		{
			return;
		}

		await chessJSmodule.InvokeVoidAsync("scrollDivToEnd", "moveListDiv");
	}

	private bool whiteToMove = true;
	private ThreadSafeBoardState state = new();
	private string fen;
	private ElementReference element;
	private IJSObjectReference chessJSmodule; //my own chessinterop.js
	private string startPos = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
	List<string> replayMoves = new List<string>();
	private DotNetObjectReference<StreamingChessboard> dotNetRef;

	// Feed-mode only (Tournaments.razor passes FeedMode): show a small Copy-FEN control below the board.
	// Kept out of the internal /tournament streaming view so a stream stays uncluttered.
	[Parameter] public bool ShowCopyFen { get; set; }
	private string copyFenLabel = "⧉";

	private async Task CopyFen()
	{
		var toCopy = string.IsNullOrEmpty(fen) ? startPos : fen;
		try { await JS.InvokeVoidAsync("navigator.clipboard.writeText", toCopy); }
		catch { return; }   // clipboard unavailable / circuit disposing
		copyFenLabel = "✓";
		await InvokeAsync(StateHasChanged);
		try { await Task.Delay(1200); } catch { }
		copyFenLabel = "⧉";
		try { await InvokeAsync(StateHasChanged); } catch { }
	}


	[JSInvokable]
	public Task OnBrowserResize()
	{
		StateHasChanged();
		return Task.CompletedTask;
	}

	private async Task PrepareChessboard()
	{
		dotNetRef = DotNetObjectReference.Create(this);
		chessJSmodule = await JsInteropService.ImportModuleAsync(JS);
		await chessJSmodule.InvokeVoidAsync("createChessboard", element);
		await chessJSmodule.InvokeVoidAsync("registerResizeEvent", dotNetRef);
		StateHasChanged();
	}

	private async Task SetPosition(string fen)
	{
		if (chessJSmodule is not null)
		{
			await chessJSmodule.InvokeVoidAsync("setPosition2", element, fen);
		}
	}

	private async Task SetArrowHighlighting(MoveAndFen input)
	{
		if (chessJSmodule is not null)
		{
			await chessJSmodule.InvokeVoidAsync("setArrowHighlighting", element, input.Move.FromSq, input.Move.ToSq, "#9D8989");
		}
	}

	private async Task SetPositionAndMove(MoveAndFen input)
	{
		if (chessJSmodule is null || input is null || input.Move is null || input.Move.LongSan.Length < 4)
		{
			return;
		}
		// Guard rules:
		bool validFrom = !string.IsNullOrEmpty(input.Move.FromSq) && input.Move.FromSq.Length == 2;
		bool validTo = !string.IsNullOrEmpty(input.Move.ToSq) && (input.Move.ToSq.Length == 2);
		bool validFen = !string.IsNullOrEmpty(input.FenAfterMove) && input.FenAfterMove.Length > 4;
		if (!validFrom || !validTo || !validFen)
		{
			Logger.LogWarning("Invalid squares in SetPositionAndMove: From='{From}' To='{To}' LongSan='{LongSan}'",
				input.Move.FromSq, input.Move.ToSq, input.Move?.LongSan);
			return;
		}
		try
		{
			await chessJSmodule.InvokeVoidAsync("setBoardWithSquareHighlighting", element, input.FenAfterMove, input.Move.Color, input.Move.FromSq, input.Move.ToSq, true);
		}
		catch (TaskCanceledException) { /* ignore during teardown */ }
		catch (JSException jsEx)
		{
			Logger.LogWarning(jsEx, "JS error in setBoardWithSquareHighlighting for {From}->{To}", input.Move.FromSq, input.Move.ToSq);
		}
		catch (Exception ex)
		{
			Logger.LogError(ex, "Unexpected error in SetPositionAndMove");
		}
	}

	public async Task OnNewFen(string newFen)
	{
		if (fen != newFen)
		{
			fen = newFen;
			startPos = newFen;
			await SetPosition(fen);
		}
	}

	public async Task OnNotifyMoveAndFen(MoveAndFen input)
	{
		@if (fen != input.FenAfterMove)
		{
			fen = input.FenAfterMove;
			state.Fen = fen;
			state.LoadFen(fen);
			whiteToMove = input.Move.Color == "b";
			await SetPositionAndMove(input);
		}
	}

	private static bool ValidatePV(string pv)
	{
		if (String.IsNullOrEmpty(pv) || pv.Length < 4)
		{
			return false;
		}
		return true;
	}

	public async Task UpdateLastPVMove(string pvMove, string oppPvMove, bool withArrows)
	{
		if (!ValidatePV(pvMove))
		{
			// An empty/blank PV is a legitimate "no PV available" state — e.g. the Ceres live feed
			// carries only the played move, not a PV — so these arrive constantly. Only warn on a
			// genuinely malformed non-empty value; otherwise this floods the console.
			if (!string.IsNullOrWhiteSpace(pvMove))
				Logger.LogWarning($"Invalid PV move received in {nameof(UpdateLastPVMove)}: '{pvMove}'");
			return;
		}
		else if (withArrows && state.LastPV != pvMove)
		{
			state.LastPV = pvMove;
			if (chessJSmodule is not null)
			{
				try
				{
					var (fromSq, toSq) = (pvMove.Substring(0, 2), pvMove.Substring(2, 2));
					if (ValidatePV(oppPvMove))
					{
						var (oppFromSq, oppToSq) = (oppPvMove.Substring(0, 2), oppPvMove.Substring(2, 2));
						var (color, oppColor) = whiteToMove ? ("#cfece0", "#383231") : ("#383231", "#cfece0");

						await chessJSmodule.InvokeVoidAsync("setDoubleArrowHighlighting", element, fromSq, toSq, oppFromSq, oppToSq, color, oppColor);
					}
					else
					{
						await chessJSmodule.InvokeVoidAsync("setArrowHighlighting", element, fromSq, toSq, "#9D8989");
					}
				}
				catch (Exception ex) when (ex is TaskCanceledException or ObjectDisposedException)
				{
				}
			}
		}
		else
		{
			state.LastPV = pvMove;
		}
	}

	public async Task UpdatePonderMoveWithPolicy(string ponderMove, double policy, double frac)
	{
		if (!ValidatePV(ponderMove))
		{
			// Empty/blank ponder is a normal "none available" state (no PV on the feed) — don't warn.
			if (!string.IsNullOrWhiteSpace(ponderMove))
				Logger.LogWarning($"Invalid PV move received: '{ponderMove}'");
			await Task.CompletedTask;
		}
		else if ((state.LastPonderMove != ponderMove && ponderMove == state.LastPV) || state.LastFraction != frac)
		{
			if (chessJSmodule is not null)
			{
				var (fromSq, toSq) = (ponderMove.Substring(0, 2), ponderMove.Substring(2, 2));
				var text = $"P:{(policy / 100):P0} N:{frac:P0}";
				var (_, color) = state.GetPieceAndColorOnSquare(toSq);

				var noPiece = string.IsNullOrEmpty(color);
				var textColor = noPiece ? "Black" : color == "w" ? "white" : "black"; //: "yellow";
				var bgColor = noPiece ? "transparent" : color == "w" ? "black" : "white";
				// if (!noPiece)
				// {
				//   Console.WriteLine($"Is piece on square {toSq} P: {piece} Color: {color}");
				// }
				state.LastPonderMove = ponderMove;
				state.LastFraction = frac;
				await chessJSmodule.InvokeVoidAsync("setPonderArrowHighlightingWithLabel", element, text, fromSq, toSq, "#9D8989", textColor, bgColor);
			}
		}
	}

	public async Task UpdateMoveHistory(string moveHistory)
	{
		MoveHistory = moveHistory;
		StateHasChanged();
		await Task.Delay(200);
		await ScrollToEnd();

	}

	protected override async Task OnParametersSetAsync()
	{
		var referenceChanged = !ReferenceEquals(previousReferenceSansForDeviation, ReferenceSansForDeviation);
		var openingChanged = !ReferenceEquals(previousOpeningSansForDeviation, OpeningSansForDeviation);
		if (MoveHistory != previousMoveHistory || referenceChanged || openingChanged)
		{
			previousMoveHistory = MoveHistory;
			previousReferenceSansForDeviation = ReferenceSansForDeviation;
			previousOpeningSansForDeviation = OpeningSansForDeviation;
			RebuildMoveHistoryTokensAndDeviation();
			if (chessJSmodule is not null)
			{
				await ScrollToEnd();
			}
		}
	}

	protected override async Task OnAfterRenderAsync(bool firstRender)
	{
		if (firstRender)
		{
			await PrepareChessboard();
		}
		if (MoveListFontSize > 0 && MoveListFontSize != moveListFontSize)
		{
			moveListFontSize = MoveListFontSize;
			moveListStyle = $"font-size:{moveListFontSize}px; height: {MoveListHeight}px;";
			openingStyle = $"font-size:{moveListFontSize}px";
			StateHasChanged();
		}

		if (MoveListHeight > 0 && MoveListHeight != moveListHeight)
		{
			moveListHeight = MoveListHeight;
			moveListStyle = $"font-size:{moveListFontSize}px; height: {MoveListHeight}px;";
			StateHasChanged();
		}
	}

	private async Task OnFullScreenRequested(bool isFullScreen)
	{
		await Task.Delay(300);
		await chessJSmodule.InvokeVoidAsync("resizeChessboard2", element);
		StateHasChanged();
	}

	protected override void OnInitialized()
	{
		Notifier.IsFullScreenRequested += OnFullScreenRequested;
		fen = startPos;
	}

	async ValueTask IAsyncDisposable.DisposeAsync()
	{
		Dispose();
		await ValueTask.CompletedTask;
	}

	public void Dispose()
	{
		Notifier.IsFullScreenRequested -= OnFullScreenRequested;
	}
}

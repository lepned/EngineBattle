@* What this tournament is, in the shape a viewer reads it: name and format on one line,
   the setup as a sentence. Replaces four bullets in a MudPaper where the format, the
   openings and both adjudication rules all had the same weight.

   The win and draw rules are deliberately not here — TournamentBanner carries them, next
   to the counters that run against them, which is where they mean something. *@

<div class="ts" style="@FontVars">
    <div class="ts-head">
        <span class="ts-name">@Name</span>
        @if (!string.IsNullOrWhiteSpace(Mode))
        {
            <span class="ts-badge">
                @Mode
                @if (!string.IsNullOrWhiteSpace(Pairing))
                {
                    <span class="ts-badge-sep">·</span>
                    @Pairing
                }
            </span>
        }
    </div>

    @* Two lines, not one joined by a separator: the description is what the tournament is
       for, the setup is how it is configured, and running them together made a sentence
       whose halves answered different questions. *@
    @if (!string.IsNullOrWhiteSpace(Description))
    {
        <p class="ts-desc">@Description</p>
    }
    @if (!string.IsNullOrWhiteSpace(Setup))
    {
        <p class="ts-setup">@Setup</p>
    }
</div>

@code {
    [Parameter] public string Name { get; set; }
    /// <summary>Format, e.g. "1-Gauntlet" or "6-player RR".</summary>
    [Parameter] public string Mode { get; set; }
    /// <summary>"Double" or "Single" — whether each opening is played both ways.</summary>
    [Parameter] public string Pairing { get; set; }
    [Parameter] public string Description { get; set; }
    /// <summary>Rounds, games and openings as one sentence.</summary>
    [Parameter] public string Setup { get; set; }
    [Parameter] public int FontSize { get; set; }

    private string FontVars => $"--ts-font:{(FontSize > 0 ? FontSize : 14)}px";
}

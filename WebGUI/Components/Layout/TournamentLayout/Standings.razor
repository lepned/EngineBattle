@using MudBlazor
@using WebGUI.Services
@using System.Timers
@implements IDisposable
@inject IJSRuntime JS
@inject JavaScriptInteropService JsInteropService
@inject ILogger<Standings> Logger

@inject NotifierService notify

<div class="standings-container eb-fit eb-g-standings"
     style="--eb-font-max: @(FontSize > 0 ? Ceiling() : "1rem");
            --eb-rows: @ScoreTable.Count;
            --eb-box-h: @(Height > 0 ? $"{Height}px" : "9999px")">
    <div class="header">
        <span class="header-text">Standings</span>
    </div>
    <div class="standings-table-wrapper" style="max-height: @(Height > 0 ? $"{Height}px" : "20vh"); overflow-y: auto;" id="standingsDiv">

        <table class="custom-table">
            <thead>
                <tr class="header-row">
                    <th class="header-cell">Player</th>
                    <th class="header-cell">Points</th>
                    <th class="header-cell">EFF%</th>
                    <th class="header-cell center">ELO (±)</th>
                    <th class="header-cell center">W-D-L</th>
                    <th class="header-cell">@(ShowNPM ? "NPM" : "Speed")</th>
                </tr>
            </thead>
            <tbody>
                @{ var scoreTable = ScoreTable.ToArray(); }
                @foreach (var context in scoreTable)
                {
                    <tr class="data-row @(context.Challenger ? "challenger" : "")">
                        <td class="data-cell name" title="@context.Player">@context.Player</td>
                        <td class="data-cell">@FormatPoints(context)</td>
                        <td class="data-cell">@FormatPerf(context)</td>
                        <td class="data-cell center">@FormatEloWithError(context, context.Challenger, scoreTable.Length == 2 && Array.IndexOf(scoreTable, context) == 0)</td>
                        <td class="data-cell center">@context.Win-@context.Draw-@context.Loss</td>
                        <td class="data-cell">
                            @if (ShowNPM)
                            {
                                @GameAnalysis.Formatting.formatNPM(context.AvgNPM)
                            }
                            else
                            {
                                @GameAnalysis.Formatting.formatNPS(context.MedSpeed)
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@code {

    [Parameter]
    public List<PlayerResult> ScoreTable { get; set; } = new();

    [Parameter]
    public int FontSize { get; set; }

    /// <summary>
    /// How much of the configured size the table may use, 0.6-1. The page measures how far the
    /// table overflows its column - the headings no longer wrap, so it can - and hands the
    /// answer back; 1 means it fits.
    /// </summary>
    [Parameter]
    public double WidthFit { get; set; } = 1.0;

    /// The configured size after that measurement, with a dot whatever the locale.
    private string Ceiling() =>
        (FontSize * WidthFit).ToString("0.##", System.Globalization.CultureInfo.InvariantCulture) + "px";

    [Parameter]
    public bool ShowNPM { get; set; }

    [Parameter]
    public int Height { get; set; }

    [Parameter]
    public int CycleSeconds { get; set; } = 20; // Default 20 seconds

    [Parameter]
    public bool ShouldCycle { get; set; }

    private int fontSize = 6;
    private Timer cycleTimer;
    private int activeTableIndex = 0;
    private int cycleSeconds = 20;
    private IJSObjectReference chessJSmodule; //my own chessinterop.js

    private async Task SafeInvokeAsync(string identifier, params object[] args)
    {
        try
        {
            await chessJSmodule.InvokeVoidAsync(identifier, args);
        }
        catch (JSException jsEx) when (jsEx.Message.Contains("Cannot set properties of undefined"))
        {
            // Historic guard from the chessboard2 era (animation timing race) - harmless to keep
            Console.WriteLine($"Suppressed known animation error in {identifier}: {jsEx.Message}");
        }
        catch (JSException jsEx)
        {
            // Log other JS errors for debugging
            Logger.LogError($"JS error in {identifier}: {jsEx.Message}");
        }
        catch (TaskCanceledException tcEx)
        {
            // Task was canceled - this happens when the circuit is busy or timing out
            Logger.LogWarning($"JS interop task canceled in {identifier}: {tcEx.Message}");
        }
        catch (OperationCanceledException ocEx)
        {
            // Operation was canceled
            Logger.LogWarning($"JS interop operation canceled in {identifier}: {ocEx.Message}");
        }
        catch (Exception ex)
        {
            // Log any other unexpected exceptions
            Logger.LogError($"Unexpected error in {identifier}: {ex.GetType().Name} - {ex.Message}");
        }
    }
    private async Task ScrollToEnd()
    {
        await SafeInvokeAsync("scrollDivToEnd", "standingsDiv");
    }

    private async Task ScrollToTop()
    {
        await SafeInvokeAsync("scrollDivToTop", "standingsDiv");
    }

    string CheckForNanAndInfinity(double value, bool percentage)
    {
        //if positive infinity return the + infinity symbol
        if (double.IsPositiveInfinity(value))
        {
            return "∞";
        }

        //if negative infinity return the - infinity symbol
        if (double.IsNegativeInfinity(value))
        {
            return "∞";
        }

        //if NaN return the three dashes
        if (double.IsNaN(value))
        {
            return "---";
        }
        if (percentage)
        {
            return value.ToString("P0");
        }
        return value.ToString("F0");
    }

    private string FormatEloWithError(PlayerResult res, bool isChallenger, bool onlyTwoPlayersAndTopRow)
    {
        if (res.Played == 0)
        {
            return "---";
        }
        if (onlyTwoPlayersAndTopRow)
        {
            return "0.0";
        }

        var elo = CheckForNanAndInfinity(res.Elo, false);
        var pos = RuntimeUtilities.ConsoleUtils.positiveInfinitySymbol;
        var neg = RuntimeUtilities.ConsoleUtils.negativeInfinitySymbol;
        if (elo == pos || elo == neg)
        {
            return elo;
        }
        var error = CheckForNanAndInfinity(res.Error, false);
        if (isChallenger)
        {
            return $"{elo} (---)";
        }
        var ret = $"{elo} ({error})";
        return ret;
    }

    private string FormatPerf(PlayerResult res)
    {
        if (res.Played == 0)
        {
            return "---";
        }
        var ratio = (res.Points / (double)res.Played);
        var percentage = CheckForNanAndInfinity(ratio, true);
        return percentage;
    }

    private string FormatPoints(PlayerResult res)
    {
        var msg = $"{res.Points}/{res.Played}";
        return msg;
    }


    private async Task DoScroll()
    {
        if (!ShouldCycle) return;

        try
        {
            if (activeTableIndex == 1)
            {
                await ScrollToEnd();
            }
            else
            {
                await ScrollToTop();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError($"Error in DoScroll: {ex.GetType().Name} - {ex.Message}");
        }
    }

    protected override void OnInitialized()
    {
        if (ShouldCycle && CycleSeconds > 0)
        {
            cycleTimer = new Timer(CycleSeconds * 1000);
            cycleTimer.Elapsed += async (sender, args) =>
            {
                activeTableIndex = (activeTableIndex + 1) % 2;
                await InvokeAsync(DoScroll);
            };
            cycleTimer.Start();
        }
        base.OnInitialized();
    }

    protected override void OnParametersSet()
    {
        if (ShouldCycle && CycleSeconds > 0 && CycleSeconds != cycleSeconds)
        {
            cycleSeconds = CycleSeconds;
            Dispose();
            OnInitialized();
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            chessJSmodule = await JsInteropService.ImportModuleAsync(JS);
        }
        if (FontSize > 0 && FontSize != fontSize)
        {
            fontSize = FontSize;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        cycleTimer?.Dispose();
    }

}

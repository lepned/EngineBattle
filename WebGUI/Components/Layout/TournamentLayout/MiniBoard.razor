@* Lightweight, dependency-free chessboard rendered from a FEN string (Unicode glyphs, no JS).
   Used for multi-game grid tiles where many small boards must render cheaply. *@

<div class="mini-board" style="width:@(Size)px;height:@(Size)px;">
    @{
        var squares = ParseFen(Fen);
        var pieceFont = (int)(Size * 0.82 / 8);
    }
    @for (int rank = 7; rank >= 0; rank--)
    {
        for (int file = 0; file < 8; file++)
        {
            var idx = rank * 8 + file;
            var piece = squares[idx];
            var isLight = (rank + file) % 2 == 1;
            var sqName = $"{(char)('a' + file)}{rank + 1}";
            var isHi = sqName == FromSq || sqName == ToSq;
            var cls = "mb-sq" + (isLight ? " light" : " dark") + (isHi ? " hi" : "");
            <div class="@cls">
                @if (piece != '\0')
                {
                    <span class="mb-pc @(char.IsUpper(piece) ? "w" : "b")" style="font-size:@(pieceFont)px">@Glyph(piece)</span>
                }
            </div>
        }
    }
</div>

@code {
    [Parameter] public string Fen { get; set; } = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
    [Parameter] public int Size { get; set; } = 160;
    [Parameter] public string FromSq { get; set; }
    [Parameter] public string ToSq { get; set; }

    // squares[rank*8 + file], rank 0 = rank 1 (a1 = index 0). '\0' = empty.
    private static char[] ParseFen(string fen)
    {
        var board = new char[64];
        if (string.IsNullOrWhiteSpace(fen)) return board;
        var boardPart = fen.Split(' ')[0];
        var ranks = boardPart.Split('/');
        if (ranks.Length != 8) return board;
        // FEN lists rank 8 first
        for (int r = 0; r < 8; r++)
        {
            var rankStr = ranks[r];
            int file = 0;
            int boardRank = 7 - r; // rank 8 -> index rank 7
            foreach (var c in rankStr)
            {
                if (char.IsDigit(c)) { file += c - '0'; }
                else { if (file < 8) board[boardRank * 8 + file] = c; file++; }
            }
        }
        return board;
    }

    private static string Glyph(char piece) => char.ToLowerInvariant(piece) switch
    {
        'k' => "♚", // solid glyphs for both colors; colored via CSS
        'q' => "♛",
        'r' => "♜",
        'b' => "♝",
        'n' => "♞",
        'p' => "♟",
        _ => ""
    };
}

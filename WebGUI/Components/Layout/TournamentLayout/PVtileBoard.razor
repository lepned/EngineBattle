@* Single board for a multi-game grid tile. Native EbChessboard, parameter-driven, no move
   list, no JS. One instance per game (key by gameId in the grid). *@

@using WebGUI.Components.Layout.ChessboardLayout

<EbChessboard Fen="@(string.IsNullOrEmpty(Fen) ? StartPos : Fen)"
              SizePx="@Size"
              ShowCoordinates="false"
              LastMoveFrom="@FromSq"
              LastMoveTo="@ToSq" />

@code {
    private const string StartPos = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";

    [Parameter] public string Fen { get; set; } = StartPos;
    [Parameter] public string Color { get; set; } = "w";   // kept for API compatibility; highlight color is uniform
    [Parameter] public string FromSq { get; set; } = "";
    [Parameter] public string ToSq { get; set; } = "";
    [Parameter] public int Size { get; set; } = 190;
}

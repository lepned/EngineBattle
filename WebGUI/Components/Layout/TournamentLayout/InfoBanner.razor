@using System.Linq

@* The three sizes below are all relative to one token, so the banner takes the user's nudge
   like every other region and the arithmetic that used to run in C# now runs in CSS. *@
<MudItem Class="no-scroll ml-5 mr-5 mt-1 eb-scale eb-g-banner" Style=@FontToken>

    @* One grid for both rows: each row is a subgrid of the same column tracks, so a header
       sits over its value whatever the content - two flex rows sized each column by its own text. *@
    <div class="infoBannerGrid mr-3" style="grid-template-columns: @Columns;">
        <div class="infoBanner">
            <div style=@FontHeader class="ml-1"> Hardware </div>
            <div style=@FontHeader> @(ShowGpu ? "GPU" : "") </div>
            <div style=@FontHeader> Time control </div>
            <div style=@FontHeader> Game </div>
            <div style=@FontHeader> Round </div>
            <div style=@FontHeader> 50m </div>
            <div style=@FontHeader> R3 </div>
            <div style=@FontHeader> Draw </div>
            @if (Info != null && Info.UseTBAdj)
            {
                <div style=@FontHeader> TB </div>
            }
            @if (Info != null && Info.UseDevCounter)
            {
                <div style=@FontHeader> Dev </div>
            }
            <div style=@FontHeader> Result </div>
            <div style=@FontHeader>
                <div style="display:flex; align-items:center; justify-content:left;">
                    <span style="line-height:1;">⚔</span>
                    <span style="margin-left:6px;">H2H</span>
                </div>
            </div>
            <div style=@FontHeader> Time left </div>
            <div style=@FontHeader> Ends (UTC) </div>
        </div>

        <div class="infoBannerContent">
            <div style=@FontNormal class="ml-1">@Info?.Hardware </div>
            <div style=@FontNormal>
                @if (ShowGpu)
                {
                    <GpuTemp />
                }
            </div>
            <div style=@FontNormal> @Info?.TCText </div>
            <div style=@FontNormal> @Info?.Game </div>
            <div style=@FontNormal> @Info?.Round </div>
            <div style=@FontNormal> @move50 </div>
            <div style=@FontNormal> @R3 </div>
            <div style=@FontNormal> @(DrawP < 0 ? "off" : $"{DrawP}p") </div>
            @if (Info != null && Info.UseTBAdj)
            {
                <div style=@FontNormal> @TB </div>
            }
            @if (Info != null && Info.UseDevCounter)
            {
                <div style=@FontNormal> @Info.DevCounter </div>
            }
            <div style=@FontNormal class="pl-1"> @Info?.ResultTxt </div>
            <div style=@FontNormal>
                <div style="display:flex; align-items:center; justify-content:left;">
                    @for (int i = 0; i < H2HGroups.Length; i++)
                    {
                        <span style="@($"display:inline-block; text-align:center; min-width:{H2HMaxDigits}ch; {FontNormal} line-height:1;")">@H2HGroups[i]</span>
                        if (i < H2HGroups.Length - 1)
                        {
                            <span style="margin:0 4px;">-</span>
                        }
                    }
                </div>
            </div>
            <div style=@FontNormal> @Info?.TimeLeftTxt </div>
            <div style=@FontNormal> @Info?.TournamentEndsTxt </div>
        </div>
    </div>
</MudItem>

@code {

    [Parameter]
    public int Move50 { get; set; }

    [Parameter]
    public int R3 { get; set; }

    [Parameter]
    public int DrawP { get; set; }

    [Parameter]
    public int TB { get; set; }

    [Parameter]
    public int FontSize { get; set; }

    [Parameter]
    public InfoBannerInfo Info { get; set; }

    /// <summary>The GPU temperature in the empty column after Hardware.</summary>
    [Parameter]
    public bool ShowGpu { get; set; }

    // Constants now: the number they scale from arrives as --font-size, which .eb-scale
    // computes from the ceiling below and the user's nudge. The caps stay where they were -
    // this banner is one row across the whole page and cannot grow without wrapping.
    private const string FontHeader = "font-size: calc(var(--font-size, 14px) + 1px);";
    private const string FontNormal = "font-size: min(21px, calc(var(--font-size, 14px) - 1px));";
    /// <summary>
    /// How much of the configured size the banner may use, 0.5-1. The page measures how far the
    /// strip overflows its width and hands the answer back; 1 means it fits.
    /// </summary>
    [Parameter]
    public double WidthFit { get; set; } = 1.0;

    private string FontToken =>
        "--eb-font-max: "
        + ((FontSize > 0 ? FontSize : 14) * WidthFit)
            .ToString("0.##", System.Globalization.CultureInfo.InvariantCulture)
        + "px;";
    /// The column widths, in the proportions the lg sizes used to give; a column never gets
    /// narrower than its widest text, the page's width fit shrinks the font instead.
    private string Columns
    {
        get
        {
            var cols = new List<int> { 5, 1, 2, 1, 1, 1, 1, 1 };
            if (Info != null && Info.UseTBAdj) cols.Add(1);
            if (Info != null && Info.UseDevCounter) cols.Add(1);
            cols.AddRange([2, 2, 2, 3]);
            return string.Join(" ", cols.Select(c => $"{c}fr"));
        }
    }

    private string move50 => $"{Move50 / 2}.{Move50 % 2}"; //CalcMove50();

    // computed H2H helper values
    private string[] H2HGroups
    {
        get
        {
            var dummyRaw = string.Empty;
            var raw = (Info?.HeadToHead ?? dummyRaw).Trim();
            var parts = raw.Split('-', StringSplitOptions.RemoveEmptyEntries).Select(p => p.Trim()).ToArray();
            if (string.IsNullOrEmpty(raw) || parts.Length != 3)
            {                
                return Array.Empty<string>();
            }
            return parts;
        }
    }

    private int H2HMaxDigits => Math.Max(1, H2HGroups.Max(g => g.Length));

}
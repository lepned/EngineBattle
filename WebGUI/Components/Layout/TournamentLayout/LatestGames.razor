@using MudBlazor
@using WebGUI.Services

@* The ceiling, with no row clamp. This list is the NEXT twenty, not a table you have to see
   all of: the clamp would divide the box by twenty and land on the floor, so you would get all
   twenty at 10px instead of the next seven at the size the file asks for. Reading the next few
   is the job, and the rest clips. Standings and the crosstable keep the clamp because there
   every row counts. *@
<div class="pairings-container eb-scale eb-g-latest"
     style="--eb-font-max: @(FontSize > 0 ? $"{FontSize}px" : "1rem");
            --max-height: @(tableHeight > 0 ? $"{tableHeight}px" : "auto");">
  <div class="header">
    <span class="header-text">Latest games@(HeaderSuffix)</span>
  </div>
  <div class="table-wrapper">
    <table class="custom-table">
      <thead>
        <tr class="header-row">
          <th class="header-cell">White</th>
          <th class="header-cell">Black</th>
          <th class="header-cell">M#</th>
          <th class="header-cell">Result</th>
          <th class="header-cell">Reason</th>
          <th class="header-cell">Time</th>
        </tr>
      </thead>
      <tbody>
        @{ var results = Results.ToArray(); }
        @if (results.Length > 0)
        {
          foreach (var context in results)
          {
            <tr class="data-row">
              <td class="data-cell name" title="@context.Player1">@context.Player1</td>
              <td class="data-cell name" title="@context.Player2">@context.Player2</td>
              <td class="data-cell">@context.Moves</td>
              <td class="data-cell">@context.Result</td>
              <td class="data-cell">@context.Reason</td>
              <td class="data-cell">@(GameAnalysis.Formatting.formatMoveTime(context.GameTime))</td>
            </tr>
          }
        }
        else
        {
          <tr class="data-row">
            <td class="data-cell" colspan="6">No games available</td>
          </tr>
        }
      </tbody>
    </table>
  </div>
</div>

@code {

  [Parameter]
  public List<Result> Results { get; set; } = new();

  [Parameter]
  public int FontSize { get; set; }

  [Parameter]
  public int TableHeight { get; set; }

  [Parameter]
  public string HeaderSuffix { get; set; } = "";

  private int fontSize = 12;
  private int tableHeight = 0;

  protected override void OnAfterRender(bool firstRender)
  {
    if (FontSize > 0 && FontSize != fontSize)
    {
      fontSize = FontSize;
      StateHasChanged();
    }    

    base.OnAfterRender(firstRender);
  }

  protected override void OnParametersSet()
  {
    if (TableHeight > 0 && TableHeight != tableHeight)
    {      
      tableHeight = TableHeight;
      StateHasChanged();
    }
    base.OnParametersSet();
  }

}

@implements IDisposable
@using System.Timers

@* The id is what the page measures the slack under; the two branches below are mutually
   exclusive, so only one of these ever exists at a time.

   The height is set here, on the box, rather than left to whichever table happens to be inside
   it. Without it the box is as tall as its content, so the page measured a different thing
   depending on where the cycle had got to - starting a run while Latest Games was showing
   measured an empty "No games available" table and sized the box for that. *@
<div class="table-container" id="pairingsBox"
     style="@(tableHeight > 0 ? $"height:{tableHeight}px;" : "")">

  @if (activeTableIndex == 0)
  {
    <div class="table-wrapper active">
      <LatestGames FontSize=@fontSizeLatestGames Results="@Results" TableHeight="@tableHeight" HeaderSuffix="@HeaderSuffix" />
    </div>
  }
  else
  {
    <div class="table-wrapper">
      <Pairings FontSize=@fontSizePairing PairingList="@Pairings" TableHeight="@tableHeight" HeaderSuffix="@HeaderSuffix" />
    </div>
  }
</div>

@code {
  private Timer cycleTimer;
  private int activeTableIndex = 1;

  [Parameter]
  public List<Result> Results { get; set; } = new();

  [Parameter]
  public List<Pairing> Pairings { get; set; } = new();

  [Parameter]
  public int FontSizePairing { get; set; } = 15;

  [Parameter]
  public int FontSizeLatestGames { get; set; } = 15;

  [Parameter]
  public int CycleSeconds { get; set; } = 20; // Default 30 seconds

  [Parameter]
  public int TableHeight { get; set; }

  [Parameter]
  public string HeaderSuffix { get; set; } = "";

  private int tableHeight = 0;
  private int fontSizePairing = 12;
  private int fontSizeLatestGames = 12;
  private int cycleSeconds = 20;

  protected override void OnInitialized()
  {
    cycleTimer = new Timer(CycleSeconds * 1000);
    cycleTimer.Elapsed += async (sender, args) =>
    {
      activeTableIndex = (activeTableIndex + 1) % 2;
      await InvokeAsync(StateHasChanged);
    };
    cycleTimer.Start();
    base.OnInitialized();
  }

  protected override void OnParametersSet()
  {
    if (FontSizePairing > 0 && FontSizePairing != fontSizePairing)
    {
      fontSizePairing = FontSizePairing;
      StateHasChanged();
    }

    if (FontSizeLatestGames > 0 && FontSizeLatestGames != fontSizeLatestGames)
    {
      fontSizeLatestGames = FontSizeLatestGames;
      StateHasChanged();
    }

    // Zero is meaningful: the page uses it to collapse this table when the layout has no room
    // for it. Anything between 1 and 5 is a transient measurement, not an instruction.
    if (TableHeight != tableHeight && (TableHeight == 0 || TableHeight > 5))
    {
      tableHeight = TableHeight;
      StateHasChanged();
    }

    if (CycleSeconds > 0 && CycleSeconds != cycleSeconds)
    {
      cycleSeconds = CycleSeconds;
      Dispose();
      OnInitialized();
    }
    base.OnParametersSet();
  }

  public void Dispose()
  {
    cycleTimer?.Dispose();
  }
}
@using WebGUI.Components.Layout.ChessboardLayout


<div class="pv-board-container @GetContainerSizeClass()">
	<div class="pv-board left-board @GetBoardSizeClass()">
		<EbChessboard Fen="@whiteFen" SizePx="null"
					  LastMoveFrom="@whiteFrom" LastMoveTo="@whiteTo" LastMoveColor="@whiteMoveColor" />
	</div>
	<div class="pv-board right-board @GetBoardSizeClass()">
		<EbChessboard Fen="@blackFen" SizePx="null"
					  LastMoveFrom="@blackFrom" LastMoveTo="@blackTo" LastMoveColor="@blackMoveColor" />
	</div>
</div>


@code {

	[Parameter]
	public string BoardSize { get; set; }

	[Parameter]
	public MoveAndFen WhiteMoveAndFen { get; set; }

	[Parameter]
	public MoveAndFen BlackMoveAndFen { get; set; }

	[Parameter]
	public bool IsWhite { get; set; }

	[Parameter]
	public bool IsDeviation { get; set; }

	private string whiteFen = EbChessboard.StartFen;
	private string whiteFrom;
	private string whiteTo;
	private string whiteMoveColor;
	private string blackFen = EbChessboard.StartFen;
	private string blackFrom;
	private string blackTo;
	private string blackMoveColor;
	private string currentBoardSize = "medium"; // "small", "medium", "large"

	// Last fen received via parameters. Parameters only win when they actually change;
	// otherwise a parent re-render would overwrite state set via SetPVMoveWithAnnotation
	// (opening replay runs before the first engine move updates the parameters).
	private string lastWhiteParamFen;
	private string lastBlackParamFen;

	private string GetBoardSizeClass() => $"board-{currentBoardSize.ToLowerInvariant()}";
	private string GetContainerSizeClass() => $"container-{currentBoardSize.ToLowerInvariant()}";

	//called during opening replay, which runs off the dispatcher thread -
	//render must be marshalled via InvokeAsync
	public Task SetPVMoveWithAnnotation(MoveAndFen input, bool clear)
	{
		if (input?.FenAfterMove is { Length: > 0 })
		{
			whiteFen = blackFen = input.FenAfterMove;
			whiteFrom = blackFrom = input.Move.FromSq;
			whiteTo = blackTo = input.Move.ToSq;
			whiteMoveColor = blackMoveColor = input.Move.Color;
			return InvokeAsync(StateHasChanged);
		}
		return Task.CompletedTask;
	}

	protected override void OnParametersSet()
	{
		if (WhiteMoveAndFen?.FenAfterMove is { Length: > 0 } wf && wf != lastWhiteParamFen)
		{
			lastWhiteParamFen = wf;
			whiteFen = wf;
			whiteFrom = WhiteMoveAndFen.Move.FromSq;
			whiteTo = WhiteMoveAndFen.Move.ToSq;
			whiteMoveColor = WhiteMoveAndFen.Move.Color;
		}
		if (BlackMoveAndFen?.FenAfterMove is { Length: > 0 } bf && bf != lastBlackParamFen)
		{
			lastBlackParamFen = bf;
			blackFen = bf;
			blackFrom = BlackMoveAndFen.Move.FromSq;
			blackTo = BlackMoveAndFen.Move.ToSq;
			blackMoveColor = BlackMoveAndFen.Move.Color;
		}
		if (!string.IsNullOrEmpty(BoardSize) && BoardSize != currentBoardSize)
		{
			currentBoardSize = BoardSize;
		}
	}
}

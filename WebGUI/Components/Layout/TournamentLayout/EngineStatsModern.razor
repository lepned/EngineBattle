@using WebGUI.Components.Layout.ChessboardLayout

@* The size arrives as a token like everywhere else; the stylesheet spends it. Everything
   inside this box is sized in em, so this one value still drives the whole panel.

   The wrapper exists to BE the container. A container query never matches the container element
   itself, so the rules that used to sit on .engine-stats-container - which declared the
   container - could never fire, and the panel kept its configured size however narrow its
   column got. With the declaration one level out, the panel is a descendant and can be sized
   from the width it actually has.

   --eb-panel-k is the configured size divided by the width that size was chosen for, so the
   middle term of the clamp reaches the ceiling at exactly that width and falls away below it. *@
<div class="engine-stats-fit">
<div class="engine-stats-container eb-scale eb-g-enginepanel"
     style="--eb-font-max: @(FontSize > 0 ? $"{FontSize}px" : "1rem"); --eb-panel-k: @PanelWidthFactor; @MainLogoVars">
  <!-- Row 1: Engine Headers & Main Logo -->
  <div class="engine-header-cell @(Engine1ToMove ? "active" : "")">
    <span class="side-label">White</span>
    <div class="engine-logo-wrapper" style="@(LogoWrapperStyle) overflow:hidden;">
      <img src="@Engine1Logo" alt="@Engine1Name" title="@engine1Tooltip" class="engine-logo" style="max-width:100%;max-height:100%;object-fit:contain;" />
    </div>
    <h3 class="engine-name" title="@Engine1Name">@Engine1Name</h3>
    <span class="engine-version">@Engine1Version</span>
  </div>
  @* No inline size here. The stylesheet already scales this logo with the container it sits
     in - five breakpoints and a cqw term - and an inline max-width beat every one of them, so
     the logo stayed 300px wide in a 360px panel and the two engine cells beside it were left
     with 30px each. The stylesheet's own ceiling is now 240x130 - LOWER than the 300x200 that
     inline style set, so restoring it would not merely duplicate the cap, it would lift it, and
     an inline style beats every @container rule in the scoped sheet. *@
  <div class="main-logo-wrapper" style="overflow:hidden;max-width:100%;">
    <img src="@MainLogo" alt="EngineBattle" class="main-logo" />
    <span class="powered-by">Powered by EngineBattle</span>
    <span class="author">Lars E. Pedersen</span>
  </div>
  <div class="engine-header-cell @(Engine1ToMove ? "" : "active")">
    <span class="side-label">Black</span>
    <div class="engine-logo-wrapper" style="@(LogoWrapperStyle) overflow:hidden;">
      <img src="@Engine2Logo" alt="@Engine2Name" title="@engine2Tooltip" class="engine-logo" style="max-width:100%;max-height:100%;object-fit:contain;" />
    </div>
    <h3 class="engine-name" title="@Engine2Name">@Engine2Name</h3>
    <span class="engine-version">@Engine2Version</span>
  </div>

  <!-- Row 2: Evaluation -->
  <div class="eval @(Engine1ToMove ? "active-eval" : "")">@Engine1.Eval</div>
  <div class="label-cell header">Evaluation</div>
  <div class="eval @(Engine1ToMove ? "" : "active-eval")">@Engine2.Eval</div>

  <!-- Row 3: Depth/SD -->
  <div class="stat-cell">@Engine1.Depth/@Engine1.SD</div>
  <div class="label-cell">Depth/SD</div>
  <div class="stat-cell">@Engine2.Depth/@Engine2.SD</div>

  <!-- Row 4: Speed -->
  <div class="stat-cell">@(Engine1.EPS > 0 ? GameAnalysis.Formatting.formatNPS(Engine1.NPS) + " (" + GameAnalysis.Formatting.formatEPS(Engine1.EPS) + ")" : GameAnalysis.Formatting.formatNPS(Engine1.NPS))</div>
  <div class="label-cell">Speed</div>
  <div class="stat-cell">@(Engine2.EPS > 0 ? GameAnalysis.Formatting.formatNPS(Engine2.NPS) + " (" + GameAnalysis.Formatting.formatEPS(Engine2.EPS) + ")" : GameAnalysis.Formatting.formatNPS(Engine2.NPS))</div>

  <!-- Row 5: Nodes -->
  <div class="stat-cell">@FormatNodes(Engine1.Nodes)</div>
  <div class="label-cell">Nodes</div>
  <div class="stat-cell">@FormatNodes(Engine2.Nodes)</div>

  <!-- Row 6: TB Hits -->
  <div class="stat-cell">@FormatNodes(Engine1.TBhits)</div>
  <div class="label-cell">TB Hits</div>
  <div class="stat-cell">@FormatNodes(Engine2.TBhits)</div>

  <!-- Row 7: WDL -->
  <div class="stat-cell wdl">@GetWDLString(Engine1.WDL)</div>
  <div class="label-cell">WDL</div>
  <div class="stat-cell wdl">@GetWDLString(Engine2.WDL)</div>

  @* Rows 8-9: the clocks. EngineClocks renders these six cells straight into this grid and
     listens to the clock tick ITSELF, so a tick redraws six cells and not this whole panel -
     which is what happened before, ten times a second in time trouble, tooltips and all. *@
  <EngineClocks WhiteTimeLeft="@Engine1TimeLeft" WhiteMoveTime="@Engine1TimePerMove"
                BlackTimeLeft="@Engine2TimeLeft" BlackMoveTime="@Engine2TimePerMove"
                WhiteToMove="@Engine1ToMove" />

  @* Row 10: each engine's PV board, in that engine's own column. PvBoardRow renders the three
     cells directly into this grid - see its own comment for why it is a component at all. *@
  @if (ShowPV)
  {
    <PvBoardRow WhiteFen="@whiteFen" WhiteFrom="@whiteFrom" WhiteTo="@whiteTo"
                WhiteMoveColor="@whiteMoveColor"
                BlackFen="@blackFen" BlackFrom="@blackFrom" BlackTo="@blackTo"
                BlackMoveColor="@blackMoveColor"
                SizePx="@PvBoardSizePx" />
  }
</div>
</div>

@code {

  // ── The two PV boards ────────────────────────────────────────────────────────
  // Moved here from PVboardDuo, which no longer exists. The state is what it was there: a fen
  // and a last move per side, set either by the parameters or, during opening replay, by a
  // direct call from the page.
  private string whiteFen = EbChessboard.StartFen;
  private string whiteFrom;
  private string whiteTo;
  private string whiteMoveColor;
  private string blackFen = EbChessboard.StartFen;
  private string blackFrom;
  private string blackTo;
  private string blackMoveColor;

  // Parameters only win when they actually CHANGE; otherwise a parent re-render would
  // overwrite state set through SetPVMoveWithAnnotation, and opening replay runs before the
  // first engine move updates the parameters.
  private string lastWhiteParamFen;
  private string lastBlackParamFen;

  [Parameter]
  public MoveAndFen WhiteMoveAndFen { get; set; }

  [Parameter]
  public MoveAndFen BlackMoveAndFen { get; set; }

  /// <summary>One PV board's size in pixels, worked out by Tournaments.SizeControls.cs from the
  /// panel width it measured, or null before the first measuring pass.</summary>
  [Parameter]
  public int? PvBoardSizePx { get; set; }

  /// <summary>
  /// Called during opening replay, which runs OFF the dispatcher thread - the render has to be
  /// marshalled. The position is taken whether the boards are shown or not, so they are right
  /// the moment they are switched on; the render is spent only when they are, because a render
  /// here is the whole panel and with the boards off it would draw nothing new.
  /// </summary>
  public Task SetPVMoveWithAnnotation(MoveAndFen input, bool clear)
  {
    if (input?.FenAfterMove is { Length: > 0 })
    {
      whiteFen = blackFen = input.FenAfterMove;
      whiteFrom = blackFrom = input.Move.FromSq;
      whiteTo = blackTo = input.Move.ToSq;
      whiteMoveColor = blackMoveColor = input.Move.Color;
      return ShowPV ? InvokeAsync(StateHasChanged) : Task.CompletedTask;
    }
    return Task.CompletedTask;
  }

  // Built once per engine, not once per render: this panel renders on every engine info line,
  // and the tooltip is a LINQ pass and a string.Join over the UCI options each time.
  private string engine1Tooltip, engine2Tooltip;
  private (EngineConfig, string) tooltipKey1, tooltipKey2;

  protected override void OnParametersSet()
  {
    if (tooltipKey1 != (Engine1Config, Engine1Name)) { tooltipKey1 = (Engine1Config, Engine1Name); engine1Tooltip = GetEngineOptionsTooltip(Engine1Config, Engine1Name); }
    if (tooltipKey2 != (Engine2Config, Engine2Name)) { tooltipKey2 = (Engine2Config, Engine2Name); engine2Tooltip = GetEngineOptionsTooltip(Engine2Config, Engine2Name); }
    if (WhiteMoveAndFen?.FenAfterMove is { Length: > 0 } wf && wf != lastWhiteParamFen)
    {
      lastWhiteParamFen = wf;
      whiteFen = wf;
      whiteFrom = WhiteMoveAndFen.Move.FromSq;
      whiteTo = WhiteMoveAndFen.Move.ToSq;
      whiteMoveColor = WhiteMoveAndFen.Move.Color;
    }
    if (BlackMoveAndFen?.FenAfterMove is { Length: > 0 } bf && bf != lastBlackParamFen)
    {
      lastBlackParamFen = bf;
      blackFen = bf;
      blackFrom = BlackMoveAndFen.Move.FromSq;
      blackTo = BlackMoveAndFen.Move.ToSq;
      blackMoveColor = BlackMoveAndFen.Move.Color;
    }
  }

  [Parameter]
  public bool ShowCompletePV { get; set; } = true;

  [Parameter]
  public bool ShowPV { get; set; }

  [Parameter]
  public string Engine1Logo { get; set; }

  [Parameter]
  public string Engine1Name { get; set; }

  [Parameter]
  public string Engine1Version { get; set; }

  [Parameter]
  public string Engine2Logo { get; set; }

  [Parameter]
  public string Engine2Name { get; set; }

  [Parameter]
  public string Engine2Version { get; set; }

  [Parameter]
  public EngineStatus Engine1 { get; set; }

  [Parameter]
  public EngineStatus Engine2 { get; set; }

  [Parameter]
  public EngineConfig Engine1Config { get; set; }

  [Parameter]
  public EngineConfig Engine2Config { get; set; }

  [Parameter]
  public string Engine1TimeLeft { get; set; } = "00:00:00";

  [Parameter]
  public string Engine1TimePerMove { get; set; } = "00:00:00";

  [Parameter]
  public string Engine2TimeLeft { get; set; } = "00:00:00";

  [Parameter]
  public string Engine2TimePerMove { get; set; } = "00:00:00";

  [Parameter]
  public bool Engine1ToMove { get; set; }

  [Parameter]
  public bool IsFRC { get; set; }

  [Parameter]
  public int FontSize { get; set; }

  /// <summary>
  /// The panel's configured size per pixel of panel width, as a plain number for calc().
  ///
  /// 360px is the width this panel has in EB's own tournament layout on a wide window, measured
  /// rather than picked: at that width the clamp lands exactly on the configured size, so a
  /// maximised window looks as it always did, and a narrower column scales down from there.
  /// </summary>
  private const double PanelReferenceWidthPx = 360.0;

  private string PanelWidthFactor =>
      ((FontSize > 0 ? FontSize : 14) / PanelReferenceWidthPx)
      .ToString("0.#####", System.Globalization.CultureInfo.InvariantCulture);

  [Parameter]
  public string MainLogoFileName { get; set; }

  [Parameter]
  public string LogoSize { get; set; } = "";

  /// <summary>tournament.json's ceiling for the main logo, "WxH" or "N"; empty = 240x130.</summary>
  [Parameter]
  public string MainLogoSize { get; set; } = "";

  /// <summary>
  /// The main logo's ceiling, as two CSS variables the stylesheet spends. Not an inline size on
  /// the image: an inline max-width beats every @container rule and would stop the logo
  /// scaling down with the panel (that was the 300px-logo-in-a-360px-panel bug). The variables
  /// only replace the PIXEL term of the stylesheet's min(), so the em and cqw terms still
  /// shrink it on a narrow panel and this stays a ceiling, exactly as LogoSize is for the
  /// engine logos. Nothing is emitted when the setting is empty, so the CSS defaults apply.
  /// </summary>
  private string MainLogoVars
  {
    get
    {
      var parsed = ChessLibrary.LayoutTypes.parseLogoSize(MainLogoSize);
      if (parsed == null) return "";
      var (w, h) = parsed.Value;
      return $"--eb-mainlogo-w: {w}px; --eb-mainlogo-h: {h}px;";
    }
  }

  private string MainLogo => string.IsNullOrEmpty(MainLogoFileName) ? LogoBackup : $"Img/{MainLogoFileName}";

  private string LogoBackup = "Img/MainLogoEB.png";

  private string LogoWrapperStyle
  {
    get
    {
      var parsed = ChessLibrary.LayoutTypes.parseLogoSize(LogoSize);
      if (parsed == null) return "max-width:150px; max-height: 100px;";
      var (w, h) = parsed.Value;
      return $"max-width: {w}px; max-height: {h}px;";
    }
  }

  private string GetEngineOptionsTooltip(EngineConfig cfg, string name)
  {
    if (cfg?.Options == null || cfg.Options.Count == 0)
      return name;
    var lines = cfg.Options.Select(kv => $"{kv.Key}: {kv.Value}");
    return $"{name}\n\nUCI Options:\n{string.Join("\n", lines)}";
  }

  private string GetWDLString(WDLType wdlValue)
  {
    string msg = "[0.0%|0.0%|0.0%]";
    switch (wdlValue)
    {
      case WDLType.HasValue wdlinput:
        var wdl = wdlinput.Values;
        msg = $"[{(wdl.Win / 1000):P1}|{(wdl.Draw / 1000):P1}|{(wdl.Loss / 1000):P1}]";
        break;
    }
    return msg;
  }

  private string FormatNodes(long nodes)
  {
    if (nodes > 1_000_000_000)
    {
      var giga = (decimal)nodes / 1_000_000_000;
      return giga.ToString("F1") + "G";
    }
    else if (nodes > 1_000_000)
    {
      var mill = (decimal)nodes / 1_000_000;
      return mill.ToString("F1") + "M";
    }
    else if (nodes > 1_000)
    {
      var mill = (decimal)nodes / 1_000;
      return mill.ToString("F1") + "K";
    }
    else
    {
      return nodes.ToString("F1");
    }
  }



}

    private void DoQAnalysis()
    {
        try
        {
            var fen = ChessBoard.FEN();
            var posWithMoves = ChessBoard.PositionWithFenAndMoves(fen);
            var fenWithAllMoves = ChessBoard.PositionWithMoves();
            var history = ChessBoard.GetMoveHistory();
            logger.LogInformation($"Starting analysis with {fen} and moves {history}");
            if (analyzer == null)
            {
                logger.LogInformation("No engine loaded");
                analyzer = new Analysis.Manager.SimpleEngineAnalyzer(Engine, ChessBoard, logger, UpdateMe, true);
            }
            var engineName = "all";

            var parts = (Config.PolicyDistributionMinMaxFilter ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            float minVal = 0f, maxVal = 1f; // init to satisfy definite assignment

            var ok =
                parts.Length == 2 &&
                float.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out minVal) &&
                float.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out maxVal) &&
                minVal >= 0f && maxVal <= 1f && minVal < maxVal;

            var (min, max) = ok ? (minVal, maxVal) : (0f, 1f);

            //var (min, max) = (0.0f, 1.0f); //(0.2f, 0.8f);
            var (neuralNet, res) = analyzer?.TryGetMoveQAndTopForPosSequence(engineName, min, max);
            analyzer?.StopDistributionEngine();
            foreach (var item in res)
            {
                var player = item.IsWhite ? "White" : "Black";
                logger.LogInformation("{Player} {Rank} Move played {MovePlayed} Policy {Policy:F2}% Top move {Top} policy {TopPolicy:F2}%",
                    player, item.PolicyRank, item.PlayedMove.SANMove, item.PlayedMove.P, item.BestMove.SANMove, item.BestMove.P);
            }
            // NEW: draw the rank-per-move sequence on the Q-plot area
            _ = searchInfoPlot?.SetRankSequence(res, neuralNet);

            var whiteRank1s = res.Count(t => t.PolicyRank == 1 && t.IsWhite);
            var blackRank1s = res.Count(t => t.PolicyRank == 1 && !t.IsWhite);
            var whiteTotal = res.Count(t => t.IsWhite);
            var blackTotal = res.Count(t => !t.IsWhite);
            var whiteFrac = whiteTotal > 0 ? (double)whiteRank1s / whiteTotal * 100 : 0;
            var blackFrac = blackTotal > 0 ? (double)blackRank1s / blackTotal * 100 : 0;
            logger.LogInformation("White Rank1 moves {WhiteRank1} out of {WhiteTotal} fraction {WhiteFrac:F2}%", whiteRank1s, whiteTotal, whiteFrac);
            logger.LogInformation("Black Rank1 moves {blackRank1s} out of {blackTotal} fraction {blackFrac:F2}%", blackRank1s, blackTotal, blackFrac);

            var whiteDistribution = res.Where(t => t.IsWhite)
                .GroupBy(t => t.PolicyRank)
                .Select(g => new { Rank = g.Key, Count = g.Count() })
                .OrderBy(g => g.Rank)
                .ToList();

            var blackDistribution = res.Where(t => !t.IsWhite)
                .GroupBy(t => t.PolicyRank)
                .Select(g => new { Rank = g.Key, Count = g.Count() })
                .OrderBy(g => g.Rank)
                .ToList();

            //distribution graph of rank1, rank2 etc
            var distribution = res.GroupBy(t => t.PolicyRank)
                .Select(g => new { Rank = g.Key, Count = g.Count() })
                .OrderBy(g => g.Rank)
                .ToList();

            var numberOfRanks = Math.Min(distribution.Max(e => e.Rank), 12);

            foreach (var item in distribution)
            {
                var percentage = (double)item.Count / res.Count() * 100;
                logger.LogInformation("Rank {Rank} Count {Count} Percentage {Percentage:F2}%", item.Rank, item.Count, percentage);
            }

            //finally write to console the top 4 ranks fractions
            var top5 = distribution.Where(d => d.Rank <= 5).Sum(d => d.Count);
            var top5frac = (double)top5 / res.Count() * 100;
            logger.LogInformation("Top 5 moves {Top5} out of {Total} fraction {Top5Frac:F2}%", top5, res.Count(), top5frac);
            if (Config.CombineWhiteAndBlackMoves)
            {
                // Combined single-bar with 11+ tail and 1..10 individual (1..6 at least)
                searchInfoPlot?.SetPolicyDistributionCombinedBucketed(
                    distribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    neuralNet,
                    minDistinctRanks: 2,
                    tailStart: 10);
            }
            else
            {
                // Or split bars with the same 11+ tail
                searchInfoPlot?.SetPolicyDistributionBucketed(
                    distribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    whiteDistribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    blackDistribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    neuralNet,
                    minDistinctRanks: 2,
                    tailStart: 7);
            }

        }
        catch (Exception ex)
        {
            logger.LogCritical(ex.Message);
            //throw;
        }

    }


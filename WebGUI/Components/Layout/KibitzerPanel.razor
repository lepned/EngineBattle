@using WebGUI.Services
@using System.Globalization
@using System.IO
@using ChessLibrary
@using WebGUI.Components.Layout.ChessboardLayout
@implements IAsyncDisposable
@inject NotifierService Notifier
@inject OverlaySetting OverlaySetting
@inject GlobalSettingsService SettingsService
@inject ILogger<KibitzerPanel> logger

@* Compact broadcast kibitzer: engine picker, start/stop, time limit, multi-PV lines
   and policy overlay publishing. Slim replacement for EnginePanel on viewer pages. *@
<div class="kib-panel">
    <div class="kib-row">
        <select class="kib-select kib-engine-select" value="@selectedPath" @onchange="OnEngineSelected" title="Analysis engine">
            @if (engineFiles.Count == 0)
            {
                <option value="">no engine definitions found</option>
            }
            @foreach (var f in engineFiles)
            {
                <option value="@f.Path">@f.Name</option>
            }
        </select>
        <button class="kib-power @(running ? "on" : "")" disabled="@(engineConfig == null)"
                @onclick="ToggleRunning" title="@(running ? "Stop analysis" : "Start analysis")">
            @(running ? "■" : "▶")
        </button>
    </div>

    @if (engineFiles.Count == 0)
    {
        <div class="kib-setup-hint">
            No engine definitions found. Set your <b>Engine defs folder</b> (and optionally a
            default engine) in <a href="/settings">Settings</a>, then return here.
        </div>
    }

    <div class="kib-row kib-controls">
        <label title="Search time per position">
            <select class="kib-select" value="@limitSeconds" @onchange="OnLimitChanged">
                <option value="0">∞</option>
                <option value="5">5s</option>
                <option value="10">10s</option>
                <option value="30">30s</option>
            </select>
        </label>
        <label title="Number of engine lines">
            <select class="kib-select" value="@model.Lines" @onchange="OnPvLinesChanged">
                <option value="1">1 line</option>
                <option value="3">3 lines</option>
                <option value="5">5 lines</option>
            </select>
        </label>
        @if (hasLiveStats)
        {
            <label class="kib-overlay" title="Policy overlay on the board">
                <input type="checkbox" checked="@overlayOn" @onchange="OnOverlayToggled" /> overlay
            </label>
        }
        @if (waitingForEngine)
        {
            <span class="kib-wait">starting…</span>
        }
        else if (holding && running)
        {
            <span class="kib-wait">waiting for the next game…</span>
        }
        else if (!string.IsNullOrEmpty(engineNote))
        {
            <span class="kib-wait">@engineNote</span>
        }
    </div>

    @if (dataList.Count > 0)
    {
        var main = dataList[0].Value;
        <div class="kib-status">
            <span class="kib-eval">@WhiteEvalStr(main)</span>
            <span>depth @main.Depth</span>
            <span>@FormatNodes(main.Nodes)</span>
            <span>@Formatting.formatNPS(main.NPS)</span>
        </div>
        <div class="kib-pvs">
            @foreach (var item in dataList)
            {
                <div class="kib-pv-row" title="@item.Value.PV">
                    <span class="kib-pv-eval">@WhiteEvalStr(item.Value)</span>
                    <span class="kib-pv-line">@item.Value.PV</span>
                </div>
            }
        </div>
    }
</div>

@code {
    [Parameter] public Chess.Board ChessBoard { get; set; }
    [Parameter] public string Id { get; set; } = EngineSlot.A;
    [Parameter] public EngineConfig InitialEngine { get; set; }
    [Parameter] public string InitialEnginePath { get; set; }
    /// <summary>White-perspective eval of the best line (pawns, or mate distance) plus the
    /// FEN the search was started on — feeds an eval bar / eval chart.</summary>
    [Parameter] public EventCallback<(double? Cp, int? Mate, string Fen)> OnEvalUpdated { get; set; }
    /// <summary>Verbose move stats of the current search (Lc0/Ceres LogLiveStats engines
    /// only) plus the FEN the search runs on — feeds the candidate-moves panel. Fires
    /// regardless of the overlay checkbox.</summary>
    [Parameter] public EventCallback<(IReadOnlyList<NNValues> Stats, string Fen)> OnLiveStats { get; set; }

    /// <summary>Per-depth iteration rows, raised as each new depth opens. Empty for engines
    /// that report live move stats — those hosts show the candidate table instead.</summary>
    [Parameter] public EventCallback<(IReadOnlyList<IterationRow> Rows, string Fen, string InfoLine, bool Searching)> OnIterations { get; set; }

    private record EngineFile(string Path, string Name);

    private readonly List<EngineFile> engineFiles = new();
    private string selectedPath = "";
    private EngineConfig engineConfig;

    private AnalysisManager.SimpleEngineAnalyzer analyzer;
    private bool hasLiveStats;

    // ── The search control (ChessLibrary/Analysis/PanelModel.fs, as the engine panel): auto-search
    // on the board's position, results by search id, so a previous position's lines never show ──
    private PanelModel.State model = PanelModel.initial(3);
    // ▶ is auto-search on
    private bool running => model.Auto;
    private bool waitingForEngine => model.Engine.IsStarting;
    private List<KeyValuePair<int, EngineStatus>> dataList =>
        model.Rows.Select(r => new KeyValuePair<int, EngineStatus>(r.Key, r.Value)).OrderBy(r => r.Key).ToList();
    // counts engine starts and replacements: a start or an update of an older one is dropped
    private int engineGeneration;

    // Iteration log for alpha-beta engines, which report no root visit counts. The reading
    // of an info line is shared with EnginePanel — see IterationCollector.
    private readonly IterationCollector iterationCollector = new();
    private EngineStatus pendingIterationStatus;
    private string lastIterationInfoLine = "";
    private readonly System.Diagnostics.Stopwatch searchTimer = new();
    private readonly System.Diagnostics.Stopwatch iterationPublish = System.Diagnostics.Stopwatch.StartNew();
    private bool iterationSkipLogged;

    private bool overlayOn = true;
    private int limitSeconds = 5;
    private string engineNote = "";
    private readonly CancellationTokenSource disposeCts = new();

    protected override void OnInitialized()
    {
        engineConfig = InitialEngine;
        selectedPath = InitialEnginePath ?? "";
        LoadEngineList();
        // Without a configured default engine the dropdown would show an entry that
        // is not actually loaded — load the first one so ▶ works right away.
        if (engineConfig == null && engineFiles.Count > 0)
        {
            try
            {
                engineConfig = JSON.readSingleEngineConfig(engineFiles[0].Path);
                selectedPath = engineFiles[0].Path;
            }
            catch (Exception ex)
            {
                logger.LogWarning("Could not load engine config {Path}: {Msg}", engineFiles[0].Path, ex.Message);
            }
        }
        Notifier.NotifyFen += OnNotifyFen;
    }

    private void LoadEngineList()
    {
        engineFiles.Clear();
        try
        {
            var folder = SettingsService.Settings.EngineDefsFolder;
            if (!string.IsNullOrWhiteSpace(folder) && Directory.Exists(folder))
            {
                foreach (var f in Directory.GetFiles(folder, "*.json").OrderBy(Path.GetFileName))
                    engineFiles.Add(new EngineFile(f, Path.GetFileNameWithoutExtension(f)));
            }
        }
        catch (Exception ex)
        {
            logger.LogWarning("Could not scan engine folder: {Msg}", ex.Message);
        }
        // The configured default engine may live outside the folder.
        if (!string.IsNullOrEmpty(selectedPath) &&
            !engineFiles.Any(f => string.Equals(f.Path, selectedPath, StringComparison.OrdinalIgnoreCase)))
        {
            engineFiles.Insert(0, new EngineFile(selectedPath, Path.GetFileNameWithoutExtension(selectedPath)));
        }
    }

    // The host has no position yet (a round switch, before its first game): nothing to search.
    private bool holding;

    private PanelModel.Request CurrentRequest() =>
        new(limitSeconds <= 0 ? PanelModel.Limit.Infinite : PanelModel.Limit.NewMoveTime(limitSeconds * 1000),
            !holding && (ChessBoard?.AnyLegalMove() ?? false));

    /// <summary>The host's position is gone until it announces a new one: the search stops and
    /// the lines clear; ▶ stays as it is and the next announced position is searched.</summary>
    public Task HoldPosition() => InvokeAsync(async () =>
    {
        if (disposeCts.IsCancellationRequested) return;
        holding = true;
        await Send(PanelModel.Event.Navigated);
        StateHasChanged();
    });

    /// <summary>The host has a position again and announces it (NotifyFen). True when it was held:
    /// then the position must be announced even if it equals the last one.</summary>
    public bool ReleasePosition()
    {
        var was = holding;
        holding = false;
        return was;
    }

    // fen: the position of the search an update belongs to (every update carries its own)
    private async Task Send(PanelModel.Event e, string fen = "")
    {
        var result = PanelModel.step(model, e);
        model = result.Item1;
        foreach (var effect in result.Item2)
            await Execute(effect, fen);
    }

    private async Task Execute(PanelModel.Effect effect, string fen)
    {
        switch (effect)
        {
            case PanelModel.Effect.Search search:
                RunSearch(search.Item1);
                break;
            case PanelModel.Effect.Settle settle:
                _ = SettleAfter(settle.navigation, settle.delayMs);
                break;
            case PanelModel.Effect.SetMultiPv multiPv:
                analyzer?.AddSetoption(EngineOption.Create("MultiPV", multiPv.Item.ToString()));
                break;
            case PanelModel.Effect.PublishEval eval:
                if (OnEvalUpdated.HasDelegate)
                    await OnEvalUpdated.InvokeAsync((eval.cp != null ? eval.cp.Value : null, eval.mate != null ? eval.mate.Value : null, fen));
                break;
            case PanelModel.Effect.Completed:
                await OnSearchDone(fen);
                break;
            case PanelModel.Effect.Show show:
                await ShowUpdate(show.Item, fen);
                break;
            default:
                // the load runs on; the model hears EngineReady or EngineGone when it is done
                if (effect.IsStartEngine) _ = StartEngine();
                else if (effect.IsStopEngine) analyzer?.Stop();
                else if (effect.IsQuitEngine) { engineGeneration++; EngineQuit.OffThread(analyzer, logger); analyzer = null; }
                else if (effect.IsClearLists) await ClearLists();
                // ShowRows: the next render shows the model's rows. Timer, ClearCharts, Late, ResetEngine: nothing here.
                break;
        }
    }

    private void RunSearch(PanelModel.Limit limit)
    {
        if (analyzer == null) return;
        try
        {
            int id = limit is PanelModel.Limit.MoveTime t ? analyzer.SearchTime(t.ms) : analyzer.GoInfinite();
            model = PanelModel.step(model, PanelModel.Event.NewStarted(id)).Item1;
        }
        catch (Exception ex)
        {
            // the model would wait for a search that never started
            logger.LogWarning("Search start failed: {Msg}", ex.Message);
            model = PanelModel.step(model, PanelModel.Event.Stop).Item1;
        }
    }

    private async Task SettleAfter(int navigation, int delayMs)
    {
        await Task.Delay(delayMs);
        if (disposeCts.IsCancellationRequested) return;
        try
        {
            await InvokeAsync(async () =>
            {
                await Send(PanelModel.Event.NewSettled(navigation, CurrentRequest()));
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async Task StartEngine()
    {
        var config = engineConfig;
        var generation = ++engineGeneration;
        bool Stale() => generation != engineGeneration || disposeCts.IsCancellationRequested;
        if (config == null)
        {
            await Send(PanelModel.Event.EngineGone);
            return;
        }
        StateHasChanged();
        AnalysisManager.SimpleEngineAnalyzer created;
        try
        {
            Action<SearchUpdate> onUpdate = u => Dispatch(u, generation);
            created = await Task.Run(() => new AnalysisManager.SimpleEngineAnalyzer(config, ChessBoard, logger, onUpdate, false));
        }
        catch (Exception ex)
        {
            logger.LogWarning("Engine start failed: {Msg}", ex.Message);
            if (Stale()) return;
            engineNote = "engine did not start";
            await Send(PanelModel.Event.NewAutoChanged(false));
            await Send(PanelModel.Event.EngineGone);
            StateHasChanged();
            return;
        }
        if (Stale())
        {
            EngineQuit.OffThread(created, logger);
            return;
        }
        try
        {
            created.AddSetoption(EngineOption.Create("MultiPV", model.Lines.ToString()));
            analyzer = created;
            await Send(PanelModel.Event.EngineReady);
            StateHasChanged();
        }
        catch (Exception ex) { logger.LogWarning("Starting the first search failed: {Msg}", ex.Message); }
    }

    /// The engine quits (another is chosen, or it failed); a start in progress is dropped when it finishes.
    private async Task ReplaceEngine()
    {
        engineGeneration++;
        EngineQuit.OffThread(analyzer, logger);
        analyzer = null;
        await Send(PanelModel.Event.EngineGone);
    }

    private async Task OnEngineSelected(ChangeEventArgs e)
    {
        var path = e.Value?.ToString();
        if (string.IsNullOrWhiteSpace(path) || path == selectedPath) return;
        EngineConfig config;
        try
        {
            config = JSON.readSingleEngineConfig(path);
        }
        catch (Exception ex)
        {
            logger.LogWarning("Could not load engine config {Path}: {Msg}", path, ex.Message);
            return;
        }
        selectedPath = path;
        engineConfig = config;
        hasLiveStats = false;
        engineNote = "";
        // Tell stats consumers the source changed: an empty payload means "no verbose
        // stats until proven otherwise" (the new engine may not emit them at all).
        if (OnLiveStats.HasDelegate)
            await OnLiveStats.InvokeAsync((Array.Empty<NNValues>(), ""));
        var wasRunning = running;
        await ReplaceEngine();
        await Send(PanelModel.Event.Reset);
        // still on: the new engine starts and searches the position
        if (wasRunning) await StartOrLoad();
    }

    // A search of the board's position; on one with no legal move only the engine starts, and
    // auto-search searches the next position (Settled while Starting keeps it pending).
    private Task StartOrLoad()
    {
        var request = CurrentRequest();
        return model.Engine.IsNotStarted && !request.HasMove
            ? Send(PanelModel.Event.LoadEngine)
            : Send(PanelModel.Event.NewStart(request));
    }

    private async Task ToggleRunning()
    {
        if (running)
        {
            await Send(PanelModel.Event.NewAutoChanged(false));
            await Send(PanelModel.Event.Stop);
        }
        else
        {
            engineNote = "";
            await Send(PanelModel.Event.NewAutoChanged(true));
            await StartOrLoad();
        }
    }

    // The search's own lists (the rows are the model's), and the host's iteration log with them.
    private async Task ClearLists()
    {
        // The iteration log belongs to one search. Left standing, its depths are all
        // already known when the next search reports them, so nothing counts as a new
        // depth and the host is never told anything again.
        iterationCollector.Clear();
        pendingIterationStatus = null;
        lastIterationInfoLine = "";
        iterationSkipLogged = false;
        searchTimer.Restart();
        iterationPublish.Restart();
        if (!hasLiveStats && OnIterations.HasDelegate)
            await OnIterations.InvokeAsync((Array.Empty<IterationRow>(), "", "", false));
    }

    // Every new position on the page's board (a broadcast move, or the user stepping through the
    // game): the search on the old one stops, and auto-search takes the new one once it settles.
    public Task OnNotifyFen(string newPos) => InvokeAsync(async () =>
    {
        if (disposeCts.IsCancellationRequested) return;
        await Send(PanelModel.Event.Navigated);
        StateHasChanged();
    });

    // On the engine's delivery thread: marshalled to the dispatcher, where the model runs. An
    // update of a replaced engine is dropped (search ids restart with each engine).
    private void Dispatch(SearchUpdate update, int generation)
    {
        if (disposeCts.IsCancellationRequested) return;
        try
        {
            _ = InvokeAsync(async () =>
            {
                if (disposeCts.IsCancellationRequested || generation != engineGeneration) return;
                try
                {
                    await Send(PanelModel.Event.NewResult(update.SearchId, update.Update), update.Fen);
                    StateHasChanged();
                }
                catch (ObjectDisposedException) { }
                catch (Microsoft.JSInterop.JSDisconnectedException) { }
                catch (Exception ex) { logger.LogWarning("Kibitzer update failed: {Msg}", ex.Message); }
            });
        }
        catch (ObjectDisposedException) { }
    }

    // An update the model accepted for this search (or the engine's own).
    private async Task ShowUpdate(EngineUpdate update, string fen)
    {
        switch (update)
        {
            case EngineUpdate.Ready ready:
                hasLiveStats = ready.HasLiveStat;
                engineNote = "";
                await ApplyOverlaySetting();
                break;

            case EngineUpdate.EngineFailed failed:
                logger.LogWarning("Kibitzer engine failed: {Reason}", failed.Reason);
                // the model dropped the engine already (QuitEngine); ▶ starts a new one
                engineNote = "engine stopped — press ▶ to restart";
                await Send(PanelModel.Event.NewAutoChanged(false));
                break;

            case EngineUpdate.Status s:
                if (s.Item.MultiPV <= 1) pendingIterationStatus = s.Item;
                break;

            case EngineUpdate.Info i:
                // An engine with live stats has no iteration log by design — the host shows
                // the candidate table for it. Only the other case is worth a word.
                if (hasLiveStats) break;
                if (pendingIterationStatus is null)
                {
                    if (!iterationSkipLogged)
                    {
                        iterationSkipLogged = true;
                        logger.LogDebug("Iteration log idle: an info line arrived before any status");
                    }
                    break;
                }
                lastIterationInfoLine = i.Info;
                var opened = iterationCollector.Capture(pendingIterationStatus, i.Info, searchTimer.Elapsed.TotalSeconds);
                // Publish on a new depth, and otherwise at most four times a second.
                // Depth-only publishing left the host stale for as long as the engine
                // spent refining one depth — and empty for that whole time if its rows
                // had just been reset by a game switch.
                var due = opened || iterationPublish.ElapsedMilliseconds >= 250;
                if (due && OnIterations.HasDelegate)
                {
                    iterationPublish.Restart();
                    await OnIterations.InvokeAsync((iterationCollector.Rows, fen, i.Info, true));
                }
                break;

            case EngineUpdate.NNSeq n:
                if (hasLiveStats && n.NNSeq.Count > 0)
                {
                    n.NNSeq.Reverse();
                    // Copy: the overlay consumer receives the same list instance.
                    if (OnLiveStats.HasDelegate)
                        await OnLiveStats.InvokeAsync((n.NNSeq.ToList(), fen));
                    if (overlayOn)
                        await Notifier.MovesWithId(n.NNSeq, Id);
                }
                break;
        }
    }

    // bestmove ends the search. Without this the host keeps the newest iteration row marked as
    // pending, waiting on a depth that will never open.
    private async Task OnSearchDone(string fen)
    {
        if (!hasLiveStats && OnIterations.HasDelegate)
            await OnIterations.InvokeAsync((iterationCollector.Rows, fen, lastIterationInfoLine, false));
    }

    // EngineStatus.Eval is already white-perspective: the UCI parser negates the
    // side-to-move score for black (EngineProtocol.getEssentialDataWithEPS).
    private static (double? Cp, int? Mate) WhiteEval(EngineStatus status) => status.Eval switch
    {
        EvalType.CP cp => (cp.Info, null),
        EvalType.Mate m => (null, m.Info),
        _ => ((double?)null, (int?)null)
    };

    private string WhiteEvalStr(EngineStatus status)
    {
        var (cp, mate) = WhiteEval(status);
        return mate is int m ? (m > 0 ? $"M{m}" : $"-M{-m}")
             : cp is double c ? c.ToString("+0.00;-0.00;0.00", CultureInfo.InvariantCulture)
             : "–";
    }

    private async Task ApplyOverlaySetting()
    {
        var setting = overlayOn && hasLiveStats ? OverlaySettings.Policy : OverlaySettings.None;
        OverlaySetting.SetOverlaySetting(Id, setting);
        await Notifier.UpdateDisplaySettings(setting, Id);
    }

    private async Task OnOverlayToggled(ChangeEventArgs e)
    {
        overlayOn = e.Value is bool b && b;
        await ApplyOverlaySetting();
    }

    private async Task OnLimitChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var s)) return;
        limitSeconds = s;
        // a running search is replaced by one with the new limit
        if (running) await Send(PanelModel.Event.NewStart(CurrentRequest()));
    }

    private async Task OnPvLinesChanged(ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), out var n)) return;
        await Send(PanelModel.Event.NewLinesChanged(n));
        if (running) await Send(PanelModel.Event.NewStart(CurrentRequest()));
    }

    private static string FormatNodes(long nodes) => nodes switch
    {
        >= 1_000_000_000 => $"{nodes / 1_000_000_000.0:0.#}B nodes",
        >= 1_000_000 => $"{nodes / 1_000_000.0:0.#}M nodes",
        >= 1_000 => $"{nodes / 1_000.0:0.#}k nodes",
        _ => $"{nodes} nodes"
    };

    public ValueTask DisposeAsync()
    {
        disposeCts.Cancel();
        Notifier.NotifyFen -= OnNotifyFen;
        engineGeneration++;
        EngineQuit.OffThread(analyzer, logger);
        analyzer = null;
        disposeCts.Dispose();
        return ValueTask.CompletedTask;
    }
}

    }

    // Updates arrive on the engine's delivery thread; Dispatch marshals each to the dispatcher,
    // the panel's only thread, where the model decides what it means.
    // A host's own engine (Game Review) feeds its updates here, without a search.
    public void HandleUpdate(EngineUpdate update) => Dispatch(update, "", 0, null);

    // generation: the panel engine's (a replaced engine's updates are dropped); null for a host's
    private void Dispatch(EngineUpdate update, string searchFen, int searchId, int? generation)
    {
        if (disposeCts.IsCancellationRequested) return;
        try
        {
            _ = InvokeAsync(() =>
                generation is int g && g != engineGeneration
                    ? Task.CompletedTask
                    : HandleUpdateCore(update, searchFen, searchId));
        }
        catch (ObjectDisposedException) { }
    }

    private async Task HandleUpdateCore(EngineUpdate update, string searchFen, int searchId)
    {
        if (disposeCts.IsCancellationRequested) return;
        try
        {
            updateFen = string.IsNullOrEmpty(searchFen) ? fen : searchFen;
            await Send(PanelModel.Event.NewResult(searchId, update));
        }
        catch (ObjectDisposedException) { }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (Exception ex)
        {
            // Full exception, not just the message: the effects touch a dozen collections.
            logger.LogWarning(ex, "Engine update callback failed [{Update}]", update.GetType().Name);
        }
    }

    // The position of the update being handled: its search's, or the board's for a host's.
    private string updateFen = "";

    // ── The panel model (ChessLibrary/Analysis/PanelModel.fs): every start, stop and clear ──
    private PanelModel.State model = PanelModel.initial(3);

    private async Task Send(PanelModel.Event e)
    {
        var result = PanelModel.step(model, e);
        model = result.Item1;
        foreach (var effect in result.Item2)
            await Execute(effect);
    }

    private PanelModel.Limit CurrentLimit() =>
        searchMode == SearchMode.Nodes
            ? PanelModel.Limit.NewNodes((int)numberOfNodes)
            : PanelModel.Limit.NewMoveTime((int)Math.Max(1, Math.Round(numberOfTimeMs)));

    private PanelModel.Request RequestFor(PanelModel.Limit limit) =>
        new PanelModel.Request(limit, ChessBoard?.AnyLegalMove() ?? false);

    private PanelModel.Request CurrentRequest() => RequestFor(CurrentLimit());

    private async Task Execute(PanelModel.Effect effect)
    {
        switch (effect)
        {
            case PanelModel.Effect.Search search:
                await RunSearch(search.Item1, search.searchMoves);
                break;
            case PanelModel.Effect.Settle settle:
                _ = SettleAfter(settle.navigation, settle.delayMs);
                break;
            case PanelModel.Effect.Timer timer:
                if (timer.running) { ResetSearchTimer(); StartSearchTimer(); }
                else StopSearchTimer();
                break;
            case PanelModel.Effect.SetMultiPv multiPv:
                analyzer?.AddSetoption(EngineOption.Create("MultiPV", multiPv.Item.ToString()));
                break;
            case PanelModel.Effect.PublishEval eval:
                await PublishEval(eval.cp, eval.mate);
                break;
            case PanelModel.Effect.Completed completed:
                await OnCompleted(completed.Item);
                break;
            case PanelModel.Effect.Show show:
                await ShowUpdate(show.Item);
                break;
            case PanelModel.Effect.Late late:
                await ForwardLateStats(late.Item);
                break;
            default:
                if (effect.IsStartEngine) await StartEngineNow();
                else if (effect.IsStopEngine) analyzer?.Stop();
                else if (effect.IsResetEngine) { analyzer?.Reset(); analyzer?.ClearSearchMoves(); }
                else if (effect.IsQuitEngine) DropAnalyzer();
                else if (effect.IsClearLists) ClearLists();
                else if (effect.IsClearCharts) await ClearCharts();
                else if (effect.IsShowRows) ShowRows();
                break;
        }
    }

    private async Task StartEngineNow()
    {
        var generation = engineGeneration;
        StateHasChanged();
        try
        {
            await StartAnalyzer();
        }
        catch (Exception ex)
        {
            logger.LogWarning("Failed to start the engine: {Message}", ex.Message);
        }
        // replaced meanwhile: the new engine's start reports for itself
        if (generation != engineGeneration) return;
        if (analyzer == null)
        {
            await Send(PanelModel.Event.EngineGone);
            return;
        }
        backend = analyzer.BackendInfo();
        neuralNet = showCharts ? $"{analyzer.GetNetwork()}" : "none";
        if (searchInfoPlot != null)
        {
            searchInfoPlot.EngineName = analyzer.GetEngineName();
            searchInfoPlot.NN = neuralNet;
        }
        await Send(PanelModel.Event.EngineReady);
    }

    private async Task RunSearch(PanelModel.Limit limit, Microsoft.FSharp.Collections.FSharpList<string> moves)
    {
        if (analyzer == null) return;
        // a settings list changed since the last search (contempt, for one) goes first, with ucinewgame
        if (!ReferenceEquals(ExtraSetOptions, appliedExtraSetOptions))
            ApplyExtraSetOptions();
        analyzer.SetSearchMoves(moves);
        int id = limit switch
        {
            PanelModel.Limit.Nodes n => analyzer.SearchNodes(n.Item),
            PanelModel.Limit.MoveTime t => analyzer.SearchTime(t.ms),
            _ => analyzer.GoInfinite()
        };
        await Send(PanelModel.Event.NewStarted(id));
    }

    private async Task SettleAfter(int navigation, int delayMs)
    {
        await Task.Delay(delayMs);
        if (disposeCts.IsCancellationRequested) return;
        await InvokeAsync(async () =>
        {
            await Send(PanelModel.Event.NewSettled(navigation, CurrentRequest()));
            StateHasChanged();
        });
    }


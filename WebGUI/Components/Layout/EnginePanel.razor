            .Add(Key.F5, (Func<Task>)(async () => await InvokeAsync(async () => { numberOfNodes = 1_000_000; await Analyze(); })), "Analyze 1_000_000 nodes")
            .Add(Key.F6, (Func<Task>)(async () => await InvokeAsync(async () => { numberOfNodes = 10_000_000; await Analyze(); })), "Analyze 10_000_000 nodes")
            .Add(Key.F7, (Func<Task>)(async () => await InvokeAsync(async () => { numberOfNodes = 100_000_000; await Analyze(); })), "Analyze 100_000_000 nodes")

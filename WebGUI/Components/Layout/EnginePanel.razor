                searchInfoPlot?.SetPolicyDistributionCombinedBucketed(
                    distribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    neuralNet,
                    minDistinctRanks: 2,
                    tailStart: 10);
            }
            else
            {
                searchInfoPlot?.SetPolicyDistributionBucketed(
                    distribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    whiteDistribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    blackDistribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    neuralNet,
                    minDistinctRanks: 2,
                    tailStart: 7);
            }
        }
        catch (Exception ex)
        {
            logger.LogCritical(ex.Message);
            throw;
        }
    }

    private async Task CheckAllGamesQAnalysis()
    {
        if (!showCharts) { logger.LogWarning("Q-rank analysis requires a neural network engine with LogLiveStats"); return; }
        try
        {
            StateHasChanged();
            var results = new List<PolicyRankInfo>();
            if (analyzer == null)
            {
                logger.LogInformation("No engine loaded");
                await StartAnalyzer();
            }

            var playerInSearch = Player.Trim();

            foreach (var game in PGNgames)
            {
                logger.LogInformation("Q-analyzing game {White} - {Black} result {Result} round {Round}",
                    game.GameMetaData.White, game.GameMetaData.Black, game.GameMetaData.Result, game.GameMetaData.Round);
                LoadAndOpenPGNGame(game);
                var fen = ChessBoard.FEN();
                var posWithMoves = ChessBoard.PositionWithFenAndMoves(fen);
                var player = String.Empty;
                if (game.GameMetaData.White.Trim() == playerInSearch)
                    player = "w";
                else if (game.GameMetaData.Black.Trim() == playerInSearch)
                    player = "b";
                else
                    player = "all";

                var parts = (SettingsService.Settings.PolicyDistributionMinMaxFilter ?? "")
                    .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

                float minVal = 0f, maxVal = 1f;
                var ok =
                    parts.Length == 2 &&
                    float.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out minVal) &&
                    float.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out maxVal) &&
                    minVal >= 0f && maxVal <= 1f && minVal < maxVal;

                var (min, max) = ok ? (minVal, maxVal) : (0f, 1f);
                var (neuralNetUsed, res) = analyzer?.TryGetMoveQAndTopForPosSequence(player, min, max);
                results.AddRange(res);
                neuralNet = neuralNetUsed;
            }

            analyzer?.StopDistributionEngine();

            var whiteRank1s = results.Count(t => t.PolicyRank == 1 && t.IsWhite);
            var blackRank1s = results.Count(t => t.PolicyRank == 1 && !t.IsWhite);
            var whiteTotal = results.Count(t => t.IsWhite);
            var blackTotal = results.Count(t => !t.IsWhite);
            var whiteFrac = whiteTotal > 0 ? (double)whiteRank1s / whiteTotal * 100 : 0;
            var blackFrac = blackTotal > 0 ? (double)blackRank1s / blackTotal * 100 : 0;
            logger.LogInformation("White Rank1 moves {WhiteRank1} out of {WhiteTotal} fraction {WhiteFrac:F2}%", whiteRank1s, whiteTotal, whiteFrac);
            logger.LogInformation("Black Rank1 moves {blackRank1s} out of {blackTotal} fraction {blackFrac:F2}%", blackRank1s, blackTotal, blackFrac);

            var whiteDistribution = results.Where(t => t.IsWhite)
                .GroupBy(t => t.PolicyRank)
                .Select(g => new { Rank = g.Key, Count = g.Count() })
                .OrderBy(g => g.Rank)
                .ToList();

            var blackDistribution = results.Where(t => !t.IsWhite)
                .GroupBy(t => t.PolicyRank)
                .Select(g => new { Rank = g.Key, Count = g.Count() })
                .OrderBy(g => g.Rank)
                .ToList();

            var distribution = results.GroupBy(t => t.PolicyRank)
                .Select(g => new { Rank = g.Key, Count = g.Count() })
                .OrderBy(g => g.Rank)
                .ToList();

            foreach (var item in distribution)
            {
                var percentage = (double)item.Count / results.Count() * 100;
                logger.LogInformation("Rank {Rank} Count {Count} Percentage {Percentage:F2}%", item.Rank, item.Count, percentage);
            }

            var top5 = distribution.Where(d => d.Rank <= 5).Sum(d => d.Count);
            var top5frac = (double)top5 / results.Count() * 100;
            logger.LogInformation("Top 5 moves {Top5} out of {Total} fraction {Top5Frac:F2}%", top5, results.Count(), top5frac);
            if (SettingsService.Settings.CombineWhiteAndBlackMoves)
            {
                searchInfoPlot?.SetPolicyDistributionCombinedBucketed(
                    distribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    neuralNet,
                    minDistinctRanks: 2,
                    tailStart: 10,
                    rankType: "Q");
            }
            else
            {
                searchInfoPlot?.SetPolicyDistributionBucketed(
                    distribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    whiteDistribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    blackDistribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    neuralNet,
                    minDistinctRanks: 2,
                    tailStart: 7,
                    rankType: "Q");
            }
        }
        catch (Exception ex)
        {
            logger.LogCritical(ex.Message);
            throw;
        }
    }

    private void LoadAndOpenPGNGame(PGNTypes.PgnGame game)
    {
        var board = ChessBoard;
        var gameIndex = PGNgames.IndexOf(game);
        var currentGame = $"{game.GameMetaData.White} - {game.GameMetaData.Black}: {game.GameMetaData.Result} (R# {game.GameMetaData.Round})";
        var fenP = string.IsNullOrEmpty(game.GameMetaData.Fen) ? Chess.startPos : game.GameMetaData.Fen;
        board.ResetBoardState();
        board.StartPosition = fenP;
        board.LoadFen(fenP);
        foreach (var ply in game.Mainline)
        {
            board.PlaySanMoveWithComments(ply.San, ply.Comment);
        }

        fen = board.FEN();
    }

    private async Task ResetEngine()
    {
        if (analyzer == null)
        {
            logger.LogInformation("No engine loaded");
            return;
        }
        if (analyzer.Engine.HasExited)
        {
            analyzer = null;
            await StartAnalyzer();
            searchInProgress = false;
        }

        tableHeader = "";

        analyzer?.Reset();
        ResetSearchTimer();
        if (searchInfoPlot != null)
        {
            await searchInfoPlot.ResetPlot(true);
        }
        if (cpEvalPlot != null)
        {
            await cpEvalPlot.ClearChart();
        }
        NNInfoList.Clear();
        InfoLineList.Clear();
        data.Clear();
        focusedMoves.Clear();
        analyzer?.ClearSearchMoves();
        dataList.Clear();
        StateHasChanged();
    }

    private void RunUCICommand()
    {
        if (analyzer == null)
        {
            logger.LogInformation("No engine loaded");
            return;
        }
        uciButtonPressed = true;
        analyzer?.UCI();
        StateHasChanged();
    }

    private string CalcWDL(WDLType wdlType)
    {
        var wdl = wdlType.Value();
        var total = wdl.Win + wdl.Draw + wdl.Loss;
        var (win, draw, loss) = (wdl.Win / total, wdl.Draw / total, wdl.Loss / total);
        return $"W: {win:P0} D: {draw:P0} L: {loss:P0}";
    }

    private async Task Update(EngineStatus status)
    {
        var nodes = FormatNodes(status.Nodes);
        var nps = GameAnalysis.Formatting.formatNPS(status.NPS);
        var k = status.MultiPV;
        data[k] = status;
        var ordered = data.OrderBy(e => e.Value.MultiPV).ToList();
        var wdlString = status.WDL != null ? CalcWDL(ordered[0].Value.WDL) : "W: N/A D: N/A L: N/A";
        if (status.EPS == 0)
        {
            tableHeader = $"{nodes} ({nps}) (tbhits: {status.TBhits:N0}) ({wdlString})";
        }
        else
        {
            var eps = GameAnalysis.Formatting.formatEPS(status.EPS);
            tableHeader = $"{nodes} ({nps}, {eps}) (tbhits: {status.TBhits:N0}) ({wdlString})";
        }
        dataList = ordered;
        whitePV = ordered[0].Value.PV;

        // Always update PV state for any subscriber (individual or dual dialog)
        UpdatePVState();

        await InvokeAsync(StateHasChanged);
        await Task.CompletedTask;
    }

    public async Task OnNotifyFen(string newPos)
    {
        fen = newPos;
        NNInfoList.Clear();
        if (autoSearchSwitch)
        {
            if (searchInProgress)
            {
                analyzer?.Stop();
                searchInProgress = false;
                StopSearchTimer();
                if (searchInfoPlot != null)
                {
                    await searchInfoPlot?.ResetPlot(false);
                }
                cpEvalPlot?.Clear();
                if (analyzer != null)
                {
                    StartSearchWithMode();
                    searchInProgress = true;
                    StartSearchTimer();
                }
                else
                {
                    searchInProgress = false;
                }
            }
            else
            {
                if (searchInfoPlot != null)
                {
                    await searchInfoPlot?.ResetPlot(false);
                }
                cpEvalPlot?.Clear();
                if (analyzer != null)
                {
                    StartSearchWithMode();
                    searchInProgress = true;
                    StartSearchTimer();
                }
            }
        }
        else
        {
            searchInProgress = false;
            StopSearchTimer();
        }
    }


@using System.Text.RegularExpressions;
@using WebGUI.Components
@using WebGUI.Components.Layout.ChessboardLayout
@using WebGUI.Plotting
@using WebGUI.Services
@using System.Text
@using Toolbelt.Blazor.HotKeys2
@using System.Globalization
@using static ChessLibrary.EngineTypes
@using static ChessLibrary.TypesDef.CoreTypes

@inject IJSRuntime JS
@inject JavaScriptInteropService JsInteropService
@inject NotifierService Notifier
@inject HotKeys HotKeys
@inject IDialogService DialogService
@inject ILogger<EnginePanel> logger
@inject OverlaySetting OverlaySetting
@inject GlobalSettingsService SettingsService
@implements IAsyncDisposable

<div class="engine-panel">
    <header class="ep-header">
        <h5>
            @if (!string.IsNullOrEmpty(Engine?.LogoPath))
            {
                <img class="ep-logo" src="@Engine.LogoPath" alt="@EngineName" />
            }
            else
            {
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
            }
            <span class="ep-engine-name">@EngineName</span>
        </h5>
        <div class="ep-cmd-input">
            <input type="text" @bind="text" placeholder="UCI command" title="Send a raw UCI command to the engine" />
            <button class="ep-btn secondary small" @onclick="DumpEngineStats">run</button>
        </div>
        <label class="ep-switch">
            <span class="label-text @(searchMode == SearchMode.Nodes ? "active" : "")">Nodes</span>
            <input type="checkbox" @bind="timeMode" />
            <span class="slider"></span>
            <span class="label-text @(searchMode == SearchMode.Time ? "active" : "")">Time</span>
        </label>
    </header>

    <div class="ep-controls">
        <button class="ep-btn" disabled="@(searchInProgress || waitingForEngine)" @onclick="Analyze">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            Start
        </button>
        <button class="ep-btn secondary" disabled="@(!searchInProgress || waitingForEngine)" @onclick="StopSearch">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12"/></svg>
            Stop
        </button>
        <button class="ep-btn secondary" disabled="@(searchInProgress || waitingForEngine)" @onclick="ResetEngine">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 4v6h6M23 20v-6h-6M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>
            </svg>
            Reset
        </button>
        <button class="ep-btn secondary" disabled="@(searchInProgress || waitingForEngine)" @onclick="RunUCICommand">
            UCI
        </button>
        <button class="ep-btn secondary" disabled="@(searchInProgress || waitingForEngine)" @onclick="OpenDialog">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
            Settings
        </button>
    </div>

    <div class="ep-limits">
        <div class="ep-field">
            <label>Search limit</label>
            <input type="number"
                   value="@(searchMode == SearchMode.Nodes ? numberOfNodes : numberOfTimeMs)"
                   @onchange="@(e => OnLimitChanged(double.Parse(e.Value?.ToString() ?? "1")))" />
            <span class="ep-limit-display">@FormatSearchLimit()</span>
        </div>

        <button class="ep-upload @(autoSearchSwitch ? "active" : "")" @onclick="ToggleAutoSearch" title="Auto search on position change">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
            </svg>
            Auto
        </button>

        <button class="ep-upload @(focusModeEnabled ? "active" : "")" @onclick="ToggleFocusMode" title="Focus mode: click moves in NN table to restrict search">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
            </svg>
            Focus
        </button>

        <button class="ep-upload" @onclick="BrowseNNFile">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
            </svg>
            Weights
        </button>

        <button class="ep-upload" @onclick="BrowseEngineFile">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
            </svg>
            Engine
        </button>
    </div>

    <div class="ep-nn-info">
        @if (!string.IsNullOrEmpty(neuralNet) && neuralNet != "Not set" && neuralNet != "none")
        {
            <span>NN: @neuralNet</span>
            @if (!string.IsNullOrEmpty(backend))
            {
                <span>@backend</span>
            }
        }
        else if (Engine?.Options != null)
        {
            @if (Engine.Options.ContainsKey("Threads"))
            {
                <span>Threads: @Engine.Options["Threads"]</span>
            }
            @if (Engine.Options.ContainsKey("Hash"))
            {
                <span>Hash: @Engine.Options["Hash"] MB</span>
            }
        }
        else
        {
            <span>NN: Not set</span>
        }
    </div>

    @if (focusModeEnabled && focusedMoves.Count > 0)
    {
        <div class="ep-focus-moves">
            <span class="ep-focus-label">Focus:</span>
            @foreach (var move in focusedMoves.ToArray())
            {
                <span class="ep-focus-chip" @onclick="@(() => RemoveFocusMove(move))">@move x</span>
            }
            <button class="ep-focus-clear" @onclick="ClearFocusMoves">Clear all</button>
        </div>
    }

    <div class="ep-pv-label">
        Principal Variation
        @if (runLogLiveStats && currentPosition != null && currentPosition.Nodes > 0)
        {
            <span class="ep-qv-inline">Q: @currentPosition.Q.ToString("N2") (V: @currentPosition.V.ToString("N2"))</span>
        }
    </div>
    <div class="ep-pv-wrapper">
        <div class="ep-pv">@whitePV</div>
        <button class="ep-copy-btn" @onclick="CopyPVToClipboard" title="Copy full PV to clipboard">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
        </button>
        <button class="ep-copy-btn" @onclick="OpenPVBoardDialog"
                disabled="@string.IsNullOrEmpty(whitePV)"
                title="View PV on board">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
        </button>
    </div>

    @if (currentPosition != null && currentPosition.Nodes > 0)
    {
        <div class="ep-analysis-info">
            <div class="ep-analysis-header">
                <span class="ep-analysis-stats">@tableHeader</span>
                <span class="ep-elapsed" title="Elapsed time">
                    <svg class="ep-clock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    @elapsed.ToString(@"mm\:ss\.f")
                </span>
            </div>
        </div>
    }

    @if (currentPosition != null && currentPosition.Nodes == 0)
    {
        <div class="ep-analysis-info">
            <div class="ep-analysis-header">
                <span class="ep-analysis-stats">@tableHeader</span>
                <span class="ep-elapsed" title="Elapsed time">
                    <svg class="ep-clock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    @elapsed.ToString(@"mm\:ss\.f")
                </span>
            </div>
        </div>
    }

    <div class="ep-charts" hidden="@(!showCharts)">
        <div class="ep-charts-controls">
            <div class="ep-slider" style="min-width:200px;">
                <label>Chart lines: @numberOfLines</label>
                <input type="range" min="1" max="20" step="1" @bind="numberOfLines" />
            </div>

            <label class="ep-switch">
                <input type="checkbox" checked="@showNPlot" @onchange="OnChartToggleChanged" />
                <span class="slider"></span>
                @(showNPlot ? "N-plot" : "Q-plot")
            </label>
        </div>

        <div class="ep-chart-container" hidden="@(!showNPlot)" style="height:@GetChartHeight();">
            <div class="chart" @ref="nPlotReference" style="height:100%;"></div>
        </div>
        <div class="ep-chart-container" hidden="@showNPlot" style="height:@GetChartHeight();">
            <div class="chart" @ref="qPlotReference" style="height:100%;"></div>
        </div>
    </div>

    <div class="ep-charts" hidden="@(!showCpChart)">
        <div class="ep-charts-controls">
            <div class="ep-slider" style="min-width:200px;">
                <label>Chart lines: @cpChartLines</label>
                <input type="range" min="1" max="20" step="1" @bind="cpChartLines" />
            </div>
        </div>
        <div class="ep-chart-container" style="height:@GetCpChartHeight();">
            <div class="chart" @ref="cpChartReference" style="height:100%;"></div>
        </div>
    </div>

    @if (showNNdata)
    {
        <div class="ep-table-container">
            <table class="ep-table ep-nn-table">
                <thead>
                    <tr>
                        <th class="ep-th-with-toggle">
                            Log live move stats
                            <button class="ep-raw-toggle @(showNNdata ? "active" : "")"
                                    disabled="@(NNInfoList.Count == 0)"
                                    @onclick="ShowSearchPlot"
                                    title="Show analysis table">
                                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                    <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                    <polyline points="14 2 14 8 20 8"/>
                                    <line x1="16" y1="13" x2="8" y2="13"/>
                                    <line x1="16" y1="17" x2="8" y2="17"/>
                                    <line x1="10" y1="9" x2="8" y2="9"/>
                                </svg>
                            </button>
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in NNInfoList.ToArray())
                    {
                        <tr class="@(focusedMoves.Contains(item?.LANMove) ? "ep-focused-row" : "")"
                            @onclick="@(() => OnNNTableRowClick(item))">
                            <td>@item?.Raw</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }

    @if (!showNNdata)
    {
        <div class="ep-table-container">
            <table class="ep-table">
                <thead>
                    <tr>
                        <th>Eval</th>
                        <th>D</th>
                        <th>SD</th>
                        <th class="ep-th-with-toggle">
                            PV
                            @if (runLogLiveStats)
                            {
                                <button class="ep-raw-toggle @(showNNdata ? "active" : "")"
                                        disabled="@(NNInfoList.Count == 0)"
                                        @onclick="ShowSearchPlot"
                                        title="Show raw output">
                                    <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                                        <path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/>
                                        <polyline points="14 2 14 8 20 8"/>
                                        <line x1="16" y1="13" x2="8" y2="13"/>
                                        <line x1="16" y1="17" x2="8" y2="17"/>
                                        <line x1="10" y1="9" x2="8" y2="9"/>
                                    </svg>
                                </button>
                            }
                        </th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in dataList.ToArray())
                    {
                        <tr class="@(focusModeEnabled && focusedMoves.Contains(GetFirstMove(item.Value.PVLongSAN)) ? "ep-focused-row" : "")"
                            @onclick="@(() => OnPVTableRowClick(item))">
                            <td>@item.Value.Eval</td>
                            <td>@item.Value.Depth</td>
                            <td>@item.Value.SD</td>
                            <td class="pv-cell">@item.Value.PV</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>

@if (showPVBoard)
{
    <PVBoardLive State1="@pvState" OnClose="ClosePVBoardDialog" />
}

@code {
    [Parameter] public ChessLibrary.Chess.Board ChessBoard { get; set; }
    [Parameter] public EventCallback<List<string>> OnUCIReceived { get; set; }
    [Parameter] public EventCallback<string> OnEngineMoveMade { get; set; }
    [Parameter] public string Id { get; set; }
    [Parameter] public string FEN { get; set; }
    [Parameter] public EngineConfig Engine { get; set; }
    [Parameter] public EventCallback<EngineConfigEventArgs> OnNewEngineLoaded { get; set; }
    [Parameter] public List<PGNTypes.PgnGame> PGNgames { get; set; }
    [Parameter] public string Player { get; set; }

    private int Nodes = 0;
    private int ChartLines = 3;
    private string zobristHash;
    private bool overlayDropdownOpen = false;

    public string ZobristHash
    {
        get { return ChessBoard.PositionHash().ToString(); }
        set { zobristHash = value; }
    }

    private string text = "dump-uci";
    private bool showNPlot = true;
    private string currentName = string.Empty;
    private OverlaySettings selectedOverlaySetting = OverlaySettings.None;
    private NNValues currentPosition = NNValues.Empty;
    private bool runLogLiveStats;
    private System.Text.RegularExpressions.Regex firstMoveInPV = new(@"(?:\d+\.\.\.\.|^\d+\.)\s*([^\s]+)", RegexOptions.Compiled);
    private string whitePV;
    private string fenUri = string.Empty;
    private bool uciButtonPressed = false;
    string EngineName => Engine == null ? "Engine not initialized" : Engine.Name;

    private System.Text.Json.JsonSerializerOptions options =
        new System.Text.Json.JsonSerializerOptions { WriteIndented = true, IncludeFields = true, AllowTrailingCommas = true };

    private string fen = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
    private ElementReference nPlotReference;
    private ElementReference qPlotReference;
    private SearchInfoPlot searchInfoPlot;
    private IJSObjectReference chessModule;
    private string tableHeader = "";
    private HashSet<PGNTypes.PgnGame> selectedItems = new();
    public bool QChartSelected { get; set; } = false;
    public CultureInfo currentCulture = CultureInfo.CurrentCulture;
    private bool engine1 => Id.Contains("1") ? true : false;
    private bool optimisticHead;
    private int numberOfLines = 3;
    private double numberOfNodes = 1;
    private CancellationTokenSource cts = new();
    private bool showNNdata = false;
    private string moveHistory = string.Empty;
    private bool keepNodesWhileSearching = true;
    private double Qdiff = 2;
    public bool autoSearchSwitch { get; set; } = false;
    public bool showCharts { get; set; } = true;
    private string neuralNet = "Not set";
    private string backend = "";
    private bool searchInProgress = false;
    private bool showPVBoard = false;
    private PVState pvState = new();
    private bool showCpChart = false;
    private ElementReference cpChartReference;
    private CpEvalPlot cpEvalPlot;
    private int cpChartLines = 4;
    private bool focusModeEnabled = false;
    private List<string> focusedMoves = new();

    // Expose PVState for parent components (e.g., DualAnalysis for dual comparison)
    public PVState PVState => pvState;
    private bool waitingForEngine = false;
    private ChessLibrary.AnalysisManager.SimpleEngineAnalyzer analyzer;
    private List<NNValues> NNInfoList = new();
    public List<string> InfoLineList = new();
    string baseline0 = """backend=cuda-fp16,(gpu=0,value_head=winner)""";
    string baseline1 = """backend=cuda-fp16,(gpu=1,value_head=winner)""";
    string opt0 = """backend=cuda-fp16,(gpu=0,policy_head=optimistic,value_head=winner)""";
    string opt1 = """backend=cuda-fp16,(gpu=1,policy_head=optimistic,value_head=winner)""";
    HotKeysContext keyContext;
    public List<KeyValuePair<int, EngineStatus>> dataList = new();
    Dictionary<int, EngineStatus> data = new();
    public bool IsOpt { get; set; } = false;
    private IDialogReference dialogReference;
    public double MinPolicyThreshold { get; set; }
    private System.Diagnostics.Stopwatch searchWatch = new();
    private System.Timers.Timer uiTimer;
    private TimeSpan elapsed = TimeSpan.Zero;

    private enum SearchMode { Nodes, Time }

    private SearchMode searchMode = SearchMode.Nodes;
    private double numberOfTimeMs = 3000;
    private string GetLimitLabel() => searchMode == SearchMode.Nodes ? "Node limit" : "Time (ms)";
    private bool timeMode
    {
        get => searchMode == SearchMode.Time;
        set => OnSearchModeChanged(value ? SearchMode.Time : SearchMode.Nodes);
    }

    private void ToggleOverlayDropdown()
    {
        overlayDropdownOpen = !overlayDropdownOpen;
    }

    private void ToggleAutoSearch()
    {
        autoSearchSwitch = !autoSearchSwitch;
    }

    private string FormatSearchLimit()
    {
        if (searchMode == SearchMode.Nodes)
            return $"{numberOfNodes:N0} nodes";
        else
            return $"{numberOfTimeMs:N0} ms";
    }

    private void OnSearchModeChanged(SearchMode mode)
    {
        searchMode = mode;
        StateHasChanged();
    }

    private void OnLimitChanged(double value)
    {
        if (searchMode == SearchMode.Nodes)
            numberOfNodes = Math.Max(1, value);
        else
            numberOfTimeMs = Math.Max(1, value);
    }

    private void StartSearchWithMode()
    {
        if (analyzer == null)
            return;

        if (searchMode == SearchMode.Nodes)
        {
            analyzer.SearchNodes((int)numberOfNodes, keepNodesWhileSearching);
            return;
        }

        var ms = (int)Math.Max(1, Math.Round(numberOfTimeMs));
        var goCmd = $"go movetime {ms}";
        analyzer.Play(goCmd);
    }

    private void StartSearchTimer()
    {
        searchWatch.Reset();
        searchWatch.Start();
        elapsed = TimeSpan.Zero;
        uiTimer?.Dispose();
        uiTimer = new System.Timers.Timer(100);
        uiTimer.Elapsed += (s, e) =>
        {
            elapsed = searchWatch.Elapsed;
            InvokeAsync(StateHasChanged);
        };
        uiTimer.Start();
    }

    private void StopSearchTimer()
    {
        searchWatch.Stop();
        uiTimer?.Stop();
        uiTimer?.Dispose();
        uiTimer = null;
    }

    private void ResetSearchTimer()
    {
        StopSearchTimer();
        elapsed = TimeSpan.Zero;
    }

    private async Task OnMinPolicyThresholdChanged(double value)
    {
        MinPolicyThreshold = value;
        OverlaySetting.MinPolicyThreshold = value;
        await Notifier.UpdateDisplaySettings(selectedOverlaySetting, Id);
    }

    private string GetOverlayLabel()
    {
        switch (selectedOverlaySetting)
        {
            case OverlaySettings.Policy:
                return "Policy";
            case OverlaySettings.QVDiff:
                return "QVDiff";
            case OverlaySettings.None:
                return "None";
            default:
                return $"{selectedOverlaySetting}";
        }
    }

    private async Task OnOverlaySettingChanged(OverlaySettings newSetting)
    {
        selectedOverlaySetting = newSetting;
        OverlaySetting.SetOverlaySetting(Id, selectedOverlaySetting);
        await Notifier.UpdateDisplaySettings(newSetting, Id);
        overlayDropdownOpen = false;
        StateHasChanged();
    }

    private string GetChartHeight()
    {
        return $"{200 + (numberOfLines - 1) * 15}px";
    }

    private string GetCpChartHeight()
    {
        return $"{200 + (cpChartLines - 1) * 15}px";
    }

    async Task OpenDialog()
    {
        if (analyzer == null)
        {
            logger.LogInformation("No engine loaded");
            return;
        }
        var fontSize = 20;

        var options = new DialogOptions() { MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
        if (analyzer == null)
            return;

        var parameters = new DialogParameters{
            {"FontSize",  fontSize },
            {"Engine", analyzer.Engine }};

        var header = $"Current settings for {Engine.Name}";
        dialogReference = await DialogService.ShowAsync<Pages.AnalysisPages.SetOptions>(header, parameters, options);
    }

    void CloseDialog() => dialogReference?.Close();

    private void DumpEngineStats()
    {
        var command = text;
        analyzer?.DumpStats(command);
    }

    private async Task CopyPVToClipboard()
    {
        if (!string.IsNullOrEmpty(whitePV))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", whitePV);
        }
    }

    private void OpenPVBoardDialog()
    {
        if (string.IsNullOrEmpty(whitePV)) return;

        // Update PV state with current data before showing
        UpdatePVState();
        showPVBoard = true;
        StateHasChanged();
    }

    private void ClosePVBoardDialog()
    {
        showPVBoard = false;
        StateHasChanged();
    }

    private void UpdatePVState()
    {
        if (dataList.Count == 0) return;

        var status = dataList[0].Value;
        pvState.Update(
            engineName: EngineName,
            engineId: Id,
            pvMoves: status.PVLongSAN,
            startFen: ChessBoard.FEN(),  // Use current position, not game start
            depth: status.Depth,
            nodes: status.Nodes,
            eval: status.Eval?.ToString() ?? "",
            isSearching: searchInProgress
        );
    }

    private async Task OnChartToggleChanged(ChangeEventArgs e)
    {
        showNPlot = (bool)(e.Value ?? false);
        StateHasChanged();
        // Small delay to allow DOM to update visibility
        await Task.Delay(100);
        if (!showNPlot && searchInfoPlot != null)
        {
            // Re-render the rank chart from scratch now that the Q-plot container is visible
            await searchInfoPlot.ReRenderRankSequence();
        }
        else if (chessModule is not null)
        {
            var chartRef = showNPlot ? nPlotReference : qPlotReference;
            await chessModule.InvokeVoidAsync("resizePlot", chartRef);
        }
    }


    private string FormatNodes(double nodes)
    {
        if (nodes > 1_000_000_000)
            return (nodes / 1_000_000_000).ToString("F1") + "B nodes";
        else if (nodes > 1_000_000)
            return (nodes / 1_000_000).ToString("F1") + "M nodes";
        else if (nodes > 1_000)
            return (nodes / 1_000).ToString("F1") + "K nodes";
        else
            return nodes.ToString("F1") + " nodes";
    }

    private async Task PlayMoveFromNNTable(NNValues moveInfo)
    {
        InfoLineList.Clear();
        if (autoSearchSwitch)
        {
            searchInProgress = true;
            await searchInfoPlot.ResetPlot(false);
            var move = moveInfo.LANMove;

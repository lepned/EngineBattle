    public async void HandleUpdate(EngineUpdate update)
    {
        switch (update)
        {
            case EngineUpdate.Done player:
                break;

            case EngineUpdate.Ready ready:
                showCharts = ready.HasLiveStat;
                showCpChart = !ready.HasLiveStat;
                showNNdata = false;
                searchInProgress = false;
                waitingForEngine = false;
                break;

            case EngineUpdate.Info i:
                InfoLineList.Insert(0, (i.Info));
                break;

            case EngineUpdate.Eval e:
                break;

            case EngineUpdate.BestMove b:
                whitePV = b.Item.PV;
                searchInProgress = false;
                waitingForEngine = false;
                var evalComment = $"{{{b.Item.Eval}/{b.Item.Nodes.ToString("N0")}}}";
                ChessBoard.SetCommentOnCurrentEdge(evalComment);
                StopSearchTimer();
                // Always update PV state for any subscriber
                pvState.SetSearching(false);
                await InvokeAsync(() => StateHasChanged());
                break;

            case EngineUpdate.UCIInfo info:
                if (uciButtonPressed)
                {
                    await InvokeAsync(() => OnUCIReceived.InvokeAsync(info.Data));
                }
                break;

            case EngineUpdate.Status s:
                var status = s.Item;
                await Update(status);
                if (!runLogLiveStats && showCpChart && cpEvalPlot != null)
                {
                    cpEvalPlot.AddDataPoint(status.MultiPV, status.Depth, status.Eval, status.PV);
                    await cpEvalPlot.UpdateChart(EngineName, cpChartLines);
                }
                break;

            case EngineUpdate.PolicyDistributionOutCome ds:
                var list = ds.Item;
                break;

            case EngineUpdate.NNSeq n:
                if (n.NNSeq.Count > 0)
                {
                    NNInfoList.Clear();
                    n.NNSeq.Reverse();
                    currentPosition = n.NNSeq.FirstOrDefault();
                    NNInfoList.AddRange(n.NNSeq);
                    var skipTopNode = NNInfoList.Skip(1).ToList();
                    searchInfoPlot.AddData(skipTopNode);
                    if (NNInfoList.Count > 0)
                        await Notifier.MovesWithId(NNInfoList, Id);
                    var maxLines = Math.Min(numberOfLines, NNInfoList.Count);
                    await searchInfoPlot?.UpdateLogLiveCharts(skipTopNode, maxLines, Qdiff);
                }
                break;
        }
    }


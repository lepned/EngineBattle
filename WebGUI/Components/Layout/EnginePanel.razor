    private async Task LoadUciScript()
    {
        if (analyzer == null) return;

        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, SettingsService.Settings.EngineDefsFolder },
            { x => x.FileFilter, "*.txt" },
            { x => x.Mode, WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog.FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select UCI Script", parameters, options);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;

        var filePath = (string)result.Data!;
        try
        {
            var lines = await File.ReadAllLinesAsync(filePath);
            int sent = 0, skipped = 0;
            foreach (var line in lines)
            {
                var trimmed = line.Trim();
                if (string.IsNullOrEmpty(trimmed) || trimmed.StartsWith("#")) continue;
                // options wait for an idle engine; go, stop, position and the like are skipped
                if (analyzer.Script(trimmed)) sent++; else skipped++;
            }
            logger.LogInformation("Loaded UCI script {File}: {Sent} commands sent, {Skipped} skipped", filePath, sent, skipped);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to load UCI script {File}", filePath);
        }
    }

    // A new list instance is sent right before the next search, followed by ucinewgame: Lc0
    // keeps its tree for a repeated position, and the old nodes keep the old contempt - the
    // eval did not move until the tree was cleared. Only a freshly started engine, with no
    // tree yet, gets the options at once.
    private void ApplyExtraSetOptions(bool engineJustStarted = false)
    {
        if (analyzer == null) return;
        appliedExtraSetOptions = ExtraSetOptions;
        if (ExtraSetOptions == null) return;
        // Echoed to the console (the desktop app has one too), so what the engine got can be
        // read off the screen: the exact lines, and the ucinewgame that follows them.
        var name = Engine?.Name ?? Id;
        var when = engineJustStarted ? "at start" : "before the next search";
        ChessLibrary.RuntimeUtilities.ConsoleUtils.printInColor(ConsoleColor.Cyan, $"[{name}] setoptions {when}:");
        foreach (var option in ExtraSetOptions)
        {
            ChessLibrary.RuntimeUtilities.ConsoleUtils.printInColor(ConsoleColor.Cyan, $"  setoption name {option.Name} value {option.Value}");
            analyzer.AddSetoption(option);
        }
        if (!engineJustStarted)
        {
            ChessLibrary.RuntimeUtilities.ConsoleUtils.printInColor(ConsoleColor.Cyan, "  ucinewgame");
            analyzer.NewGame();
        }
    }

    // The engine running or being started; a different one from the host replaces it.
    private string engineNameInUse;
    // the engine name the host passed last time
    private string lastHostEngineName;
    // counts replacements: a start finishing under an older count is dropped
    private int engineGeneration;
    // a start in progress: a second caller waits for it instead of starting another engine
    private Task startingAnalyzer;

    private Task StartAnalyzer()
    {
        if (analyzer != null) return Task.CompletedTask;
        return startingAnalyzer ??= StartAnalyzerCore(engineGeneration);
    }

    private async Task StartAnalyzerCore(int generation)
    {
        // returns to the caller first, so startingAnalyzer is set before the finally below clears it
        await Task.Yield();
        var config = Engine;
        engineNameInUse = config?.Name;
        try
        {
            Action<SearchUpdate> onUpdate = u => Dispatch(u.Update, u.Fen, u.SearchId, generation);
            var newAnalyzer = await Task.Run(() => new AnalysisManager.SimpleEngineAnalyzer(config, ChessBoard, logger, onUpdate, false));
            if (disposeCts.IsCancellationRequested || generation != engineGeneration)
            {
                EngineQuit.OffThread(newAnalyzer, logger);
                return;
            }
            analyzer = newAnalyzer;
            // started outside a search (Ctrl+P/Q, the Engine button's own path): the model learns it
            if (model.Engine.IsNotStarted)
                await Send(PanelModel.Event.EngineReady);
            await Send(PanelModel.Event.NewLinesChanged(ActiveChartLines));
            appliedExtraSetOptions = null;
            ApplyExtraSetOptions(engineJustStarted: true);
            if (OnEngineStarted.HasDelegate)
            {
                IReadOnlyCollection<string> names = newAnalyzer.Engine.GetUCICommands().Keys.ToList();
                await OnEngineStarted.InvokeAsync(names);
            }
        }
        finally
        {
            if (generation == engineGeneration) startingAnalyzer = null;
        }
    }

    /// The engine quits (exited, or another is loaded); a start in progress is dropped when it finishes.
    private async Task ReplaceAnalyzer()
    {
        DropAnalyzer();
        await Send(PanelModel.Event.EngineGone);
    }

    // The engine goes (replaced, or it died); a start in progress is dropped when it finishes.
    private void DropAnalyzer()
    {
        engineGeneration++;
        startingAnalyzer = null;
        engineNameInUse = null;
        EngineQuit.OffThread(analyzer, logger);
        analyzer = null;
    }


    private async Task SetChartView(ChartView view)
    {
        if (chartView == view) return;
        chartView = view;
        StateHasChanged();
        // Allow DOM to update visibility before talking to Plotly.
        await Task.Delay(100);
        // Plotly's responsive handler doesn't re-fire on hidden→visible toggles, so explicitly
        // resize the now-visible chart for every view (Q used to be skipped).
        if (chessModule is not null)
        {
            var chartRef = view switch
            {
                ChartView.N => nPlotReference,
                ChartView.Q => qPlotReference,
                ChartView.Convergence => convergencePlotReference,
                _ => nPlotReference,
            };
            await chessModule.InvokeVoidAsync("resizePlot", chartRef);
        }
        if (view == ChartView.Q && searchInfoPlot != null)
        {
            // Q-plot shares the rank-sequence overlay; re-render now that the container is visible.
            await searchInfoPlot.ReRenderRankSequence();
        }
        // Re-render the now-visible chart from accumulated data. Plotly.newPlot into a hidden
        // container produces an empty (0x0) chart that resize can't recover, so any chart that
        // was hidden during prior live updates needs a fresh render once it becomes visible.
        if (searchInfoPlot != null && NNInfoList.Count > 1)
        {
            var skipTopNode = NNInfoList.Skip(1).ToList();
            var maxLines = Math.Min(numberOfLines, skipTopNode.Count);
            switch (view)
            {
                case ChartView.N:
                    await searchInfoPlot.SetNChartData(skipTopNode, maxLines, Qdiff);
                    break;
                case ChartView.Q:
                    await searchInfoPlot.SetQChartData(skipTopNode, maxLines, Qdiff);
                    break;
                case ChartView.Convergence:
                    await searchInfoPlot.SetConvergenceChart(skipTopNode, maxLines, Qdiff);
                    break;
            }
        }
    }


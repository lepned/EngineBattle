    private async Task StartFromPanel(PanelModel.Limit limit)
    {
        if (Engine == null || chessModule == null)
            return;
        if (analyzer != null && analyzer.Engine.HasExited)
            await ReplaceAnalyzer();
        if (searchInfoPlot == null)
        {
            searchInfoPlot = new SearchInfoPlot(chessModule, qPlotReference, nPlotReference, "Cp-value", fen, neuralNet);
            searchInfoPlot.CompactLegend = CompactChartLegend;
            searchInfoPlot.ConvergenceChartElement = convergencePlotReference;
        }
        // The search that starts draws the board's overlay. Read the setting for this slot
        // from the singleton, not from the panel's own copy: a host page sets the singleton
        // (Dual analysis, the contempt page) and the copy only catches up on the panel's next
        // parameter render, which may not have happened before the first Start.
        var overlayForThisSlot = OverlaySetting.GetOverlaySetting(Id);
        if (overlayForThisSlot != OverlaySettings.None)
        {
            selectedOverlaySetting = overlayForThisSlot;
            await Notifier.UpdateDisplaySettings(overlayForThisSlot, Id);
        }
        try
        {
            await Send(PanelModel.Event.NewStart(RequestFor(limit)));
        }
        catch (Exception ex)
        {
            logger.LogWarning("Failed to start analysis: {Message}", ex.Message);
            await Send(PanelModel.Event.Stop);
        }
        await InvokeAsync(StateHasChanged);
    }


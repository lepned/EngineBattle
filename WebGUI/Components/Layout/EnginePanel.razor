    // The policy (P) or Q rank of every move played: the game on the board, or every loaded game
    // (the moves of Player when he took part). Ctrl+P / Ctrl+Q and Ctrl+Alt+P / Ctrl+Alt+Q.
    private Task CheckAnalysis() => RankAnalysis(q: false, allGames: false);
    private Task DoQAnalysis() => RankAnalysis(q: true, allGames: false);
    private Task CheckAllGamesAnalysis() => RankAnalysis(q: false, allGames: true);
    private Task CheckAllGamesQAnalysis() => RankAnalysis(q: true, allGames: true);

    private async Task RankAnalysis(bool q, bool allGames)
    {
        var rankType = q ? "Q" : "Policy";
        if (!showCharts) { logger.LogWarning("{RankType} rank analysis requires a neural network engine with LogLiveStats", rankType); return; }
        try
        {
            StateHasChanged();
            if (analyzer == null)
            {
                logger.LogInformation("No engine loaded");
                await StartAnalyzer();
            }
            if (analyzer == null) return;
            var (min, max) = PolicyFilter();
            Tuple<string, List<PolicyRankInfo>> Ranks(string player) =>
                q ? analyzer.TryGetMoveQAndTopForPosSequence(player, min, max)
                  : analyzer.TryGetMovePolicyAndTopForPosSequence(player, min, max);

            var results = new List<PolicyRankInfo>();
            string net;
            if (allGames)
            {
                var playerInSearch = Player.Trim();
                foreach (var game in PGNgames)
                {
                    logger.LogInformation("{RankType} rank of game {White} - {Black} result {Result} round {Round}",
                        rankType, game.GameMetaData.White, game.GameMetaData.Black, game.GameMetaData.Result, game.GameMetaData.Round);
                    LoadAndOpenPGNGame(game);
                    var player = game.GameMetaData.White.Trim() == playerInSearch ? "w"
                               : game.GameMetaData.Black.Trim() == playerInSearch ? "b" : "all";
                    var (used, res) = Ranks(player);
                    results.AddRange(res);
                    neuralNet = used;
                }
                net = neuralNet;
            }
            else
            {
                logger.LogInformation("Starting analysis with {Fen} and moves {History}", ChessBoard.FEN(), ChessBoard.GetMoveHistory());
                var (used, res) = Ranks("all");
                results.AddRange(res);
                net = used;
                foreach (var item in res)
                    logger.LogInformation("{Player} {Rank} Move played {MovePlayed} Policy {Policy:F2}% Top move {Top} policy {TopPolicy:F2}%",
                        item.IsWhite ? "White" : "Black", item.PolicyRank, item.PlayedMove.SANMove, item.PlayedMove.P, item.BestMove.SANMove, item.BestMove.P);
                _ = searchInfoPlot?.SetRankSequence(res, net, rankType: rankType, isVisible: !showNPlot);
            }
            analyzer.StopDistributionEngine();
            ShowRankDistribution(results, net, rankType);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "{RankType} rank analysis failed", rankType);
        }
    }

    // PolicyDistributionMinMaxFilter "min,max" (both in 0..1), else the whole range.
    private (float Min, float Max) PolicyFilter()
    {
        var parts = (SettingsService.Settings.PolicyDistributionMinMaxFilter ?? "")
            .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);
        float minVal = 0f, maxVal = 1f;
        var ok =
            parts.Length == 2 &&
            float.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out minVal) &&
            float.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out maxVal) &&
            minVal >= 0f && maxVal <= 1f && minVal < maxVal;
        return ok ? (minVal, maxVal) : (0f, 1f);
    }

    // Rank-1 shares per side, the rank distribution in the log, and its chart.
    private void ShowRankDistribution(List<PolicyRankInfo> results, string net, string rankType)
    {
        if (results.Count == 0) { logger.LogInformation("{RankType} rank analysis: no moves to rank", rankType); return; }
        foreach (var white in new[] { true, false })
        {
            var rank1 = results.Count(t => t.PolicyRank == 1 && t.IsWhite == white);
            var total = results.Count(t => t.IsWhite == white);
            logger.LogInformation("{Side} Rank1 moves {Rank1} out of {Total} fraction {Frac:F2}%",
                white ? "White" : "Black", rank1, total, total > 0 ? (double)rank1 / total * 100 : 0);
        }

        List<Tuple<int, int>> DistributionOf(IEnumerable<PolicyRankInfo> moves) =>
            moves.GroupBy(t => t.PolicyRank).OrderBy(g => g.Key).Select(g => Tuple.Create(g.Key, g.Count())).ToList();
        var distribution = DistributionOf(results);
        foreach (var d in distribution)
            logger.LogInformation("Rank {Rank} Count {Count} Percentage {Percentage:F2}%", d.Item1, d.Item2, (double)d.Item2 / results.Count * 100);
        var top5 = distribution.Where(d => d.Item1 <= 5).Sum(d => d.Item2);
        logger.LogInformation("Top 5 moves {Top5} out of {Total} fraction {Top5Frac:F2}%", top5, results.Count, (double)top5 / results.Count * 100);

        if (SettingsService.Settings.CombineWhiteAndBlackMoves)
            _ = searchInfoPlot?.SetPolicyDistributionCombinedBucketed(distribution, net, minDistinctRanks: 2, tailStart: 10, rankType: rankType);
        else
            _ = searchInfoPlot?.SetPolicyDistributionBucketed(distribution,
                DistributionOf(results.Where(t => t.IsWhite)), DistributionOf(results.Where(t => !t.IsWhite)),
                net, minDistinctRanks: 2, tailStart: 7, rankType: rankType);
    }

    private void LoadAndOpenPGNGame(PGNTypes.PgnGame game)
    {
        var board = ChessBoard;
        var fenP = string.IsNullOrEmpty(game.GameMetaData.Fen) ? Chess.startPos : game.GameMetaData.Fen;
        board.ResetBoardStateFromFen(fenP);
        foreach (var ply in game.Mainline)
        {
            board.PlaySanMoveWithComments(ply.San, ply.Comment);
        }

        fen = board.FEN();
    }

    private async Task ResetEngine()
    {
        if (analyzer == null)
        {
            logger.LogInformation("No engine loaded");
            return;
        }
        if (analyzer.Engine.HasExited)
            await ReplaceAnalyzer();
        await Send(PanelModel.Event.Reset);
        ResetSearchTimer();
        if (searchInfoPlot != null)
            await searchInfoPlot.ResetPlot(true);
        if (cpEvalPlot != null)
        {
            await cpEvalPlot.ClearChart();
            cpChartDirty = false;
        }
        StateHasChanged();
    }

    private void RunUCICommand()
    {
        if (analyzer == null)
        {
            logger.LogInformation("No engine loaded");
            return;
        }
        uciButtonPressed = true;
        analyzer?.UCI();
        StateHasChanged();
    }

    private async Task PublishEval(Microsoft.FSharp.Core.FSharpOption<double> cp, Microsoft.FSharp.Core.FSharpOption<int> mate)
    {
        if (!OnEvalUpdated.HasDelegate) return;
        double? c = Microsoft.FSharp.Core.FSharpOption<double>.get_IsSome(cp) ? cp.Value : null;
        int? m = Microsoft.FSharp.Core.FSharpOption<int>.get_IsSome(mate) ? mate.Value : null;
        await OnEvalUpdated.InvokeAsync((c, m));
    }

    // Marshalled to the dispatcher: Notifier events run on whatever thread raised them.
    // A move, a navigation, a PGN or EPD loaded: the model stops, clears and (auto) searches.
    public Task OnNotifyFen(string newPos) => InvokeAsync(async () =>
    {
        fen = newPos;
        await Send(PanelModel.Event.Navigated);
    });

    protected override Task OnInitializedAsync()
    {
        if (ReviewDefaults || IsReviewing)
        {
            numberOfTimeMs = SettingsService.Settings.ReviewTimePerMove;
            numberOfNodes = Math.Max(1, SettingsService.Settings.ReviewNodes);
            searchMode = string.Equals(SettingsService.Settings.ReviewSearchMode, "Nodes", StringComparison.OrdinalIgnoreCase)
                ? SearchMode.Nodes : SearchMode.Time;
        }
        else
        {
            numberOfTimeMs = SettingsService.Settings.DefaultSearchTimeMs;
            numberOfNodes = Math.Max(1, SettingsService.Settings.DefaultSearchNodes);
            if (string.Equals(SettingsService.Settings.DefaultSearchMode, "Time", StringComparison.OrdinalIgnoreCase))
                searchMode = SearchMode.Time;
            if (InitialTimeMs is > 0)
            {
                searchMode = SearchMode.Time;
                numberOfTimeMs = InitialTimeMs.Value;
            }
        }
        MinPolicyThreshold = OverlaySetting.MinPolicyThreshold;
        model = PanelModel.step(model, PanelModel.Event.NewReviewingChanged(IsReviewing)).Item1;
        Notifier.NotifyFen += OnNotifyFen;

        this.keyContext = this.HotKeys.CreateContext()
            .Add(Key.Escape, (Func<Task>)(async () => await ResetEngine()), "reset engine")
            .Add(ModKey.Ctrl, Key.g, (Func<Task>)(async () => await InvokeAsync(GoInfinite)), "go search")
            .Add(ModKey.Ctrl, Key.h, (Func<Task>)(async () => await InvokeAsync(StopSearch)), "stop search")
            .Add(ModKey.Ctrl, Key.p, (() => CheckAnalysis()), "check P-rank")
            .Add(ModKey.Ctrl, Key.q, (Func<Task>)(async () => await DoQAnalysis()), "check Q-rank")
            .Add(ModCode.Ctrl | ModCode.Alt, Code.P, (() => CheckAllGamesAnalysis()), "check all games policy")
            .Add(ModCode.Ctrl | ModCode.Alt, Code.Q, (Func<Task>)(async () => await CheckAllGamesQAnalysis()), "check all games Q-rank")
            .Add(Key.F1, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 1; await Analyze(); })), "Analyze 1 node")
            .Add(Key.F2, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 1_000; await Analyze(); })), "Analyze 1_000 nodes")
            .Add(Key.F3, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 10_000; await Analyze(); })), "Analyze 10_000 nodes")
            .Add(Key.F4, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 100_000; await Analyze(); })), "Analyze 100_000 nodes")
            .Add(Key.F5, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 1_000_000; await Analyze(); })), "Analyze 1_000_000 nodes")
            .Add(Key.F6, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 10_000_000; await Analyze(); })), "Analyze 10_000_000 nodes")
            .Add(Key.F7, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 100_000_000; await Analyze(); })), "Analyze 100_000_000 nodes")
            .Add(Key.F8, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 1_000_000_000; await Analyze(); })), "Analyze 1_000_000_000 nodes");

        return base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        // a review starting stops the panel's own search
        if (model.Reviewing != IsReviewing)
            await Send(PanelModel.Event.NewReviewingChanged(IsReviewing));
        // another engine from the host: the one running or starting is for the old config. Only a
        // change of what the host passes counts - a host that ignores the Engine button keeps
        // passing its old def, and that must not undo the button's engine.
        var hostChanged = Engine?.Name != lastHostEngineName;
        lastHostEngineName = Engine?.Name;
        if (hostChanged && Engine is not null && engineNameInUse != null && Engine.Name != engineNameInUse)
        {
            logger.LogInformation("Engine {Old} replaced by {New}", engineNameInUse, Engine.Name);
            await ReplaceAnalyzer();
        }
        // any new engine (the host's or the Engine button's): the views reset; the process is only replaced above
        if (Engine is not null && Engine.Name != currentName && !string.IsNullOrEmpty(currentName))
        {
            logger.LogInformation("Engine name changed from {OldName} to {NewName}", currentName, Engine.Name);
            currentName = Engine.Name;
            if (searchInfoPlot != null) await searchInfoPlot.ResetNPlot();
            await InvokeAsync(() => NNInfoList = new());
            // New engine: captured info lines belong to the old one — don't let the
            // copy output pair them with the new engine's description.
            ClearIterations();
            lastMainInfoLine = "";
            lastInfoByMultiPv.Clear();
            neuralNet = string.Empty;
            // The old engine's arrows go; whether this slot keeps an overlay depends on the new
            // engine. One without live stats cannot draw one, so the slot is switched off. One
            // with them keeps what the host page set for the slot (Dual analysis and the
            // contempt page set both slots when an engine is loaded) - wiping it here used to
            // leave a Ceres loaded through the panel's Engine button with no overlay at all,
            // because the auto-overlay below only steps in when NO slot has one.
            await Notifier.UpdateDisplaySettings(OverlaySettings.None, Id);
            if (Engine.Options?.Keys.Contains("LogLiveStats") == true)
                selectedOverlaySetting = OverlaySetting.GetOverlaySetting(Id);
            else
            {
                OverlaySetting.SetOverlaySetting(Id, OverlaySettings.None);
                selectedOverlaySetting = OverlaySettings.None;
            }
        }

        var overlaySettings = OverlaySetting.GetOverlaySetting(Id);
        if (OverlaySetting.IsOverlaySettingsEnabled)
        {
            if (overlaySettings != selectedOverlaySetting)
            {
                selectedOverlaySetting = overlaySettings;
            }
        }
        if (Engine != null)
        {
            runLogLiveStats = analyzer?.Engine.GetUCICommands().ContainsKey("LogLiveStats") ?? Engine.Options.Keys.Contains("LogLiveStats");
            showCharts = runLogLiveStats;
            showCpChart = !runLogLiveStats;
            if (runLogLiveStats && overlaySettings == OverlaySettings.None)
            {
                if (!OverlaySetting.IsOverlaySettingsEnabled && SuppressAutoOverlay?.Invoke() != true)
                {
                    OverlaySetting.SetOverlaySetting(Id, OverlaySettings.Policy);
                    selectedOverlaySetting = OverlaySettings.Policy;
                }
            }
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            chessModule = await JsInteropService.ImportModuleAsync(JS);
            var overlaySettings = OverlaySetting.GetOverlaySetting(Id);
            if (overlaySettings != OverlaySettings.None)
            {
                selectedOverlaySetting = overlaySettings;
                await OnOverlaySettingChanged(selectedOverlaySetting);
            }
            if (Engine != null)
            {
                runLogLiveStats = analyzer?.Engine.GetUCICommands().ContainsKey("LogLiveStats") ?? Engine.Options.Keys.Contains("LogLiveStats");
                showCharts = runLogLiveStats;
                showCpChart = !runLogLiveStats;
                currentName = Engine.Name;
            }
            searchInfoPlot?.Dispose();
            searchInfoPlot = new SearchInfoPlot(chessModule, qPlotReference, nPlotReference, "Cp-value", fen, neuralNet);
            searchInfoPlot.CompactLegend = CompactChartLegend;
            searchInfoPlot.ConvergenceChartElement = convergencePlotReference;
            cpEvalPlot = new CpEvalPlot(chessModule, cpChartReference);
            if (string.IsNullOrEmpty(FEN) == false)
            {
                fen = FEN;
            }
            ChessBoard.inAnalysisMode = true;
            if (ReviewDefaults || IsReviewing)
            {
                var reviewPV = SettingsService.Settings.ReviewMultiPV;
                cpChartLines = reviewPV;
                numberOfLines = reviewPV;
            }
            else
            {
                var defaultPV = Math.Max(1, SettingsService.Settings.DefaultMultiPV);
                cpChartLines = defaultPV;
                numberOfLines = defaultPV;
            }
            if (Nodes > 0) numberOfNodes = Nodes;
            Qdiff = 2;
            await Send(PanelModel.Event.NewLinesChanged(ActiveChartLines));
            StateHasChanged();
        }

        await Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Notifier.NotifyFen -= OnNotifyFen;
        disposeCts.Cancel();
        // Disposed mid-search the 100ms uiTimer would otherwise stay alive forever: updates are
        // dropped after disposeCts, so the final BestMove can no longer stop it.
        StopSearchTimer();
        try { analyzer?.Stop(); } catch { }
        engineGeneration++;
        EngineQuit.OffThread(analyzer, logger);
        logger.LogInformation("Disposing {page}", "EnginePanel");
        try
        {
            if (this.keyContext != null) await this.keyContext.DisposeAsync();
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

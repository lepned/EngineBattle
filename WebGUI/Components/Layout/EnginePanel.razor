    private static int MultiPvOf(string line)
    {
        var idx = line.IndexOf("multipv ", StringComparison.Ordinal);
        if (idx < 0) return 1;
        int n = 0;
        foreach (var c in line.AsSpan(idx + 8))
        {
            if (!char.IsDigit(c)) break;
            n = n * 10 + (c - '0');
        }
        return n == 0 ? 1 : n;
    }

    // ── AB iteration log ─────────────────────────────────────────────────────────
    // One row per completed depth of the main line. Built from the raw info line rather
    // than from EngineStatus alone, because EngineStatus has no time field — Engine.fs

@using System.Text.RegularExpressions;
@using WebGUI.Components
@using WebGUI.Components.Layout.ChessboardLayout
@using WebGUI.Plotting
@using WebGUI.Services
@using System.Text
@using Toolbelt.Blazor.HotKeys2
@using System.Globalization
@using static ChessLibrary.EngineTypes
@using static ChessLibrary.TypesDef.CoreTypes

@inject IJSRuntime JS
@inject JavaScriptInteropService JsInteropService
@inject NotifierService Notifier
@inject HotKeys HotKeys
@inject IDialogService DialogService
@inject ILogger<EnginePanel> logger
@inject OverlaySetting OverlaySetting
@inject GlobalSettingsService SettingsService
@implements IAsyncDisposable

<div class="engine-panel">
    <header class="ep-header">
        <h5 title="@GetEngineOptionsTooltip()">
            @if (!string.IsNullOrEmpty(Engine?.LogoPath))
            {
                <img class="ep-logo" src="@Engine.LogoPath" alt="@EngineName" />
            }
            else
            {
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/>
                </svg>
            }
            <span class="ep-engine-name">@EngineName</span>
        </h5>
        <div class="ep-cmd-input">
            <input type="text" @bind="text" placeholder="UCI command" title="Send a raw UCI command to the engine" />
            <button class="ep-btn secondary small" @onclick="DumpEngineStats" title="Run UCI command">
                <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
                run
            </button>
            <MudTooltip Text="Load UCI script (.txt) — one command per line, e.g. setoption name Cpuct value 1.32">
                <MudIconButton Icon="@Icons.Material.Filled.Description" Size="Size.Small"
                               OnClick="LoadUciScript" Disabled="@(analyzer == null)" Style="padding:2px;" />
            </MudTooltip>
        </div>
        <label class="ep-switch" style="margin-left:8px">
            <span class="label-text @(searchMode == SearchMode.Nodes ? "active" : "")">Nodes</span>
            <input type="checkbox" @bind="timeMode" />
            <span class="slider"></span>
            <span class="label-text @(searchMode == SearchMode.Time ? "active" : "")">Time</span>
        </label>
    </header>

    <div class="ep-controls">
        <button class="ep-btn" disabled="@(searchInProgress || waitingForEngine || IsReviewing)" @onclick="Analyze" title="Start search">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><path d="M8 5v14l11-7z"/></svg>
            Start
        </button>
        <button class="ep-btn secondary" disabled="@(!searchInProgress || waitingForEngine)" @onclick="StopSearch" title="Stop search">
            <svg class="icon" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="6" width="12" height="12"/></svg>
            Stop
        </button>
        <button class="ep-btn secondary" disabled="@(searchInProgress || waitingForEngine)" @onclick="ResetEngine" title="Reset engine">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <path d="M1 4v6h6M23 20v-6h-6M20.49 9A9 9 0 0 0 5.64 5.64L1 10m22 4l-4.64 4.36A9 9 0 0 1 3.51 15"/>
            </svg>
            Reset
        </button>
        <button class="ep-btn secondary" disabled="@(searchInProgress || waitingForEngine)" @onclick="RunUCICommand" title="Send UCI command">
            UCI
        </button>
        <button class="ep-btn secondary" disabled="@(searchInProgress || waitingForEngine)" @onclick="OpenDialog" title="UCI Settings">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
            </svg>
        </button>
    </div>

    <div class="ep-limits">
        <div class="ep-field">
            <label>Search limit</label>
            <input type="number"
                   value="@(searchMode == SearchMode.Nodes ? numberOfNodes : numberOfTimeMs)"
                   @onchange="@(e => OnLimitChanged(double.Parse(e.Value?.ToString() ?? "1", CultureInfo.InvariantCulture)))" />
        </div>

        <div class="ep-toggle-group">
            <button class="ep-upload @(autoSearchSwitch ? "active" : "")" @onclick="ToggleAutoSearch" title="Auto search on position change">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                </svg>
                Auto
            </button>

            <button class="ep-upload @(focusModeEnabled ? "active" : "")" @onclick="ToggleFocusMode" title="@(focusModeEnabled && autoSearchSwitch ? "Focus mode: Ctrl+click moves to restrict search (Auto is also enabled)" : "Focus mode: click moves in NN table to restrict search")">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <circle cx="12" cy="12" r="10"/><circle cx="12" cy="12" r="6"/><circle cx="12" cy="12" r="2"/>
                </svg>
                Focus
            </button>

            <button class="ep-upload" @onclick="BrowseNNFile" title="Load neural network weights">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                </svg>
                Weights
            </button>

            <button class="ep-upload" @onclick="BrowseEngineFile" title="Load engine configuration">
                <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4M17 8l-5-5-5 5M12 3v12"/>
                </svg>
                Engine
            </button>
        </div>

    </div>
    <span class="ep-limit-display">@FormatSearchLimit()</span>

    <div class="ep-nn-info">
        @if (!string.IsNullOrEmpty(neuralNet) && neuralNet != "Not set" && neuralNet != "none")
        {
            <span>NN: @neuralNet</span>
            @if (!string.IsNullOrEmpty(backend))
            {
                <span>@backend</span>
            }
        }
        else if (Engine?.Options != null)
        {
            @if (Engine.Options.ContainsKey("Threads"))
            {
                <span>Threads: @Engine.Options["Threads"]</span>
            }
            @if (Engine.Options.ContainsKey("Hash"))
            {
                <span>Hash: @Engine.Options["Hash"] MB</span>
            }
        }
        else
        {
            <span>NN: Not set</span>
        }
    </div>

    @if (focusModeEnabled && focusedMoves.Count > 0)
    {
        <div class="ep-focus-moves">
            <span class="ep-focus-label">Focus:</span>
            @foreach (var move in focusedMoves.ToArray())
            {
                <span class="ep-focus-chip" @onclick="@(() => RemoveFocusMove(move))">@move x</span>
            }
            <button class="ep-focus-clear" @onclick="ClearFocusMoves">Clear all</button>
        </div>
    }

    <div class="ep-pv-label">
        Principal Variation
        @if (runLogLiveStats && currentPosition != null && currentPosition.Nodes > 0)
        {
            <span class="ep-qv-inline">Q: @currentPosition.Q.ToString("N2") (V: @currentPosition.V.ToString("N2"))</span>
        }
    </div>
    <div class="ep-pv-wrapper">
        <div class="ep-pv">@whitePV</div>
        <button class="ep-copy-btn" @onclick="CopyPVToClipboard" title="Copy full PV to clipboard">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="9" y="9" width="13" height="13" rx="2" ry="2"/>
                <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"/>
            </svg>
        </button>
        <button class="ep-copy-btn" @onclick="OpenPVBoardDialog"
                disabled="@string.IsNullOrEmpty(whitePV)"
                title="View PV on board">
            <svg class="icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
                <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
        </button>
    </div>

    @if (currentPosition != null && currentPosition.Nodes > 0)
    {
        <div class="ep-analysis-info">
            <div class="ep-analysis-header">
                <span class="ep-analysis-stats">@tableHeader</span>
                <span class="ep-elapsed" title="Elapsed time">
                    <svg class="ep-clock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    @elapsed.ToString(@"mm\:ss\.f")
                </span>
            </div>
        </div>
    }

    @if (currentPosition != null && currentPosition.Nodes == 0)
    {
        <div class="ep-analysis-info">
            <div class="ep-analysis-header">
                <span class="ep-analysis-stats">@tableHeader</span>
                <span class="ep-elapsed" title="Elapsed time">
                    <svg class="ep-clock-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
                        <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
                    </svg>
                    @elapsed.ToString(@"mm\:ss\.f")
                </span>
            </div>
        </div>
    }

    <div class="ep-charts" hidden="@(!showCharts || HideCharts)">
        <div class="ep-charts-controls">
            <div class="ep-slider" style="min-width:200px;">
                <label>PV lines: @numberOfLines</label>
                <input type="range" min="1" max="20" step="1" @bind="numberOfLines" @bind:after="OnChartLinesChanged" />
            </div>

            <div class="ep-toggle-group" style="margin-left:8px;">
                <button class="ep-upload @(chartView == ChartView.N ? "active" : "")"
                        @onclick="@(() => SetChartView(ChartView.N))"
                        title="Visit fraction over time">N</button>
                <button class="ep-upload @(chartView == ChartView.Q ? "active" : "")"
                        @onclick="@(() => SetChartView(ChartView.Q))"
                        title="Q (eval) over time">Q</button>
                <button class="ep-upload @(chartView == ChartView.Convergence ? "active" : "")"
                        @onclick="@(() => SetChartView(ChartView.Convergence))"
                        title="Q vs N — scatter of root children, with snapshot baseline">Q vs N</button>
            </div>

        </div>

        <div class="ep-chart-container" hidden="@(chartView != ChartView.N)" style="height:@GetChartHeight();">
            <div class="chart" @ref="nPlotReference" style="height:100%;"></div>
        </div>
        <div class="ep-chart-container" hidden="@(chartView != ChartView.Q)" style="height:@GetChartHeight();">
            <div class="chart" @ref="qPlotReference" style="height:100%;"></div>
        </div>
        <div class="ep-chart-container" hidden="@(chartView != ChartView.Convergence)" style="height:@GetChartHeight();">
            <div class="chart" @ref="convergencePlotReference" style="height:100%;"></div>
        </div>
    </div>

    <div class="ep-charts" hidden="@(!showCpChart || HideCharts)">
        <div class="ep-charts-controls">
            <div class="ep-slider" style="min-width:200px;">
                <label>PV lines: @cpChartLines</label>
                <input type="range" min="1" max="20" step="1" @bind="cpChartLines" @bind:after="OnChartLinesChanged" />
            </div>
        </div>
        <div class="ep-chart-container" style="height:@GetCpChartHeight();">
            <div class="chart" @ref="cpChartReference" style="height:100%;"></div>
        </div>
    </div>

    @if (showNNdata)
    {
        @* A fixed height, from the same PV-lines setting the PV table sizes itself by: the box
           is the same size with 3 root moves as with 30, so a move (which empties it until
           the next search reports) never changes the layout - on a one-column screen the
           whole page used to shake. More rows than fit scroll inside. *@
        <div class="ep-table-container" style="height:@($"{40 + Math.Min(numberOfLines, 10) * 32}px")">
            <div class="ep-cm-header">
                <span class="ep-cm-title">@(runLogLiveStats ? "Live move stats" : "Iteration log")</span>
                <div class="ep-seg" role="tablist">
                    <button class="ep-seg-btn" @onclick="() => SetStatsPanel(false)" title="Show PV lines table">PV lines</button>
                    <button class="ep-seg-btn active" title="@StatsPanelTitle">@StatsPanelLabel</button>
                </div>
            </div>
            <div class="ep-cm-wrap">
                @if (runLogLiveStats)
                {
                    @* Full candidate list (verbose move stats carry every root move); the
                       ep-table-container scrolls, charts stay capped by the PV-lines input. *@
                    <CandidateMoves Stats="@NNInfoList" Fen="@fen" MaxRows="int.MaxValue" Detailed="true"
                                    FocusedMoves="@focusedMoves" PreferredLanMove="@PreferredLanMove"
                                    SourceDescription="@EngineDescription" RawInfoLine="@MainInfoLine"
                                    OnRowClick="@HandleCandidateRowClick" />
                }
                else
                {
                    @* AB engines have no root visit counts — the per-depth iteration log is
                       the equivalent view. Compact here; the full card lives under the board. *@
                    <IterationLog Rows="@iterationCollector.Rows" Fen="@fen" Compact="true" Searching="@searchInProgress"
                                  EngineLabel="@EngineIdLabel" MultiPv="@ActiveChartLines"
                                  Threads="@ThreadsLabel" RawInfoLine="@MainInfoLine" />
                }
            </div>
        </div>
    }

    @if (!showNNdata)
    {
        <div class="ep-table-container" style="min-height:@($"{40 + Math.Min(numberOfLines, 10) * 32}px"); max-height:@($"{40 + 10 * 41}px")">
            <div class="ep-pv-head">
                <span class="ep-pv-h ep-pv-h-eval">Eval</span>
                <span class="ep-pv-h ep-pv-h-depth">Depth</span>
                <span class="ep-pv-h ep-pv-h-pv">
                    PV
                    <div class="ep-seg" role="tablist">
                        <button class="ep-seg-btn active" title="PV lines table">PV lines</button>
                        <button class="ep-seg-btn" @onclick="() => SetStatsPanel(true)" title="@StatsPanelTitle">@StatsPanelLabel</button>
                    </div>
                </span>
            </div>
            @foreach (var item in dataList)
            {
                var (evalText, evalCls) = PvEvalParts(item.Value);
                <div class="ep-pv-row @(focusModeEnabled && focusedMoves.Contains(GetFirstMove(item.Value.PVLongSAN)) ? "focused" : "")"
                     title="@item.Value.PV"
                     @onclick="@((e) => OnPVTableRowClick(item, e.CtrlKey))">
                    <span class="ep-pv-eval @evalCls @(item.Value.MultiPV <= 1 ? "top" : "")">@evalText</span>
                    <span class="ep-pv-depth">@item.Value.Depth<span class="ep-pv-sd">/@item.Value.SD</span></span>
                    <span class="ep-pv-line">@item.Value.PV</span>
                </div>
            }
        </div>
    }
</div>

@if (showPVBoard)
{
    <PVBoardLive State1="@pvState" OnClose="ClosePVBoardDialog" />
}

@code {
    [Parameter] public ChessLibrary.Chess.Board ChessBoard { get; set; }
    [Parameter] public EventCallback<List<string>> OnUCIReceived { get; set; }
    [Parameter] public EventCallback<string> OnEngineMoveMade { get; set; }
    [Parameter] public string Id { get; set; }
    [Parameter] public string FEN { get; set; }
    [Parameter] public EngineConfig Engine { get; set; }
    [Parameter] public EventCallback<EngineConfigEventArgs> OnNewEngineLoaded { get; set; }
    [Parameter] public List<PGNTypes.PgnGame> PGNgames { get; set; }
    [Parameter] public string Player { get; set; }
    [Parameter] public bool IsReviewing { get; set; }
    /// Start with the review settings (limits, lines): a review page, whether or not one runs.
    [Parameter] public bool ReviewDefaults { get; set; }
    [Parameter] public EventCallback<string> OnSearchCompleted { get; set; }
    /// <summary>White-perspective eval of the main line (pawns, or mate distance) — feeds
    /// an eval bar on the host page. Throttled to meaningful changes (0.05 pawns).</summary>
    [Parameter] public EventCallback<(double? Cp, int? Mate)> OnEvalUpdated { get; set; }
    /// <summary>Verbose move stats of the current search plus the position they belong to —
    /// lets host pages render a candidate-moves panel outside this component.</summary>
    [Parameter] public EventCallback<(IReadOnlyList<NNValues> Stats, string Fen)> OnLiveStats { get; set; }
    /// <summary>Per-depth iteration log of the current search plus the position it belongs to —
    /// the AB counterpart of <see cref="OnLiveStats"/>. Raised once per new depth, not per
    /// info line, so hosts re-render at a sane rate.</summary>
    [Parameter] public EventCallback<(IReadOnlyList<IterationRow> Rows, string Fen)> OnIterations { get; set; }
    /// <summary>SAN-only legend on the N/Q charts — for hosts that show the numbers in a
    /// candidate-move panel instead (SingleAnalysis). Full values remain on hover.</summary>
    [Parameter] public bool CompactChartLegend { get; set; }
    /// <summary>Persistence key for the live-stats/PV-table toggle ("single-analysis",
    /// "dual-analysis"). Empty = don't remember, always start on the PV table.</summary>
    [Parameter] public string StatsPanelKey { get; set; } = "";
    /// <summary>Host veto for the automatic Policy-overlay enable on LogLiveStats engines —
    /// returns true while the host is showing its own board overlay (e.g. SingleAnalysis
    /// position insights, which are mutually exclusive with the policy overlay).</summary>
    [Parameter] public Func<bool> SuppressAutoOverlay { get; set; }

    [Parameter] public int Nodes { get; set; } = 0;
    /// setoption lines a host wants sent right after the engine starts and again whenever it
    /// passes a new list - Lc0 Contempt's side view, for one. Lc0 takes them between searches.
    [Parameter] public IReadOnlyList<EngineOption> ExtraSetOptions { get; set; }
    private IReadOnlyList<EngineOption> appliedExtraSetOptions;
    /// The engine's UCI option names once it has answered `uci`.
    [Parameter] public EventCallback<IReadOnlyCollection<string>> OnEngineStarted { get; set; }
    /// Start in time mode with this limit instead of the analysis defaults from Settings; the
    /// user can still change it. Lc0 Contempt asks for 3000 ms.
    [Parameter] public int? InitialTimeMs { get; set; }
    /// Keep the charts out of view - a display choice only; the data, the chart-lines slider
    /// and MultiPV are untouched, so showing them again later costs nothing but a resize.
    [Parameter] public bool HideCharts { get; set; }
    private bool overlayDropdownOpen = false;

    private string text = "dump-info";
    private enum ChartView { N, Q, Convergence }
    private ChartView chartView = ChartView.N;
    // Kept as a derived flag so existing rank-sequence visibility checks still work.
    private bool showNPlot => chartView == ChartView.N;
    private string currentName = string.Empty;
    private OverlaySettings selectedOverlaySetting = OverlaySettings.None;
    private NNValues currentPosition = NNValues.Empty;
    private bool runLogLiveStats;
    private string whitePV;
    private bool uciButtonPressed = false;
    string EngineName => Engine == null ? "Engine not initialized" : Engine.Name;

    private string GetEngineOptionsTooltip()
    {
        if (Engine?.Options == null || Engine.Options.Count == 0)
            return EngineName;
        var lines = Engine.Options.Select(kv => $"{kv.Key}: {kv.Value}");
        return $"{EngineName}\n\nUCI Options:\n{string.Join("\n", lines)}";
    }

    private System.Text.Json.JsonSerializerOptions options =
        new System.Text.Json.JsonSerializerOptions { WriteIndented = true, IncludeFields = true, AllowTrailingCommas = true };

    private string fen = "rnbqkbnr/pppppppp/8/8/8/8/PPPPPPPP/RNBQKBNR w KQkq - 0 1";
    private ElementReference nPlotReference;
    private ElementReference qPlotReference;
    private ElementReference convergencePlotReference;
    private SearchInfoPlot searchInfoPlot;
    private IJSObjectReference chessModule;
    private string tableHeader = "";
    private int numberOfLines = 3;
    private double numberOfNodes = 1;
    private bool showNNdata = false;
    private CancellationTokenSource disposeCts = new();
    private double Qdiff = 2;
    public bool autoSearchSwitch
    {
        get => model.Auto;
        set { if (value != model.Auto) model = PanelModel.step(model, PanelModel.Event.NewAutoChanged(value)).Item1; }
    }
    public bool showCharts { get; set; } = true;
    private string neuralNet = "Not set";
    private string backend = "";
    private bool searchInProgress => model.Searching;
    private bool showPVBoard = false;
    private PVState pvState = new();
    private bool showCpChart = false;
    private ElementReference cpChartReference;
    private CpEvalPlot cpEvalPlot;
    private int cpChartLines = 4;
    private bool focusModeEnabled = false;
    private List<string> focusedMoves => model.Focused.ToList();

    // Expose PVState for parent components (e.g., DualAnalysis for dual comparison)
    public PVState PVState => pvState;
    // Current MultiPV line count — hosts use it to size external stat panels consistently.
    public int ActivePvLines => numberOfLines;
    // MultiPV actually sent to the engine (the charts and the cp chart have separate inputs).
    public int ActiveMultiPv => ActiveChartLines;
    private bool waitingForEngine => model.Engine.IsStarting;
    private ChessLibrary.AnalysisManager.SimpleEngineAnalyzer analyzer;
    private List<NNValues> NNInfoList = new();
    public List<string> InfoLineList = new();
    HotKeysContext keyContext;
    public List<KeyValuePair<int, EngineStatus>> dataList = new();

    public async Task ResetChartData()
    {
        // a host moved to another position: the same clearing as a navigation, charts included
        await Send(PanelModel.Event.Navigated);
        await ClearCharts();
        await InvokeAsync(StateHasChanged);
    }
    private IDialogReference dialogReference;
    public double MinPolicyThreshold { get; set; }
    private System.Diagnostics.Stopwatch searchWatch = new();
    private System.Timers.Timer uiTimer;
    private TimeSpan elapsed = TimeSpan.Zero;

    private enum SearchMode { Nodes, Time }

    private SearchMode searchMode = SearchMode.Nodes;
    private double numberOfTimeMs = 3000;

    public bool IsTimeMode => searchMode == SearchMode.Time;
    public double CurrentNodes => numberOfNodes;
    public double CurrentTimeMs => numberOfTimeMs;
    public int CurrentChartLines => cpChartLines;
    private bool timeMode
    {
        get => searchMode == SearchMode.Time;
        set => OnSearchModeChanged(value ? SearchMode.Time : SearchMode.Nodes);
    }

    private void ToggleAutoSearch()
    {
        autoSearchSwitch = !autoSearchSwitch;
    }

    private string FormatSearchLimit()
    {
        if (searchMode == SearchMode.Nodes)
            return $"{numberOfNodes:N0} nodes";
        else
            return $"{numberOfTimeMs:N0} ms";
    }

    private void OnSearchModeChanged(SearchMode mode)
    {
        searchMode = mode;
        StateHasChanged();
    }

    private void OnLimitChanged(double value)
    {
        if (searchMode == SearchMode.Nodes)
            numberOfNodes = Math.Max(1, value);
        else
            numberOfTimeMs = Math.Max(1, value);
    }

    private void StartSearchTimer()
    {
        searchWatch.Reset();
        searchWatch.Start();
        elapsed = TimeSpan.Zero;
        uiTimer?.Dispose();
        uiTimer = new System.Timers.Timer(100);
        uiTimer.Elapsed += (s, e) =>
        {
            elapsed = searchWatch.Elapsed;
            // Guarded on both sides: a circuit torn down between two ticks makes InvokeAsync
            // itself throw synchronously on the timer thread, while anything inside the tick
            // would otherwise fault a discarded task.
            try
            {
                _ = InvokeAsync(SearchTickAsync);
            }
            catch (ObjectDisposedException) { }
            catch (Microsoft.JSInterop.JSDisconnectedException) { }
        };
        uiTimer.Start();
    }

    private void StopSearchTimer()
    {
        searchWatch.Stop();
        uiTimer?.Stop();
        uiTimer?.Dispose();
        uiTimer = null;
    }

    // The cp chart is drawn from the search timer rather than per info line: an engine can

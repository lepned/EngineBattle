    private string HeaderOf(EngineStatus status)
    {
        var nodes = AnalysisText.Nodes(status.Nodes) + " nodes";
        var nps = GameAnalysis.Formatting.formatNPS(status.NPS);
        if (status.EPS == 0)
            return $"{nodes} ({nps}) (tbhits: {status.TBhits:N0})";
        var eps = GameAnalysis.Formatting.formatEPS(status.EPS);
        return $"{nodes} ({nps}, {eps}) (tbhits: {status.TBhits:N0})";
    }

    // An accepted update, for the panel's own views.
    private async Task ShowUpdate(EngineUpdate update)
    {
        switch (update)
        {
            case EngineUpdate.Ready ready:
                showCharts = ready.HasLiveStat;
                showCpChart = !ready.HasLiveStat;
                // The remembered choice now applies to both alternatives — MCTS engines
                // get the move-stats panel, AB engines the iteration log.
                showNNdata = RememberedStatsPanelChoice();
                // the visible lines slider follows the engine kind: the engine's MultiPV too
                if (model.Lines != ActiveChartLines)
                    await Send(PanelModel.Event.NewLinesChanged(ActiveChartLines));
                break;

            case EngineUpdate.Info i:
                InfoLineList.Insert(0, (i.Info));
                // Info arrives per parsed status line — cap the (display-unused) backlog so an
                // infinite search can't grow it without bound.
                if (InfoLineList.Count > 200)
                    InfoLineList.RemoveAt(InfoLineList.Count - 1);
                // Latest raw PV info per MultiPV index — raw, so any engine-specific extras
                // survive into the CandidateMoves copy output. Capped at the chart-lines input
                // (= the MultiPV the engine searches), filtered at join time so lowering the
                // slider drops stale higher lines. Joined eagerly here; renders read the string.
                if (i.Info.Contains(" pv "))
                {
                    var k = MultiPvOf(i.Info);
                    var lineCap = ActiveChartLines;
                    if (k <= lineCap)
                    {
                        lastInfoByMultiPv[k] = i.Info;
                        lastMainInfoLine = string.Join("\n",
                            lastInfoByMultiPv.Where(kv => kv.Key <= lineCap)
                                             .OrderBy(kv => kv.Key)
                                             .Select(kv => kv.Value));
                    }
                    // Iteration log: main line only, paired with the Status parsed from this very
                    // line (emitted immediately before it).
                    if (k <= 1 && !runLogLiveStats && pendingIterationStatus is not null)
                    {
                        var newDepth = CaptureIteration(pendingIterationStatus, i.Info);
                        if (newDepth && OnIterations.HasDelegate)
                        {
                            var rowsCopy = iterationCollector.Rows;
                            // the search's position, not the board's
                            await OnIterations.InvokeAsync((rowsCopy, updateFen));
                        }
                    }
                }
                break;

            case EngineUpdate.UCIInfo info:
                if (uciButtonPressed)
                    await OnUCIReceived.InvokeAsync(info.Data);
                break;

            case EngineUpdate.Status s:
                var status = s.Item;
                // in place before the raw Info of this same line builds the iteration row
                if (status.MultiPV <= 1) pendingIterationStatus = status;
                tableHeader = HeaderOf(status);
                if (!runLogLiveStats && showCpChart && cpEvalPlot != null)
                {
                    cpEvalPlot.AddDataPoint(status.MultiPV, status.Depth, status.Eval, status.PV);
                    cpChartDirty = true;
                }
                break;

            case EngineUpdate.NNSeq n:
                if (n.NNSeq.Count > 0)
                {
                    // a reversed copy: the engine's own list is left alone
                    var fresh = n.NNSeq.ToList();
                    fresh.Reverse();
                    currentPosition = fresh.FirstOrDefault();
                    // Swap in a fresh list instead of mutating in place — renders may be
                    // enumerating the old one.
                    NNInfoList = fresh;
                    var skipTopNode = NNInfoList.Skip(1).ToList();
                    searchInfoPlot?.AddData(skipTopNode);
                    if (NNInfoList.Count > 0)
                        await Notifier.MovesWithId(NNInfoList, Id);
                    var maxLines = Math.Min(numberOfLines, NNInfoList.Count);
                    if (searchInfoPlot != null)
                        await searchInfoPlot.UpdateLogLiveCharts(skipTopNode, maxLines, Qdiff, includeConvergence: chartView == ChartView.Convergence);
                    await ForwardStats(fresh);
                }
                break;
        }
    }

    // Another search's live stats: not shown, but the host caches them under their own position
    // (the search's), so they are there when the user steps back.
    private async Task ForwardLateStats(EngineUpdate update)
    {
        if (update is EngineUpdate.NNSeq n && n.NNSeq.Count > 0)
        {
            var stats = n.NNSeq.ToList();
            stats.Reverse();
            await ForwardStats(stats);
        }
    }

    private async Task ForwardStats(List<NNValues> stats)
    {
        if (OnLiveStats.HasDelegate)
            await OnLiveStats.InvokeAsync((stats.ToList(), updateFen));
    }

    private async Task OnCompleted(BestMoveInfo info)
    {
        whitePV = info.PV;
        var main = model.Rows.ContainsKey(1) ? model.Rows[1] : null;
        var commentEval = main != null ? main.Eval : info.Eval;
        var commentNodes = main != null ? main.Nodes : info.Nodes;
        // A host's search (Game Review) is not about ChessBoard's current move: the board holds
        // the reviewed game, and its last move got every review eval.
        if (!IsReviewing)
            ChessBoard.SetCommentOnCurrentEdge($"{{{commentEval}/{commentNodes.ToString("N0")}}}");
        // the timer that would have drawn it is gone now, so draw what the last lines added
        await FlushCpChart();
        pvState.SetSearching(false);
        if (OnSearchCompleted.HasDelegate)
        {
            var evalStr = commentEval switch
            {
                // three sections: a near-zero negative would print "-+0.0" with two
                EvalType.CP cp => $"{cp.Info:+0.0;-0.0;0.0}",
                EvalType.Mate m => $"M{m.Info}",
                _ => ""
            };
            await OnSearchCompleted.InvokeAsync(evalStr);
        }
        StateHasChanged();
    }


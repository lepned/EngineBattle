    private async Task Analyze()
    {
        if (Engine == null || chessModule == null)
        {
            return;
        }
        if (analyzer != null && analyzer.Engine.HasExited)
        {
            analyzer = null;
            await StartAnalyzer();
        }
        InfoLineList.Clear();
        ClearIterations();
        if (searchInfoPlot == null)
        {
            searchInfoPlot = new SearchInfoPlot(chessModule, qPlotReference, nPlotReference, "Cp-value", fen, neuralNet);
            searchInfoPlot.CompactLegend = CompactChartLegend;
            searchInfoPlot.ConvergenceChartElement = convergencePlotReference;
        }
        else
        {
            await searchInfoPlot?.ResetPlot(false);
        }
        cpEvalPlot?.Clear();
        cpChartDirty = false;
        searchInProgress = true;
        ResetSearchTimer();
        if (selectedOverlaySetting != OverlaySettings.None)
            await Notifier.UpdateDisplaySettings(selectedOverlaySetting, Id);
        await InvokeAsync(StateHasChanged);
        try
        {
            if (analyzer == null)
            {
                waitingForEngine = true;
                StateHasChanged();
                await StartAnalyzer();
                if (analyzer == null) return;
                backend = analyzer.BackendInfo();
                if (searchInfoPlot != null)
                {
                    searchInfoPlot.EngineName = analyzer.GetEngineName();
                    searchInfoPlot.NN = showCharts ? $"{analyzer.GetNetwork()}" : "none";
                }
                neuralNet = showCharts ? $"{analyzer.GetNetwork()}" : "none";
            }
            StartSearchWithMode();
            StartSearchTimer();
        }
        catch (Exception ex)
        {
            logger.LogWarning("Failed to start analysis: {Message}", ex.Message);
            searchInProgress = false;
            waitingForEngine = false;
        }

        await InvokeAsync(StateHasChanged);
    }

    private async Task StopSearch()
    {
        if (analyzer != null)
            analyzer.Stop();
        searchInProgress = false;
        StopSearchTimer();
        await Task.CompletedTask;
    }

    // Updates arrive on the engine's reader thread. The handler is async, so at its first
    // await it returns and the reader thread immediately starts the next one — two flows
    // then mutate `data` and `InfoLineList` at once. A mate found at the ply cap delivers
    // 245 updates in 8ms and makes that collision routine ("Destination array was not long
    // enough" out of a dictionary being copied while it grows). Marshalling to the
    // dispatcher serialises them: component state is only ever touched from one thread,
    // which is what Blazor expects in the first place.
    public void HandleUpdate(EngineUpdate update)
    {
        if (disposeCts.IsCancellationRequested) return;
        try
        {
            _ = InvokeAsync(() => HandleUpdateCore(update));
        }
        catch (ObjectDisposedException) { }
    }

    private async Task HandleUpdateCore(EngineUpdate update)
    {
        if (disposeCts.IsCancellationRequested) return;
        try
        {
            switch (update)
            {
                case EngineUpdate.Done player:
                    break;

                case EngineUpdate.Ready ready:
                    showCharts = ready.HasLiveStat;
                    showCpChart = !ready.HasLiveStat;
                    // The remembered choice now applies to both alternatives — MCTS engines
                    // get the move-stats panel, AB engines the iteration log.
                    showNNdata = RememberedStatsPanelChoice();
                    searchInProgress = false;
                    waitingForEngine = false;
                    break;

                case EngineUpdate.Info i:
                    InfoLineList.Insert(0, (i.Info));
                    // Info now arrives per parsed status line — cap the (display-unused)
                    // backlog so an infinite search can't grow it without bound.
                    if (InfoLineList.Count > 200)
                        InfoLineList.RemoveAt(InfoLineList.Count - 1);
                    // Latest raw PV info per MultiPV index — raw, so any engine-specific
                    // extras survive into the CandidateMoves copy output. Capped at the
                    // chart-lines input (= the MultiPV the engine searches), filtered at
                    // join time so lowering the slider drops stale higher lines. Joined
                    // eagerly here (single engine reader thread mutates the dict, cleared
                    // on the dispatcher — lock both; renders read only the joined string).
                    if (i.Info.Contains(" pv "))
                    {
                        var k = MultiPvOf(i.Info);
                        var lineCap = ActiveChartLines;
                        if (k <= lineCap)
                        {
                            lock (lastInfoByMultiPv)
                            {
                                lastInfoByMultiPv[k] = i.Info;
                                lastMainInfoLine = string.Join("\n",
                                    lastInfoByMultiPv.Where(kv => kv.Key <= lineCap)
                                                     .OrderBy(kv => kv.Key)
                                                     .Select(kv => kv.Value));
                            }
                        }
                        // Iteration log: main line only, paired with the Status parsed from
                        // this very line (emitted immediately before it).
                        if (k <= 1 && !runLogLiveStats && pendingIterationStatus is not null)
                        {
                            var newDepth = CaptureIteration(pendingIterationStatus, i.Info);
                            if (newDepth && OnIterations.HasDelegate)
                            {
                                var rowsCopy = iterationCollector.Rows;
                                var rowsFen = fen;
                                await InvokeAsync(() => OnIterations.InvokeAsync((rowsCopy, rowsFen)));
                            }
                        }
                    }
                    break;

                case EngineUpdate.Eval e:
                    break;

                case EngineUpdate.BestMove b:
                    whitePV = b.Item.PV;
                    searchInProgress = false;
                    waitingForEngine = false;
                    // Attribute the result to the position the search actually ran on.
                    // A stopped search's bestmove can arrive after navigation; writing it
                    // onto the current board marked the NEW position as analyzed (auto-
                    // search then skipped it forever) and attached the old eval to it.
                    pendingSearchFens.TryDequeue(out var searchedFen);
                    var staleResult =
                        !string.IsNullOrEmpty(searchedFen)
                        && ChessBoard != null
                        && !string.Equals(searchedFen, ChessBoard.FEN(), StringComparison.Ordinal);
                    var commentEval = data.ContainsKey(1) ? data[1].Eval : b.Item.Eval;
                    var commentNodes = data.ContainsKey(1) ? data[1].Nodes : b.Item.Nodes;
                    var evalComment = $"{{{commentEval}/{commentNodes.ToString("N0")}}}";
                    if (!staleResult)
                        ChessBoard.SetCommentOnCurrentEdge(evalComment);
                    StopSearchTimer();
                    // The timer that would have drawn it is gone now, so draw whatever the
                    // last lines added before the search ended.
                    await FlushCpChart();
                    pvState.SetSearching(false);
                    // Fill empty PV in status table from bestmove (value head engines)
                    if (!string.IsNullOrEmpty(b.Item.PV) && data.ContainsKey(1) && string.IsNullOrEmpty(data[1].PV))
                    {
                        var s = data[1];
                        data[1] = new EngineStatus(s.PlayerName, s.Eval, s.Nodes, s.NPS, s.EPS, s.Depth, s.SD, s.TBhits, s.WDL, b.Item.PV, b.Item.Move, s.MultiPV);
                        dataList = data.OrderBy(e => e.Value.MultiPV).ToList();
                    }
                    if (staleResult)
                    {
                        logger.LogDebug("Dropping stale search result for {Fen}", searchedFen);
                    }
                    else if (OnSearchCompleted.HasDelegate)
                    {
                        var evalStr = commentEval switch
                        {
                            EvalType.CP cp => $"{cp.Info:+0.0;-0.0}",
                            EvalType.Mate m => $"M{m.Info}",
                            _ => ""
                        };
                        await InvokeAsync(() => OnSearchCompleted.InvokeAsync(evalStr));
                    }
                    await InvokeAsync(() => StateHasChanged());
                    break;

                case EngineUpdate.UCIInfo info:
                    if (uciButtonPressed)
                    {
                        await InvokeAsync(() => OnUCIReceived.InvokeAsync(info.Data));
                    }
                    break;

                case EngineUpdate.Status s:
                    var status = s.Item;
                    // Assigned before the first await so it is in place when the raw Info
                    // for this same line arrives and builds the iteration row.
                    if (status.MultiPV <= 1) pendingIterationStatus = status;
                    await Update(status);
                    if (!runLogLiveStats && showCpChart && cpEvalPlot != null)
                    {
                        cpEvalPlot.AddDataPoint(status.MultiPV, status.Depth, status.Eval, status.PV);
                        cpChartDirty = true;
                    }
                    break;

                case EngineUpdate.PolicyDistributionOutCome ds:
                    var list = ds.Item;
                    break;

                case EngineUpdate.NNSeq n:
                    if (n.NNSeq.Count > 0)
                    {
                        n.NNSeq.Reverse();
                        currentPosition = n.NNSeq.FirstOrDefault();
                        // Swap in a fresh list instead of mutating in place — renders may
                        // be enumerating the old one on the dispatcher right now.
                        NNInfoList = n.NNSeq.ToList();
                        var skipTopNode = NNInfoList.Skip(1).ToList();
                        searchInfoPlot?.AddData(skipTopNode);
                        if (NNInfoList.Count > 0)
                            await Notifier.MovesWithId(NNInfoList, Id);
                        var maxLines = Math.Min(numberOfLines, NNInfoList.Count);
                        if (searchInfoPlot != null)
                            await searchInfoPlot.UpdateLogLiveCharts(skipTopNode, maxLines, Qdiff, includeConvergence: chartView == ChartView.Convergence);
                        if (OnLiveStats.HasDelegate)
                        {
                            // Engine updates arrive on the reader thread; EventCallback
                            // renders the host page, so marshal to the dispatcher.
                            var statsCopy = NNInfoList.ToList();
                            var statsFen = fen;
                            await InvokeAsync(() => OnLiveStats.InvokeAsync((statsCopy, statsFen)));
                        }
                    }
                    break;
            }
        }
        catch (ObjectDisposedException) { }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (Exception ex)
        {
            // Full exception, not just the message: this handler touches a dozen collections
            // and the message alone ("Destination array was not long enough") says nothing
            // about which one.
            logger.LogWarning(ex, "Engine update callback failed [{Update}]", update.GetType().Name);
        }
    }

    private void SetStatsPanel(bool showStats)
    {
        if (showNNdata == showStats) return;
        showNNdata = showStats;
        if (!string.IsNullOrEmpty(StatsPanelKey))
        {
            var settings = SettingsService.Settings;
            settings.ShowLiveMoveStatsPanel[StatsPanelKey] = showNNdata;
            SettingsService.Save(settings);
        }
    }

    private bool RememberedStatsPanelChoice() =>
        !string.IsNullOrEmpty(StatsPanelKey)
        && SettingsService.Settings.ShowLiveMoveStatsPanel.TryGetValue(StatsPanelKey, out var preferStats)
        && preferStats;

    private async Task DoQAnalysis()
    {
        if (!showCharts) { logger.LogWarning("Q-rank analysis requires a neural network engine with LogLiveStats"); return; }
        try
        {
            var fen = ChessBoard.FEN();
            var posWithMoves = ChessBoard.PositionWithFenAndMoves(fen);
            var fenWithAllMoves = ChessBoard.PositionWithMoves();
            var history = ChessBoard.GetMoveHistory();
            logger.LogInformation($"Starting analysis with {fen} and moves {history}");
            if (analyzer == null)
            {
                logger.LogInformation("No engine loaded");
                await StartAnalyzer();
            }
            var engineName = "all";

            var parts = (SettingsService.Settings.PolicyDistributionMinMaxFilter ?? "")
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries);

            float minVal = 0f, maxVal = 1f;

            var ok =
                parts.Length == 2 &&
                float.TryParse(parts[0], NumberStyles.Float, CultureInfo.InvariantCulture, out minVal) &&
                float.TryParse(parts[1], NumberStyles.Float, CultureInfo.InvariantCulture, out maxVal) &&
                minVal >= 0f && maxVal <= 1f && minVal < maxVal;

            var (min, max) = ok ? (minVal, maxVal) : (0f, 1f);

            var (neuralNet, res) = analyzer?.TryGetMoveQAndTopForPosSequence(engineName, min, max);
            analyzer?.StopDistributionEngine();
            foreach (var item in res)
            {
                var player = item.IsWhite ? "White" : "Black";
                logger.LogInformation("{Player} {Rank} Move played {MovePlayed} Policy {Policy:F2}% Top move {Top} policy {TopPolicy:F2}%",
                    player, item.PolicyRank, item.PlayedMove.SANMove, item.PlayedMove.P, item.BestMove.SANMove, item.BestMove.P);
            }
            _ = searchInfoPlot?.SetRankSequence(res, neuralNet, rankType: "Q", isVisible: !showNPlot);

            var whiteRank1s = res.Count(t => t.PolicyRank == 1 && t.IsWhite);
            var blackRank1s = res.Count(t => t.PolicyRank == 1 && !t.IsWhite);
            var whiteTotal = res.Count(t => t.IsWhite);
            var blackTotal = res.Count(t => !t.IsWhite);
            var whiteFrac = whiteTotal > 0 ? (double)whiteRank1s / whiteTotal * 100 : 0;
            var blackFrac = blackTotal > 0 ? (double)blackRank1s / blackTotal * 100 : 0;
            logger.LogInformation("White Rank1 moves {WhiteRank1} out of {WhiteTotal} fraction {WhiteFrac:F2}%", whiteRank1s, whiteTotal, whiteFrac);
            logger.LogInformation("Black Rank1 moves {blackRank1s} out of {blackTotal} fraction {blackFrac:F2}%", blackRank1s, blackTotal, blackFrac);

            var whiteDistribution = res.Where(t => t.IsWhite)
                .GroupBy(t => t.PolicyRank)
                .Select(g => new { Rank = g.Key, Count = g.Count() })
                .OrderBy(g => g.Rank)
                .ToList();

            var blackDistribution = res.Where(t => !t.IsWhite)
                .GroupBy(t => t.PolicyRank)
                .Select(g => new { Rank = g.Key, Count = g.Count() })
                .OrderBy(g => g.Rank)
                .ToList();

            var distribution = res.GroupBy(t => t.PolicyRank)
                .Select(g => new { Rank = g.Key, Count = g.Count() })
                .OrderBy(g => g.Rank)
                .ToList();

            var numberOfRanks = Math.Min(distribution.Max(e => e.Rank), 12);

            foreach (var item in distribution)
            {
                var percentage = (double)item.Count / res.Count() * 100;
                logger.LogInformation("Rank {Rank} Count {Count} Percentage {Percentage:F2}%", item.Rank, item.Count, percentage);
            }

            var top5 = distribution.Where(d => d.Rank <= 5).Sum(d => d.Count);
            var top5frac = (double)top5 / res.Count() * 100;
            logger.LogInformation("Top 5 moves {Top5} out of {Total} fraction {Top5Frac:F2}%", top5, res.Count(), top5frac);
            if (SettingsService.Settings.CombineWhiteAndBlackMoves)
            {
                searchInfoPlot?.SetPolicyDistributionCombinedBucketed(
                    distribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    neuralNet,
                    minDistinctRanks: 2,
                    tailStart: 10,
                    rankType: "Q");
            }
            else
            {
                searchInfoPlot?.SetPolicyDistributionBucketed(
                    distribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    whiteDistribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    blackDistribution.Select(d => Tuple.Create(d.Rank, d.Count)),
                    neuralNet,
                    minDistinctRanks: 2,
                    tailStart: 7,
                    rankType: "Q");
            }
        }
        catch (Exception ex)
        {
            logger.LogCritical(ex.Message);
        }
    }


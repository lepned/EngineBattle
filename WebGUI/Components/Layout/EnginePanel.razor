    private async Task LoadUciScript()
    {
        if (analyzer == null) return;

        var parameters = new DialogParameters<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>
        {
            { x => x.InitialPath, SettingsService.Settings.EngineDefsFolder },
            { x => x.FileFilter, "*.txt" },
            { x => x.Mode, WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog.FileBrowserMode.File }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseOnEscapeKey = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<WebGUI.Components.Layout.ExperimentalLayout.FileBrowserDialog>("Select UCI Script", parameters, options);
        var result = await dialog.Result;
        if (result == null || result.Canceled) return;

        var filePath = (string)result.Data!;
        try
        {
            var lines = await File.ReadAllLinesAsync(filePath);
            int count = 0;
            foreach (var line in lines)
            {
                var trimmed = line.Trim();
                if (string.IsNullOrEmpty(trimmed) || trimmed.StartsWith("#")) continue;
                analyzer.DumpStats(trimmed);
                count++;
            }
            logger.LogInformation("Loaded UCI script {File}: {Count} commands sent", filePath, count);
        }
        catch (Exception ex)
        {
            logger.LogError(ex, "Failed to load UCI script {File}", filePath);
        }
    }


    private void LoadAndOpenPGNGame(PGNTypes.PgnGame game)
    {
        var board = ChessBoard;
        var gameIndex = PGNgames.IndexOf(game);
        var currentGame = $"{game.GameMetaData.White} - {game.GameMetaData.Black}: {game.GameMetaData.Result} (R# {game.GameMetaData.Round})";
        var fenP = string.IsNullOrEmpty(game.GameMetaData.Fen) ? Chess.startPos : game.GameMetaData.Fen;
        board.ResetBoardStateFromFen(fenP);
        foreach (var ply in game.Mainline)
        {
            board.PlaySanMoveWithComments(ply.San, ply.Comment);
        }

        fen = board.FEN();
    }

    private async Task ResetEngine()
    {
        if (analyzer == null)
        {
            logger.LogInformation("No engine loaded");
            return;
        }
        if (analyzer.Engine.HasExited)
        {
            analyzer = null;
            await StartAnalyzer();
            searchInProgress = false;
        }

        tableHeader = "";

        analyzer?.Reset();
        ResetSearchTimer();
        if (searchInfoPlot != null)
        {
            await searchInfoPlot.ResetPlot(true);
        }
        if (cpEvalPlot != null)
        {
            await cpEvalPlot.ClearChart();
            cpChartDirty = false;
        }
        NNInfoList = new();
        ClearIterations();
        InfoLineList.Clear();
        data.Clear();
        focusedMoves.Clear();
        analyzer?.ClearSearchMoves();
        dataList.Clear();
        StateHasChanged();
    }

    private void RunUCICommand()
    {
        if (analyzer == null)
        {
            logger.LogInformation("No engine loaded");
            return;
        }
        uciButtonPressed = true;
        analyzer?.UCI();
        StateHasChanged();
    }

    private async Task Update(EngineStatus status)
    {
        var nodes = FormatNodes(status.Nodes);
        var nps = GameAnalysis.Formatting.formatNPS(status.NPS);
        var k = status.MultiPV;
        data[k] = status;
        // Deduplicate: if focused search overwrites multipv 1 with a move that
        // also exists in a stale higher multipv slot, remove the stale duplicate
        if (focusedMoves.Count > 0)
        {
            var currentFirstMove = status.PVLongSAN?.Split(' ').FirstOrDefault();
            if (!string.IsNullOrEmpty(currentFirstMove))
            {
                var dupeKeys = data.Keys
                    .Where(key => key != k && data[key].PVLongSAN?.Split(' ').FirstOrDefault() == currentFirstMove)
                    .ToList();
                foreach (var dupe in dupeKeys) data.Remove(dupe);
            }
        }
        var ordered = data.OrderBy(e => e.Value.MultiPV).ToList();
        if (status.EPS == 0)
        {
            tableHeader = $"{nodes} ({nps}) (tbhits: {status.TBhits:N0})";
        }
        else
        {
            var eps = GameAnalysis.Formatting.formatEPS(status.EPS);
            tableHeader = $"{nodes} ({nps}, {eps}) (tbhits: {status.TBhits:N0})";
        }
        dataList = ordered;
        whitePV = ordered[0].Value.PV;

        // Always update PV state for any subscriber (individual or dual dialog)
        UpdatePVState();

        if (k <= 1) await PublishEval(status);

        await InvokeAsync(StateHasChanged);
        await Task.CompletedTask;
    }

    // Eval-bar publishing: throttled so the host page is not re-rendered per info line.
    private double? lastPublishedCp;
    private int? lastPublishedMate;

    private async Task PublishEval(EngineStatus status)
    {
        if (!OnEvalUpdated.HasDelegate) return;
        // EngineStatus.Eval is already white-perspective (the UCI parser negates for black).
        (double? cp, int? mate) = status.Eval switch
        {
            EvalType.CP c => ((double?)c.Info, (int?)null),
            EvalType.Mate m => (null, m.Info),
            _ => ((double?)null, (int?)null)
        };
        if (cp == null && mate == null) return;
        var changed = mate != lastPublishedMate || (cp.HasValue != lastPublishedCp.HasValue) ||
                      (cp.HasValue && lastPublishedCp.HasValue && Math.Abs(cp.Value - lastPublishedCp.Value) >= 0.05);
        if (!changed) return;
        lastPublishedCp = cp;
        lastPublishedMate = mate;
        await InvokeAsync(() => OnEvalUpdated.InvokeAsync((cp, mate)));
    }

    // Coalesces overlapping auto-search starts: at most one task runs and one waits.
    // Guards against unbounded thread-pool pile-up when the engine hangs or dies
    // (WaitForReadyOk can block for a long time on a crashed process).
    private int autoSearchQueued;
    // Position snapshot for the auto-search task: Chess.Board is not thread-safe and
    // is mutated on the dispatcher, so the task must never touch it (same pattern as
    // KibitzerPanel). Immutable tuple — the reference write is atomic and a coalesced
    // start picks up the newest snapshot.
    private (string PosCmd, string Go, string Fen) latestAutoSearch;

    // FEN of each in-flight search, enqueued when the go is actually issued and
    // dequeued when its bestmove arrives. A stopped search's bestmove can land after
    // navigation (even after the NEXT search's go was sent), and must not be
    // attributed to the new position: it marked the new position as analyzed (so
    // auto-search skipped it forever) and attached the old eval to the new edge/ply.
    private readonly System.Collections.Concurrent.ConcurrentQueue<string> pendingSearchFens = new();

    private void NoteSearchStarted(string searchFen)
    {
        // Bound the queue: a bestmove can be lost on abnormal engine output
        while (pendingSearchFens.Count > 4) pendingSearchFens.TryDequeue(out _);
        pendingSearchFens.Enqueue(searchFen ?? "");
    }

    private string BuildAutoGoCommand()
    {
        var suffix = analyzer.SearchMoves.Any() ? " searchmoves " + string.Join(" ", analyzer.SearchMoves) : "";
        return searchMode == SearchMode.Nodes
            ? $"go nodes {(int)numberOfNodes}{suffix}"
            : $"go movetime {(int)Math.Max(1, Math.Round(numberOfTimeMs))}{suffix}";
    }

    // Marshalled to the dispatcher: the body mutates UI state and snapshots the shared
    // board, and Notifier events run on whatever thread raised them — today always the
    // dispatcher, but nothing enforces that for future callers.
    public Task OnNotifyFen(string newPos) => InvokeAsync(async () =>
    {
        fen = newPos;
        NNInfoList = new();
        ClearIterations();
        lastMainInfoLine = "";
        lock (lastInfoByMultiPv) lastInfoByMultiPv.Clear();
        if (focusedMoves.Count > 0)
        {
            focusedMoves.Clear();
            ApplySearchMoves();
        }
        if (autoSearchSwitch)
        {
            if (IsPositionAnalyzed?.Invoke() == true)
            {
                // Skipping this position — but a search started for a PREVIOUS position
                // may still be running; left alone it keeps the panel stuck "searching"
                // (Stop enabled) with stats that no longer match the board.
                if (searchInProgress)
                {
                    analyzer?.Stop();
                    StopSearchTimer();
                    searchInProgress = false;
                }
                return;
            }
            if (searchInProgress)
            {
                analyzer?.Stop();
                StopSearchTimer();
            }
            if (searchInfoPlot != null)
                await searchInfoPlot?.ResetPlot(false);
            cpEvalPlot?.Clear();
            cpChartDirty = false;
            if (analyzer != null)
            {
                searchInProgress = true;
                StartSearchTimer();
                var a = analyzer;
                // Snapshot the shared board here on the dispatcher — the search task
                // must never touch it (racing the board's owner page corrupts the
                // move list mid-render: "Collection was modified").
                if (!ChessBoard.AnyLegalMove()) return;
                latestAutoSearch = (ChessBoard.PositionWithMovesFromGraph(), BuildAutoGoCommand(), ChessBoard.FEN());
                if (Interlocked.CompareExchange(ref autoSearchQueued, 1, 0) == 0)
                {
                    _ = Task.Run(async () => {
                        try
                        {
                            // Lock per analyzer so a task stuck on a dead engine never
                            // blocks searches of a recreated one.
                            lock (a)
                            {
                                autoSearchQueued = 0;
                                if (!autoSearchSwitch || !ReferenceEquals(a, analyzer)) return;
                                if (a.Engine.HasExited)
                                {
                                    logger.LogWarning("Engine process has exited during auto-search");
                                    searchInProgress = false;
                                }
                                else
                                {
                                    var (posCmd, goCmd, searchFen) = latestAutoSearch;
                                    // Enqueue next to the actual go: coalesced starts
                                    // (CAS above) send only the newest snapshot once.
                                    NoteSearchStarted(searchFen);
                                    a.PlayPrepared(posCmd, goCmd);
                                }
                            }
                            if (!searchInProgress)
                            {
                                StopSearchTimer();
                                await InvokeAsync(StateHasChanged);
                            }
                        }
                        catch (Exception ex) { logger.LogWarning("Search start failed: {Msg}", ex.Message); }
                    });
                }
            }
            else
            {
                searchInProgress = false;
            }
        }
        else
        {
            searchInProgress = false;
            StopSearchTimer();
        }
    });

    protected override Task OnInitializedAsync()
    {
        if (IsReviewing)
        {
            numberOfTimeMs = SettingsService.Settings.ReviewTimePerMove;
            numberOfNodes = Math.Max(1, SettingsService.Settings.ReviewNodes);
            searchMode = string.Equals(SettingsService.Settings.ReviewSearchMode, "Nodes", StringComparison.OrdinalIgnoreCase)
                ? SearchMode.Nodes : SearchMode.Time;
        }
        else
        {
            numberOfTimeMs = SettingsService.Settings.DefaultSearchTimeMs;
            numberOfNodes = Math.Max(1, SettingsService.Settings.DefaultSearchNodes);
            if (string.Equals(SettingsService.Settings.DefaultSearchMode, "Time", StringComparison.OrdinalIgnoreCase))
                searchMode = SearchMode.Time;
        }
        MinPolicyThreshold = OverlaySetting.MinPolicyThreshold;
        Notifier.NotifyFen += OnNotifyFen;

        this.keyContext = this.HotKeys.CreateContext()
            .Add(Key.Escape, (Func<Task>)(async () => await ResetEngine()), "reset engine")
            .Add(ModKey.Ctrl, Key.s, (() => ToggleOptimisticAndBase()), "toggle optimistic and baseline")
            .Add(ModKey.Ctrl, Key.g, (Func<Task>)(async () => await InvokeAsync(GoInfinite)), "go search")
            .Add(ModKey.Ctrl, Key.h, (Func<Task>)(async () => { analyzer?.Stop(); await InvokeAsync(StateHasChanged); }), "stop search")
            .Add(ModKey.Ctrl, Key.p, (() => CheckAnalysis()), "check P-rank")
            .Add(ModKey.Ctrl, Key.q, (Func<Task>)(async () => await DoQAnalysis()), "check Q-rank")
            .Add(ModCode.Ctrl | ModCode.Alt, Code.P, (() => CheckAllGamesAnalysis()), "check all games policy")
            .Add(ModCode.Ctrl | ModCode.Alt, Code.Q, (Func<Task>)(async () => await CheckAllGamesQAnalysis()), "check all games Q-rank")
            .Add(Key.F1, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 1; await Analyze(); })), "Analyze 1 node")
            .Add(Key.F2, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 1_000; await Analyze(); })), "Analyze 1_000 nodes")
            .Add(Key.F3, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 10_000; await Analyze(); })), "Analyze 10_000 nodes")
            .Add(Key.F4, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 100_000; await Analyze(); })), "Analyze 100_000 nodes")
            .Add(Key.F5, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 1_000_000; await Analyze(); })), "Analyze 1_000_000 nodes")
            .Add(Key.F6, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 10_000_000; await Analyze(); })), "Analyze 10_000_000 nodes")
            .Add(Key.F7, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 100_000_000; await Analyze(); })), "Analyze 100_000_000 nodes")
            .Add(Key.F8, (Func<Task>)(async () => await InvokeAsync(async () => { searchMode = SearchMode.Nodes; numberOfNodes = 1_000_000_000; await Analyze(); })), "Analyze 1_000_000_000 nodes");

        return base.OnInitializedAsync();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Engine is not null && Engine.Name != currentName && !string.IsNullOrEmpty(currentName))
        {
            logger.LogInformation("Engine name changed from {OldName} to {NewName}", currentName, Engine.Name);
            currentName = Engine.Name;
            await searchInfoPlot?.ResetNPlot();
            await InvokeAsync(() => NNInfoList = new());
            // New engine: captured info lines belong to the old one — don't let the
            // copy output pair them with the new engine's description.
            ClearIterations();
            lastMainInfoLine = "";
            lock (lastInfoByMultiPv) lastInfoByMultiPv.Clear();
            neuralNet = string.Empty;
            OverlaySetting.SetOverlaySetting(Id, OverlaySettings.None);
            await Notifier.UpdateDisplaySettings(OverlaySettings.None, Id);
            selectedOverlaySetting = OverlaySettings.None;
            await Task.CompletedTask;
        }

        var overlaySettings = OverlaySetting.GetOverlaySetting(Id);
        if (OverlaySetting.IsOverlaySettingsEnabled)
        {
            if (overlaySettings != selectedOverlaySetting)
            {
                selectedOverlaySetting = overlaySettings;
            }
        }
        if (Engine != null)
        {
            runLogLiveStats = analyzer?.Engine.GetUCICommands().ContainsKey("LogLiveStats") ?? Engine.Options.Keys.Contains("LogLiveStats");
            showCharts = runLogLiveStats;
            showCpChart = !runLogLiveStats;
            if (runLogLiveStats && overlaySettings == OverlaySettings.None)
            {
                if (!OverlaySetting.IsOverlaySettingsEnabled && SuppressAutoOverlay?.Invoke() != true)
                {
                    OverlaySetting.SetOverlaySetting(Id, OverlaySettings.Policy);
                    selectedOverlaySetting = OverlaySettings.Policy;
                }
            }
        }
        StateHasChanged();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            chessModule = await JsInteropService.ImportModuleAsync(JS);
            optimisticHead = engine1;
            var overlaySettings = OverlaySetting.GetOverlaySetting(Id);
            if (overlaySettings != OverlaySettings.None)
            {
                selectedOverlaySetting = overlaySettings;
                await OnOverlaySettingChanged(selectedOverlaySetting);
            }
            if (Engine != null)
            {
                runLogLiveStats = analyzer?.Engine.GetUCICommands().ContainsKey("LogLiveStats") ?? Engine.Options.Keys.Contains("LogLiveStats");
                showCharts = runLogLiveStats;
                showCpChart = !runLogLiveStats;
                currentName = Engine.Name;
            }
            searchInfoPlot?.Dispose();
            searchInfoPlot = new SearchInfoPlot(chessModule, qPlotReference, nPlotReference, "Cp-value", fen, neuralNet);
            searchInfoPlot.CompactLegend = CompactChartLegend;
            searchInfoPlot.ConvergenceChartElement = convergencePlotReference;
            cpEvalPlot = new CpEvalPlot(chessModule, cpChartReference);
            if (string.IsNullOrEmpty(FEN) == false)
            {
                fen = FEN;
            }
            searchInProgress = false;
            ChessBoard.inAnalysisMode = true;
            if (IsReviewing)
            {
                var reviewPV = SettingsService.Settings.ReviewMultiPV;
                cpChartLines = reviewPV;
                numberOfLines = reviewPV;
            }
            else
            {
                var defaultPV = Math.Max(1, SettingsService.Settings.DefaultMultiPV);
                cpChartLines = defaultPV;
                numberOfLines = defaultPV;
            }
            if (Nodes > 0) numberOfNodes = Nodes;
            Qdiff = 2;
            StateHasChanged();
        }

        await Task.CompletedTask;
    }

    public async ValueTask DisposeAsync()
    {
        Notifier.NotifyFen -= OnNotifyFen;
        disposeCts.Cancel();
        // Disposed mid-search the 100ms uiTimer would otherwise stay alive forever:
        // HandleUpdate early-returns after disposeCts, so the final BestMove can no
        // longer stop it.
        StopSearchTimer();
        try { analyzer?.Stop(); } catch { }
        analyzer?.Quit();
        logger.LogInformation("Disposing {page}", "EnginePanel");
        try
        {
            if (this.keyContext != null) await this.keyContext.DisposeAsync();
        }
        catch (Microsoft.JSInterop.JSDisconnectedException) { }
        catch (ObjectDisposedException) { }
    }

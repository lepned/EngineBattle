
<MudDialog>
  <DialogContent>
    @if (Gauntlet)
    {
      if (showPairs)
      {
        <CrossChallengerTablePairDetailModern CrossTable="CrossTable" FontSize="Fontsize + 4" Players="Players" GameResult="@GameResult"></CrossChallengerTablePairDetailModern>
      }
      else
      {
        <CrossChallengerTableDetailModern CrossTable="CrossTable" FontSize="Fontsize + 4" Players="Players" GameResult="@GameResult"></CrossChallengerTableDetailModern>
      }
    }
    else
    {
      if (showPairs)
      {
        <CrossTablePairDetailModern CrossTable="CrossTable" FontSize="Fontsize + 4" GameResult="@GameResult"></CrossTablePairDetailModern>
      }
      else
      {
        <CrossTableDetailModern CrossTable="CrossTable" FontSize="Fontsize + 4" GameResult="@GameResult"></CrossTableDetailModern>
      }
    }
  </DialogContent>
</MudDialog>

@code {
  [CascadingParameter] IMudDialogInstance MudDialog { get; set; }
  [Parameter] public List<CrossTableEntry> CrossTable { get; set; }
  [Parameter] public int Fontsize { get; set; }
  [Parameter] public bool Gauntlet { get; set; }
  [Parameter] public int Players { get; set; }
  [Parameter] public string GameResult { get; set; }

  private bool showPairs;
  private System.Timers.Timer cycleTimer;

  protected override void OnInitialized()
  {
    cycleTimer = new System.Timers.Timer(15000);
    cycleTimer.Elapsed += (sender, args) =>
    {
      showPairs = !showPairs;
      InvokeAsync(StateHasChanged);
    };
    cycleTimer.Start();
  }

  public void Dispose()
  {
    cycleTimer?.Dispose();
  }

  void Close() => MudDialog.Close(DialogResult.Ok(true));
}

<Window
    x:Class="EngineBattle.Desktop.MainWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="EngineBattle"
    Width="1280" Height="820"
    WindowStyle="None"
    ResizeMode="CanResize"
    Background="#FF1F2128">

    <!-- No OS title bar: EngineBattle's own app bar acts as the caption, with window buttons
         injected into it by TitleBarScript. CaptionHeight is 0 because the WebView2 is an
         HwndHost that swallows mouse input, so dragging is driven from the page instead. -->
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0"
                            ResizeBorderThickness="6"
                            CornerRadius="0"
                            GlassFrameThickness="0"
                            UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>

    <!-- The margin is the resize gutter. The WebView2's own HWND covers whatever it occupies,
         so without this inset there would be nowhere left for Windows to hit-test a resize. -->
    <Grid x:Name="RootHost" Margin="6">
        <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />

        <!-- Covers the WebView2 until the server answers, then gets out of the way. WPF cannot
             draw over an HwndHost, so this only works while the WebView is collapsed. -->
        <Grid x:Name="Overlay" Background="#FF1F2128">
            <Grid MaxWidth="820" Margin="48" VerticalAlignment="Center" HorizontalAlignment="Center">

                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center">
                    <TextBlock Text="EngineBattle"
                               HorizontalAlignment="Center"
                               Foreground="#FFE8EAF0"
                               FontSize="22" />
                    <TextBlock x:Name="StatusText"
                               Text="Starting…"
                               Margin="0,10,0,22"
                               HorizontalAlignment="Center"
                               Foreground="#FF9AA1B1"
                               FontSize="13" />
                    <ProgressBar IsIndeterminate="True" Width="260" Height="3"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#FF5B8DEF" />
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorTitle"
                               Foreground="#FFE8EAF0"
                               FontSize="18"
                               TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="360" Margin="0,16,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="ErrorDetail"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FF9AA1B1"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Retry" Padding="18,6" Click="OnRetryClick" />
                        <Button Content="Server output" Padding="18,6" Margin="12,0,0,0" Click="OnShowOutputClick" />
                        <Button Content="Copy details" Padding="18,6" Margin="12,0,0,0" Click="OnCopyClick" />
                        <Button Content="Close" Padding="18,6" Margin="12,0,0,0" Click="OnCloseClick" />
                    </StackPanel>
                </StackPanel>

            </Grid>
        </Grid>
    </Grid>
</Window>

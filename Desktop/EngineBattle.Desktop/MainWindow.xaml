<Window
    x:Class="EngineBattle.Desktop.MainWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf"
    Title="EngineBattle"
    Width="1280" Height="820"
    WindowStyle="SingleBorderWindow"
    ResizeMode="CanResize"
    Background="#FF1F2128">

    <!-- The ordinary Windows title bar and border: the window snaps, resizes and is dragged
         like any other app, and the page below draws nothing of its own for the window. F11
         swaps WindowStyle to None (and ResizeMode to NoResize) for true fullscreen. -->

    <DockPanel x:Name="RootHost">

        <!-- Shell-only commands: zoom, reload, the window itself, the server's output. The app's
             own navigation stays in its nav drawer - a second copy here would be one more thing
             to keep in step. Hidden in fullscreen, like the frame. -->
        <DockPanel x:Name="AppMenu" DockPanel.Dock="Top" Background="#FF23252D" LastChildFill="True">
        <Menu Background="Transparent" Foreground="#FFE8EAF0" BorderThickness="0"
              HorizontalAlignment="Left" VerticalAlignment="Center" SnapsToDevicePixels="True">

            <!-- WPF ships no dark menu, and half-darkening one leaves light text on the
                 system-drawn popup. Both roles that occur here - the bar's headers and the
                 items inside a drop-down - are templated, so every surface is ours. -->
            <Menu.Resources>
                <SolidColorBrush x:Key="MenuPopupBg" Color="#FF2A2D36" />
                <SolidColorBrush x:Key="MenuBorderBrush" Color="#FF3C4150" />
                <SolidColorBrush x:Key="MenuFg" Color="#FFE8EAF0" />
                <SolidColorBrush x:Key="MenuFgDim" Color="#FF858B9C" />
                <SolidColorBrush x:Key="MenuHighlight" Color="#FF39415A" />

                <ControlTemplate x:Key="TopLevelHeader" TargetType="{x:Type MenuItem}">
                    <Grid>
                        <Border x:Name="Bd" Background="Transparent" Padding="12,7">
                            <ContentPresenter ContentSource="Header" RecognizesAccessKey="True"
                                              VerticalAlignment="Center" />
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Bottom" Focusable="False"
                               AllowsTransparency="True" PopupAnimation="None"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}">
                            <Border Background="{StaticResource MenuPopupBg}"
                                    BorderBrush="{StaticResource MenuBorderBrush}"
                                    BorderThickness="1" Padding="0,4" Margin="0,0,8,8">
                                <Border.Effect>
                                    <DropShadowEffect BlurRadius="8" ShadowDepth="2" Opacity="0.4" Color="#FF000000" />
                                </Border.Effect>
                                <StackPanel IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </Border>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHighlight}" />
                        </Trigger>
                        <Trigger Property="IsSubmenuOpen" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHighlight}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

                <ControlTemplate x:Key="SubmenuItem" TargetType="{x:Type MenuItem}">
                    <Border x:Name="Bd" Background="Transparent" Padding="0">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentPresenter Grid.Column="0" ContentSource="Header" RecognizesAccessKey="True"
                                              Margin="14,6,10,6" VerticalAlignment="Center" />
                            <TextBlock Grid.Column="1" Text="{TemplateBinding InputGestureText}"
                                       Margin="28,6,14,6" VerticalAlignment="Center"
                                       Foreground="{StaticResource MenuFgDim}" />
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource MenuHighlight}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Foreground" Value="{StaticResource MenuFgDim}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>

                <Style TargetType="{x:Type MenuItem}">
                    <Setter Property="Foreground" Value="{StaticResource MenuFg}" />
                    <Setter Property="Template" Value="{StaticResource SubmenuItem}" />
                    <Style.Triggers>
                        <Trigger Property="Role" Value="TopLevelHeader">
                            <Setter Property="Template" Value="{StaticResource TopLevelHeader}" />
                        </Trigger>
                        <Trigger Property="Role" Value="TopLevelItem">
                            <Setter Property="Template" Value="{StaticResource TopLevelHeader}" />
                        </Trigger>
                    </Style.Triggers>
                </Style>

                <Style x:Key="{x:Static MenuItem.SeparatorStyleKey}" TargetType="{x:Type Separator}">
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="{x:Type Separator}">
                                <Border Height="1" Margin="10,4" Background="{StaticResource MenuBorderBrush}" />
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </Menu.Resources>
            <!-- The web app's navigation drawer, toggled from the row that already exists:
                 floating over the page it would cost the top row of every screen. -->
            <MenuItem Click="OnMenuToggleDrawer" ToolTip="Show or hide the navigation (the app's own drawer)">
                <MenuItem.Header>
                    <Path Data="M0,0 H15 M0,5 H15 M0,10 H15" Stroke="#FFE8EAF0" StrokeThickness="1.5"
                          SnapsToDevicePixels="True" Margin="2,0,2,0" />
                </MenuItem.Header>
            </MenuItem>
            <MenuItem Header="_File">
                <MenuItem Header="E_xit" InputGestureText="Alt+F4" Click="OnMenuExit" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Zoom _In" InputGestureText="Ctrl++" Click="OnMenuZoomIn" />
                <MenuItem Header="Zoom _Out" InputGestureText="Ctrl+-" Click="OnMenuZoomOut" />
                <MenuItem x:Name="ResetZoomItem" Header="_Reset Zoom" InputGestureText="Ctrl+0" Click="OnMenuZoomReset" />
                <Separator />
                <MenuItem Header="Re_load" InputGestureText="F5" Click="OnMenuReload" />
                <MenuItem Header="_Full Screen" InputGestureText="F11" Click="OnMenuFullScreen" />
            </MenuItem>
            <MenuItem Header="_Tools">
                <MenuItem Header="_Server Output" InputGestureText="Ctrl+Shift+L" Click="OnMenuServerOutput" />
                <MenuItem Header="_Developer Tools" InputGestureText="F12" Click="OnMenuDevTools" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="_About EngineBattle" Click="OnMenuAbout" />
            </MenuItem>
        </Menu>
        </DockPanel>

        <Grid>
            <wv2:WebView2 x:Name="WebView" Visibility="Collapsed" />

            <!-- Covers the WebView2 until the server answers, then gets out of the way. WPF
                 cannot draw over an HwndHost, so this only works while the WebView is
                 collapsed. -->
            <Grid x:Name="Overlay" Background="#FF1F2128">
                <Grid MaxWidth="820" Margin="48" VerticalAlignment="Center" HorizontalAlignment="Center">

                <StackPanel x:Name="LoadingPanel" HorizontalAlignment="Center">
                    <TextBlock Text="EngineBattle"
                               HorizontalAlignment="Center"
                               Foreground="#FFE8EAF0"
                               FontSize="22" />
                    <TextBlock x:Name="StatusText"
                               Text="Starting…"
                               Margin="0,10,0,22"
                               HorizontalAlignment="Center"
                               Foreground="#FF9AA1B1"
                               FontSize="13" />
                    <ProgressBar IsIndeterminate="True" Width="260" Height="3"
                                 Background="Transparent" BorderThickness="0"
                                 Foreground="#FF5B8DEF" />
                </StackPanel>

                <StackPanel x:Name="ErrorPanel" Visibility="Collapsed">
                    <TextBlock x:Name="ErrorTitle"
                               Foreground="#FFE8EAF0"
                               FontSize="18"
                               TextWrapping="Wrap" />
                    <ScrollViewer MaxHeight="360" Margin="0,16,0,0"
                                  HorizontalScrollBarVisibility="Auto"
                                  VerticalScrollBarVisibility="Auto">
                        <TextBox x:Name="ErrorDetail"
                                 IsReadOnly="True"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="#FF9AA1B1"
                                 FontFamily="Consolas"
                                 FontSize="12"
                                 TextWrapping="Wrap" />
                    </ScrollViewer>
                    <StackPanel Orientation="Horizontal" Margin="0,20,0,0">
                        <Button Content="Retry" Padding="18,6" Click="OnRetryClick" />
                        <Button Content="Server output" Padding="18,6" Margin="12,0,0,0" Click="OnShowOutputClick" />
                        <Button Content="Copy details" Padding="18,6" Margin="12,0,0,0" Click="OnCopyClick" />
                        <Button Content="Close" Padding="18,6" Margin="12,0,0,0" Click="OnCloseClick" />
                    </StackPanel>
                </StackPanel>

                </Grid>
            </Grid>
        </Grid>
    </DockPanel>
</Window>

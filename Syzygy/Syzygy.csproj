<Project Sdk="Microsoft.NET.Sdk">

  <!-- Syzygy tablebase probing in process: a C# port of Fathom, used by ChessLibrary's
       tablebase adjudication. C# because the port is pointer code over memory-mapped table files. -->
  <PropertyGroup>
    <OutputType>Library</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <Nullable>disable</Nullable>
    <RootNamespace>EngineBattle.Tablebases</RootNamespace>
  </PropertyGroup>

</Project>
